# NGINX config

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/lib/cmprovision/public;
    client_max_body_size 8G;

    server_name _;

    # Modules decompress the image while downloading it; writing a long run of zeros to eMMC can
    # keep a module from reading the socket for minutes. Do not drop the download in the meantime
    # (the nginx default send_timeout is 60s).
    location /uploads/ {
        send_timeout 6h;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    index index.php index.html;

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_request_buffering off;
        fastcgi_read_timeout 86400s;
    }
}
