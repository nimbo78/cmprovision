[Unit]
Description=Restore the durable cmprovision update gate and schedule interrupted recovery
Requires=cmprovision-network-init.service
After=local-fs.target cmprovision-network-init.service
Before=nginx.service cmprovision-queue.service cmprovision-queue-images.service cmprovision-wallboard-data.service cmprovision-dnsmasq.service cmprovision-rpiboot.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B -I /var/lib/cmprovision-updates/recover.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
