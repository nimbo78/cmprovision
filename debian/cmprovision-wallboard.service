[Unit]
Description=cmprovision HDMI connection watcher
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/cmprovision/hdmi-wallboard.py watch
Restart=on-failure
RestartSec=5
RuntimeDirectory=cmprovision-wallboard
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
