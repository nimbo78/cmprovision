[Unit]
Description=Reconcile the provisioning time server with the confirmed network
After=network-online.target cmprovision-network-recover.service cmprovision-dnsmasq.service chrony.service
ConditionPathExists=|/etc/cmprovision/stand-ntp.json
ConditionPathExists=|/run/cmprovision-time/listener-closing
ConditionPathExists=|/run/cmprovision-time/dhcp-options.reload

[Service]
Type=oneshot
ExecStart=/usr/sbin/cmprovision-stand-ntp reconcile
