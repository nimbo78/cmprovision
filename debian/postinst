#!/bin/sh

set -e

case "$1" in
  configure)

    PHP_VERSION=`echo "<?php echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;" | php`

    # artisan runs as the web user: the database is in WAL, and -wal and -shm files a root process created would
    # stay root's and lock the web server out
    ARTISAN="runuser -u www-data -- /var/lib/cmprovision/artisan"

    # Ownership: the code belongs to root, the web server writes only to storage, bootstrap/cache,
    # public/uploads, etc (dnsmasq.conf) and the SQLite database. Packages before 1.6.7 gave
    # www-data the whole tree, and dpkg keeps the owner of existing directories on upgrade; it runs
    # before artisan writes as the web user, and again at the end for what the steps run as root created.
    # chown -h everywhere: these places are writable by the web user, and following a symlink planted
    # there would hand it any file on the system.
    fix_ownership() {
        APP=/var/lib/cmprovision
        find "$APP" -xdev \( -path "$APP/storage" -o -path "$APP/bootstrap/cache" -o -path "$APP/public/uploads" \
            -o -path "$APP/etc" -o -path "$APP/.env" -o -path "$APP/database/database.sqlite*" \) -prune \
            -o -user www-data -exec chown -h root:root {} +
        chown -R -h www-data:www-data "$APP/storage" "$APP/bootstrap/cache" "$APP/public/uploads" "$APP/etc"
        chown -h www-data:www-data "$APP/database"
        for f in "$APP/.env" "$APP"/database/database.sqlite*; do
            if [ -f "$f" ] && [ ! -L "$f" ]; then chown -h www-data:www-data "$f"; fi
        done
        return 0
    }
    fix_ownership || echo "Could not adjust file ownership in /var/lib/cmprovision"

    # Its own php-fpm pool: 40-48 modules start and report at once. A file of ours for this PHP version, so the www
    # pool's conffile stays untouched; a new PHP version needs this configure again (dpkg-reconfigure cmprovision4)
    POOL=/etc/php/${PHP_VERSION}/fpm/pool.d/cmprovision.conf
    if [ -d "$(dirname "$POOL")" ]; then
        cat > "$POOL.new" <<'POOLCONF'
; cmprovision4: its own pool, so 40-48 modules starting and reporting at once never wait for a worker
; written by the cmprovision4 package on every configure: local changes are lost
[cmprovision]
user = www-data
group = www-data
listen = /run/php/cmprovision-fpm.sock
listen.owner = www-data
listen.group = www-data
pm = dynamic
pm.max_children = 16
pm.start_servers = 4
pm.min_spare_servers = 2
pm.max_spare_servers = 6
pm.max_requests = 500
POOLCONF
        if cmp -s "$POOL.new" "$POOL"; then
            rm -f "$POOL.new"
        else
            mv "$POOL.new" "$POOL"
            echo "php-fpm pool for cmprovision: $POOL"
            deb-systemd-invoke restart php${PHP_VERSION}-fpm || true
        fi
    else
        echo "WARNING: no php-fpm ${PHP_VERSION} pool directory: the web interface needs php${PHP_VERSION}-fpm"
    fi
    # The site talks to that pool. It is a conffile, so its shipped copy keeps php-fpm.sock and this edit is made here,
    # on a new installation as on one that named the www pool's socket of its PHP version; without the pool it stays
    if [ -f "$POOL" ] && grep -q "fastcgi_pass unix:/run/php/php[0-9.]*-fpm.sock" "/etc/nginx/sites-available/cmprovision"; then
        sed -i "s#fastcgi_pass unix:/run/php/php[0-9.]*-fpm.sock#fastcgi_pass unix:/run/php/cmprovision-fpm.sock#" "/etc/nginx/sites-available/cmprovision"
        echo "The nginx site talks to /run/php/cmprovision-fpm.sock"
        nginx -t >/dev/null 2>&1 && deb-systemd-invoke reload nginx || echo "nginx configuration test failed, not reloaded"
    fi

    if ! groups www-data | grep -q systemd-journal; then
        # Allow webserver user to read logs
        adduser www-data systemd-journal
    fi

    if [ ! -e /var/lib/cmprovision/.env ]; then

        # Set Laravel app key
        install -o www-data -g www-data -m 600 /var/lib/cmprovision/env.example /var/lib/cmprovision/.env
        $ARTISAN key:generate
        $ARTISAN config:cache

        # Make sure log is owned by www-data
        # install replaces whatever is there (never follows a symlink planted by the web user)
        install -m 644 -o www-data -g www-data /dev/null /var/lib/cmprovision/storage/logs/laravel.log

        # Enlarge php-fpm file upload size
        echo "Enlarging php maximum file upload size"
        PHP_INI=`echo "<?php echo str_replace('cli', 'fpm', php_ini_loaded_file() );" | php`
        sed -i "s/upload_max_filesize = 2M/upload_max_filesize = 8G/" "$PHP_INI"
        sed -i "s/post_max_size = 8M/post_max_size = 8G/" "$PHP_INI"
        sed -i "s/max_input_time = 60/max_input_time = 86400/" "$PHP_INI"
        deb-systemd-invoke restart php${PHP_VERSION}-fpm || true

        # Enable site in nginx (as *.conf: some nginx setups load only sites-enabled/*.conf)
        echo "Enabling CM provision webinterface in nginx"
        ln -sf /etc/nginx/sites-available/cmprovision /etc/nginx/sites-enabled/cmprovision.conf
        rm -f /etc/nginx/sites-enabled/default
        deb-systemd-invoke restart nginx || true
    fi

    # The nginx site is a conffile that this script also edits, so upgrades do not replace it:
    # add the image download timeout to existing installations here.
    NGINX_SITE=/etc/nginx/sites-available/cmprovision
    if ! grep -q "send_timeout" "$NGINX_SITE"; then
        echo "Adding image download timeout to $NGINX_SITE"
        sed -i 's#^    location / {#    location /uploads/ {\n        send_timeout 6h;\n    }\n\n    location / {#' "$NGINX_SITE"
        nginx -t >/dev/null 2>&1 && deb-systemd-invoke reload nginx || echo "nginx configuration test failed, not reloaded"
    fi

    # The site is enabled as cmprovision.conf: WLAN Pi OS points nginx.conf to wlanpi-core's, which
    # loads only sites-enabled/*.conf. Debian loads every name, so the old link must go, or the site
    # would be there twice (duplicate default server).
    if [ -L /etc/nginx/sites-enabled/cmprovision ]; then
        echo "Enabling the nginx site as cmprovision.conf"
        rm -f /etc/nginx/sites-enabled/cmprovision
        ln -sf "$NGINX_SITE" /etc/nginx/sites-enabled/cmprovision.conf
        nginx -t >/dev/null 2>&1 && deb-systemd-invoke reload nginx || echo "nginx configuration test failed, not reloaded"
    fi

    # Modules load their boot files over TFTP from cmprovision-dnsmasq, which needs UDP port 69.
    # Another TFTP server there (WLAN Pi OS runs tftpd-hpa on all addresses) keeps it from starting.
    TFTP_OWNER=$(ss -Hlunp 'sport = :69' 2>/dev/null | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | grep -v '^dnsmasq$' | head -1)
    if [ -n "$TFTP_OWNER" ]; then
        echo "WARNING: UDP port 69 is taken by $TFTP_OWNER: modules cannot network boot until it is stopped"
        echo "         (for tftpd-hpa: systemctl disable --now tftpd-hpa), then: systemctl restart cmprovision-dnsmasq"
    fi

    # Uploaded images pass through PHP's temporary directory. Keep it on disk next to the images:
    # on Debian 13 /tmp is RAM-backed (half the memory at most), and renaming is instant.
    UPLOAD_TMP=/var/lib/cmprovision/storage/app/upload-tmp
    if [ -L "$UPLOAD_TMP" ]; then rm -f "$UPLOAD_TMP"; fi   # storage is the web user's: no symlinks for root to follow
    install -d -o www-data -g www-data -m 700 "$UPLOAD_TMP"
    PHP_INI=`echo "<?php echo str_replace('cli', 'fpm', php_ini_loaded_file() );" | php`
    if [ -n "$PHP_INI" ] && ! grep -q "^upload_tmp_dir = $UPLOAD_TMP" "$PHP_INI"; then
        echo "Setting upload_tmp_dir = $UPLOAD_TMP in $PHP_INI"
        if grep -q "^;\?upload_tmp_dir =" "$PHP_INI"; then
            sed -i "s#^;\?upload_tmp_dir =.*#upload_tmp_dir = $UPLOAD_TMP#" "$PHP_INI"
        else
            echo "upload_tmp_dir = $UPLOAD_TMP" >> "$PHP_INI"
        fi
        deb-systemd-invoke restart php${PHP_VERSION}-fpm || true
    fi

    # The .env template used to ship development settings; production ones are safer
    # (debug pages show configuration and stack traces to anyone who reaches them).
    sed -i "s/^APP_ENV=local$/APP_ENV=production/; s/^APP_DEBUG=true$/APP_DEBUG=false/" /var/lib/cmprovision/.env

    sed -i "s/QUEUE_CONNECTION=sync/QUEUE_CONNECTION=database/" /var/lib/cmprovision/.env
    $ARTISAN config:clear
    $ARTISAN view:clear
    # a route cache made by hand (artisan optimize) would keep the routes of the old version: since 2.5.1 that would
    # put /scriptexecute back in the web group, refuse every module report (419) and drop the stand check
    $ARTISAN route:clear

    DB=/var/lib/cmprovision/database/database.sqlite
    if [ -L "$DB" ]; then rm -f "$DB"; fi   # the database directory is the web user's: no symlinks for root to follow
    if [ ! -e "$DB" ]; then
        install -m 600 -o www-data -g www-data /dev/null "$DB"
        echo "Initializing database"
        $ARTISAN migrate --seed --force
    else
        $ARTISAN migrate --force
        # New PHP code: restart php-fpm so opcache stops serving the previous version. debhelper gives
        # every file the timestamp of the changelog entry, so a rebuild of the same version is invisible
        # to opcache's mtime check (seen as a fatal error from the old composer autoloader).
        deb-systemd-invoke restart php${PHP_VERSION}-fpm || true
        # Restart rpiboot just in case an upgrade was triggered by the new version requirement in 'control' file
        deb-systemd-invoke restart cmprovision-rpiboot || true
        # Restart dnsmasq
        deb-systemd-invoke restart cmprovision-dnsmasq || true
    fi

    # Ownership again (fix_ownership above): what the steps run as root created
    fix_ownership || echo "Could not adjust file ownership in /var/lib/cmprovision"

    # The built-in Wi-Fi as a cold spare (2.5.2): the switch is written once and then left to the operator, and one check
    # runs now (the built-in Wi-Fi leaves a minute after the install if the card holds); it never fails the configure
    if [ ! -e /etc/default/cmprovision-uplink ]; then
        cat > /etc/default/cmprovision-uplink <<'EOF' || echo "Could not write /etc/default/cmprovision-uplink: the cold spare stays on"
# The built-in Wi-Fi as a cold spare (cmprovision): disconnected while another uplink carries the default route,
# connected when there has been none for 30 seconds. SPARE=no keeps it connected all the time.
SPARE=yes
EOF
    fi
    /usr/lib/cmprovision/uplink-spare check postinst || true
    # the metrics by device (2.5.3): NetworkManager reads its conf.d again, connections take them when they connect
    nmcli general reload conf >/dev/null 2>&1 || true

  ;;
esac

#DEBHELPER#

exit 0
