#!/bin/sh

set -e

# Do not remove the only recovery implementation during a full snapshot/restore.
# A root full-restore owns the gate while it installs its selected matching package.
if [ "$1" = "remove" ] && [ -e /run/cmprovision-backups/pending.json ]; then
    echo "A full backup or restore needs recovery. Resolve it before removing cmprovision." >&2
    exit 1
fi

# Do not remove or replace the recovery helper while an unconfirmed network change depends on it.
# Recovery is idempotent when no transaction is pending; a conflict stops package removal/upgrade.
if [ "$1" = "upgrade" ] || [ "$1" = "remove" ]; then
    if [ -x /usr/lib/cmprovision/network-transaction ]; then
        /usr/lib/cmprovision/network-transaction recover || {
            echo "Cannot replace cmprovision while network recovery needs attention." >&2
            exit 1
        }
    fi
fi

# Release the optional FPMS data consumer before application code changes or leaves.
# The normal FPMS process belongs to its own package and continues to run.
# The shared data producer goes too: it is a long-running PHP process and would keep the old code (it no longer follows
# the HDMI display with PartOf=, and debhelper starts nothing of it); whoever wants it, the display or the FPMS consumer,
# starts it again when postinst has restarted their watchers.
if [ "$1" = "upgrade" ] || [ "$1" = "remove" ]; then
    deb-systemd-invoke stop cmprovision-fpms.service cmprovision-fpms-data.service cmprovision-wallboard-data.service >/dev/null || true
fi

# Going back to a version without the image checksum worker (older than 2.5): its unit file leaves with this package,
# so stop and disable the worker now, or it would run the old code next to the old worker until a reboot
if [ "$1" = "upgrade" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.5.0~"; then
    deb-systemd-invoke stop cmprovision-queue-images.service >/dev/null || true
    deb-systemd-helper disable cmprovision-queue-images.service >/dev/null || true
fi

# The built-in Wi-Fi as a cold spare (2.5.2): leaving the package, or going back to a version without it, must not leave
# the built-in Wi-Fi disconnected until a reboot. A downgrade also takes the timer's unit away: purge drops its link and
# deb-systemd-helper's record of it, so the next upgrade enables it as on a first install (disable would keep the record,
# and the next upgrade would take the missing link for the admin's choice). A remove keeps the timer enabled for a later
# reinstall: debhelper stops it.
if [ "$1" = "remove" ] || { [ "$1" = "upgrade" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.5.2~"; }; then
    deb-systemd-invoke stop cmprovision-uplink.timer >/dev/null || true
    if [ "$1" = "upgrade" ]; then
        deb-systemd-helper purge cmprovision-uplink.timer >/dev/null || true
    fi
    systemctl stop 'cmprovision-uplink-check-*.timer' >/dev/null 2>&1 || true
    /usr/lib/cmprovision/uplink-spare release || true
fi

# Going below 2.7 removes scriptexecute64/ while dnsmasq still follows etc/boot.
if [ "$1" = "upgrade" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.7.0~"; then
    runuser -u www-data -- /usr/lib/cmprovision/boot-link legacy /var/lib/cmprovision || true
fi

# The receiver opens the application database and must stop when its files leave on downgrade.
if [ "$1" = "upgrade" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.7.2~"; then
    deb-systemd-invoke stop cmprovision-usb-diagnostics.service >/dev/null || true
    deb-systemd-helper purge cmprovision-usb-diagnostics.service >/dev/null || true
fi

# The display's reader holds SQLite connections; stop all its units before their code leaves on downgrade.
if [ "$1" = "upgrade" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.7.3~"; then
    deb-systemd-invoke stop cmprovision-wallboard.service cmprovision-wallboard-display.service cmprovision-wallboard-data.service >/dev/null || true
    deb-systemd-helper purge cmprovision-wallboard.service >/dev/null || true
fi
# The data unit appeared in 2.7.5: going below it leaves no unit file for a reader that could still be running.
if [ "$1" = "upgrade" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.7.5~"; then
    deb-systemd-invoke stop cmprovision-wallboard-data.service >/dev/null || true
fi

# The station's name over LLDP (2.23.0) leaves with its helper, and with a version that would not keep it current
if [ "$1" = "remove" ] || { [ "$1" = "upgrade" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.23.0~"; }; then
    /usr/lib/cmprovision/lldp-station withdraw || true
fi

#DEBHELPER#

exit 0
