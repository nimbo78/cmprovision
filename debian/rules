#!/usr/bin/make -f

WEB_CONTENT = debian/cmprovision4/var/lib/cmprovision/
RUNTIME_DIRS = storage/app/public storage/framework/cache/data storage/framework/sessions \
 storage/framework/testing storage/framework/views storage/logs bootstrap/cache public/uploads

%:
	dh $@

# Backup/restore run as root: install them outside the www-data-owned application directory.
override_dh_install:
	# Composer may fall back to source checkouts; their VCS files are not runtime content.
	dh_install --exclude=.git --exclude=.hg --exclude=.svn
	# VCS exclusion also removes .gitignore-only trees; fresh installs still need these directories.
	install -d -m 755 $(addprefix $(WEB_CONTENT),$(RUNTIME_DIRS))
	install -D -m 755 tools/sensor-askpass $(WEB_CONTENT)tools/sensor-askpass
	install -D -m 755 tools/backup.sh debian/cmprovision4/usr/sbin/cmprovision-backup
	install -D -m 755 tools/restore.sh debian/cmprovision4/usr/sbin/cmprovision-restore
	install -D -m 755 tools/uplink-spare debian/cmprovision4/usr/lib/cmprovision/uplink-spare
	install -D -m 755 tools/90-cmprovision-uplink debian/cmprovision4/usr/lib/NetworkManager/dispatcher.d/90-cmprovision-uplink
	install -D -m 755 tools/wifi-networks debian/cmprovision4/usr/lib/cmprovision/wifi-networks
	install -D -m 755 tools/vlan-networks debian/cmprovision4/usr/lib/cmprovision/vlan-networks
	install -D -m 755 tools/network-transaction debian/cmprovision4/usr/lib/cmprovision/network-transaction
	install -D -m 755 tools/dnsmasq-start debian/cmprovision4/usr/lib/cmprovision/dnsmasq-start
	for f in network-profile.py network-transaction.py network-transaction-store.py network-transaction-backend.py network-transaction-watchdog.py network-transaction-router.py network-connection-backend.py stand-network-backend.py stand-network-binding.py stand-role.py; do install -D -m 644 tools/$$f debian/cmprovision4/usr/lib/cmprovision/$$f; done
	install -D -m 755 tools/boot-link debian/cmprovision4/usr/lib/cmprovision/boot-link
	install -D -m 755 tools/lldp-station debian/cmprovision4/usr/lib/cmprovision/lldp-station
	install -D -m 644 tools/90-cmprovision-uplink.conf debian/cmprovision4/usr/lib/NetworkManager/conf.d/90-cmprovision-uplink.conf
	install -D -m 755 tools/usb-diagnostics.py debian/cmprovision4/usr/lib/cmprovision/usb-diagnostics.py
	install -D -m 755 tools/hdmi-wallboard.py debian/cmprovision4/usr/lib/cmprovision/hdmi-wallboard.py
	install -D -m 755 tools/wallboard-control debian/cmprovision4/usr/lib/cmprovision/wallboard-control
	install -D -m 755 tools/fpms-control.py debian/cmprovision4/usr/lib/cmprovision/fpms-control.py
	install -D -m 755 tools/fpms-control debian/cmprovision4/usr/lib/cmprovision/fpms-control
	install -D -m 755 tools/station-power.py debian/cmprovision4/usr/lib/cmprovision/station-power.py
	install -D -m 755 tools/station-power debian/cmprovision4/usr/lib/cmprovision/station-power
	install -D -m 755 tools/station-power-panel debian/cmprovision4/usr/lib/cmprovision/station-power-panel
	install -D -m 755 tools/station-time debian/cmprovision4/usr/lib/cmprovision/station-time
	install -D -m 644 tools/station-time.py debian/cmprovision4/usr/lib/cmprovision/station-time.py
	install -D -m 644 tools/time-backup.sh debian/cmprovision4/usr/lib/cmprovision/time-backup.sh
	install -D -m 755 tools/station-updates debian/cmprovision4/usr/lib/cmprovision/station-updates
	install -D -m 644 tools/station-updates.py debian/cmprovision4/usr/lib/cmprovision/station-updates.py
	for f in tools/update_*.py; do install -D -m 644 $$f debian/cmprovision4/usr/lib/cmprovision/$$(basename $$f); done

# The watcher alone decides whether there is a display (it starts the display, which wants the data unit). A static unit
# would otherwise be started by dh as well.
override_dh_installsystemd:
	dh_installsystemd -Xcmprovision-wallboard-display.service -Xcmprovision-wallboard-data.service -Xcmprovision-fpms-data.service -Xcmprovision-updates-recover.service
	dh_installsystemd --no-enable --no-start cmprovision-wallboard-display.service cmprovision-wallboard-data.service cmprovision-fpms-data.service
	dh_installsystemd --no-start cmprovision-updates-recover.service

override_dh_strip:
	dh_strip --exclude=.elf --exclude=ledpattern

# The code belongs to root; the web server writes only to these (and the SQLite file, created by
# postinst, in database/). postinst applies the same split to existing installations.
WRITABLE = storage bootstrap/cache public/uploads etc

override_dh_fixperms:
	dh_fixperms
	chmod 755 $(WEB_CONTENT)artisan
	for d in $(WRITABLE); do chown -R www-data:www-data $(WEB_CONTENT)$$d; done
	chown www-data:www-data $(WEB_CONTENT)database
