#!/usr/bin/make -f

WEB_CONTENT = debian/cmprovision4/var/lib/cmprovision/

%:
	dh $@

# Backup/restore run as root: install them outside the www-data-owned application directory.
override_dh_install:
	dh_install
	install -D -m 755 tools/sensor-askpass $(WEB_CONTENT)tools/sensor-askpass
	install -D -m 755 tools/backup.sh debian/cmprovision4/usr/sbin/cmprovision-backup
	install -D -m 755 tools/restore.sh debian/cmprovision4/usr/sbin/cmprovision-restore
	install -D -m 755 tools/uplink-spare debian/cmprovision4/usr/lib/cmprovision/uplink-spare
	install -D -m 755 tools/90-cmprovision-uplink debian/cmprovision4/usr/lib/NetworkManager/dispatcher.d/90-cmprovision-uplink
	install -D -m 755 tools/wifi-networks debian/cmprovision4/usr/lib/cmprovision/wifi-networks
	install -D -m 755 tools/boot-link debian/cmprovision4/usr/lib/cmprovision/boot-link
	install -D -m 644 tools/90-cmprovision-uplink.conf debian/cmprovision4/usr/lib/NetworkManager/conf.d/90-cmprovision-uplink.conf

override_dh_strip:
	dh_strip --exclude=.elf --exclude=ledpattern

# The code belongs to root; the web server writes only to these (and the SQLite file, created by
# postinst, in database/). postinst applies the same split to existing installations.
WRITABLE = storage bootstrap/cache public/uploads etc

override_dh_fixperms:
	dh_fixperms
	chmod 755 $(WEB_CONTENT)artisan
	for d in $(WRITABLE); do chown -R www-data:www-data $(WEB_CONTENT)$$d; done
	chown www-data:www-data $(WEB_CONTENT)database
