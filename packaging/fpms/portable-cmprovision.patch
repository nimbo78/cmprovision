+# the short causes of cmprovision's catalogue (app/Support/ShortCause.php), the longest with a curl code
+CAUSES = ["Storage overwritten", "Image file truncated", "Pieces copy damaged", f"No data from server 10 min (curl{NBSP}7)",
+          f"Image gone from server (curl{NBSP}22)", f"Server refused resume (curl{NBSP}33)", f"Download cut (curl{NBSP}56)",
+          f"Server unreachable (curl{NBSP}28)", f"Decompressor stopped (curl{NBSP}23)", f"Server name unknown (curl{NBSP}6)",
+          "Not a valid image", "Image data corrupted", "Storage not writable", "eMMC I/O error", "No active project",
+          "Image checksum not ready", "Not a disk image", "No eMMC or SD card", "Image larger than eMMC",
+          "EEPROM: no SPI chip", "EEPROM image mismatch", "EEPROM download failed", "EEPROM flash failed",
+          "New OS did not boot", "New OS did not report", "OS check failed", "Server error",
+          "Pre-install script failed (code 255)", "Post-install script failed (code 255)", "SHA256 mismatch after write",
