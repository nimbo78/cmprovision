@@ -0,0 +1,266 @@
+"""Compact station menu. No imports from the WLAN Pi application/provider."""
+
+import argparse
+import json
+import logging
+import signal
+import time
+from datetime import timedelta
+from pathlib import Path
+
+from .integrations.cmprovision import CONFIG, SNAPSHOT, FIRST_ADMIN, Panel, heartbeat
+from .integrations.cmprovision_power import request as power_request
+from .integrations.cmprovision_rescue import request as rescue_request
+from .modules.screen.st7735_probe import probe_st7735
+from .modules.screen import hyperpixel
+
+BUTTONS = {
+    6: "UP",
+    19: "DOWN",
+    5: "LEFT",
+    26: "RIGHT",
+    13: "CENTER",
+    21: "KEY1",
+    20: "KEY2",
+    16: "KEY3",
+}
+
+
+def wait_for_display(stopping, until=None):
+    """Stay cheap and interruptible while the panel is absent or unrecognized."""
+    next_probe = 0.0
+    while not stopping():
+        now = time.monotonic()
+        if until is not None and now >= until:
+            return None
+        if hyperpixel.configured():
+            event = hyperpixel.find_touch()
+            if event:
+                return {**hyperpixel.DISPLAY, "event": event}
+        elif Path("/dev/spidev0.0").exists():
+            if now >= next_probe:
+                display = probe_st7735()
+                if display:
+                    return display
+                next_probe = now + 30
+        else:
+            next_probe = 0.0
+        heartbeat(False)
+        time.sleep(min(3, max(0, until - now)) if until is not None else 3)
+    return None
+
+
+def run_hyperpixel(panel, args, stopping, started):
+    from PIL import Image
+    from .integrations.cmprovision_touch import TouchMenu
+    menu = TouchMenu(panel)
+    last_error = None
+
+    def running():
+        return not stopping() and (not args.seconds or time.monotonic() < started + args.seconds)
+
+    while running():
+        screen = touch = None
+        try:
+            event = hyperpixel.find_touch()
+            if not event:
+                raise OSError("HyperPixel touch controller unavailable")
+            touch = hyperpixel.TouchInput(event, args.rotate)
+            screen = hyperpixel.DpiScreen.open()
+            last_key = time.monotonic()
+            next_frame = next_heartbeat = next_poll = 0
+            sleeping = False
+            ready = False
+            while running():
+                now = time.monotonic()
+                if now >= next_poll:
+                    panel.refresh()
+                    panel.expire_access()
+                    if FIRST_ADMIN.is_file():
+                        last_key = now
+                    next_poll = now + 0.2
+                idle = panel.should_sleep(now - last_key, args.sleep)
+                if idle != sleeping:
+                    sleeping, next_frame = idle, 0
+                    if sleeping:
+                        menu.motion.begin(None, now, None)
+                        screen.show(Image.new('RGB', (hyperpixel.SCAN_WIDTH, hyperpixel.SCAN_HEIGHT)))
+                if not sleeping and now >= next_frame:
+                    frame = menu.frame()
+                    screen.show(hyperpixel.to_scanout(frame, args.rotate))
+                    next_frame = now+2
+                    if not ready:
+                        print("FPMS_DISPLAY_DETECTED HyperPixel 4.0 Touch GT911", flush=True)
+                        print("FPMS_LITE_READY", flush=True)
+                        ready, last_error = True, None
+                elif not sleeping and menu.motion.advance(now):
+                    screen.show(hyperpixel.to_scanout(menu.image, args.rotate))
+                if sleeping and now >= next_heartbeat and not screen.dedicated(screen.card, screen.connector, screen.crtc):
+                    raise OSError("DPI output changed")
+                if ready and now >= next_heartbeat:
+                    heartbeat(True, display=hyperpixel.DISPLAY)
+                    next_heartbeat = now+3
+                taps = touch.read(0.2 if sleeping else menu.motion.delay(time.monotonic(), 0.2))
+                if taps:
+                    last_key, next_frame = time.monotonic(), 0
+                    if sleeping:
+                        sleeping = False
+                    else:
+                        menu.tap(*taps[0])
+                        if args.seconds:
+                            print(f"Touch page={panel.page} detail={bool(panel.detail)}", flush=True)
+        except (ImportError, OSError, RuntimeError, ValueError) as exc:
+            if str(exc) != last_error:
+                logging.getLogger(__name__).warning("HyperPixel unavailable: %s", exc)
+                last_error = str(exc)
+        finally:
+            if panel.rescue_menu and panel.rescue_menu.open:
+                panel.rescue_menu.close()
+            if touch:
+                touch.close()
+            try:
+                if screen:
+                    screen.close()
+            finally:
+                heartbeat(False)
+        # Release the card before retrying after an output or ownership change.
+        screen = None
+        if running():
+            time.sleep(3)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--snapshot", type=Path, default=SNAPSHOT)
+    parser.add_argument("--config", type=Path, default=CONFIG)
+    parser.add_argument("--preview", type=Path)
+    parser.add_argument("--rotate", type=int, choices=(0, 180), default=0)
+    parser.add_argument(
+        "--sleep",
+        type=int,
+        choices=range(0, 3601),
+        default=None,
+        help="Override the FPMS screen timeout for this run (seconds, 0 stays on)",
+    )
+    parser.add_argument(
+        "--seconds", type=int, choices=range(1, 601), help="Bounded hardware test"
+    )
+    args = parser.parse_args()
+    # the panel is the whole screen here: button 2 goes back to Overview instead of leaving
+    panel = Panel(args.config, args.snapshot, can_leave=False,
+                  power_client=None if args.preview else power_request,
+                  rescue_client=None if args.preview else rescue_request)
+    panel.refresh(force=True)
+    if args.preview:
+        panel.frame().save(args.preview)
+        return
+
+    # Identify the controller before taking backlight or button GPIOs.
+    stop = False
+
+    def stopping(*_):
+        nonlocal stop
+        stop = True
+
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        signal.signal(sig, stopping)
+    started = time.monotonic()
+    display = wait_for_display(lambda: stop, until=started + args.seconds if args.seconds else None)
+    if display is None or stop:
+        return
+    if display.get("profile") == "hyperpixel-4-touch":
+        run_hyperpixel(panel, args, lambda: stop, started)
+        return
+    print("FPMS_DISPLAY_DETECTED ST7735S " + display['id'], flush=True)
+
+    import gpiod
+    from gpiod.line import Bias, Edge
+
+    from .modules.gpiochip import get_gpiochip
+    from .modules.screen.st7735 import ST7735
+
+    screen = ST7735()
+    last_key, last_frame, last_heartbeat, sleeping = time.monotonic(), 0, 0, False
+    with gpiod.request_lines(
+        get_gpiochip(),
+        consumer="fpms-lite",
+        config={
+            tuple(BUTTONS): gpiod.LineSettings(
+                bias=Bias.PULL_UP,
+                edge_detection=Edge.FALLING,
+                debounce_period=timedelta(milliseconds=30),
+            )
+        },
+    ) as buttons:
+        try:
+            screen.init()
+            print("FPMS_LITE_READY", flush=True)
+            while not stop and (
+                not args.seconds or time.monotonic() - started < args.seconds
+            ):
+                now = time.monotonic()
+                if now - last_heartbeat >= 3:
+                    heartbeat(True, display=display)
+                    last_heartbeat = now
+                try:
+                    panel.refresh()
+                except Exception:
+                    logging.getLogger(__name__).exception("snapshot not usable")
+                panel.expire_access()
+                setup_visible = FIRST_ADMIN.is_file()
+                if setup_visible:
+                    last_key = now
+                idle = panel.should_sleep(now - last_key, args.sleep)
+                if idle != sleeping:
+                    sleeping, last_frame = idle, 0
+                    if sleeping:
+                        screen.sleep()
+                    else:
+                        screen.wakeup()
+                if not sleeping and now - last_frame >= 2:
+                    try:
+                        screen.drawImage(panel.frame().rotate(args.rotate))
+                    except Exception:
+                        logging.getLogger(__name__).exception("page not drawn")
+                    last_frame = now
+                if buttons.wait_edge_events(timedelta(seconds=0.2)):
+                    for event in buttons.read_edge_events():
+                        last_key = time.monotonic()
+                        if sleeping:
+                            screen.wakeup()
+                            sleeping = False
+                        else:
+                            key = BUTTONS[event.line_offset]
+                            if args.rotate:
+                                key = {
+                                    "UP": "DOWN",
+                                    "DOWN": "UP",
+                                    "LEFT": "RIGHT",
+                                    "RIGHT": "LEFT",
+                                    "KEY1": "KEY3",
+                                    "KEY3": "KEY1",
+                                }.get(key, key)
+                            panel.key(key)
+                            if args.seconds:
+                                print(
+                                    json.dumps(
+                                        {
+                                            "button": key,
+                                            "page": panel.page,
+                                            "detail": panel.detail,
+                                        }
+                                    ),
+                                    flush=True,
+                                )
+                        last_frame = 0
+        finally:
+            if panel.rescue_menu:
+                panel.rescue_menu.close()
+            if hasattr(screen, "device"):
+                screen.sleep()
+                screen.device.module_exit()
+            heartbeat(False)
+
+
+if __name__ == "__main__":
+    main()
