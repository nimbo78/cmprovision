+def test_hyperpixel_industrial_face_targets_and_offline_navigation(tmp_path, theme, color_mode, monkeypatch):
+    import fpms.integrations.cmprovision_touch as touch
+    from fpms.integrations.cmprovision_touch import TouchMenu
+
+    snap = demo_snapshot()
+    first = industrial_switch()
+    first["blocks"][0]["ports"][7].update(server=True, endpoint="wlanpi-da2", link_up=True, speed=1000)
+    snap.update(panel={"theme": theme, "color_mode": color_mode}, switches=[first, snap["switches"][0]])
+    p = panel_with(tmp_path, snap)
+    p.page = 1
+    menu = TouchMenu(p)
+    labels = []
+    bolts, unknowns, links = [], [], []
+    label, mark, icon_caption = menu.label, menu.mark, touch.icon_caption
+
+    def record(x, y, value, *args, **kw):
+        labels.append(value)
+        if value == "?":
+            unknowns.append((x, y))
+        return label(x, y, value, *args, **kw)
+
+    def record_mark(x, y, symbol, *args, **kw):
+        if symbol == "bolt":
+            bolts.append((x, y))
+        return mark(x, y, symbol, *args, **kw)
+
+    def record_caption(draw, x, y, symbol, caption, *args, **kw):
+        if symbol == "Ports":
+            links.append((x, y, caption))
+        if symbol == "bolt":
+            bolts.append((x, y))
+            if caption == "?":
+                unknowns.append((x, y))
+        return icon_caption(draw, x, y, symbol, caption, *args, **kw)
+
+    def render():
+        labels.clear()
+        menu.frame()
+
+    def tap(target):
+        x, y, right, bottom = next(box for box, action in menu.targets if action == target)
+        menu.tap((x + right) // 2, (y + bottom) // 2)
+        render()
+
+    monkeypatch.setattr(menu, "label", record)
+    monkeypatch.setattr(menu, "mark", record_mark)
+    monkeypatch.setattr(touch, "icon_caption", record_caption)
+    render()
+    tiles = {key: box for box, (kind, key) in menu.targets if kind == "row"}
+    copper = [tiles[f"0:GE1/0/{n}"] for n in range(1, 9)]
+    cages = [tiles[f"0:10GE1/0/{n}"] for n in range(1, 5)]
+    assert len(tiles) == 12 and max(b[2] for b in copper) < min(b[0] for b in cages)
+    for left, top, right, bottom in tiles.values():
+        width, height = right - left + 1, bottom - top + 1
+        assert min(width, height) >= 44 and max(width, height) <= 1.5 * min(width, height)
+        mid_x = (left + right) // 2
+        assert menu.image.getpixel((mid_x, top)) != menu.image.getpixel((mid_x, top - 2))
+    assert {"S5735I-S8U4XN-V2", "GE RJ45", "10GE SFP+"} <= set(labels)
+    assert {f"GE{n}" for n in range(1, 9)} | {f"10GE{n}" for n in range(1, 5)} <= set(labels)
+    assert labels.count("wlanpi-da2") == 2   # the header and the endpoint on GE8
+    assert any(copper[7][0] <= x <= copper[7][2] and copper[7][1] <= y <= copper[7][3]
+               and caption == "Up · 1G" for x, y, caption in links)
+    for upper, lower in ((copper[:4], copper[4:]), (cages[:2], cages[2:])):
+        assert len({b[1] for b in upper}) == len({b[1] for b in lower}) == 1
+        assert upper[0][3] < lower[0][1]
+        assert [b[0] for b in upper] == [b[0] for b in lower]
+        assert all(a[2] < b[0] for a, b in zip(upper, upper[1:]))
+    for bank, supports_poe in ((copper, True), (cages, False)):
+        for left, top, right, bottom in bank:
+            for readings in (bolts, unknowns):
+                assert any(left <= x <= right and top <= y <= bottom for x, y in readings) is supports_poe
+    for pin in tiles:
+        tap(("row", pin))
+        assert p.detail == ("port", pin) and menu.port_row()["portname"] == pin.split(":")[1]
+        tap(("key", "KEY2"))
+    tap(("row", "0:10GE1/0/1"))
+    tap(("section", "physical"))
+    first.update(answering=False, serial="HX-1")
+    p.snapshot.write_text(json.dumps(snap))
+    p.refresh(now=102, force=True)
+    render()
+    assert p.detail is None and {"rack-hw", "S5735I-S8U4XN-V2", "HX-1"} <= set(labels)
+    assert not any(kind in ("offset", "port_device", "section") for _, (kind, _) in menu.targets)
+    assert {key.split(":")[0] for _, (kind, key) in menu.targets if kind == "row"} == {"1"}
+    tap(("row", "1:Gi0/1"))
+    assert menu.port_row()["name"] == SWITCH + " Gi0/1"
+    tap(("key", "KEY2"))
+    first["answering"] = True
+    p.snapshot.write_text(json.dumps(snap))
+    p.refresh(now=103, force=True)
+    render()
+    assert "HX-1" not in labels and ("offset", 0) in [a for _, a in menu.targets]
