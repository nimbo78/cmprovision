+@lru_cache(maxsize=12)
+def brand(size, variant):
+    """The 48-unit application-mark.blade.php centreline, sampled at 1.6 units before antialiasing."""
+    a, b, ink = {
+        "light": ("#ffd37a", "#e2681c", "#2a1a0c"),
