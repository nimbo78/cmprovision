new file mode 100644
index 0000000..32d6366
--- /dev/null
+++ b/fpms/integrations/cmprovision_power.py
@@ -0,0 +1,208 @@
+"""Lite station menu: appearance preferences and separately confirmed power actions."""
+import json
+import re
+import subprocess
+
+from PIL import Image, ImageDraw
+from . import cmprovision_fonts as fonts
+
+COLOR_MODES = ('light', 'dark', 'auto')
+SCREEN_TIMEOUTS = (15, 30, 60, 120, 300, 600, 1800, 3600, 0)
+SYSTEM_ITEMS = ('Cancel', 'Restart', 'Shut down', 'Appearance >', 'Screen timeout >')
+
+
+def timeout_label(seconds):
+    if seconds == 0:
+        return 'Never'
+    if seconds == 3600:
+        return '1 h'
+    return f'{seconds // 60} min' if seconds >= 60 else f'{seconds} s'
+
+
+def request(payload):
+    """The root display talks only to the package's fixed, bounded local bridge."""
+    result = subprocess.run(["/usr/lib/cmprovision/station-power-panel"],
+                            input=json.dumps(payload), text=True, capture_output=True,
+                            timeout=15, check=False)
+    if len(result.stdout) > 8192:
+        raise RuntimeError("Power controller unavailable")
+    response = json.loads(result.stdout)
+    if result.returncode != 0 or not isinstance(response, dict) or response.get("ok") is not True:
+        raise RuntimeError("Power controller unavailable")
+    return response.get("result")
+
+
+class PowerMenu:
+    def __init__(self, client, clock):
+        self.client, self.clock = client, clock
+        self.open = False
+        self.stage, self.index, self.action = "menu", 0, "reboot"
+        self.token, self.deadline, self.active_count = None, 0, 0
+        self.message = "Check station status before retrying."
+        self.appearance_mode, self.mode_index = 'dark', 1
+        self.appearance_saved = False
+        self.timeout_seconds, self.timeout_index, self.timeout_saved = 60, SCREEN_TIMEOUTS.index(60), False
+        self.observations = {}
+
+    def show(self):
+        self.open, self.stage, self.index = True, "menu", 0
+        self.token = None
+        self.observations.clear()
+
+    def expire(self):
+        if self.stage in ("confirm", "interrupt") and self.clock() >= self.deadline:
+            self.stage = "expired"
+
+    def _reply(self, result, preparing=False):
+        if not isinstance(result, dict) or result.get("action") != self.action:
+            raise ValueError("Invalid response")
+        stage = result.get("stage")
+        if stage == "scheduled" and not preparing:
+            self.stage, self.token = stage, None
+            return
+        if stage not in (("confirm",) if preparing else ("interrupt",)):
+            raise ValueError("Invalid stage")
+        token, count = result.get("token"), result.get("active_count")
+        if not isinstance(token, str) or not re.fullmatch("[0-9a-f]{64}", token):
+            raise ValueError("Invalid token")
+        if type(count) is not int or not 0 <= count <= 100000:
+            raise ValueError("Invalid module count")
+        if not preparing and token != self.token:
+            raise ValueError("Changed token")
+        self.stage, self.token, self.active_count = stage, token, count
+
+    def _preference(self, stage, field, choices, value=None):
+        payload = {'operation': stage} if value is None else {'operation': 'set-' + stage, field: value}
+        result = self.client(payload)
+        if not isinstance(result, dict) or result.get('stage') != stage:
+            raise ValueError('Invalid display setting response')
+        confirmed, observed = result.get(field), result.get('observed_at')
+        if type(confirmed) is not type(choices[0]) or confirmed not in choices or type(observed) is not int or not 0 <= observed < 2**53:
+            raise ValueError('Invalid display setting')
+        if value is not None and confirmed != value:
+            raise ValueError('Display change was not confirmed')
+        self.observations[stage] = (confirmed, observed)
+        return confirmed
+
+    def key(self, key):
+        self.expire()
+        if key == "KEY2":
+            if self.stage in ('timeout', 'timeout_error'):
+                self.stage, self.index = 'menu', 4
+                return
+            if self.stage in ('appearance', 'appearance_error'):
+                self.stage, self.index = 'menu', 3
+                return
+            # Scheduling cannot be cancelled here. For an unused ticket this invalidates
+            # server-side confirmation too; expiry still protects a failed cancel request.
+            if self.token:
+                try: self.client(dict(operation="cancel", token=self.token))
+                except Exception: pass
+            self.open, self.token = False, None
+            return
+        try:
+            if self.stage == "menu":
+                if key in ("UP", "DOWN"):
+                    self.index = (self.index + (1 if key == "DOWN" else -1)) % len(SYSTEM_ITEMS)
+                elif key == "CENTER":
+                    if self.index == 0:
+                        self.open = False
+                        return
+                    if self.index == 3:
+                        self.stage, self.appearance_saved = 'appearance', False
+                        self.appearance_mode = self._preference('appearance', 'mode', COLOR_MODES)
+                        self.mode_index = COLOR_MODES.index(self.appearance_mode)
+                        return
+                    if self.index == 4:
+                        self.stage, self.timeout_saved = 'timeout', False
+                        self.timeout_seconds = self._preference('screen-timeout', 'seconds', SCREEN_TIMEOUTS)
+                        self.timeout_index = SCREEN_TIMEOUTS.index(self.timeout_seconds)
+                        return
+                    self.action = ("reboot", "poweroff")[self.index - 1]
+                    self._reply(self.client(dict(operation="prepare", action=self.action)), preparing=True)
+                    self.deadline = self.clock() + 120
+            elif self.stage == 'appearance':
+                if key in ('UP', 'DOWN'):
+                    self.mode_index = (self.mode_index + (1 if key == 'DOWN' else -1)) % len(COLOR_MODES)
+                elif key == 'CENTER':
+                    mode = COLOR_MODES[self.mode_index]
+                    self.appearance_mode = self._preference('appearance', 'mode', COLOR_MODES, mode)
+                    self.appearance_saved = True
+            elif self.stage == 'timeout':
+                if key in ('UP', 'DOWN'):
+                    self.timeout_index = (self.timeout_index + (1 if key == 'DOWN' else -1)) % len(SCREEN_TIMEOUTS)
+                elif key == 'CENTER':
+                    seconds = SCREEN_TIMEOUTS[self.timeout_index]
+                    self.timeout_seconds = self._preference('screen-timeout', 'seconds', SCREEN_TIMEOUTS, seconds)
+                    self.timeout_saved = True
+            elif self.stage in ("confirm", "interrupt") and key == "KEY1":
+                self._reply(self.client(dict(operation="confirm", token=self.token,
+                                             interrupt=self.stage == "interrupt")))
+        except Exception:
+            # A lost reply may mean the action was scheduled. Never retry a confirmation
+            # automatically, and never show private command output on the display.
+            self.stage = self.stage + '_error' if self.stage in ('appearance', 'timeout') else 'error'
+
+
+def render(menu, palette):
+    """Same compact power flow and semantic palette for Classic/New and Light/Dark/Auto."""
+    menu.expire()
+    p = dict(palette)
+    p.setdefault("fg", p.get("text"))
+    img = Image.new("RGB", (128, 128), p["bg"])
+    draw = ImageDraw.Draw(img)
+    title, body, small = fonts.font("title"), fonts.font("body"), fonts.font("code")
+    legend = fonts.font("tiny")
+    draw.rectangle((0, 0, 17, 13), fill=p["accent"])
+    fonts.draw_centered(small, img, (0, 0, 17, 13), "cm", p["bg"])
+    caption = {'menu': 'Station', 'timeout': 'Timeout', 'appearance': 'Appearance'}.get(menu.stage.removesuffix('_error'), 'Power')
+    title.draw(img, 22, 0, caption, p["fg"])
+    draw.line((0, 16, 127, 16), fill=p["line"])
+    action = "Restart" if menu.action == "reboot" else "Shut down"
+    stage = menu.stage
+    if stage == "menu":
+        for n, word in enumerate(SYSTEM_ITEMS):
+            y = 21 + n * 16
+            if n == menu.index:
+                draw.rectangle((1, y - 3, 126, y + 14), outline=p["accent"])
+            body.draw(img, 8, y, word, p["accent"] if n == menu.index else p["fg"])
+        lines = ["CENTER Select", "KEY2 Back"]
+    elif stage in ('appearance', 'timeout'):
+        if stage == 'appearance':
+            choices, index, current = COLOR_MODES, menu.mode_index, menu.appearance_mode
+            label, hint = str.title, 'Saved' if menu.appearance_saved else 'Choose color mode'
+        else:
+            choices, index, current = SCREEN_TIMEOUTS, menu.timeout_index, menu.timeout_seconds
+            label, hint = timeout_label, 'Saved' if menu.timeout_saved else 'Up/down to choose'
+        first = min(max(index - 1, 0), len(choices) - 3)
+        for n in range(first, first + 3):
+            y = 25 + (n - first) * 21
+            if n == index:
+                draw.rectangle((1, y - 3, 126, y + 14), outline=p['accent'])
+            value = choices[n]
+            draw.ellipse((8, y + 3, 13, y + 8), outline=p['accent'], fill=p['accent'] if value == current else p['bg'])
+            body.draw(img, 22, y, label(value), p['accent'] if n == index else p['fg'])
+        small.draw(img, 2, 88, hint, p['muted'])
+        lines = ['CENTER Apply', 'KEY2 Back']
+    else:
+        heading = {"confirm": action + "?", "interrupt": "Interrupt flashing?",
+                   "scheduled": action + " requested", "error": "Not confirmed",
+                   "expired": "Confirmation expired", 'appearance_error': 'Theme not confirmed',
+                   'timeout_error': 'Timeout not saved'}.get(stage, "Power")
+        body.draw(img, 2, 23, fonts.fit(body, heading, 124), p["warn"] if stage == "interrupt" else p["fg"])
+        message = {
+            "confirm": "This station will restart." if menu.action == "reboot" else "To start again, cycle PoE or external power.",
+            "interrupt": f"{menu.active_count} active modules. Image/EEPROM writes may fail. Recovery may be needed.",
+            "scheduled": "Waiting for restart. No more confirmation needed." if menu.action == "reboot" else "Allow shutdown to finish. Cycle power to start again.",
+            "error": menu.message,
+            "expired": "Choose the action again.",
+            'appearance_error': 'Reopen Appearance to check the saved mode.',
+            'timeout_error': 'Reopen Screen timeout to check the saved value.',
+        }.get(stage, "")
+        for n, line in enumerate(fonts.wrap(small, message, 124)[:5]):
+            small.draw(img, 2, 42 + 12 * n, line, p["muted"])
+        lines = (["KEY1 Confirm", "KEY2 Cancel"] if stage in ("confirm", "interrupt") else ["KEY2 Back"])
+    draw.line((0, 105, 127, 105), fill=p["line"])
+    for n, line in enumerate(lines):
+        legend.draw(img, 2, 109 + 10 * n, line, p["fg"])
+    return img
diff --git a/fpms/integrations/cmprovision_rescue.py b/fpms/integrations/cmprovision_rescue.py
new file mode 100644
index 0000000..b348bf3
--- /dev/null
+++ b/fpms/integrations/cmprovision_rescue.py
@@ -0,0 +1,215 @@
+"""Public AP summary and an explicitly opened, short-lived local access card."""
+import grp
+import ipaddress
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import tempfile
+import time
+
+STATUS = Path('/run/cmprovision/rescue-wifi.json')
+LEASE = Path('/run/fpms/rescue-wifi-qr.json')
+CLOSED = Path('/run/fpms/rescue-wifi-qr-closed.json')
+SECONDS = 60
+
+
+def wifi_payload(ssid, password):
+    if not isinstance(ssid, str) or not 1 <= len(ssid.encode('utf-8')) <= 32 or any(ord(c) < 32 or ord(c) == 127 for c in ssid):
+        raise ValueError('Invalid SSID')
+    if not isinstance(password, str) or not 12 <= len(password) <= 63 or any(not 32 <= ord(c) <= 126 for c in password):
+        raise ValueError('Invalid password')
+    def escape(value):
+        return ''.join(('\\' if c in '\\;,:"' else '') + c for c in value)
+    return f'WIFI:T:WPA;S:{escape(ssid)};P:{escape(password)};;'
+
+
+def qr_matrix(ssid, password):
+    import qrcode
+    code = qrcode.QRCode(error_correction=qrcode.constants.ERROR_CORRECT_L, box_size=1, border=4)
+    code.add_data(wifi_payload(ssid, password), optimize=0)
+    code.make(fit=True)
+    return code.get_matrix()
+
+
+def request():
+    """Lite is root, inside its unchanged sandbox. Never expose credentials in the public snapshot.
+
+    The only shared secret file is root-owned, readable by the HDMI user, in Lite's
+    own runtime directory. Readers enforce the same monotonic 60-second expiry.
+    """
+    with os.fdopen(os.open(STATUS, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), 'r', encoding='utf-8') as source:
+        st = os.fstat(source.fileno())
+        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022 or st.st_size > 65536:
+            raise ValueError('AP status unavailable')
+        status = json.loads(source.read(65537))
+    if status.get('active') is not True or status.get('state') not in ('active', 'recovery') or \
+            type(status.get('checked_at')) not in (int, float) or not 0 <= time.time() - status['checked_at'] <= 90:
+        raise ValueError('AP is not active')
+    result = subprocess.run(['/usr/lib/cmprovision/rescue-wifi', 'reveal'],
+                            capture_output=True, text=True, timeout=5, check=False)
+    if result.returncode or len(result.stdout) > 8192:
+        raise ValueError('AP credentials unavailable')
+    value = json.loads(result.stdout).get('active')
+    if not isinstance(value, dict) or value.get('ssid') != status.get('ssid'):
+        raise ValueError('AP credentials unavailable')
+    ssid, password = value.get('ssid'), value.get('password')
+    now = time.monotonic()
+    value = dict(version=1, created_at=now, expires_at=now + SECONDS, ssid=ssid,
+                 password=password, matrix=qr_matrix(ssid, password))
+    directory = LEASE.parent.lstat()
+    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or directory.st_mode & 0o022:
+        raise ValueError('Display directory unavailable')
+    fd, name = tempfile.mkstemp(prefix='.rescue-qr-', dir=LEASE.parent)
+    try:
+        with os.fdopen(fd, 'w', encoding='utf-8') as destination:
+            json.dump(value, destination, ensure_ascii=False)
+            os.fchmod(destination.fileno(), 0o640)
+            os.fchown(destination.fileno(), 0, grp.getgrnam('cmprovision-wallboard').gr_gid)
+        os.replace(name, LEASE)
+    finally:
+        if os.path.exists(name): os.unlink(name)
+    return value
+
+
+def clear_lease():
+    try: LEASE.unlink(missing_ok=True)
+    except OSError: pass
+
+
+def close_notice():
+    # Public timestamp only: lets HDMI dismiss its automatic AP-start card too.
+    try:
+        fd, name = tempfile.mkstemp(prefix='.rescue-closed-', dir=CLOSED.parent)
+        try:
+            with os.fdopen(fd, 'w', encoding='utf-8') as destination:
+                json.dump(dict(closed_at=time.monotonic()), destination)
+                os.fchmod(destination.fileno(), 0o644)
+            os.replace(name, CLOSED)
+        finally:
+            if os.path.exists(name): os.unlink(name)
+    except OSError:
+        pass
+
+
+class AccessCard:
+    def __init__(self, client, clock):
+        self.client, self.clock = client, clock
+        self.open, self.credentials, self.deadline = False, None, 0
+        self.stage, self.scroll = 'qr', 0
+
+    def show(self):
+        self.open, self.stage, self.scroll = True, 'qr', 0
+        self.deadline = self.clock() + SECONDS
+        try:
+            value = self.client()
+            wifi_payload(value['ssid'], value['password'])
+            self.credentials = value
+        except Exception:
+            self.credentials, self.stage = None, 'error'
+            clear_lease()
+
+    def close(self):
+        was_open = self.open
+        self.open, self.credentials = False, None
+        clear_lease()
+        if was_open: close_notice()
+
+    def expire(self):
+        if self.open and self.clock() >= self.deadline:
+            self.close()
+
+    def key(self, key):
+        if key in ('KEY1', 'KEY2', 'LEFT', 'KEY3'):
+            self.close()
+        elif key in ('CENTER', 'RIGHT') and self.credentials:
+            self.stage = 'text' if self.stage == 'qr' else 'qr'
+            self.scroll = 0
+        elif key in ('UP', 'DOWN'):
+            self.scroll = max(0, self.scroll + (1 if key == 'DOWN' else -1))
+
+
+def render(card, palette):
+    from PIL import Image, ImageDraw
+    from . import cmprovision_fonts as fonts
+    if card.stage == 'qr' and card.credentials:
+        # Black/white, full quiet zone, integer pixels: independent of the UI theme.
+        matrix = card.credentials['matrix']
+        scale = 128 // len(matrix)
+        image = Image.new('RGB', (128, 128), 'white')
+        draw = ImageDraw.Draw(image)
+        offset = (128 - len(matrix) * scale) // 2
+        for y, row in enumerate(matrix):
+            for x, dark in enumerate(row):
+                if dark:
+                    left, top = offset + x * scale, offset + y * scale
+                    draw.rectangle((left, top, left + scale - 1, top + scale - 1), fill='black')
+        return image
+    image = Image.new('RGB', (128, 128), palette['bg'])
+    fg = palette.get('fg', palette.get('text'))
+    body, code, tiny = fonts.font('body'), fonts.font('code'), fonts.font('tiny')
+    body.draw(image, 2, 2, 'Rescue Wi-Fi', palette['accent'])
+    if card.credentials:
+        ssid = card.credentials['ssid']
+        # These compact bitmap fonts intentionally have limited Unicode coverage.
+        # Do not present substituted '?' glyphs as the network's actual name.
+        ssid = ssid if all(c in code.glyphs for c in ssid) else 'Scan QR for SSID'
+        lines = ['SSID', ssid, 'Password', card.credentials['password']]
+    else:
+        lines = ['QR unavailable', 'Check AP / package']
+    wrapped = []
+    for line in lines:
+        part = ''
+        for char in line:
+            if part and code.width(part + char) > 124:
+                wrapped.append(part); part = ''
+            part += char
+        wrapped.append(part)
+    card.scroll = min(card.scroll, max(0, len(wrapped) - 7))
+    for i, line in enumerate(wrapped[card.scroll:card.scroll + 7]):
+        code.draw(image, 2, 18 + i * (code.h + 1), line, fg)
+    tiny.draw(image, 2, 116, 'OK QR  2 Back  ' + str(max(0, int(card.deadline-card.clock()))) + 's', palette['muted'])
+    return image
+
+
+def info(data):
+    from .cmprovision import text
+    raw = data.get('rescue_wifi')
+    if not isinstance(raw, dict) or not (raw.get('enabled') is True or raw.get('active') is True):
+        return None
+    state = text(raw.get('state'))
+    summary = {'active':'AP active', 'recovery':'AP recovery', 'waiting':'AP waiting', 'paused':'AP paused',
+               'fault':'AP failed', 'unavailable':'AP status stale', 'starting':'AP starting',
+               'stopping':'AP stopping', 'standby':'AP ready', 'off':'AP off'}.get(state, 'AP unavailable')
+    active = raw.get('active') is True
+    remaining = raw.get('remaining')
+    if not active and type(remaining) is int and 0 <= remaining <= 3600:
+        summary += f' {remaining // 60}:{remaining % 60:02}'
+    clients = raw.get('clients')
+    clients = clients if type(clients) is int and 0 <= clients <= 512 else None
+    address = text(raw.get('address'))
+    try:
+        if ipaddress.ip_address(address).version != 4: address = ''
+    except ValueError:
+        address = ''
+    return {'active':active, 'summary':summary, 'ssid':text(raw.get('ssid'))[:32], 'address':address,
+            'clients':f'{clients} client' + ('' if clients == 1 else 's') if clients is not None else '? clients'}
+
+
+def lines(data, measure=None, width=118):
+    value = info(data)
+    if not value: return []
+    result = [value['summary']]
+    if not value['active']: return result
+    measure = measure or (lambda s: len(s) * 6)
+    chunk = ''
+    for char in value['ssid']:
+        if chunk and measure(chunk + char) > width:
+            result.append(chunk)
+            chunk = ''
+        chunk += char
+    if chunk: result.append(chunk)
+    if value['address']: result.append(value['address'])
+    result.append(value['clients'])
+    return result
