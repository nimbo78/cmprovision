+#!/usr/bin/env python3
+"""Render the actual 128px panel with clearly labelled illustrative data."""
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from PIL import Image, ImageDraw, ImageFont
+
+from fpms.integrations.cmprovision import PAGES, Panel
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    config, snapshot = args.output / "config.json", args.output / "snapshot.json"
+    config.write_text(json.dumps({"enabled": True, "open_on_start": True}))
+    snapshot.write_text(
+        json.dumps(
+            {
+                "version": 1,
+                "generated_at": int(time.time()),
+                "host": "demo-station",
+                "app_version": "cmprovision / DEMO",
+                "project": "DEMO - batch 78",
+                "counts": {"running": 2, "done": 4, "failed": 1, "unknown": 0},
+                "station": {
+                    "management": "192.0.2.4",
+                    "provisioning": "eth0.42 up",
+                    "storage": "21 GiB free",
+                },
+                "unknown": [],
+                "modules": [
+                    {
+                        "serial": "demo-1",
+                        "mac": "02:00:00:00:00:01",
+                        "name": "demo-sensor-1",
+                        "port": "sw Gi0/2",
+                        "state": "run",
+                        "phase": "write",
+                        "percent": 42,
+                        "speed": "30 MiB/s",
+                        "eta": "2m remaining",
+                    },
+                    {
+                        "serial": "demo-2",
+                        "mac": "02:00:00:00:00:02",
+                        "name": "demo-sensor-2",
+                        "port": "sw Gi0/3",
+                        "state": "fail",
+                        "phase": "failed",
+                        "detail": "eMMC write timed out",
+                        "advice": "Check power and retry diagnostics",
+                    },
+                ],
+                "switches": [
+                    {
+                        "name": "sw",
+                        "answering": True,
+                        "blocks": [
+                            {
+                                "ports": [
+                                    {"name": "Gi0/1", "state": "server", "serials": []},
+                                    {
+                                        "name": "Gi0/2",
+                                        "state": "write",
+                                        "serials": ["demo-1"],
+                                    },
+                                    {
+                                        "name": "Gi0/3",
+                                        "state": "failed",
+                                        "serials": ["demo-2"],
+                                    },
+                                    {"name": "Gi0/4", "state": "done", "serials": []},
+                                ]
+                            }
+                        ],
+                    }
+                ],
+            }
+        )
+    )
+    panel = Panel(config, snapshot)
+    panel.refresh(force=True)
+    sheet = Image.new("RGB", (6 * 400 + 16, 470), "#202024")
+    draw = ImageDraw.Draw(sheet)
+    font = ImageFont.load_default(size=17)
+    for i, title in enumerate((*PAGES, "Device details")):
+        if i < 5:
+            panel.page = i
+        else:
+            panel.page, panel.index = 2, 1
+            panel.key("CENTER")
+        frame = panel.frame()
+        frame.save(args.output / f"{i + 1}.png")
+        sheet.paste(
+            frame.resize((384, 384), Image.Resampling.NEAREST), (16 + i * 400, 40)
+        )
+        draw.text((16 + i * 400, 10), title, font=font, fill="white")
+    draw.text(
+        (16, 441),
+        "FPMS 128 x 128 - actual renderer, illustrative DEMO data; Warm / Dark web palette",
+        font=font,
+        fill="#ff8a3d",
+    )
+    sheet.save(args.output / "preview.png")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/run-portable-rootfs.sh b/tools/run-portable-rootfs.sh
new file mode 100644
index 0000000..922834a
--- /dev/null
+++ b/tools/run-portable-rootfs.sh
@@ -0,0 +1,76 @@
+#!/bin/sh
+# Lab runner only. ROOT is an existing disposable Debian Trixie rootfs.
+# SOURCE is this checkout. No disks are mounted or written by this runner.
+set -eu
+
+if [ "${1:-}" = --inside ]; then
+    mode=$2
+    root=$3
+    source=$4
+    mkdir -p "$root/opt/fpms" "$root/proc" "$root/sys"
+    mount --bind "$source" "$root/opt/fpms"
+    mount -o remount,bind,ro "$root/opt/fpms"
+    mount -t proc proc "$root/proc"
+    # libgpiod validates character devices through sysfs as well as /dev.
+    mount --bind /sys "$root/sys"
+    mount -o remount,bind,ro "$root/sys"
+    # Only selected character devices, never the host disk or host /run.
+    for device in /dev/null /dev/zero /dev/random /dev/urandom; do
+        touch "$root$device"
+        mount --bind "$device" "$root$device"
+    done
+    if [ "$mode" = probe ] || [ "$mode" = menu ]; then
+        for device in /dev/gpiochip* /dev/spidev*; do
+            [ -c "$device" ] || continue
+            touch "$root$device"
+            mount --bind "$device" "$root$device"
+        done
+        if [ "$mode" = menu ]; then
+            chroot "$root" /usr/bin/python3 /opt/fpms/tools/preview-cmprovision.py /tmp/cmprovision-menu-demo
+            exec chroot "$root" /bin/sh -ec 'cd /; PYTHONPATH=/usr/lib/fpms-lite python3 -m fpms.lite --seconds 180 --sleep 0 --config /tmp/cmprovision-menu-demo/config.json --snapshot /tmp/cmprovision-menu-demo/snapshot.json'
+        fi
+        exec chroot "$root" /usr/bin/python3 /opt/fpms/tools/portable-display-probe.py --seconds 180
+    fi
+    exec chroot "$root" /bin/sh -ec '
+        cd /opt/fpms
+        cat /etc/os-release
+        if dpkg-query -W | grep -q "^wlanpi"; then
+            echo "Unexpected WLAN Pi package in clean test root" >&2
+            exit 1
+        fi
+        test ! -e /etc/wlanpi-model
+        test ! -e /etc/wlanpi-state
+        test ! -e /etc/wlanpi-release
+        PYTHONDONTWRITEBYTECODE=1 python3 -m pytest -p no:cacheprovider tests/test_portable_display.py tests/modules/test_env_utils_gpiochip.py tests/test_cmprovision.py -q
+        python3 tools/portable-display-probe.py --preview /tmp/portable-preview.png
+    '
+fi
+
+mode=${1:-}
+case "$mode" in test|probe|menu) ;; *) echo "Usage: $0 test|probe|menu ROOT SOURCE" >&2; exit 2;; esac
+[ "$#" -eq 3 ] || exit 2
+[ "$(id -u)" -eq 0 ] || { echo "Run as root for private mounts/chroot." >&2; exit 2; }
+root=$(realpath -e "$2")
+source=$(realpath -e "$3")
+[ "$root" != / ] && [ -f "$root/etc/debian_version" ] || exit 2
+grep -q '^VERSION_CODENAME=trixie$' "$root/etc/os-release" || exit 2
+[ -f "$source/tools/portable-display-probe.py" ] || exit 2
+
+restore=no
+watchdog="cmprovision-fpms-probe-restore-$$"
+cleanup() {
+    if [ "$restore" = yes ]; then
+        systemctl start wlanpi-fpms.service
+        systemctl stop "$watchdog.timer" || true
+    fi
+}
+trap cleanup EXIT
+trap 'exit 130' INT TERM HUP
+if [ "$mode" != test ] && systemctl is-active --quiet wlanpi-fpms.service; then
+    # A timer also restores the menu if SSH or this runner is killed outright.
+    systemd-run --quiet --unit="$watchdog" --on-active=220s /usr/bin/systemctl start wlanpi-fpms.service
+    restore=yes
+    systemctl stop wlanpi-fpms.service
+fi
+timeout --kill-after=5s 200s unshare --mount --pid --fork --kill-child --propagation private \
+    /bin/sh "$0" --inside "$mode" "$root" "$source"
