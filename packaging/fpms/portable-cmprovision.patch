@@ -0,0 +1,333 @@
+import json
+import os
+import signal
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from fpms.integrations import cmprovision
+from fpms.integrations.cmprovision import Panel, rate, read_json, remaining, settings, slow
+from fpms.integrations.cmprovision_menu import CmprovisionMenu
+
+
+@pytest.fixture
+def panel(tmp_path):
+    config, snapshot = tmp_path / "config.json", tmp_path / "snapshot.json"
+    config.write_text(json.dumps({"enabled": True, "open_on_start": False}))
+    snapshot.write_text(
+        json.dumps(
+            {
+                "version": 1,
+                "generated_at": 100,
+                "project": "Project 78",
+                "host": "station",
+                "counts": {"done": 4, "running": 2, "failed": 1, "unknown": 0},
+                "modules": [
+                    {
+                        "serial": "first",
+                        "name": "wlanpi-one",
+                        "state": "fail",
+                        "phase": "write",
+                        "detail": "Storage timeout",
+                        "percent": 42,
+                    },
+                    {
+                        "serial": "second",
+                        "name": "wlanpi-two",
+                        "state": "run",
+                        "phase": "verify",
+                        "percent": 80,
+                    },
+                ],
+                "switches": [
+                    {
+                        "name": "sw",
+                        "answering": True,
+                        "blocks": [
+                            {
+                                "ports": [
+                                    {
+                                        "name": "Gi0/2",
+                                        "state": "fail",
+                                        "serials": ["first"],
+                                    }
+                                ]
+                            }
+                        ],
+                    }
+                ],
+                "unknown": [
+                    {
+                        "name": "Unknown device",
+                        "mac": "00:00:00:00:00:01",
+                        "detail": "No registration",
+                    }
+                ],
+                "station": {
+                    "management": "192.0.2.4",
+                    "provisioning": "eth0.42 up",
+                    "storage": "21 GiB free",
+                },
+            }
+        )
+    )
+    p = Panel(config, snapshot)
+    p.refresh(now=101, force=True)
+    return p
+
+
+def test_pure_import_does_not_pull_in_wlanpi_or_hardware():
+    code = """
+import importlib.abc, sys
+class Block(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, *args):
+        if fullname in ('fpms.modules.constants', 'fpms.modules.env_utils', 'gpiod', 'spidev', 'dbus'):
+            raise AssertionError(fullname)
+sys.meta_path.insert(0, Block())
+import fpms.lite
+import fpms.integrations.cmprovision_menu
+"""
+    subprocess.run(
+        [sys.executable, "-c", code], check=True, cwd=Path(__file__).parents[1]
+    )
+
+
+def test_numeric_snapshot_uses_readable_rate_and_eta():
+    assert rate(30 * 1048576) == "30.0 MiB/s"
+    assert remaining(125) == "ETA 2:05"
+    assert rate(None) == remaining(None) == ""
+
+
+def test_port_opens_correct_module_and_never_switches_identity_when_it_leaves(panel):
+    panel.key("KEY2")
+    panel.key("CENTER")
+    assert panel.detail_row()["serial"] == "first"
+    panel.data["modules"] = panel.data["modules"][1:]
+    assert panel.detail_row() is None
+    assert panel.frame().size == (128, 128)
+    panel.key("KEY3")
+    assert panel.detail is None
+    assert panel.key("KEY3") is False
+
+
+def test_all_pages_render_and_errors_include_unregistered_devices(panel):
+    for page in range(5):
+        panel.page = page
+        assert panel.frame().size == (128, 128)
+    panel.page = 3
+    assert len(panel.rows()) == 2
+    panel.key("DOWN")
+    panel.key("CENTER")
+    assert panel.detail_row()["name"] == "Unknown device"
+    panel.key("DOWN")
+    panel.frame()
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        [],
+        None,
+        {},
+        {"version": 2},
+        {"version": 1, "generated_at": "bad"},
+        {"version": 1, "generated_at": 500},
+    ],
+)
+def test_invalid_or_future_data_has_no_live_counts(panel, value):
+    panel.snapshot.write_text(json.dumps(value))
+    panel.refresh(now=101, force=True)
+    assert panel.problem and not panel.data
+    panel.frame()
+
+
+def test_stale_snapshot_is_explicit_and_disable_clears_device_data(panel):
+    panel.refresh(now=150, force=True)
+    assert panel.problem == "Stale data" and panel.age == 50
+    assert panel.data["modules"]
+    panel.config.write_text(json.dumps({"enabled": False, "open_on_start": False}))
+    panel.refresh(force=True)
+    assert not panel.enabled and not panel.data and panel.problem == "Integration off"
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        None,
+        {},
+        {"enabled": "false", "open_on_start": False},
+        {"enabled": True, "open_on_start": 1},
+    ],
+)
+def test_invalid_configuration_is_off(tmp_path, value):
+    path = tmp_path / "settings"
+    path.write_text(json.dumps(value))
+    assert settings(path) == {"enabled": False, "open_on_start": False}
+
+
+def test_partial_and_wrongly_typed_nested_data_cannot_crash_panel(panel):
+    panel.data = {
+        "version": 1,
+        "generated_at": 100,
+        "counts": [],
+        "modules": [None, {"name": {}, "percent": float("nan")}],
+        "switches": [{"blocks": [{"ports": [None, {"name": [], "serials": "bad"}]}]}],
+        "station": [],
+        "unknown": {},
+    }
+    for page in range(5):
+        panel.page = page
+        panel.frame()
+        panel.key("CENTER")
+        panel.frame()
+        panel.key("KEY3")
+
+
+def test_full_menu_is_preserved_and_hot_disable_returns_to_stock_menu(panel):
+    state = {
+        "display_state": "menu",
+        "current_menu_location": [0],
+        "button_press_count": 0,
+        "option_selected": None,
+        "start_up": False,
+    }
+    menu = [{"name": "Network", "action": []}, {"name": "System", "action": []}]
+    bridge = CmprovisionMenu(state, menu, lambda image: None, True, panel)
+    bridge.tick(publish=False)
+    assert [m["name"] for m in menu] == ["Network", "System", "cmprovision"]
+    assert state["display_state"] == "menu"  # Enabling does not steal the current page.
+    bridge.action()
+    assert bridge.selected()
+    assert bridge.key("KEY2")
+    assert bridge.key("KEY3")
+    assert not bridge.selected()
+    bridge.action()
+    panel.config.write_text(json.dumps({"enabled": False, "open_on_start": False}))
+    panel.refresh(force=True)
+    bridge.tick(publish=False)
+    assert [m["name"] for m in menu] == ["Network", "System"]
+    assert state["display_state"] == "menu"
+    assert not bridge.key("KEY3")  # normal FPMS shortcuts work outside the integration
+
+
+def test_startup_preference_is_used_once_only(panel):
+    panel.config.write_text(json.dumps({"enabled": True, "open_on_start": True}))
+    state = {
+        "display_state": "page",
+        "option_selected": None,
+        "start_up": True,
+        "button_press_count": 0,
+    }
+    bridge = CmprovisionMenu(state, [], lambda image: None, True, panel)
+    bridge.tick(publish=False)
+    assert bridge.selected() and not state["start_up"]
+    bridge.leave()
+    bridge.tick(publish=False)
+    assert not bridge.selected()
+
+
+def within(seconds, function, *args):
+    """A call that would hang on a pipe fails the test instead of the whole run."""
+    signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError("blocked")))
+    signal.alarm(seconds)
+    try:
+        return function(*args)
+    finally:
+        signal.alarm(0)
+
+
+def test_a_pipe_in_place_of_the_snapshot_does_not_hang_the_menu(panel, tmp_path):
+    # the web user owns the directory of the snapshot: it can put anything under that name
+    fifo = tmp_path / "fifo.json"
+    os.mkfifo(fifo)
+    assert within(5, read_json, fifo) == {}
+    panel.snapshot = fifo
+    within(5, panel.refresh, 102, True)
+    assert panel.data == {} and panel.problem in ("Waiting for data", "Unsupported data")
+
+
+def test_a_link_in_place_of_the_snapshot_is_not_followed(panel, tmp_path):
+    target = tmp_path / "elsewhere.json"
+    target.write_text(json.dumps({"version": 1, "generated_at": 100}))
+    link = tmp_path / "link.json"
+    link.symlink_to(target)
+    assert read_json(target) != {}
+    assert read_json(link) == {}
+    assert read_json(tmp_path) == {}  # a directory is not a snapshot
+
+
+def test_a_file_of_a_stranger_is_not_read(tmp_path, monkeypatch):
+    path = tmp_path / "a.json"
+    path.write_text("{}")
+    path.write_text(json.dumps({"a": 1}))
+    assert read_json(path) == {"a": 1}
+    monkeypatch.setattr(cmprovision, "trusted_owners", lambda: frozenset({os.geteuid() + 1}))
+    assert read_json(path) == {}
+
+
+@pytest.mark.parametrize("value", [10**400, -(10**400), 1e999, True, "100"])
+def test_an_absurd_timestamp_is_invalid_not_a_crash(panel, value):
+    data = json.loads(panel.snapshot.read_text())
+    data["generated_at"] = value
+    text = json.dumps(data).replace("Infinity", "1e999")
+    panel.snapshot.write_text(text)
+    panel.refresh(now=101, force=True)
+    assert panel.problem in ("Invalid timestamp", "Waiting for data", "Unsupported data")
+    assert panel.data == {}
+    assert panel.frame().size == (128, 128)
+
+
+def test_silent_devices_with_the_same_name_keep_their_own_cards(panel):
+    panel.data["unknown"] = [
+        {"port": "sw Gi0/3", "state": "quiet", "name": "unknown device", "mac": None, "detail": "first"},
+        {"port": "sw Gi0/4", "state": "quiet", "name": "unknown device", "mac": None, "detail": "second"},
+    ]
+    panel.page = 3
+    rows = panel.rows()
+    second = next(i for i, row in enumerate(rows) if row.get("detail") == "second")
+    panel.index = second
+    panel.key("CENTER")
+    assert panel.detail_row()["detail"] == "second"
+    panel.data["unknown"] = panel.data["unknown"][1:]
+    assert panel.detail_row()["detail"] == "second"
+    panel.data["unknown"] = []
+    assert panel.detail_row() is None
+
+
+def test_two_switches_with_the_same_name_do_not_share_a_port_card(panel):
+    one = {"name": "sw", "answering": True, "blocks": [{"ports": [{"name": "Gi0/1", "serials": [], "state": "free", "note": "one"}]}]}
+    two = {"name": "sw", "answering": True, "blocks": [{"ports": [{"name": "Gi0/1", "serials": [], "state": "free", "note": "two"}]}]}
+    panel.data["switches"] = [one, two]
+    panel.page = 1
+    panel.index = 1
+    panel.key("CENTER")
+    assert panel.detail_row()["note"] == "two"
+    panel.data["switches"] = [one]
+    assert panel.detail_row() is None  # the second switch left: not the first one's port
+
+
+def test_a_run_past_its_batch_is_told_on_the_card():
+    assert slow(200) == "SLOW +3:20"
+    assert slow(None) == slow(0) == slow(10**400) == slow("5") == ""
+
+
+def test_the_menu_survives_a_snapshot_that_breaks_the_panel(panel, monkeypatch):
+    state = {"display_state": "menu", "button_press_count": 0}
+    menu = []
+    shown = []
+    adapter = CmprovisionMenu(state, menu, shown.append, hardware=False, panel=panel)
+    monkeypatch.setattr(cmprovision.Panel, "refresh", lambda *a, **k: (_ for _ in ()).throw(OverflowError("boom")))
+    adapter.tick(publish=False)  # the main loop of the stock menu calls this
+    adapter.show()
+    assert shown == []
+
+
+def test_the_slow_flag_of_a_module_reaches_its_card(panel):
+    panel.data["modules"][1]["slow"] = 215
+    panel.page = 2
+    panel.index = 1
+    panel.key("CENTER")
+    row = panel.detail_row()
+    assert row["slow"] == 215 and slow(row["slow"]) == "SLOW +3:35"
