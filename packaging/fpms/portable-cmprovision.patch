+        line((3, 3), (3, 9), (9, 9))
+    elif name == "power":
+        d.arc((3 * scale, 4 * scale, 21 * scale, 22 * scale), -52, 232, fill=255, width=2 * scale)
+        line((12, 2), (12, 12))
+    elif name == "shield":
+        line((12, 2), (20, 6), (19, 13), (16, 18), (12, 21), (8, 18), (5, 13), (4, 6), (12, 2))
+    elif name == "list":
+        for y in (6, 12, 18):
+            line((3, y), (5, y))
+            line((9, y), (21, y))
+    elif name == "wifi":
