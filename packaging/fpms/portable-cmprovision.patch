@@ -0,0 +1,712 @@
+from types import SimpleNamespace
+import pytest
+from PIL import Image, ImageDraw
+
+from fpms.integrations.cmprovision import Panel, heartbeat
+from fpms.integrations.cmprovision_touch import TouchMenu, centered, font
+from fpms.modules.screen.hyperpixel import DISPLAY, DpiScreen, Touches, find_touch, point, to_scanout
+
+
+def test_physical_targets_and_rotation():
+    for raw, target in [((105, 111), (62, 179)), ((676, 109), (412, 170)), ((146, 409), (76, 683))]:
+        x, y = point(*raw, (0, 799), (0, 479), 0)
+        assert abs(x - target[1]) < 15 and abs(y - (479 - target[0])) < 15
+        assert point(*raw, (0, 799), (0, 479), 180) == (799 - x, 479 - y)
+    assert point(150, 400, (100, 200), (200, 600), 0) == (400, 239)
+
+
+def test_all_four_display_corners_match_touch_in_both_landscape_mountings():
+    for rotate in (0, 180):
+        frame = Image.new("RGB", (800, 480))
+        for n, (raw, native) in enumerate(
+            [((0, 0), (0, 0)), ((799, 0), (479, 0)), ((0, 479), (0, 799)), ((799, 479), (479, 799))],
+            start=1,
+        ):
+            frame.putpixel(point(*raw, (0, 799), (0, 479), rotate), (n, 50, 80))
+            scan = to_scanout(frame, rotate)
+            assert scan.size == (480, 800)
+            assert scan.getpixel(native) == (n, 50, 80)
+
+
+def test_touch_commits_once_on_release_and_discards_drag_multitouch_or_lost_sync():
+    def gesture(extra=()):
+        touch = Touches((0, 799), (0, 479), 0)
+        events = [
+            (3, 0, 100),
+            (3, 1, 100),
+            (1, 330, 1),
+            (0, 0, 0),
+            *extra,
+            (1, 330, 0),
+            (0, 0, 0),
+            (0, 0, 0),
+        ]
+        return [p for k, c, v in events if (p := touch.feed(k, c, v)) is not None]
+
+    assert gesture() == [point(100, 100, (0, 799), (0, 479), 0)]
+    assert gesture([(3, 0, 500), (0, 0, 0), (3, 0, 100), (0, 0, 0)]) == []
+    assert gesture([(3, 47, 1), (3, 57, 88), (0, 0, 0)]) == []
+    assert gesture([(0, 3, 0), (0, 0, 0)]) == []
+
+
+def test_identity_requires_rectangular_panel_and_its_device_tree_touchscreen(tmp_path):
+    node = tmp_path / "tree/spi/display@0"
+    node.mkdir(parents=True)
+    (node / "compatible").write_bytes(b"pimoroni,hyperpixel4\0")
+    device = tmp_path / "sys/bus/i2c/devices/22-0014/input/input5"
+    device.mkdir(parents=True)
+    controller = tmp_path / "tree/i2c@0/ft6236@14"
+    controller.mkdir(parents=True)
+    (device.parents[1] / "of_node").symlink_to(controller)
+    (controller / "compatible").write_bytes(b"goodix,gt911\0")
+    (device / "name").write_text("22-0014 Goodix Capacitive TouchScreen")
+    (device / "id").mkdir()
+    (device / "id/product").write_text("038f")
+    event = tmp_path / "inputs/event7"
+    event.mkdir(parents=True)
+    (event / "device").symlink_to(device)
+    assert find_touch(tmp_path / "tree", event.parent) == "event7"
+    (controller / "compatible").write_bytes(b"another,touch\0")
+    assert find_touch(tmp_path / "tree", event.parent) is None
+    (controller / "compatible").write_bytes(b"goodix,gt911\0")
+    (node / "compatible").write_bytes(b"pimoroni,hyperpixel4sq\0")
+    assert find_touch(tmp_path / "tree", event.parent) is None
+
+
+def test_live_device_and_stable_touch_row(tmp_path):
+    panel = Panel(tmp_path / "config", tmp_path / "snapshot", can_leave=False)
+    panel.enabled, panel.problem, panel.age = True, "", 1
+    panel.data = {
+        "station": {"hostname": "test-station"},
+        "project": "stage1",
+        "counts": {"done": 1},
+        "modules": [{"serial": "aaa", "name": "sensor-a", "state": "ok"}],
+    }
+    menu = TouchMenu(panel)
+
+    def select(action):
+        for (x0, y0, x1, y1), candidate in menu.targets:
+            if candidate == action:
+                menu.tap((x0 + x1) // 2, (y0 + y1) // 2)
+                return
+        raise AssertionError((action, menu.targets))
+
+    assert menu.frame().size == (800, 480)
+    select(("page", 2))
+    menu.frame()
+    panel.data["modules"].insert(0, {"serial": "bbb", "name": "sensor-b", "state": "run"})
+    select(("row", "aaa"))
+    assert panel.detail == ("module", "aaa")
+    menu.frame()
+    select(("key", "KEY2"))
+    assert panel.detail is None and panel.page == 2
+    menu.frame()
+    panel.data["modules"] = []
+    select(("row", "bbb"))
+    assert panel.detail is None
+
+
+@pytest.mark.parametrize("view", ["map", "list", "card"])
+def test_long_hostname_moves_but_port_power_and_link_stay_fixed(tmp_path, monkeypatch, view):
+    import time
