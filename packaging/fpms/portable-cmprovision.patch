+def fixture(name):
+    if name == "empty":
+        snap = demo_snapshot()
+        snap.update(modules=[], unknown=[], switches=[], counts={"done": 0, "running": 0, "failed": 0, "stale": 0})
+        return snap
+    if name == "demo":
+        return demo_snapshot()
+    if name == "stand48":
+        snap = demo_snapshot()
+        big = stand48_snapshot()
+        snap["switches"] += big["switches"]
+        snap["modules"] += big["modules"]
+        return snap
+    if name == "long_texts":
+        snap = demo_snapshot()
+        snap["project"] = "a-project-name-of-forty-characters-long-x"
+        snap["host"] = "provisioner-with-a-very-long-host-name-of-sixty-four-chars-xxxx"
+        for m in snap["modules"]:
+            if m["hostname"]:
+                m["name"] = m["hostname"] = "h" * 63
+        snap["unknown"][0].update(name="LLDP " + "x" * 60, detail="a description " * 15)
+        snap["station"]["uplink"]["ssid"] = "Office \U0001F600 network with a long name"
+        snap["switches"][0]["name"] = "switch-with-a-long-name-" + "y" * 40
+        return snap
+    if name == "all_failures":
+        snap = demo_snapshot()
+        snap["modules"] = [module(n + 1, f"wlanpi-f{n:02d}", "fail", "failed", "Writing image", 50, cause=cause,
+                                  reason="A reason. " * 6, advice="What to do. " * 6, code="curl 56, exit 1")
+                           for n, cause in enumerate(CAUSES)]
+        return snap
+    raise KeyError(name)
+
+
+SCREENS = ["page0", "page1", "page2", "page3", "page4", "card1", "card2", "card3", "card3-scrolled", "prompt", "old"]
+
+
+def screen(p, name):
+    if name.startswith("page"):
+        p.page = int(name[4])
+    elif name.startswith("card"):
+        p.page = int(name[4])
+        p.key("CENTER")
+        if name.endswith("scrolled"):
+            for _ in range(40):
+                p.key("DOWN")
+    elif name == "prompt":
+        p.key("KEY2")
+    elif name == "old":
+        p.page = 3
+        p.key("CENTER")
+    return p
+
