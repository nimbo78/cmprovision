index 0000000..bc4ae2b
--- /dev/null
+++ b/tools/portable-display-probe.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Bounded hardware probe; not a replacement for FPMS or a production UI.
+
+Run from the source tree, in a clean Trixie rootfs with python3-pil,
+python3-libgpiod and python3-spidev. Stop the existing display owner first.
+The caller must restore that service when this command exits.
+"""
+
+import argparse
+from datetime import timedelta
+import json
+from pathlib import Path
+import sys
+import time
+
+from PIL import Image, ImageDraw, ImageFont
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+BUTTONS = {6: "UP", 19: "DOWN", 5: "LEFT", 26: "RIGHT", 13: "CENTER",
+           21: "KEY1", 20: "KEY2", 16: "KEY3"}
+
+
+def frame(events, elapsed):
+    image = Image.new("RGB", (128, 128), "#211b17")
+    draw = ImageDraw.Draw(image)
+    font = ImageFont.load_default()
+    draw.rounded_rectangle((5, 5, 29, 29), radius=4, fill="#e98946")
+    draw.text((9, 10), "cm", font=font, fill="#211b17")
+    draw.text((36, 7), "FPMS", font=font, fill="#f5e8dc")
+    draw.text((36, 20), "TRIXIE TEST", font=font, fill="#e98946")
+    draw.line((6, 36, 122, 36), fill="#6b4b37")
+    draw.text((7, 43), "Clean userspace", font=font, fill="#f5e8dc")
+    draw.text((7, 57), "WLAN Pi kernel", font=font, fill="#bba695")
+    draw.text((7, 77), events[-1]["button"] if events else "Press a button", font=font, fill="#8fc695")
+    draw.text((7, 94), f"{len(events)} events / {int(elapsed)}s", font=font, fill="#f5e8dc")
+    draw.text((7, 112), "Auto restore FPMS", font=font, fill="#bba695")
+    return image
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seconds", type=int, default=60, choices=range(1, 301))
+    parser.add_argument("--preview")
+    parser.add_argument("--report", default="/tmp/portable-display-report.json")
+    args = parser.parse_args()
+    if args.preview:
+        frame([], 0).save(args.preview)
+        return
+
+    import gpiod
+    from gpiod.line import Bias, Edge
+    from fpms.modules.gpiochip import get_gpiochip
+    from fpms.modules.screen.st7735 import ST7735
+
+    started = time.monotonic()
+    events = []
+    display = ST7735()
+    # Acquiring buttons first prevents a second FPMS instance from starting
+    # the probe while the existing menu still owns its button lines.
+    with gpiod.request_lines(get_gpiochip(), consumer="fpms-portability-probe",
+                             config={tuple(BUTTONS): gpiod.LineSettings(
+                                 bias=Bias.PULL_UP, edge_detection=Edge.FALLING,
+                                 debounce_period=timedelta(milliseconds=20))}) as buttons:
+        try:
+            display.init()
+            print("DISPLAY_READY", flush=True)
+            while time.monotonic() - started < args.seconds:
+                display.drawImage(frame(events, time.monotonic() - started))
+                if buttons.wait_edge_events(timedelta(seconds=0.5)):
+                    for event in buttons.read_edge_events():
+                        item = {"button": BUTTONS[event.line_offset],
+                                "elapsed": round(time.monotonic() - started, 3)}
+                        events.append(item)
+                        print(json.dumps(item), flush=True)
+        finally:
+            if hasattr(display, "device"):
+                display.device.module_exit()
+            Path(args.report).write_text(json.dumps({
+                "scope": "clean Trixie userspace; host WLAN Pi kernel",
+                "events": events, "elapsed": round(time.monotonic() - started, 3),
+            }, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
