+    else:
+        key, word = port_state(row, None)
+        port = text(row.get("portname")) or text(row.get("name"))
+    d.rectangle((0, 0, 127, 15), fill=P[key])
+    ink = on_color(key)
+    age = panel.age_label()
+    right = 125
+    if age:
+        right -= chip(img, d, 126, 7.5, age, "warn") + 2
+    else:
+        body.draw(img, 125 - body.width(word), mid_y(body, 0, 16, word), word, ink)
+        right -= body.width(word) + 4
+    title.draw(img, 3, mid_y(title, 0, 16), fonts.fit(title, port, right - 3), ink)
+    y = 18
+    lines = []
+    if module is not None:
+        name = text(row.get("name")) or text(row.get("mac")) or "Unknown"
+        f = title if title.width(name) <= 124 and ":" not in name else code
+        shown = fonts.fit(f, name, 124)
+        f.draw(img, 2, y, shown, P["fg"])
+        y += f.h + 1
+        percent = row.get("percent")
+        step = step_of(row)
+        if type(percent) in (int, float) and 0 <= percent < 100:
+            step = f"{step}  {int(percent)}%".strip()
+        if step:
+            body.draw(img, 2, y, fonts.fit(body, step, LINE_W), P["muted"])
+            y += body.h + 1
+        if slow(row.get("slow")):
+            body.draw(img, 2, y, slow(row.get("slow")), P["warn"])
+            y += body.h + 1
+        if type(percent) in (int, float) and 0 <= percent <= 100:
+            bar(d, 2, y, 125, percent / 100, key)
+            y += 4
+        lines = module_lines(row, body, code, error)
+        speed = "  ".join(t for t in (rate(row.get("speed")), remaining(row.get("eta"))) if t)
+        if speed and text(row.get("state")) == "run":
+            lines.insert(0, ("muted", body, speed))
+        if shown != name:                                   # the card wraps what the line above had to cut
+            lines[0:0] = [("fg", body, line) for line in fonts.wrap(body, name, 120)]
+    else:
+        lines = port_lines(panel, row, body, error)
+    y += 1
+    d.line((0, y, 127, y), fill=P["line"])
+    scroll_lines(img, d, panel, lines, y + 2)
+
+
+def module_lines(row, body, code, error):
+    """The scrolling part of a module card: (colour, font, text) per line."""
+    from .cmprovision import hardware_lines, objects, text
+
+    lines = []
+
+    def para(colour, f, value, width=120):
+        if value:
+            lines.extend((colour, f, line) for line in fonts.wrap(f, value, width))
+
+    if text(row.get("state")) == "recognized":
+        para("muted", body, text(row.get("detail")))
+    elif device_kind(row):                                  # a device on a port: what it says of itself, its MAC
+        para("muted", body, text(row.get("detail")))
+    elif row.get("registered") is False:
+        para("fg", error, "USB, no provisioning run")
+    else:
+        # the reason in full; an older server has only its failure text (detail)
+        failed = text(row.get("state")) in ("fail", "stale")
+        para("fg", error, text(row.get("reason")) or (text(row.get("cause")) if failed else "")
+             or (text(row.get("detail")) if failed else ""))
+    para("muted", error, text(row.get("advice")))
+    if row.get("code"):
+        para("warn", error, "Code " + text(row.get("code")))
+    diag = row.get("diagnostics") if isinstance(row.get("diagnostics"), dict) else {}
+    issues = objects(diag.get("issues"), 4)
+    if issues:                                              # a healthy report has no title worth a line
+        para("fg", error, text(diag.get("title")))
+        for issue in issues:
+            if text(issue.get("title")) != text(diag.get("title")):
+                para("fg", error, text(issue.get("title")))
+            para("muted", error, text(issue.get("advice")))
+    for line in hardware_lines(row):
+        para("muted", error, line)
+    para("muted", error, text(row.get("mac")))              # the details of the card in Silkscreen, as the spec has them
+    para("muted", error, "S/N " + text(row.get("serial")) if row.get("serial") else "")
+    para("muted", error, text(row.get("port")))
+    return lines
+
+
+def port_lines(panel, row, body, error):
+    """The scrolling part of a port card: what is on it, its link and PoE."""
+    from .cmprovision import objects, text
+
+    lines = []
+    label = text(row.get("name"))
+    device = next((u for u in (objects(panel.data.get("recognized")) + objects(panel.data.get("unknown"))) if text(u.get("port")) == label), None)
+    if row.get("server"):
+        lines += [("muted", body, line) for line in fonts.wrap(body, "This server (the provisioner)", 120)]
+    elif isinstance(row.get("station"), dict):
+        lines += station_lines(row["station"], body, fonts.font("code"), 120)
+    elif text(row.get("state")) == "No response":
+        lines += [("muted", body, line) for line in fonts.wrap(body, "The switch does not answer", 120)]
+    elif device is not None:
+        lines.append(("fg", body, fonts.fit(body, text(device.get("name")) or "Unknown device", 120)))
+        for value in (text(device.get("detail")), text(device.get("mac"))):
+            lines += [("muted", body, line) for line in fonts.wrap(body, value, 120)] if value else []
+    elif text(row.get("state")) == "free":
+        lines.append(("muted", body, "Nothing connected"))
+    facts = "  ".join(t for t in (link_speed(row.get("speed")), _watts(row.get("watts"))) if t)
+    if facts:
+        lines.append(("muted", body, facts))
+    return lines
+
+
+def scroll_lines(img, d, panel, lines, top, right=120):
+    """Lines from top to the bottom of the screen, scrolled by the panel (up and down), with a bar on the right when
+    there are more than fit; the panel's scroll is held at the last screen."""
+    avail = 128 - top
+    fits, used = 0, 0
+    for _, f, _ in lines:
+        if used + f.h > avail:
+            break
+        used += f.h
+        fits += 1
+    # how far can it go: the last start that still fills the screen
+    last, used = len(lines), 0
+    while last > 0 and used + lines[last - 1][1].h <= avail:
+        used += lines[last - 1][1].h
+        last -= 1
+    panel.scroll = max(0, min(panel.scroll, last))
+    y, shown = top, 0
+    for colour, f, line in lines[panel.scroll:]:
+        if y + f.h > 128:
+            break
+        f.draw(img, 2, y, line, P[colour])
+        y += f.h
+        shown += 1
+    if len(lines) > fits:
+        d.rectangle((125, top, 126, 127), fill=P["panel"])
+        t = top + int((127 - top) * panel.scroll / len(lines))
+        b = top + int((127 - top) * (panel.scroll + shown) / len(lines))
+        d.rectangle((125, t, 126, max(t + 2, b)), fill=P["fg"])
+
+
+# ---- Station ----
+
+QUALITY = {"Excellent": "good", "Good": "good", "Fair": "warn", "Weak": "bad"}
+
+
+def signal_bars(d, x, bottom, bars, key):
+    """Four bars of 2 px, 3/5/7/9 px high; the lit ones in the colour of the quality."""
+    for i in range(4):
+        h = 3 + 2 * i
+        d.rectangle((x + i * 3, bottom - h + 1, x + i * 3 + 1, bottom), fill=P[key] if i < bars else P["line"])
+
+
+def station(img, d, panel):
+    """The provisioner itself: who and where it is, how it reaches the management network and how well, and its health,
+    problems first."""
+    from .cmprovision import number, objects, text
+
+    body, title, code = header(img, d, panel, "Station"), fonts.font("title"), fonts.font("code")
+    y = 18
+    # the name of the station comes first: a development build's commit ("2.22.2+26 · c617038") goes, then the version
+    version = text(panel.data.get("app_version")).split(" · ")[0].strip()
+    host = text(panel.data.get("host")) or "cmprovision"
+    vw = body.width(version) + 6 if version else 0
+    if body.width(host) > 124 - vw:
+        version, vw = "", 0
+    f = title if title.width(host) <= 124 - vw else body     # a smaller name rather than a cut one
+    f.draw(img, 2, y + title.asc - f.asc, fonts.fit(f, host, 124 - vw), P["fg"])
+    if version:
+        body.draw(img, 126 - body.width(version), y + title.asc - body.asc, version, P["muted"])
+    y += title.h + 1
+    d.line((0, y, 127, y), fill=P["line"])
+    y += 3
+    st = panel.data.get("station") if isinstance(panel.data.get("station"), dict) else None
+    from .cmprovision_rescue import info as rescue_info, lines as rescue_lines
+    rescue = rescue_info(panel.data)
+    if rescue and rescue['active']:
+        clients = rescue['clients']
+        body.draw(img, 2, y, fonts.fit(body, rescue['summary'], LINE_W - body.width(clients) - 6), P['accent'])
+        body.draw(img, 126 - body.width(clients), y, clients, P['muted'])
+        y += body.h + 1
+        for value in rescue_lines(panel.data, body.width, LINE_W)[1:-1]:
+            f = code if value == rescue['address'] else body
+            f.draw(img, 2, y, fonts.fit(f, value, LINE_W), P['fg'])
+            y += f.h + 1
+        d.line((0, y, 127, y), fill=P['line'])
+        health_rows(img, d, panel, st or {}, y + 3)
+        return
+    if st is None:
+        body.draw(img, 2, y, "--", P["muted"])
+        return
+    if not isinstance(st.get("uplink"), dict):
+        # an older server tells no uplink: only its address, no alarm it cannot back
+        code.draw(img, 2, y, text(st.get("management")) or "--", P["muted"])
+        y += code.h + 2
+        d.line((0, y, 127, y), fill=P["line"])
+        health_rows(img, d, panel, st, y + 3)
+        return
+    up = st["uplink"]
+    state = text(up.get("state"))
+    if state == "wifi":
+        key = QUALITY.get(text(up.get("quality")), "muted")
+        signal = number(up.get("signal"), None)
+        dbm = f"{int(signal)} dBm" if signal is not None else ""
+        signal_bars(d, 2, y + body.asc - 1, int(number(up.get("bars"), 0)), key if key != "muted" else "dim")
+        body.draw(img, 16, y, fonts.fit(body, text(up.get("ssid")) or "Wi-Fi", 108 - body.width(dbm) - 6), P["fg"])
+        if dbm:
+            body.draw(img, 126 - body.width(dbm), y, dbm, P[key])
+        y += body.h + 1
+        x = body.draw(img, 16, y, text(up.get("quality")), P[key]) if up.get("quality") else 16
+        parts = [p for p in (f"{int(number(up.get('rate')))} Mb/s" if number(up.get("rate"), None) else "", text(up.get("band")),
+                             "Wi-Fi " + text(up.get("generation")) if up.get("generation") else "") if p]
+        while parts and x + 6 + body.width("  ".join(parts)) > 126:      # whole parts drop from the end, no "..."
+            parts.pop()
+        if parts:
+            body.draw(img, x + 6, y, "  ".join(parts), P["muted"])
+        y += body.h + 1
+    elif state == "wired":
+        line = " ".join(t for t in (text(up.get("device")), "up", link_speed(up.get("speed"))) if t)
+        body.draw(img, 2, y, fonts.fit(body, line, LINE_W), P["fg"])
+        y += body.h + 1
+    elif state == "wifi_down":
+        signal_bars(d, 2, y + body.asc - 1, 0, "bad")
+        body.draw(img, 16, y, "Wi-Fi not connected", P["bad"])
+        y += body.h + 1
+        body.draw(img, 16, y, fonts.fit(body, f"{text(up.get('device')) or 'Wi-Fi'}: no network", 110), P["muted"])
+        y += body.h + 1
+    else:
+        body.draw(img, 2, y, "No uplink", P["bad"])
+        y += body.h + 1
+    if up.get("spare_active"):
+        body.draw(img, 16, y, "built-in spare in use", P["warn"])
+        y += body.h + 1
+    if state in ("wifi", "wired") and up.get("address"):
+        code.draw(img, 16 if state == "wifi" else 2, y, text(up.get("address")), P["muted"])
+        y += code.h + 1
+    y += 1
+    d.line((0, y, 127, y), fill=P["line"])
+    health_rows(img, d, panel, st, y + 3)
+
+
+def station_rows(panel, st):
+    """(colour, name or None, value) of the health of the station, red ones first, then yellow, then the good ones."""
+    from .cmprovision import number, objects, text
+
+    rows = []
+
+    def link_row(name, link):
+        up = link.get("up") is not False
+        signal = number(link.get("signal"), None)
+        if up and text(link.get("kind")) == "wifi" and text(link.get("ssid")):
+            # a Wi-Fi link: its network and signal, as the uplink block tells its own
+            return "good", name, " ".join(t for t in (text(link.get("ssid")), f"{int(signal)} dBm" if signal is not None else "") if t)
+        return ("good" if up else "bad", name, " ".join(t for t in (text(link.get("name")) if name == "Stand link" else "",
+                                                                   "up" if up else "down",
+                                                                   link_speed(link.get("speed")) if up else "") if t))
+
+    if isinstance(st.get("links"), list):
+        links = objects(st.get("links"))
+        stand = next((l for l in links if text(l.get("role")) == "stand"), None)
+        rows.append(("bad", "Stand link", "down") if stand is None else link_row("Stand link", stand))
+        for link in links:
+            if text(link.get("role")) in ("other", "backup"):
+                rows.append(link_row(text(link.get("name")), link))
+    elif text(st.get("provisioning")):
+        # an older server: its own words for the stand link ("eth0 up", "eth0 down")
+        said = text(st.get("provisioning"))
+        rows.append(("bad" if said.endswith(" down") else "good", "Stand link", said))
+    services = st.get("services") if isinstance(st.get("services"), dict) else None
+    if services is not None:
+        stopped = services.get("stopped")
+        stopped = [text(s) for s in stopped if text(s)] if isinstance(stopped, list) else []
+        if len(stopped) == 1:
+            rows.append(("bad", None, f"{stopped[0]} stopped"))
+        elif stopped:
+            rows.append(("bad", None, f"{len(stopped)} services stopped"))
+        else:
+            disabled = services.get("disabled")
+            disabled = [text(s) for s in disabled if text(s)] if isinstance(disabled, list) else []
+            if disabled:
+                message = f"{disabled[0]} disabled" if len(disabled) == 1 else f"{len(disabled)} services disabled"
+                rows.append(("muted", None, message))
+            else:
+                rows.append(("good", "Services", f"{int(number(services.get('up')))} of {int(number(services.get('total')))} up"))
+    # now on the server's clock: when the snapshot was made, and how old it is
+    generated = number(panel.data.get("generated_at"), None)
+    now = generated + (panel.age or 0) if generated is not None else None
+    switches = objects(panel.data.get("switches"), 64)
+    for switch in switches:
+        name = "Switch" if len(switches) == 1 else text(switch.get("name"))
+        if switch.get("answering") is False:
+            since_t = number(switch.get("silent_since"), None)
+            since = f"silent {int((now - since_t) // 60)} min" if now is not None and since_t else "not answering"
+            # the name may be long: the silence must not be what gets cut
+            rows.append(("bad", name, since))
+        else:
+            rows.append(("good", name, "answering"))
+    if st.get("storage"):
+        rows.append(("warn" if st.get("storage_low") else "good", "Disk", text(st.get("storage"))))
+    from .cmprovision_rescue import info as rescue_info
+    rescue = rescue_info(panel.data)
+    if rescue and not rescue['active']:
+        rows.append(('warn' if rescue['summary'] != 'AP ready' else 'muted', None, rescue['summary']))
+    order = {"bad": 0, "warn": 1, "muted": 2, "good": 3}
+    return sorted(rows, key=lambda r: order[r[0]])
+
+
+def health_rows(img, d, panel, st, top):
+    body = fonts.font("body")
+    rows = station_rows(panel, st)
+    step = body.h + 1
+    fits = max(1, (128 - top) // step)
+    scrolls = fits < len(rows)
+    right = 122 if scrolls else 126                         # room for the scroll bar when the rows go on
+    panel.scroll = max(0, min(panel.scroll, len(rows) - fits))
+    if scrolls:
+        d.rectangle((125, top, 126, 127), fill=P["panel"])
+        t = top + (127 - top) * panel.scroll // len(rows)
+        d.rectangle((125, t, 126, t + max(2, (127 - top) * fits // len(rows))), fill=P["fg"])
+    y = top
+    for key, name, value in rows[panel.scroll:panel.scroll + fits]:
+        mid = round(cap_mid(body, y))
+        d.rectangle((2, mid - 2, 6, mid + 2), fill=P[key])
+        colour = P["fg"] if key == "good" else P[key]
+        if name and body.width(value) + 6 + body.width("Switch") <= right - 10:
+            # the value whole on the right, the name in what is left (a long switch name is the part that gets cut)
+            body.draw(img, 10, y, fonts.fit(body, name, right - 10 - body.width(value) - 6), P["muted"])
+            body.draw(img, right - body.width(value), y, value, colour)
+        else:                                               # a problem tells itself: "dnsmasq stopped"
+            body.draw(img, 10, y, fonts.fit(body, value, right - 10), colour)
+        y += step
diff --git a/fpms/integrations/cmprovision_power.py b/fpms/integrations/cmprovision_power.py
