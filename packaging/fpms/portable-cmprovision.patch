+"""Appearance is a persisted preference, separate from destructive power confirmation."""
+import json
+
+import pytest
+
+from fpms.integrations.cmprovision import Panel
+from fpms.integrations import cmprovision_fonts as fonts
+
+MODES = ('light', 'dark', 'auto')
+
+
+class Client:
+    def __init__(self, mode='auto'):
+        self.mode, self.observed_at = mode, 100
+        self.calls, self.fail = [], None
+
+    def __call__(self, payload):
+        self.calls.append(dict(payload))
+        assert payload['operation'] in ('appearance', 'set-appearance'), 'Appearance must never request station power'
+        if payload['operation'] == self.fail:
+            raise RuntimeError('private backend error')
+        if payload['operation'] == 'set-appearance':
+            self.mode = payload['mode']
+        return dict(stage='appearance', mode=self.mode, observed_at=self.observed_at)
+
+
+def panel(tmp_path, client, layout='new', mode='auto'):
+    p = Panel(tmp_path/'config', tmp_path/'snapshot', can_leave=False, power_client=client)
+    p.data = {'panel': {'theme': layout, 'color_mode': mode}, 'generated_at': 90, 'display_auto_mode': 'dark'}
+    return p
+
+
+def open_appearance(p):
+    p.key('KEY3')
+    for _ in range(3): p.key('DOWN')
+    p.key('CENTER')
+    assert p.power_menu.stage == 'appearance'
+
+
+def choose(p, mode):
+    while MODES[p.power_menu.mode_index] != mode: p.key('DOWN')
+    p.key('CENTER')
+
+
+def test_submenu_reads_current_web_mode_and_back_never_saves(tmp_path):
+    c = Client('light')
+    p = panel(tmp_path, c)
+    open_appearance(p)
+    assert c.calls == [{'operation': 'appearance'}]
+    assert p.power_menu.appearance_mode == 'light'
+    assert p.power_menu.mode_index == 0
+    p.key('DOWN')
+    p.key('KEY2')
+    assert p.power_menu.open and p.power_menu.stage == 'menu' and p.power_menu.index == 3
+    p.key('KEY2')
+    assert not p.power_menu.open and c.calls == [{'operation': 'appearance'}]
+
+
+@pytest.mark.parametrize('layout', ['new', 'classic'])
+@pytest.mark.parametrize('mode', MODES)
+def test_apply_is_immediate_for_both_layouts_and_survives_closing_menu(tmp_path, layout, mode):
+    c = Client('auto')
+    p = panel(tmp_path, c, layout)
+    open_appearance(p)
+    choose(p, mode)
+    assert c.calls[-1] == {'operation': 'set-appearance', 'mode': mode}
+    assert p.power_menu.appearance_mode == mode
+    assert p.color_mode() == ('dark' if mode == 'auto' else mode)
+    p.key('KEY2'); p.key('KEY2')
+    assert not p.power_menu.open
+    assert p.color_mode() == ('dark' if mode == 'auto' else mode)
+    assert p.theme() == layout
+
+
+def test_auto_continues_using_the_shared_day_night_signal(tmp_path):
+    c = Client('dark')
+    p = panel(tmp_path, c, mode='dark')
+    open_appearance(p); choose(p, 'auto')
+    p.data['display_auto_mode'] = 'light'
+    assert p.color_mode() == 'light'
+    p.data['display_auto_mode'] = 'dark'
+    assert p.color_mode() == 'dark'
+
+
+def test_acknowledged_mode_is_not_undone_by_the_old_snapshot_but_later_web_changes_win(tmp_path):
+    c = Client('auto')
+    p = panel(tmp_path, c)
+    open_appearance(p); choose(p, 'light')
+    p.config.write_text(json.dumps({'enabled': True, 'open_on_start': True}))
+    def refresh(at, mode):
+        p.snapshot.write_text(json.dumps({'version': 1, 'generated_at': at, 'panel': {'color_mode': mode}, 'display_auto_mode': 'dark'}))
+        p.refresh(now=110, force=True)
+    refresh(99, 'dark')
+    assert p.color_mode() == 'light'
+    refresh(100, 'dark')
+    assert p.color_mode() == 'light'
+    refresh(101, 'auto')  # a later web edit can supersede the panel save
+    assert p.color_mode() == 'dark'
+    p.frame()
+    assert p.power_menu.appearance_mode == 'auto'
+
+
+@pytest.mark.parametrize('operation', ['appearance', 'set-appearance'])
+def test_backend_failure_keeps_confirmed_mode_and_returns_to_parent_safely(tmp_path, operation):
+    c = Client('auto')
+    p = panel(tmp_path, c)
+    if operation == 'appearance':
+        c.fail = operation
+        p.key('KEY3')
+        for _ in range(3): p.key('DOWN')
+        p.key('CENTER')
+    else:
+        open_appearance(p); c.fail = operation; choose(p, 'light')
+    assert p.power_menu.stage == 'appearance_error'
+    assert p.color_mode() == 'dark'
+    p.key('KEY1')
+    p.key('CENTER')
+    assert not any(r['operation'] in ('prepare', 'confirm') for r in c.calls)
+    p.key('KEY2')
+    assert p.power_menu.open and p.power_menu.stage == 'menu'
+
+
+@pytest.mark.parametrize('reply', [None, {}, {'stage': 'scheduled', 'mode': 'light', 'observed_at': 100},
+    {'stage': 'appearance', 'mode': 'blue', 'observed_at': 100},
+    {'stage': 'appearance', 'mode': 'light', 'observed_at': True}])
+def test_malformed_readback_does_not_claim_a_new_mode(tmp_path, reply):
+    p = panel(tmp_path, lambda _: reply)
+    p.key('KEY3')
+    for _ in range(3): p.key('DOWN')
+    p.key('CENTER')
+    assert p.power_menu.stage == 'appearance_error'
+    assert p.color_mode() == 'dark'
+
+
+@pytest.mark.parametrize('layout', ['new', 'classic'])
+@pytest.mark.parametrize('mode', MODES)
+@pytest.mark.parametrize('stage', ['menu', 'appearance', 'appearance_error'])
+def test_menu_and_submenu_fit_all_layouts_and_palettes(tmp_path, layout, mode, stage):
+    c = Client(mode)
+    p = panel(tmp_path, c, layout, mode)
+    open_appearance(p)
+    p.power_menu.stage = stage
+    fonts.start_recording()
+    img = p.frame()
+    ink, centred = fonts.stop_recording()
+    assert img.size == (128, 128)
+    assert not fonts.overlaps(ink)
+    assert not fonts.off_centre(centred)
+
+
+@pytest.mark.parametrize('layout', ['new', 'classic'])
+def test_timeout_menu_saves_never_and_a_later_web_edit_updates_the_idle_timer(tmp_path, layout):
+    settings = {'seconds': 120}
+    calls = []
+
+    def client(payload):
+        calls.append(payload)
+        if payload['operation'] == 'set-screen-timeout':
+            settings['seconds'] = payload['seconds']
+        else:
+            assert payload == {'operation': 'screen-timeout'}
+        return dict(stage='screen-timeout', seconds=settings['seconds'], observed_at=100)
+
+    p = panel(tmp_path, client, layout)
+    assert not p.should_sleep(59) and p.should_sleep(60)
+    p.data['panel']['screen_timeout'] = 120
+    assert not p.should_sleep(119) and p.should_sleep(120)
+    p.key('KEY3')
+    for _ in range(4): p.key('DOWN')
+    p.key('CENTER')
+    assert p.power_menu.stage == 'timeout'
+    for _ in range(5): p.key('DOWN')  # 2 min -> 5, 10, 30, 60 min -> Never
+    p.key('CENTER')
+    assert calls[-1] == {'operation': 'set-screen-timeout', 'seconds': 0}
+    assert not p.should_sleep(86400)
+    fonts.start_recording()
+    assert p.frame().size == (128, 128)
+    ink, _ = fonts.stop_recording()
+    assert not fonts.overlaps(ink)
+    p.key('KEY2')
+    assert p.power_menu.stage == 'menu' and p.power_menu.index == 4
+    p.key('KEY2')
+    p.data.update(generated_at=101)
+    p.data['panel']['screen_timeout'] = 30
+    assert not p.should_sleep(29) and p.should_sleep(30)
+    assert not p.should_sleep(100, 0) and p.should_sleep(2, 2)  # explicit CLI override
+    p.data = {}
+    assert p.should_sleep(30)  # keep the last valid policy during a publisher interruption
+
+
+def test_timeout_rejects_a_failed_save_and_keeps_the_previous_choice(tmp_path):
+    def client(payload):
+        if payload['operation'] == 'screen-timeout':
+            return dict(stage='screen-timeout', seconds=60, observed_at=100)
+        return dict(stage='screen-timeout', seconds=True, observed_at=101)
+    p = panel(tmp_path, client)
+    p.key('KEY3')
+    for _ in range(4): p.key('DOWN')
+    p.key('CENTER'); p.key('DOWN'); p.key('CENTER')
+    assert p.power_menu.stage == 'timeout_error' and p.screen_timeout() == 60
+    p.key('KEY2')
+    assert p.power_menu.stage == 'menu' and p.power_menu.index == 4
+
+
+def test_waveshare_sleeps_at_saved_timeout_consumes_first_key_and_wakes_for_never(tmp_path, monkeypatch):
+    from types import SimpleNamespace
+    import sys
+    from fpms import lite
+
+    now, transitions = [0], []
+    p = panel(tmp_path, Client())
+    p.refresh = lambda **kw: p.data['panel'].update(screen_timeout=0 if now[0] >= 35 else 15)
+    monkeypatch.setattr(lite, 'Panel', lambda *a, **kw: p)
+    monkeypatch.setattr(lite, 'time', SimpleNamespace(monotonic=lambda: now[0]))
+    monkeypatch.setattr(lite, 'heartbeat', lambda *a, **kw: None)
+    monkeypatch.setattr(lite, 'wait_for_display', lambda stopped, until=None: {'profile': 'waveshare-1.44', 'id': '7c89f0'})
+    monkeypatch.setattr(lite.signal, 'signal', lambda *a: None)
+    monkeypatch.setattr(sys, 'argv', ['fpms', '--seconds', '41'])
+
+    class Buttons:
+        def __enter__(self): return self
+        def __exit__(self, *a): pass
+        def wait_edge_events(self, timeout):
+            now[0] += 1
+            return now[0] == 17
+        def read_edge_events(self):
+            return [SimpleNamespace(line_offset=26)]  # RIGHT would change page on an awake panel
+
+    screen = SimpleNamespace(init=lambda: None, drawImage=lambda frame: None,
+                             sleep=lambda: transitions.append((now[0], 'sleep')),
+                             wakeup=lambda: transitions.append((now[0], 'wake')))
+    monkeypatch.setitem(sys.modules, 'gpiod', SimpleNamespace(request_lines=lambda *a, **kw: Buttons(), LineSettings=lambda **kw: None))
+    monkeypatch.setitem(sys.modules, 'gpiod.line', SimpleNamespace(Bias=SimpleNamespace(PULL_UP=1), Edge=SimpleNamespace(FALLING=1)))
+    monkeypatch.setitem(sys.modules, 'fpms.modules.gpiochip', SimpleNamespace(get_gpiochip=lambda: 'test'))
+    monkeypatch.setitem(sys.modules, 'fpms.modules.screen.st7735', SimpleNamespace(ST7735=lambda: screen))
+    lite.main()
+    assert transitions == [(15, 'sleep'), (17, 'wake'), (32, 'sleep'), (35, 'wake')]
+    assert p.page == 0
