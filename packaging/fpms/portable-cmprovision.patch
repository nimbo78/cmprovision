+"""Bitmap fonts of the cmprovision panel and the checks every screen goes through.
+
+A 128x128 panel of 0.2 mm pixels reads best in fonts drawn for its pixels: BDF files in fpms/fonts/cmprovision (made by
+tools/cmprovision-fonts.py; licences beside them), drawn one to one without smoothing. Text is placed by its ink, not by
+the advance of its glyphs, which carries empty columns: that is what keeps a digit in the middle of its tag.
+
+While recording (the tests), every text drawn leaves its ink box and every centred text its box and ink, so a test can
+find texts that touch, text off the screen and text off the centre of its box.
+"""
+
+import string
+from pathlib import Path
+
+from PIL import Image, ImageChops, ImageFilter
+
+FONT_DIR = Path(__file__).resolve().parent.parent / "fonts" / "cmprovision"
+# Silkscreen's brackets and bars reach above its capitals: its lines are measured by what the panel writes with it
+TEXT = string.ascii_letters + string.digits + ":-/.()%>~"
+ROLES = {
+    "title": ("helvB10.bdf", None),      # page titles, the port in lists and cards
+    "body": ("helvB08.bdf", None),       # lists, lines, tags
+    "big": ("helvB18.bdf", None),        # the counts of Overview
+    "code": ("spleen-6x12.bdf", None),   # MAC, address
+    "tiny": ("5x7.bdf", None),           # port numbers in the cells of the map
+    "error": ("silkscreen-8.bdf", TEXT),  # what went wrong
+    "mark": ("helvB08.bdf", None),       # the cm of the mark
+}
+_cache = {}
+
+
+class BitmapFont:
+    """A BDF font. h is the line: tight metrics over printable ASCII (or the given characters), not the declared ascent,
+    which keeps room for accents a 128 px screen cannot spare."""
+
+    def __init__(self, path, chars=None):
+        self.glyphs = {}
+        lines = iter(Path(path).read_text(encoding="latin-1").splitlines())
+        for line in lines:
+            if not line.startswith("STARTCHAR"):
+                continue
+            enc, dw, bb, rows = None, 0, None, []
+            for line in lines:
+                key, _, value = line.partition(" ")
+                if key == "ENCODING":
+                    enc = int(value.split()[0])
+                elif key == "DWIDTH":
+                    dw = int(value.split()[0])
+                elif key == "BBX":
+                    bb = [int(v) for v in value.split()]
+                elif key == "BITMAP":
+                    for line in lines:
+                        if line.startswith("ENDCHAR"):
+                            break
+                        rows.append(line.strip())
+                    break
+            if enc is None or enc < 0 or bb is None:
+                continue
+            w, h, xo, yo = bb
+            mask = Image.new("1", (max(w, 1), max(h, 1)), 0)
+            px = mask.load()
+            for r, hexrow in enumerate(rows[:h]):
+                bits, n = (int(hexrow, 16) if hexrow else 0), len(hexrow) * 4
+                for c in range(w):
+                    if bits >> (n - 1 - c) & 1:
+                        px[c, r] = 1
+            self.glyphs[chr(enc)] = (mask, dw, xo, yo, h, mask.getbbox())
+        measured = [self.glyphs[c] for c in (chars or map(chr, range(33, 127))) if c in self.glyphs]
+        self.asc = max(yo + h for _, _, _, yo, h, _ in measured)
+        self.desc = max(0, max(-yo for _, _, _, yo, _, _ in measured))
+        self.h = self.asc + self.desc + 1
+
+    def _g(self, ch):
+        return self.glyphs.get(ch) or self.glyphs.get(" " if ch == " " else "?") or self.glyphs["?"]
+
+    def width(self, s):
+        return sum(self._g(ch)[1] for ch in s)
+
+    def ink_top(self, s):
+        """Pixels from the top of the line to the highest ink of s."""
+        tops = [self.asc - (self._g(ch)[3] + self._g(ch)[4]) for ch in s if self._g(ch)[5]]
+        return min(tops) if tops else self.asc
+
+    def ink(self, x, y, s):
+        """The ink box of s drawn at x, y (inclusive), or None for blank text."""
+        box, base = None, y + self.asc
+        for ch in s:
+            mask, dw, xo, yo, h, bb = self._g(ch)
+            if bb:
+                gx, gy = x + xo, base - yo - h
+                g = (gx + bb[0], gy + bb[1], gx + bb[2] - 1, gy + bb[3] - 1)
+                box = g if box is None else (min(box[0], g[0]), min(box[1], g[1]), max(box[2], g[2]), max(box[3], g[3]))
+            x += dw
+        return box
+
+    def draw(self, img, x, y, s, color):
+        """Draws s with the top of its line at y; returns the x after it."""
+        if _ink is not None:
+            box = self.ink(x, y, s)
+            if box:
+                _ink.append(box + (s,))
+        base = y + self.asc
+        for ch in s:
+            mask, dw, xo, yo, h, _ = self._g(ch)
+            img.paste(color, (x + xo, base - yo - h), mask)
+            x += dw
+        return x
+
+
+def font(role):
+    if role not in _cache:
+        name, chars = ROLES[role]
+        _cache[role] = BitmapFont(FONT_DIR / name, chars)
+    return _cache[role]
+
+
+def _fits(f, s, width):
+    """How many characters of s fit in width: one pass over the advances (the width of a BDF text is their sum), so a
+    long string from the snapshot costs its length, not its length squared."""
+    used = 0
+    for n, ch in enumerate(s):
+        used += f.width(ch)
+        if used > width:
+            return n
+    return len(s)
+
+
+def fit(f, s, width):
+    """s as is, or cut with '...' so the cut is seen (the whole text is one press away, on the card)."""
+    s = s.replace(" ", " ")
+    if f.width(s) <= width:
+        return s
+    n = max(1, _fits(f, s, width - f.width("...")))
+    return s[:n].rstrip() + "..."
+
+
+def wrap(f, s, width):
+    """Words to lines no wider than width; a word wider than a line is cut, never dropped. A no-break space keeps its
+    neighbours on one line ("(curl 18)") and is drawn as a space. Widths add up as the words go: linear in s."""
+    lines, cur, cur_w, space = [], "", 0, f.width(" ")
+    for word in [w for w in s.split(" ") if w]:
+        word_w = f.width(word)
+        while word_w > width:
+            if cur:
+                lines.append(cur)
+                cur, cur_w = "", 0
+            n = max(1, _fits(f, word, width))
+            lines.append(word[:n])
+            word = word[n:]
+            word_w = f.width(word)
+        if not cur:
+            cur, cur_w = word, word_w
+        elif cur_w + space + word_w <= width:
+            cur, cur_w = cur + " " + word, cur_w + space + word_w
+        else:
+            lines.append(cur)
+            cur, cur_w = word, word_w
+    if cur:
+        lines.append(cur)
+    return [line.replace(" ", " ") for line in lines]
+
+
+def ink_bbox(f, s):
+    """The ink of s relative to where draw() puts it, inclusive; (0, 0, -1, -1) for blank text."""
+    return f.ink(0, 0, s) or (0, 0, -1, -1)
+
+
+def draw_centered(f, img, box, s, color):
+    """s with its ink in the middle of box (inclusive): an odd pixel left over goes right and down."""
+    ix0, iy0, ix1, iy1 = ink_bbox(f, s)
+    x = box[0] + (box[2] - box[0] + 1 - (ix1 - ix0 + 1)) // 2 - ix0
+    y = box[1] + (box[3] - box[1] + 1 - (iy1 - iy0 + 1)) // 2 - iy0
+    f.draw(img, x, y, s, color)
+    if _centred is not None:
+        _centred.append((tuple(box), (x + ix0, y + iy0, x + ix1, y + iy1), s))
+
+
+# ---- the checks every screen goes through (tests) ----
+_ink = None
+_centred = None
+
+
+def start_recording():
+    global _ink, _centred
+    _ink, _centred = [], []
+
+
+def stop_recording():
+    """(ink boxes, centred texts) since start_recording()."""
+    global _ink, _centred
+    found = (_ink or [], _centred or [])
+    _ink = _centred = None
+    return found
+
+
+def recording():
+    """Whether the texts drawn are being kept (tests): measuring them costs time the panel does not spend otherwise."""
+    return _ink is not None
+
+
+def record(box, s, mask=None):
+    """A text drawn by other means (the classic theme's default font): its ink box, inclusive, and the ink itself (an
+    image of the box, non-zero where drawn) when the check should go by pixels, not by boxes."""
+    if _ink is not None and box:
+        _ink.append(tuple(box) + (s, mask))
+
+
+def _touch(a, b):
+    """Whether two recorded texts touch: their boxes, or, when both carry their ink, their pixels (a 3x3 neighbourhood)."""
+    if len(a) < 6 or len(b) < 6 or a[5] is None or b[5] is None:
+        return True
+    x0, y0 = min(a[0], b[0]) - 1, min(a[1], b[1]) - 1
+    size = (max(a[2], b[2]) + 2 - x0, max(a[3], b[3]) + 2 - y0)
+    first, second = Image.new("L", size), Image.new("L", size)
+    first.paste(a[5].point(lambda v: 255 if v else 0), (a[0] - x0, a[1] - y0))
+    second.paste(b[5].point(lambda v: 255 if v else 0), (b[0] - x0, b[1] - y0))
+    return ImageChops.multiply(first.filter(ImageFilter.MaxFilter(3)), second).getbbox() is not None
+
+
+def hide_below(y):
+    """A plate from row y down covers what was drawn there: it is not on the screen to be checked."""
+    if _ink is not None:
+        _ink[:] = [b for b in _ink if b[3] < y]
+        _centred[:] = [c for c in _centred if c[0][3] < y]
+
+
+def overlaps(ink):
+    """Texts with no empty pixel between their inks, and text that leaves the 128x128 screen."""
+    bad = []
+    for i, a in enumerate(ink):
+        if a[0] < 0 or a[1] < 0 or a[2] > 127 or a[3] > 127:
+            bad.append(f"off screen: {a[4]!r} {a[:4]}")
+        for b in ink[i + 1:]:
+            if a[0] <= b[2] + 1 and b[0] <= a[2] + 1 and a[1] <= b[3] + 1 and b[1] <= a[3] + 1 and _touch(a, b):
+                bad.append(f"{a[4]!r} {a[:4]} touches {b[4]!r} {b[:4]}")
+    return bad
+
+
+def off_centre(centred, tolerance=1):
+    """Texts in boxes whose left and right (or top and bottom) margins differ by more than tolerance pixels."""
+    bad = []
+    for box, ink, s in centred:
+        dx = (ink[0] - box[0]) - (box[2] - ink[2])
+        dy = (ink[1] - box[1]) - (box[3] - ink[3])
+        if abs(dx) > tolerance or abs(dy) > tolerance:
+            bad.append(f"{s!r} in {box}: left-right {dx:+d}, top-bottom {dy:+d}")
+    return bad
diff --git a/fpms/integrations/cmprovision_menu.py b/fpms/integrations/cmprovision_menu.py
new file mode 100644
index 0000000..ba50d9d
--- /dev/null
+++ b/fpms/integrations/cmprovision_menu.py
@@ -0,0 +1,119 @@
+"""Adapter for the existing FPMS menu; the existing process owns all hardware."""
+
+import logging
+import time
+
+from .cmprovision import Panel, heartbeat, settings
+
+log = logging.getLogger(__name__)
+
+# The panel is left by a second press of button 2; in the stock menu button 2 turns the display upside down, so a press
+# of it that follows a leave (one more, in a hurry) is not meant for the stock menu
+LEAVE_GUARD_SECONDS = 2.0
+
+
+class CmprovisionMenu:
+    def __init__(self, state, menu, draw, hardware, panel=None, redraw=None):
+        self.state, self.menu, self.draw_image = state, menu, draw
+        self.hardware = hardware
+        # draws the stock menu again: the screen shows our last frame until something does (found on a real panel)
+        self.redraw = redraw
+        self.left_at = -1e9
+        self.panel = panel or Panel()
+        self.started = False
+
+        # Stock FPMS dispatches functions, not bound methods.
+        def show():
+            self.show()
+
+        self.action = show
+        self.item = {"name": "cmprovision", "action": show}
+
+    def selected(self):
+        return (
+            self.state.get("display_state") == "page"
+            and self.state.get("option_selected") is self.action
+        )
+
+    def leave(self):
+        self.state.update(
+            display_state="menu",
+            option_selected=None,
+            current_menu_location=[0],
+            current_scroll_selection=0,
+            start_up=False,
+        )
+        self.state["button_press_count"] += 1
+        self.left_at = time.monotonic()
+        if self.redraw:
+            try:
+                self.redraw()
+            except Exception:
+                log.exception("stock menu not redrawn")
+
+    def tick(self, publish=True):
+        # The stock menu's main loop calls this: nothing a snapshot holds may stop it.
+        try:
+            self._tick(publish)
+        except Exception:
+            log.exception("cmprovision menu tick failed")
+
+    def _tick(self, publish):
+        with self.panel.lock:
+            if publish:
+                heartbeat(self.hardware)
+            self.panel.refresh()
+            enabled = self.panel.enabled
+            if enabled and self.item not in self.menu:
+                self.menu.append(self.item)
+            elif not enabled and self.item in self.menu:
+                index = self.menu.index(self.item)
+                # Other menu branches retain their indices because ours is appended.
+                if (
+                    self.selected()
+                    or self.state.get("current_menu_location", [0])[0] == index
+                ):
+                    self.leave()
+                self.menu.remove(self.item)
+            if not self.started:
+                self.started = True
+                if enabled and settings(self.panel.config)["open_on_start"]:
+                    self.state.update(
+                        start_up=False,
+                        display_state="page",
+                        option_selected=self.action,
+                    )
+
+    def show(self):
+        with self.panel.lock:
+            try:
+                self.panel.refresh()
+                if not self.panel.enabled:
+                    self.leave()
+                    return
+                self.state.update(
+                    start_up=False, display_state="page", option_selected=self.action
+                )
+                image = self.panel.frame()
+                # The stock menu draws with an ImageDraw that belongs to state["image"] and shows that very object: the frame
+                # goes into it, the object is not replaced (a replaced image left the stock pages drawn out of sight and our
+                # last frame on the screen, whatever the buttons did).
+                shared = self.state.get("image")
+                if shared is not None and shared.size == image.size and shared.mode == image.mode:
+                    shared.paste(image)
+                    image = shared
+                self.draw_image(image)
+            except Exception:
+                log.exception("cmprovision page failed")
+                self.leave()
+
+    def key(self, key):
+        with self.panel.lock:
+            if not self.selected():
+                # one more press of button 2 right after leaving would turn the display over: it is swallowed
+                return key == "KEY2" and time.monotonic() - self.left_at < LEAVE_GUARD_SECONDS
+            if not self.panel.key(key):
+                self.leave()
+            else:
+                self.show()
+            return True
diff --git a/fpms/integrations/cmprovision_new.py b/fpms/integrations/cmprovision_new.py
new file mode 100644
index 0000000..3d7f9ae
--- /dev/null
+++ b/fpms/integrations/cmprovision_new.py
@@ -0,0 +1,1019 @@
+"""The new look of the cmprovision panel (Settings → Provisioning → FPMS display: New).
+
+Drawn for a 1.44" 128x128 screen whose backlight washes out the dark: bitmap fonts one to one (cmprovision_fonts),
+saturated colours, whole tiles of colour for what needs a look. The layout follows the approved mockups
+(docs/superpowers/specs/2026-10-30-fpms-panel-v2/mock3.py in the cmprovision repository); every screen is checked by the
+tests for texts that touch, leave the screen or sit off the centre of their box.
+"""
+
+from PIL import Image, ImageDraw
+
+from . import cmprovision_fonts as fonts
+
+P = {
+    "bg": (0, 0, 0), "fg": (255, 255, 255), "muted": (170, 170, 170), "dim": (110, 110, 110), "line": (70, 70, 74),
+    "panel": (30, 30, 34), "accent": (255, 122, 26), "good": (40, 225, 110), "run": (70, 150, 255), "bad": (255, 50, 40),
+    "warn": (255, 196, 0), "ink": (0, 0, 0),
+}
+DARK = dict(P)
+LIGHT = {
+    "bg": (255, 248, 240), "fg": (40, 37, 35), "muted": (85, 77, 71), "dim": (105, 96, 88), "line": (148, 135, 124),
+    "panel": (241, 230, 218), "accent": (184, 62, 6), "good": (0, 119, 55), "run": (0, 84, 168),
+    "bad": (179, 26, 25), "warn": (133, 75, 0), "ink": (0, 0, 0),
+}
+
+
+def on_color(key):
+    """Choose a readable black or white label for a filled status, in either palette."""
+    def linear(v):
+        v /= 255
+        return v / 12.92 if v <= .04045 else ((v + .055) / 1.055) ** 2.4
+    r, g, b = P[key]
+    lum = .2126 * linear(r) + .7152 * linear(g) + .0722 * linear(b)
+    return (0, 0, 0) if (lum + .05) / .05 >= 1.05 / (lum + .05) else (255, 255, 255)
+
+# a module's state: its colour and its word
+STATE = {"fail": ("bad", "FAILED"), "stale": ("warn", "SILENT"), "run": ("run", "RUNNING"), "ok": ("good", "DONE"),
+         "unknown": ("dim", "UNKNOWN"), "recognized": ("accent", "OURS")}
+TILES = (("failed", "FAILED", "bad"), ("stale", "SILENT", "warn"), ("running", "RUNNING", "run"), ("done", "DONE", "good"))
+TILE_H = 38
+MIN_GAP = 4          # empty rows at least between a count and its word
+LINE_W = 125         # a line of text from x 2: its last ink column stays on the screen
+LIST_CHARS = 120     # more than two lines of a list row hold: the rest of a text is not even measured
+
+
+def render(panel):
+    """The frame of the page or card the panel is on."""
+    from .cmprovision import PAGES
+
+    img = Image.new("RGB", (128, 128), P["bg"])
+    d = ImageDraw.Draw(img)
+    if not panel.data:
+        header(img, d, panel, "cmprovision")
+        message(img, panel)
+    elif panel.detail:
+        card(img, d, panel)
+    else:
+        [overview, ports, devices, errors, station][panel.page](img, d, panel)
+    until = panel.prompt_until
+    now = panel.clock()
+    if until is not None and now < until:
+        from .cmprovision import PROMPT_SECONDS
+
+        leave_prompt(img, d, (until - now) / PROMPT_SECONDS)
+    return img
+
+
+# ---- parts ----
+
+def cap(f):
+    return f.asc - f.ink_top("H")
+
+
+def mid_y(f, top, height, s="H"):
+    """y that puts the ink of s (no descenders) in the middle of the band top..top+height-1."""
+    t = f.ink_top(s)
+    return top + (height - (f.asc - t)) // 2 - t
+
+
+def cap_mid(f, y):
+    """The middle row of the capitals of a text drawn at y."""
+    return y + (f.ink_top("H") + f.asc - 1) / 2
+
+
+def chip(img, d, right, center, word, key, f=None, padx=3, pady=2):
+    """A filled tag sized by the ink of its word, equal margins all round, its middle on the row center; its width."""
+    f = f or fonts.font("body")
+    ix0, iy0, ix1, iy1 = fonts.ink_bbox(f, word)
+    w, h = ix1 - ix0 + 1 + 2 * padx, iy1 - iy0 + 1 + 2 * pady
+    top = round(center - (h - 1) / 2)
+    box = (right - w + 1, top, right, top + h - 1)
+    d.rounded_rectangle(box, radius=2, fill=P[key])
+    fonts.draw_centered(f, img, box, word, on_color(key))
+    return w
+
+
+def header(img, d, panel, title):
+    """The cm tile, the title, and at the right the dots of the pages, or the age of old data in yellow; on Errors the
+    red count of modules that need a look."""
+    from .cmprovision import PAGES
+
+    body, title_font = fonts.font("body"), fonts.font("title")
+    d.rounded_rectangle((0, 0, 17, 13), radius=3, fill=P["accent"])
+    fonts.draw_centered(fonts.font("mark"), img, (0, 0, 17, 13), "cm", on_color("accent"))     # the mark, the same everywhere
+    right = 127
+    # Overview tells the age in its yellow band instead of the project line
+    age = panel.age_label() if panel.page != 0 or panel.detail else ""
+    if age:
+        right -= chip(img, d, right, 6.5, age, "warn") + 3
+    else:
+        for i in range(len(PAGES)):
+            cx = 104 + i * 5
+            if i == panel.page and not panel.detail:
+                d.rectangle((cx - 1, 5, cx + 2, 8), fill=P["fg"])
+            else:
+                d.rectangle((cx, 6, cx + 1, 7), fill=P["dim"])
+        right = 97
+    if panel.data and panel.page == 3 and not panel.detail and panel.error_count():
+        right -= chip(img, d, right, 6.5, str(min(99, panel.error_count())), "bad") + 3
+    title_font.draw(img, 21, mid_y(title_font, 0, 14), fonts.fit(title_font, title, right - 21), P["fg"])
+    d.line((0, 15, 127, 15), fill=P["line"])
+    return body
+
+
+def message(img, panel):
+    """No data to show: why, and where to look."""
+    body = fonts.font("body")
+    lines = ["Enable in Settings", "FPMS display"] if not panel.enabled else [panel.problem or "Waiting for data", "Check the web UI"]
+    y = 52
+    for i, line in enumerate(lines):
+        body.draw(img, (128 - body.width(line)) // 2, y, line, P["accent" if i == 0 else "muted"])
+        y += body.h + 2
+
+
+def leave_prompt(img, d, left):
+    """Button 2 on a page: the first press asks, a second within 3 s leaves; the orange bar runs out with the time."""
+    body = fonts.font("body")
+    top = 97
+    fonts.hide_below(top)                                   # what the plate covers is not on the screen
+    d.rectangle((0, top, 127, 127), fill=P["fg"])
+    d.rectangle((0, top, max(0, int(127 * left)), top + 1), fill=P["accent"])
+    y = mid_y(body, top + 4, 13)
+    x = body.draw(img, 4, y, "Press", on_color("fg")) + 3
+    ix0, _, ix1, _ = fonts.ink_bbox(body, "2")
+    right = x + (ix1 - ix0 + 1) + 2 * 4 - 1
+    chip(img, d, right, cap_mid(body, y), "2", "accent", body, padx=4, pady=2)
+    body.draw(img, right + 4, y, "again", on_color("fg"))
+    body.draw(img, 4, top + 18, "to leave cmprovision", on_color("fg"))
+
+
+# ---- Overview ----
+
+def counts(panel):
+    c = panel.data.get("counts") if isinstance(panel.data.get("counts"), dict) else {}
+    from .cmprovision import number
+
+    return {k: max(0, int(number(c.get(k)))) for k in ("failed", "stale", "running", "done")}
+
+
+def batch_line(panel):
+    """The project (orange) and what its batch did ("37 done", ETA "6:20"), as much as fits, the ETA going first."""
+    from .cmprovision import number, objects, text
+
+    batch = panel.data.get("batch") if isinstance(panel.data.get("batch"), dict) else {}
+    done = (batch.get("counts") or {}).get("done") if isinstance(batch.get("counts"), dict) else None
+    left = batch.get("left_seconds")
+    parts = []
+    if type(done) is int and done >= 0:
+        parts.append(f"{done} done")
+    if type(left) in (int, float) and number(left, None) is not None and left >= 0:
+        parts.append(f"{int(left) // 60}:{int(left) % 60:02d}")
+    project = text(panel.data.get("project")) or "No active project"
+    return project, parts
+
+
+def overview(img, d, panel):
+    body, big = header(img, d, panel, "Overview"), fonts.font("big")
+    band = cap(body) + 5
+    age = panel.age_label()
+    if age:                                                 # only when the data is 10 s old or older
+        d.rectangle((0, 17, 127, 17 + band - 1), fill=P["warn"])
+        body.draw(img, 2, mid_y(body, 17, band), f"Updated {age} ago", on_color("warn"))
+    else:
+        # the project in orange, the batch in grey after it: the colour parts them, a dot would cost the ETA its room
+        project, parts = batch_line(panel)
+        y = mid_y(body, 17, band)
+        while parts and body.width(project + " " + " ".join(parts)) > LINE_W:
+            parts.pop()
+        x = body.draw(img, 2, y, fonts.fit(body, project, LINE_W), P["accent"])
+        if parts:
+            body.draw(img, x, y, " " + " ".join(parts), P["muted"])
+    n = counts(panel)
+    for i, (key, word, color) in enumerate(TILES):
+        x0, y0 = (i % 2) * 65, 31 + (i // 2) * (TILE_H + 2)
+        loud = key in ("failed", "stale") and n[key] > 0
+        d.rounded_rectangle((x0, y0, x0 + 62, y0 + TILE_H - 1), radius=3, fill=P[color] if loud else P["panel"])
+        num_c = on_color(color) if loud else (P[color] if n[key] else P["dim"])
+        lab_c = on_color(color) if loud else (P["fg"] if n[key] else P["dim"])
+        value = str(min(999, n[key]))
+        # the count hangs from the top, the word stands on the bottom: at least MIN_GAP empty rows between
+        big.draw(img, x0 + 5, y0 + 4 - big.ink_top(value), value, num_c)
+        body.draw(img, x0 + 5, y0 + TILE_H - 4 - body.asc, word, lab_c)
+        hint = x0 + 58 - body.width("OK >")
+        # the centre opens Errors; the hint gives way to a count of three digits
+        if loud and key == "failed" and panel.error_count() and x0 + 5 + big.width(value) + 2 < hint:
+            body.draw(img, hint, y0 + 4 - body.ink_top("OK"), "OK >", on_color(color))
+    size, cells = mini_map(panel.data.get("switches"))
+    if size:
+        for x, y, port in cells:
+            fill, outline = port_style(port)
+            d.rectangle((x, y, x + size - 1, y + size - 1), fill=P[fill] if fill else None, outline=P[outline])
+    else:
+        stand = [c for c in _switch_columns(panel.data.get("switches")) if c]
+        ports = sum(1 for columns in stand for top_port, bottom_port, _ in columns for p in (top_port, bottom_port) if p)
+        switches = len(stand)
+        if ports:
+            line = f"{ports} ports, {switches} switch{'es' if switches != 1 else ''}"
+            body.draw(img, (128 - body.width(line)) // 2, 114, line, P["muted"])
+
+
+def port_style(port):
+    """(fill, outline) as names of P: a module in the colour of its state, the provisioner orange, free a hollow cell."""
+    from .cmprovision import text
+
+    if port.get("server"):
+        return "accent", "accent"
+    if isinstance(port.get("station"), dict):           # another cmprovision station: the mark in an outline
+        return None, "accent"
+    if text(port.get("state")) == "recognized":
+        return "accent", "accent"
+    key = {"ok": "good", "run": "run", "fail": "bad", "stale": "warn"}.get(text(port.get("filter")))
+    if key and text(port.get("state")) == "module":
+        return key, key
+    if text(port.get("state")) == "uplink":
+        return "dim", "dim"
+    if text(port.get("state")) in ("unrecognized", "quiet", "boot"):
+        return None, "warn"
+    return None, "line"
+
+
+def _switch_columns(switches):
+    """Per switch, its ports as the columns of its front panel: [[(top, bottom, block), ...], ...]"""
+    from .cmprovision import number, objects
+
+    out = []
+    for switch in objects(switches, 64):
+        columns = []
+        for b, block in enumerate(objects(switch.get("blocks"), 32)):
+            ports = objects(block.get("ports"), 256)
+            if number(block.get("rows"), 1) >= 2:              # as Panel.map_view() reads a block without rows
+                columns += [(ports[i], ports[i + 1] if i + 1 < len(ports) else None, b) for i in range(0, len(ports), 2)]
+            else:
+                columns += [(None, p, b) for p in ports]
+        out.append(columns)
+    return out
+
+
+def _band(stand, size, gap, top):
+    """Switches side by side in one band of two rows: (width, [(x, y, port)])."""
+    block_gap, switch_gap = gap + 2, gap + 5
+    cells, x = [], 0
+    for s, columns in enumerate(stand):
+        if s:
+            x += switch_gap
+        last = None
+        for top_port, bottom_port, block in columns:
+            if last is not None and block != last:
+                x += block_gap
+            last = block
+            for row, port in ((0, top_port), (1, bottom_port)):
+                if port is not None:
+                    cells.append((x, top + row * (size + gap), port))
+            x += size + gap
+    return x - gap, cells
+
+
+def mini_map(switches, width=124, top=113):
+    """The stand at the bottom of Overview: every port of every switch as a small cell, odd above even, a gap between
+    the blocks of a switch and a wider one between switches. (size, [(x, y, port)]) with the largest cells that fit in
+    one band (6 px down to 3 px); a bigger stand takes two bands of 3 px cells, its switches split between them; (None, [])
+    when even that does not fit."""
+    stand = [columns for columns in _switch_columns(switches) if columns]
+    if not stand:
+        return None, []
+    for size, gap in ((6, 2), (5, 1), (4, 1), (3, 1)):
+        total, cells = _band(stand, size, gap, top)
+        if total <= width:
+            return size, [(cx + (128 - total) // 2, cy, port) for cx, cy, port in cells]
+    for split in range(1, len(stand)):
+        bands = [_band(stand[:split], 3, 1, top), _band(stand[split:], 3, 1, top + 8)]
+        if all(total <= width for total, _ in bands):
+            return 3, [(cx + (128 - total) // 2, cy, port) for total, cells in bands for cx, cy, port in cells]
+    return None, []
+
+
+# ---- Ports ----
+
+PORT_STATES = {"server": ("accent", "SERVER"), "free": ("line", "FREE"), "uplink": ("dim", "UPLINK"),
+               "recognized": ("accent", "OURS"), "unrecognized": ("warn", "UNKNOWN"), "quiet": ("warn", "QUIET"), "boot": ("run", "BOOT")}
+FILTER_STATE = {"ok": "ok", "run": "run", "fail": "fail", "stale": "stale"}
+
+
+def module_of(panel, row):
+    """The module a port row shows, by the serial of the port."""
+    from .cmprovision import objects, text
+
+    serials = [text(s) for s in row.get("serials")] if isinstance(row.get("serials"), list) else []
+    return next((m for m in objects(panel.data.get("modules")) if text(m.get("serial")) in serials), None) if serials else None
+
+
+def port_state(row, module):
+    """(colour, word) of a port: its module's state, else what is on it."""
+    from .cmprovision import text
+
+    if module is not None:
+        return STATE.get(text(module.get("state")), STATE["unknown"])
+    if row.get("server"):
+        return PORT_STATES["server"]
+    if isinstance(row.get("station"), dict):
+        return "accent", "STATION"
+    state = text(row.get("state"))
+    if state == "module":
+        return STATE.get(FILTER_STATE.get(text(row.get("filter")), "unknown"), STATE["unknown"])
+    if state == "No response":                              # the row of a switch that does not answer
+        return "warn", "SILENT"
+    return PORT_STATES.get(state, ("dim", state.upper()[:8] or "PORT"))
+
+
+def link_speed(mbps):
+    """1G, 2.5G, 100M: the speed of a link (the port speed is in Mbit/s, never a write rate)."""
+    from .cmprovision import number
+
+    value = number(mbps, None)
+    if value is None or value <= 0:
+        return ""
+    return f"{value / 1000:g}G" if value >= 1000 else f"{int(value)}M"
+
+
+def map_layout(columns, ports_map, selected):
+    """Where the cells of one switch go: (cells [(x, y, w, h, index)], numbers, bank, banks, detail_y).
+    Up to 8 columns the whole switch with numbers, whatever the setting; wider, 8 columns to a page with numbers
+    (pages), or every column in narrow cells without numbers (whole) when they fit."""
+    def place(cols, w, h, gap, top, x_gap):
+        out, x, last = [], 0, None
+        for top_i, bottom_i, block in cols:
+            if last is not None and block != last:
+                x += 3
+            last = block
+            for row, index in ((0, top_i), (1, bottom_i)):
+                if index is not None:
+                    out.append((x, top + row * (h + x_gap), w, h, index))
+            x += w + gap
+        total = x - gap
+        shift = (128 - total) // 2
+        return [(cx + shift, cy, cw, ch, i) for cx, cy, cw, ch, i in out]
+
+    if len(columns) <= 8:
+        return place(columns, 12, 12, 3, 32, 3), True, 0, 1, 63
+    if ports_map == "whole":
+        blocks = len({b for _, _, b in columns}) - 1
+        for w in (4, 3):
+            if len(columns) * (w + 1) - 1 + 3 * blocks <= 124:
+                return place(columns, w, 7, 1, 33, 1), False, 0, 1, 56
+    at = next((c for c, (t, b, _) in enumerate(columns) if selected in (t, b)), 0)
+    bank, banks = at // 8, -(-len(columns) // 8)
+    return place(columns[bank * 8:(bank + 1) * 8], 12, 12, 2, 32, 2), True, bank, banks, 66
+
+
+def ports(img, d, panel):
+    from .cmprovision import text
+
+    body, tiny = header(img, d, panel, "Ports"), fonts.font("tiny")
+    rows = panel.rows()
+    if not rows:
+        for i, line in enumerate(("No switches: add one in", "Settings > Network")):
+            body.draw(img, (128 - body.width(line)) // 2, 52 + i * (body.h + 2), line, P["muted"])
+        return
+    panel.selected()
+    view = next((v for v in panel.map_view() if any(panel.index in (t, b) for t, b, _ in v["columns"])
+                 or (not v["answering"] and v["first"] == panel.index)), None)
+    if view is None:
+        return
+    band = cap(body) + 5
+    yb = mid_y(body, 17, band, "t")
+    if not view["answering"] and not view["columns"]:
+        body.draw(img, 2, yb, fonts.fit(body, view["name"], LINE_W), P["muted"])
+        body.draw(img, (128 - body.width("No response")) // 2, 52, "No response", P["warn"])
+        return
+    # a switch that stopped answering keeps its last map: the ports as they were, said to be old
+    cells, numbered, bank, banks, detail_y = map_layout(view["columns"], panel.ports_map(), panel.index)
+    pages = f"{bank + 1}/{banks}" if banks > 1 else ""
+    tag, tag_colour = ("not answering", "warn") if not view["answering"] else (pages, "fg")
+    right = 126 - (body.width(tag) + 4 if tag else 0)
+    body.draw(img, 2, yb, fonts.fit(body, view["name"], right - 2), P["muted"])
+    if tag:
+        body.draw(img, 126 - body.width(tag), yb, tag, P[tag_colour])
+    if pages:
+        for b in range(banks):                              # where this screen is among the pages
+            cx = 64 - (banks * 6) // 2 + b * 6
+            d.rectangle((cx, 60, cx + 3, 60), fill=P["fg"] if b == bank else P["dim"])
+    for x, y, w, h, index in cells:
+        if index >= len(rows):                              # past the 512 ports a list holds
+            continue
+        row = rows[index]
+        fill, outline = port_style(row)
+        box = (x, y, x + w - 1, y + h - 1)
+        d.rectangle(box, fill=P[fill] if fill else None, outline=P[outline])
+        if numbered:
+            label = "cm" if row.get("server") or isinstance(row.get("station"), dict) else text(row.get("number"))
+            fonts.draw_centered(tiny, img, box, label, on_color(fill) if fill else P["muted" if outline == "line" else outline])
+        if index == panel.index:
+            d.rectangle((box[0] - 2, box[1] - 2, box[2] + 2, box[3] + 2), outline=P["fg"])
+            d.rectangle((box[0] - 1, box[1] - 1, box[2] + 1, box[3] + 1), outline=P["bg"])
+    port_detail(img, d, panel, detail_y, rows[panel.index])
+
+
+def port_detail(img, d, panel, y, row):
+    """Below the map: the port and its state; the module, its step, and the bar with speed and ETA while it runs, or
+    what went wrong in up to two lines; what else is on the port."""
+    from .cmprovision import objects, rate, remaining, text
+
+    body, title, code, error = fonts.font("body"), fonts.font("title"), fonts.font("code"), fonts.font("error")
+    module = module_of(panel, row)
+    key, word = port_state(row, module)
+    d.line((0, y - 2, 127, y - 2), fill=P["line"])
+    port = text(row.get("portname")) or text(row.get("name"))
+    w = chip(img, d, 127, cap_mid(title, y), word, key)
+    title.draw(img, 2, y, fonts.fit(title, port, 124 - w - 4), P["fg"])
+    y += title.h + 2
+    if module is not None:
+        name = text(module.get("name")) or text(module.get("mac")) or "Unknown"
+        f = code if ":" in name else body
+        f.draw(img, 2, y, fonts.fit(f, name, LINE_W), P["fg"])
+        y += f.h + 1
+        percent = module.get("percent")
+        step = step_of(module)
+        if type(percent) in (int, float) and 0 <= percent < 100:
+            step = f"{step}  {int(percent)}%".strip()
+        body.draw(img, 2, y, fonts.fit(body, step, LINE_W), P["muted"])
+        y += body.h + 2
+        if text(module.get("state")) in ("fail", "stale"):
+            for line in fonts.wrap(error, text(module.get("cause")) or text(module.get("detail")) or word, 124)[:2]:
+                error.draw(img, 2, y, line, P["fg"])
+                y += error.h
+            return
+        if type(percent) in (int, float) and 0 <= percent <= 100:
+            bar(d, 2, y, 125, percent / 100, key)
+            y += 6
+        speed = "  ".join(t for t in (rate(module.get("speed")), remaining(module.get("eta"))) if t)
+        if speed:
+            body.draw(img, 2, y, fonts.fit(body, speed, LINE_W), P["muted"])
+        return
+    if row.get("server"):
+        for line in fonts.wrap(body, "This server (the provisioner)", 124):
+            body.draw(img, 2, y, line, P["muted"])
+            y += body.h
+        return
+    if isinstance(row.get("station"), dict):
+        for colour, f, line in station_lines(row["station"], body, fonts.font("code"), 124):
+            f.draw(img, 2, y, line, P[colour])
+            y += f.h
+        return
+    if text(row.get("state")) == "No response":
+        for line in fonts.wrap(body, "The switch does not answer", 124):
+            body.draw(img, 2, y, line, P["muted"])
+            y += body.h
+        return
+    label = text(row.get("name"))
+    device = next((u for u in (objects(panel.data.get("recognized")) + objects(panel.data.get("unknown"))) if text(u.get("port")) == label), None)
+    if device is not None:
+        body.draw(img, 2, y, fonts.fit(body, text(device.get("name")) or "Unknown device", LINE_W), P["fg"])
+        y += body.h + 1
+        detail = text(device.get("detail")) or text(device.get("mac"))
+        if detail:
+            body.draw(img, 2, y, fonts.fit(body, detail, LINE_W), P["muted"])
+            y += body.h + 1
+    elif text(row.get("state")) == "free":
+        body.draw(img, 2, y, "Nothing connected", P["muted"])
+        return
+    facts = "  ".join(t for t in (link_speed(row.get("speed")), _watts(row.get("watts"))) if t)
+    if facts:
+        body.draw(img, 2, y, facts, P["muted"])
+
+
+def station_lines(station, body, code, width):
+    """Who another cmprovision station on a port is: its name, its role on the stand, its address."""
+    from .cmprovision import text
+
+    role = "Provisioner of the stand" if station.get("provisioner") is True else "cmprovision station"
+    lines = [("fg", body, line) for line in fonts.wrap(body, text(station.get("name")), width)]
+    lines += [("muted", body, line) for line in fonts.wrap(body, role, width)]
+    if text(station.get("address")):
+        lines.append(("muted", code, text(station.get("address"))))
+    return lines
+
+
+def _watts(value):
+    from .cmprovision import number
+
+    w = number(value, None)
+    return f"{w:.1f} W" if w is not None and w > 0 else ""
+
+
+def bar(d, x0, y, x1, frac, key, h=3):
+    d.rectangle((x0, y, x1, y + h - 1), fill=P["panel"])
+    if frac > 0:
+        d.rectangle((x0, y, x0 + int((x1 - x0) * min(1, frac)), y + h - 1), fill=P[key])
+
+
+# ---- Devices and Errors ----
+
+def short_port(row):
+    """Gi0/3 of "t-iof-sw01-provision Gi0/3"; USB for a module seen over USB; Port ? when the server does not know it."""
+    from .cmprovision import text
+
+    port = text(row.get("port"))
+    if port.startswith("USB"):
+        return "USB"
+    if not port or port.lower() == "port unknown":
+        return "Port ?"
+    return port.rsplit(" ", 1)[-1]
+
+
+def short_step(step):
+    """Flash EEPROM of "Pre-install: Flash EEPROM": the script tells more than the phase."""
+    return step.split(": ", 1)[-1]
+
+
+def device_kind(row):
+    """unrecognized or quiet for a device on a port that is not a module ("" for a module): Errors marks its rows with
+    kind, the snapshot's own record of the device says it in state."""
+    from .cmprovision import text
+
+    kind = text(row.get("kind")) or text(row.get("state"))
+    return kind if kind in UNKNOWN_KIND else ""
+
+
+def step_of(row):
+    """The step of a module: the server's label; from an older server only its phase, and not when that is the end
+    itself ("failed", "done"): "failed failed" says nothing."""
+    from .cmprovision import text
+
+    step = text(row.get("step"))
+    if not step:
+        phase = text(row.get("phase"))
+        step = phase if phase not in ("failed", "done", "ready") else ""
+    return step
+
+
+def window(heights, selected, top, bottom=128, gap=0):
+    """The rows to draw, as (first, last + 1): from the top, scrolled just enough to show the selected row whole."""
+    first = 0
+    while first < selected and sum(heights[first:selected + 1]) + gap * (selected - first) > bottom - top:
+        first += 1
+    last, used = first, 0
+    while last < len(heights) and used + heights[last] <= bottom - top:
+        used += heights[last] + gap
+        last += 1
+    return first, max(last, min(len(heights), first + 1))
+
+
+def devices(img, d, panel):
+    from .cmprovision import slow, text
+
+    body, code = header(img, d, panel, "Devices"), fonts.font("code")
+    rows = panel.rows()
+    panel.selected()
+    if not rows:
+        body.draw(img, (128 - body.width("No devices")) // 2, 56, "No devices", P["muted"])
+        return
+    row_h = body.h + max(body.h, code.h) + 6
+    first, last = window([row_h] * len(rows), panel.index, 18)
+    y = 18
+    for i in range(first, last):
+        m = rows[i]
+        state = text(m.get("state"))
+        key, word = STATE.get(state, STATE["unknown"])
+        if i == panel.index:
+            d.rounded_rectangle((0, y, 127, y + row_h - 2), radius=3, fill=P["panel"], outline=P["fg"])
+        d.rectangle((3, y + 3, 5, y + row_h - 5), fill=P[key])
+        # a long port name ("GigabitEthernet1/0/12") gives way to the state beside it
+        x = body.draw(img, 9, y + 2, fonts.fit(body, short_port(m), 58), P["fg"])
+        percent = m.get("percent")
+        flag = slow(m.get("slow"))
+        if flag:
+            right, colour = flag, "warn"
+        elif state == "run" and type(percent) in (int, float) and 0 <= percent < 100:
+            right, colour = f"{int(percent)}%", "run"
+        elif state == "run":
+            right, colour = short_step(step_of(m)) or word, "run"
+        else:
+            right, colour = word, key
+        right = fonts.fit(body, right, 124 - x - 6)
+        body.draw(img, 124 - body.width(right), y + 2, right, P[colour])
+        name = text(m.get("name")) or text(m.get("mac")) or "Unknown"
+        f = code if ":" in name else body
+        f.draw(img, 9, y + 3 + body.h, fonts.fit(f, name, 115), P["muted"])
+        if state == "run" and type(percent) in (int, float) and 0 <= percent <= 100:
+            bar(d, 9, y + row_h - 4, 124, percent / 100, key, h=2)
+        y += row_h
+
+
+UNKNOWN_KIND = {"unrecognized": "UNKNOWN", "quiet": "QUIET"}
+
+
+def error_lines(row, error):
+    """What went wrong with a row of Errors, in up to two lines: the short cause of the server; a module without one by
+    its step; a device that is not a module by what it says of itself."""
+    from .cmprovision import text
+
+    kind = text(row.get("kind"))
+    if kind:                                                # a device on a port, not a module
+        lines = [text(row.get("name")) or "Unknown device", text(row.get("detail")) or text(row.get("mac"))]
+        return [fonts.fit(error, line[:LIST_CHARS], 115) for line in lines if line][:2]
+    cause = text(row.get("cause"))
+    if not cause:
+        # an older server sends no short cause: its failure text, else the step
+        state, step, detail = text(row.get("state")), step_of(row), text(row.get("detail"))
+        if state == "stale":
+            cause = "No report"
+        elif state == "fail":
+            cause = detail or (step + " failed" if step else "Failed")
+        else:
+            cause = detail or "USB, no provisioning run"
+    # two lines are what a row has: more of a text from the snapshot is never measured
+    lines = fonts.wrap(error, cause[:LIST_CHARS], 115)
+    return lines[:1] + [fonts.fit(error, " ".join(lines[1:]), 115)] if len(lines) > 2 else lines
+
+
+def errors(img, d, panel):
+    from .cmprovision import text
+
+    body, title, error = header(img, d, panel, "Errors"), fonts.font("title"), fonts.font("error")
+    rows = panel.rows()
+    panel.selected()
+    if not rows:
+        body.draw(img, (128 - body.width("No errors")) // 2, 56, "No errors", P["muted"])
+        return
+    # a row is at least 28 px high: the screen shows four, so only the rows around the selected one are measured
+    lo, hi = max(0, panel.index - 4), min(len(rows), panel.index + 5)
+    lines = {i: error_lines(rows[i], error) for i in range(lo, hi)}
+    heights = [3 + title.h + len(lines[i]) * error.h + 2 for i in range(lo, hi)]
+    first, last = window(heights, panel.index - lo, 18, gap=2)
+    y = 18
+    for i in range(lo + first, lo + last):
+        row, row_h = rows[i], heights[i - lo]
+        kind = text(row.get("kind"))
+        if kind or text(row.get("state")) == "unknown":
+            key, word = "dim", UNKNOWN_KIND.get(kind, "USB" if not kind else "UNKNOWN")
+        else:
+            key, word = STATE.get(text(row.get("state")), STATE["unknown"])
+        selected = i == panel.index
+        if selected:
+            d.rounded_rectangle((0, y, 127, y + row_h - 1), radius=3, fill=P["panel"], outline=P["fg"])
+        d.rectangle((3, y + 3, 5, y + row_h - 4), fill=P[key])
+        w = chip(img, d, 124, cap_mid(title, y + 2), word, key)
+        title.draw(img, 9, y + 2, fonts.fit(title, short_port(row), 124 - w - 13), P["fg"])
+        ly = y + 3 + title.h
+        for line in lines[i]:
+            error.draw(img, 9, ly, line, P["fg"] if selected else P["muted"])
+            ly += error.h
+        y += row_h + 2
+
+
+# ---- cards ----
+
+def card(img, d, panel):
+    """A module or a port, everything the panel knows of it: a band of its colour with the port and the state (or the
+    age of old data), the name, the step and its bar; below, scrolling with up and down, what went wrong and what to do,
+    the codes, the diagnostics, MAC, serial and switch."""
+    from .cmprovision import rate, remaining, slow, text
+
+    body, title, code, error = fonts.font("body"), fonts.font("title"), fonts.font("code"), fonts.font("error")
+    row = panel.detail_row()
+    if row is None:
+        header(img, d, panel, "Device")
+        body.draw(img, (128 - body.width("Device left stand")) // 2, 56, "Device left stand", P["warn"])
+        return
+    kind = panel.detail[0]
+    module = row if kind == "module" else None
+    if kind == "module":
+        if device_kind(row):                                # a device on a port opened from Errors, not a module
+            key, word = "dim", UNKNOWN_KIND[device_kind(row)]
+        elif row.get("registered") is False:
+            key, word = "dim", "USB"
+        else:
+            key, word = STATE.get(text(row.get("state")), STATE["unknown"])
