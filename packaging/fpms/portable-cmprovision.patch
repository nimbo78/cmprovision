+def stand48_snapshot(ports_map="pages"):
+    """One switch of 48 ports as in the mockups: modules done, running, failed, silent; free ports; the provisioner on 48."""
+    snap = demo_snapshot()
+    modules = [
+        dict(module(2, "wlanpi-3a1", "run", "write", "Writing image", 48, speed=int(24.6 * 1048576), eta=130),
+             port=f"{SW2} Gi1/0/2"),
+        dict(module(17, "wlanpi-7b2", "fail", "failed", "Writing image", 12, cause=f"Server unreachable (curl{NBSP}7)",
+                    code="curl 7, exit 1"), port=f"{SW2} Gi1/0/17"),
+    ]
+    by_port = {2: modules[0], 17: modules[1]}
+    ports = []
+    for i in range(48):
+        n = i + 1
+        k = ("ok" if i % 5 in (0, 2) else "run" if i % 5 == 1 else "free") if i < 44 else "free"
+        k = "fail" if i in (16, 31) else "stale" if i == 22 else k
+        m = by_port.get(n)
+        if n == 48:
+            ports.append({"name": f"Gi1/0/{n}", "number": n, "state": "uplink", "filter": "uplink", "serials": [],
+                          "server": True, "speed": 1000})
+        elif k == "free":
+            ports.append({"name": f"Gi1/0/{n}", "number": n, "state": "free", "filter": "free", "serials": [],
+                          "server": False})
+        else:
+            ports.append({"name": f"Gi1/0/{n}", "number": n, "state": "module", "filter": k,
+                          "serials": [m["serial"]] if m else [f"other{n}"], "server": False, "speed": 1000})
+    snap["switches"] = [{"name": SW2, "answering": True, "blocks": [{"rows": 2, "label": "PORTS", "ports": ports}]}]
+    snap["modules"] = modules
+    snap["panel"] = {"theme": "new", "ports_map": ports_map}
+    return snap
+
+
+def on_port(p, n):
+    p.page = 1
+    p.index = n - 1
+    return p
