+@pytest.mark.parametrize("look", [("new", "pages"), ("new", "whole"), ("classic", "pages")])
+@pytest.mark.parametrize("data", ["empty", "demo", "stand48", "long_texts", "all_failures"])
+@pytest.mark.parametrize("name", SCREENS)
+def test_no_text_touches_another_or_leaves_the_screen(tmp_path, look, data, name):
+    snap = fixture(data)
+    snap["panel"] = {"theme": look[0], "ports_map": look[1]}
+    p = screen(panel_with(tmp_path, snap, now=112 if name == "old" else 101, clock=Clock()), name)
+    img, ink, centred = drawn(p)
+    assert fonts.overlaps(ink) == []
+    if look[0] == "new":
+        assert fonts.off_centre(centred) == []
+        if data == "all_failures":
+            assert not any("..." in t for t in strings(ink) if p.page == 3 and not p.detail)
