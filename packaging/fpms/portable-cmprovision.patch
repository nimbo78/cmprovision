+++ b/fpms/integrations/cmprovision_rescue.py
@@ -0,0 +1,44 @@
+"""Secret-free rescue Wi-Fi presentation shared by Classic and New."""
+import ipaddress
+
+
+def info(data):
+    from .cmprovision import text
+    raw = data.get('rescue_wifi')
+    if not isinstance(raw, dict) or not (raw.get('enabled') is True or raw.get('active') is True):
+        return None
+    state = text(raw.get('state'))
+    summary = {'active':'AP active', 'recovery':'AP recovery', 'waiting':'AP waiting', 'paused':'AP paused',
+               'fault':'AP failed', 'unavailable':'AP status stale', 'starting':'AP starting',
+               'stopping':'AP stopping', 'standby':'AP ready', 'off':'AP off'}.get(state, 'AP unavailable')
+    active = raw.get('active') is True
+    remaining = raw.get('remaining')
+    if not active and type(remaining) is int and 0 <= remaining <= 3600:
+        summary += f' {remaining // 60}:{remaining % 60:02}'
+    clients = raw.get('clients')
+    clients = clients if type(clients) is int and 0 <= clients <= 512 else None
+    address = text(raw.get('address'))
+    try:
+        if ipaddress.ip_address(address).version != 4: address = ''
+    except ValueError:
+        address = ''
+    return {'active':active, 'summary':summary, 'ssid':text(raw.get('ssid'))[:32], 'address':address,
+            'clients':f'{clients} client' + ('' if clients == 1 else 's') if clients is not None else '? clients'}
+
+
+def lines(data, measure=None, width=118):
+    value = info(data)
+    if not value: return []
+    result = [value['summary']]
+    if not value['active']: return result
+    measure = measure or (lambda s: len(s) * 6)
+    chunk = ''
+    for char in value['ssid']:
+        if chunk and measure(chunk + char) > width:
+            result.append(chunk)
+            chunk = ''
+        chunk += char
+    if chunk: result.append(chunk)
+    if value['address']: result.append(value['address'])
+    result.append(value['clients'])
+    return result
