+"""The bitmap fonts of the cmprovision panel: their metrics match the mockups, wrapping keeps codes whole and loses
+nothing, and the checks every screen goes through (touching texts, text off centre) find what they should."""
+
+from PIL import Image
+
+from fpms.integrations import cmprovision_fonts as fonts
+
+
+def test_metrics_match_the_mockups():
+    expect = {"title": (12, 16), "body": (9, 12), "big": (19, 25), "code": (9, 13), "tiny": (6, 8)}
+    for role, (asc, h) in expect.items():
+        f = fonts.font(role)
+        assert (f.asc, f.h) == (asc, h), role
+    big = fonts.font("big")
+    assert big.asc - big.ink_top("0123456789") == 18
+    assert big.width("12") == 26
+
+
+def test_silkscreen_fits_23_letters():
+    error = fonts.font("error")
+    line = "The connection to the provisioning server"
+    assert error.width(line[:23]) <= 124 < error.width(line[:24])
+
+
+def test_wrap_keeps_the_code_together():
+    error = fonts.font("error")
+    assert fonts.wrap(error, "Download cut (curl 18)", 115) == ["Download cut", "(curl 18)"]
+
+
+def test_wrap_never_drops_a_character():
+    body = fonts.font("body")
+    text = "a-very-long-hostname-that-does-not-fit-on-one-line and then some words wlanpi-c18"
+    lines = fonts.wrap(body, text, 60)
+    assert all(body.width(line) <= 60 for line in lines)
+    assert "".join(lines).replace(" ", "") == text.replace(" ", "")
+
+
+def test_fit_marks_the_cut():
+    body = fonts.font("body")
+    assert fonts.fit(body, "short", 100) == "short"
+    cut = fonts.fit(body, "a name far too long for the width given here", 60)
+    assert cut.endswith("...") and body.width(cut) <= 60
+
+
+def test_draw_centered_gives_equal_margins():
+    body = fonts.font("body")
+    x0, y0, x1, y1 = fonts.ink_bbox(body, "2")
+    box = (10, 10, 10 + (x1 - x0 + 1) + 8 - 1, 10 + (y1 - y0 + 1) + 4 - 1)
+    img = Image.new("RGB", (64, 64))
+    fonts.start_recording()
+    fonts.draw_centered(body, img, box, "2", (255, 255, 255))
+    ink, centred = fonts.stop_recording()
+    (b, i, s), = centred
+    assert (i[0] - b[0], b[2] - i[2], i[1] - b[1], b[3] - i[3]) == (4, 4, 2, 2)
+    assert fonts.off_centre(centred) == []
+
+
+def test_overlap_check_finds_touching_texts():
+    body = fonts.font("body")
+    img = Image.new("RGB", (128, 128))
+    fonts.start_recording()
+    body.draw(img, 2, 2, "Gi0/3", (255, 255, 255))
+    right = 2 + fonts.ink_bbox(body, "Gi0/3")[2]
+    body.draw(img, right + 1 - fonts.ink_bbox(body, "FAILED")[0], 2, "FAILED", (255, 255, 255))  # no empty column between
+    ink, _ = fonts.stop_recording()
+    assert len(fonts.overlaps(ink)) == 1
+
+    fonts.start_recording()
+    body.draw(img, 2, 2, "Gi0/3", (255, 255, 255))
+    body.draw(img, 2, 2 + body.h, "FAILED", (255, 255, 255))  # the next line: a blank row between
+    ink, _ = fonts.stop_recording()
+    assert fonts.overlaps(ink) == []
+
+
+def test_text_off_the_screen_is_found():
+    body = fonts.font("body")
+    img = Image.new("RGB", (128, 128))
+    fonts.start_recording()
+    body.draw(img, 100, 120, "FAILED", (255, 255, 255))
+    ink, _ = fonts.stop_recording()
+    assert any(p.startswith("off screen") for p in fonts.overlaps(ink))
+
+
+def test_hidden_text_is_not_checked():
+    body = fonts.font("body")
+    img = Image.new("RGB", (128, 128))
+    fonts.start_recording()
+    body.draw(img, 2, 100, "RUNNING", (255, 255, 255))
+    body.draw(img, 2, 100, "Press 2", (0, 0, 0))
+    fonts.hide_below(98)       # a plate from y 98 covered the first; the second was drawn on it
+    body.draw(img, 2, 100, "Press 2", (0, 0, 0))
+    ink, _ = fonts.stop_recording()
+    assert fonts.overlaps(ink) == []
