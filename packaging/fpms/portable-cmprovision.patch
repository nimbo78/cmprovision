+    def switch_tiles(self, rows, columns, blocks):
+        count = max(1, len(columns))
+        splits = sum(a[2] != b[2] for a, b in zip(columns, columns[1:]))
+        width, gap = 741, 6
+        extra = max(0, min(12, (width - count * 44 - (count - 1) * gap) // max(1, splits)))
+        cell = min(90, (width - (count - 1) * gap - extra * splits) // count)
+        x = 30
+        for col, (upper, lower, group) in enumerate(columns):
+            if col == 0 or columns[col - 1][2] != group:
+                if col:
+                    x += extra
+                group_size = sum(c[2] == group for c in columns)
+                self.label(
+                    x, 146, blocks[group].get("label"), 14, "muted", group_size * (cell + gap) - gap, "bold"
+                )
+            for side, index in enumerate((upper, lower)):
+                if index is None or index >= len(rows):
+                    continue
+                row = rows[index]
+                y = 167 + side * 83
+                self.map_tile(row, (x, y, x + cell - 1, y + 77))
+            x += cell + gap
