+    data = demo_snapshot()
+    data['rescue_wifi'] = dict(enabled=True, active=True, state='active', ssid='DEMO rescue', address='192.168.240.1', clients=1)
+    (tmp_path/'snapshot.json').write_text(json.dumps(data))
+    code = '''import json,sys
+from pathlib import Path
+sys.path.insert(0, sys.argv[1])
+from fpms.integrations.cmprovision import Panel
+directory = Path(sys.argv[2])
+data = json.loads((directory/'snapshot.json').read_text())
+for theme in ('classic','new'):
