+"""The classic look of the cmprovision panel (Settings → Provisioning → FPMS display: Classic): the first look of
+the panel, kept as it was with its defects fixed, for whom it suits and for a bigger screen later."""
+
+import math
+
+from PIL import Image, ImageDraw
+
+from . import cmprovision_fonts as fonts
+from .cmprovision import (BLOCK_GAP, COLORS, CUBE, GAP, MAP_COLUMNS, MAP_TOP, PAGES, number, objects, rate, remaining,
+                          slow, text, hardware_lines)
+
+DARK = dict(COLORS)
+LIGHT = {
+    "bg": "#fff8f0", "panel": "#f1e6da", "line": "#a6978b", "text": "#282523", "muted": "#554d47",
+    "accent": "#b83e06", "good": "#007737", "bad": "#b31a19", "warn": "#854b00", "info": "#0054a8",
+}
+
+
+def contrast_ink(color):
+    """Black or white, whichever contrasts more with a filled port or the mark."""
+    rgb = tuple(int(color[i:i+2], 16) / 255 for i in (1, 3, 5))
+    lin = tuple(v / 12.92 if v <= .04045 else ((v + .055) / 1.055) ** 2.4 for v in rgb)
+    lum = .2126 * lin[0] + .7152 * lin[1] + .0722 * lin[2]
+    return "#000000" if (lum + .05) / .05 >= 1.05 / (lum + .05) else "#ffffff"
+
+
+TEXT_W = 114   # card lines are wrapped and drawn to this one width (they were wrapped at 118, cut at 114: letters lost)
+
+
+def map_cells(panel):
+    """What the map page draws: (switch name, bank, banks, switch answers, cells) for the switch of the selected row;
+    a cell is (x, y, index into rows())."""
+    panel.selected()
+    for view in panel.map_view():
+        columns = view["columns"]
+        mine = [
+            i
+            for i, (top, bottom, _) in enumerate(columns)
+            if panel.index in (top, bottom)
+        ]
+        if not mine and not (not view["answering"] and view["first"] == panel.index):
+            continue
+        banks = max(1, -(-len(columns) // MAP_COLUMNS))
+        bank = (mine[0] // MAP_COLUMNS) if mine else 0
+        cells, x, last = [], 4, None
+        for top, bottom, block in columns[bank * MAP_COLUMNS : (bank + 1) * MAP_COLUMNS]:
+            if last is not None and block != last:
+                x += BLOCK_GAP
+            last = block
+            for y, index in ((MAP_TOP, top), (MAP_TOP + CUBE + GAP, bottom)):
+                if index is not None and index < 512:
+                    cells.append((x, y, index))
+            x += CUBE + GAP
+        return view["name"], bank, banks, view["answering"], cells
+    return "", 0, 1, True, []
+
+def map_style(row):
+    """(fill, outline, ink) as names of COLORS: hollow is free, filled is a module, outlined is something else."""
+    filt, state = text(row.get("filter")), text(row.get("state"))
+    if row.get("server"):
+        return "accent", "accent", "bg"
+    if state == "recognized":
+        return "accent", "accent", "bg"
+    if state == "module" or filt in ("ok", "run", "fail", "stale"):
+        key = {"ok": "good", "run": "info", "fail": "bad", "stale": "warn"}.get(filt, "muted")
+        return key, key, "bg"
+    key = {"free": "muted", "uplink": "accent", "boot": "info"}.get(state, "warn")
+    return None, key, key
+
+def draw_map(panel, draw, label):
+    rows = panel.rows()
+    if not rows:
+        label(5, 50, "No switches: add one in", "muted", panel.small)
+        label(5, 62, "Settings > Network", "muted", panel.small)
+        return
+    name, bank, banks, answering, cells = map_cells(panel)
+    label(4, 36, name + (f"  {bank + 1}/{banks}" if banks > 1 else ""), "text", panel.small, 120)
+    if not answering:
+        label(5, 60, "No response", "warn")
+    for x, y, index in cells:
+        row = rows[index] if index < len(rows) else {}
+        fill, outline, ink = map_style(row)
+        draw.rectangle(
+            (x, y, x + CUBE - 1, y + CUBE - 1),
+            fill=COLORS[fill] if fill else None,
+            outline=COLORS[outline],
+        )
+        caption = "cm" if row.get("server") else text(row.get("number"))
+        width = draw.textlength(caption, font=panel.tiny)
+        # digits stand one pixel from the top; the lowercase "cm" has no height above its x-height: one pixel higher
+        top = y if row.get("server") else y + 1
+        draw.text(
+            (x + (CUBE - width) / 2, top), caption, font=panel.tiny, fill=contrast_ink(COLORS[fill]) if fill else COLORS[ink]
+        )
+        if index == panel.index:
+            draw.rectangle((x - 1, y - 1, x + CUBE, y + CUBE), outline=COLORS["text"])
+    row = rows[panel.index] if rows and panel.index < len(rows) else None
+    if row:
+        module = next(
+            (
+                m
+                for m in objects(panel.data.get("modules"))
+                if text(m.get("serial")) in [text(s) for s in (row.get("serials") or [])]
+            ),
+            None,
+        )
+        port = text(row.get("portname")) or text(row.get("name"))
+        if module:
+            label(4, 82, text(module.get("name")), "text", panel.small, 120)
+            percent = module.get("percent")
+            progress = f" {int(percent)}%" if type(percent) in (int, float) and math.isfinite(percent) else ""
+            label(4, 92, port + "  " + text(module.get("phase") or module.get("state")) + progress, "muted", panel.small, 120)
+        else:
+            label(4, 82, port, "text", panel.small, 120)
+            label(4, 92, "OURS" if row.get("state") == "recognized" else text(row.get("state")), "accent" if row.get("state") == "recognized" else "muted", panel.small, 120)
+    for x, fill, title in ((3, "good", "done"), (38, "info", "run"), (66, "bad", "fail"), (94, "muted", "free")):
+        hollow = title == "free"
+        draw.rectangle(
+            (x, 104, x + 6, 110), fill=None if hollow else COLORS[fill], outline=COLORS[fill]
+        )
+        label(x + 10, 102, title, "muted", panel.small, 24)
+
+def render(panel):
+    with panel.lock:
+        scrollable = False
+        image = Image.new("RGB", (128, 128), COLORS["bg"])
+        draw = ImageDraw.Draw(image)
+
+        def label(x, y, value, color="text", font=None, width=120):
+            font = font or panel.font
+            value = text(value)
+            while value and draw.textlength(value, font=font) > width:
+                value = value[:-1]
+            draw.text((x, y), value, font=font, fill=COLORS[color])
+            if value.strip() and fonts.recording():
+                # the ink itself (textbbox adds the font's margins and ends past the last pixel), for the checks of every screen
+                # smoothed as on the screen: drawn in mode "1" FreeType makes other, wider glyphs
+                probe = Image.new("L", (192, 192))
+                ImageDraw.Draw(probe).text((x + 32, y + 32), value, font=font, fill=255)
+                bb = probe.getbbox()
+                if bb:
+                    # with the ink's own pixels: a descender beside the next line is not a touch
+                    fonts.record((bb[0] - 32, bb[1] - 32, bb[2] - 33, bb[3] - 33), value, probe.crop(bb))
+
+        def wrap(value, width=TEXT_W):
+            """Words to lines that fit the same width the lines are drawn in: no letter is lost at the end of a line."""
+            lines, cur = [], ""
+            for word in value.split():
+                while draw.textlength(word, font=panel.font) > width:
+                    n = len(word)
+                    while n > 1 and draw.textlength(word[:n], font=panel.font) > width:
+                        n -= 1
+                    if cur:
+                        lines.append(cur)
+                        cur = ""
+                    lines.append(word[:n])
+                    word = word[n:]
+                trial = cur + " " + word if cur else word
+                if draw.textlength(trial, font=panel.font) <= width:
+                    cur = trial
+                else:
+                    lines.append(cur)
+                    cur = word
+            if cur:
+                lines.append(cur)
+            return lines
+
+        draw.rounded_rectangle((3, 3, 21, 19), radius=3, fill=COLORS["accent"])
+        # the tile is 3..21 by 3..19 and the lettering is 13 px wide (x 6..18) and 5 px high (y 9..13): the same margin on both sides
+        draw.text((6, 5), "cm", font=panel.small, fill=contrast_ink(COLORS["accent"]))
+        label(
+            27,
+            4,
+            "Device" if panel.detail else PAGES[panel.page],
+            font=panel.small,
+            width=97,
+        )
+        draw.line((3, 23, 124, 23), fill=COLORS["line"])
+        if panel.problem:
+            label(
+                4,
+                26,
+                panel.problem + (f" {panel.age}s" if panel.age is not None else ""),
+                "warn",
+                panel.small,
+            )
+        elif panel.age_label():                               # fresh data needs no word
+            label(4, 26, f"Updated {panel.age_label()} ago", "warn", panel.small)
+        if not panel.data:
+            label(
+                5,
+                51,
+                "Enable in Settings" if not panel.enabled else "Check web UI",
+                "accent",
+            )
+            label(5, 69, "FPMS display", "muted")
+        elif panel.detail:
+            row = panel.detail_row()
+            if row is None:
+                label(5, 55, "Device left stand", "warn")
+            else:
+                diag = (
+                    row.get("diagnostics")
+                    if isinstance(row.get("diagnostics"), dict)
+                    else {}
+                )
+                issues = objects(diag.get("issues"), 4)
+                port_card = panel.detail[0] == "port"
+                if port_card and row.get("state") == "recognized":
+                    row = next((u for u in objects(panel.data.get("recognized")) if text(u.get("port")) == text(row.get("name"))), row)
+                lines = [
+                    row.get("name"),
+                    row.get("port"),
+                    row.get("mac"),
+                    "OURS" if row.get("state") == "recognized" else (row.get("phase") or row.get("state")),
+                    slow(row.get("slow")),
+                    row.get("cause") or row.get("detail"),
+                    # a port's speed is its link in Mbit/s, not a write rate
+                    link_speed(row.get("speed")) if port_card else rate(row.get("speed")),
+                    remaining(row.get("eta")),
+                    diag.get("title") if issues else None,     # a healthy report has no title worth a line
+                    row.get("reason"),
+                    row.get("advice"),
+                ]
+                for issue in issues:
+                    lines += [issue.get("title"), issue.get("advice")]
+                lines += hardware_lines(row)
+                wrapped = [line for value in filter(None, map(text, lines)) for line in wrap(value)]
+                panel.scroll = min(panel.scroll, max(0, len(wrapped) - 5))
+                for i, line in enumerate(wrapped[panel.scroll : panel.scroll + 5]):
+                    label(5, 40 + i * 13, line, width=TEXT_W)
+                if len(wrapped) > 5:
+                    # a bar on the right: where the window is among the lines, so the end of a card is seen as the end
+                    scrollable = True
+                    draw.rectangle((124, 40, 125, 104), fill=COLORS["line"])
+                    top = 40 + int(65 * panel.scroll / len(wrapped))
+                    bottom = 40 + int(65 * (panel.scroll + 5) / len(wrapped))
+                    draw.rectangle((124, top, 125, max(top + 2, bottom)), fill=COLORS["text"])
+                pct = row.get("percent")
+                if type(pct) in (int, float) and math.isfinite(pct):
+                    shade = {"ok": "good", "done": "good", "fail": "bad", "failed": "bad", "stale": "warn", "run": "info"}.get(
+                        text(row.get("state")), "accent"
+                    )
+                    draw.rectangle((5, 108, 122, 111), fill=COLORS["line"])
+                    draw.rectangle(
+                        (5, 108, 5 + int(117 * max(0, min(100, pct)) / 100), 111),
+                        fill=COLORS[shade],
+                    )
+        elif panel.page == 0:
+            label(
+                4,
+                40,
+                panel.data.get("project") or "No active project",
+                "accent",
+                panel.small,
+            )
+            counts = (
+                panel.data.get("counts")
+                if isinstance(panel.data.get("counts"), dict)
+                else {}
+            )
+            for x, y, key, title, color in [
+                (4, 55, "running", "RUN", "accent"),
+                (66, 55, "done", "DONE", "good"),
+                (4, 84, "failed", "FAIL", "bad"),
+                (66, 84, "unknown", "OTHER", "warn"),
+            ]:
+                draw.rectangle((x, y, x + 57, y + 26), fill=COLORS["panel"])
+                value = max(0, int(number(counts.get(key))))
+                if key == "unknown":
+                    value += max(0, int(number(counts.get("stale"))))
+                label(x + 3, y + 1, str(min(999, value)), color, panel.large, 32)
+                label(x + 27, y + 16, title, "muted", panel.small, 30)
+        elif panel.page == 1:
+            draw_map(panel, draw, label)
+        elif panel.page in (2, 3):
+            rows = panel.rows()
+            panel.selected()
+            if not rows:
+                label(
+                    5, 56, "No errors" if panel.page == 3 else "No devices", "muted"
+                )
+            for i, row in enumerate(
+                rows[panel.index // 4 * 4 : panel.index // 4 * 4 + 4]
+            ):
+                y = 40 + i * 18
+                selected = panel.index % 4 == i
+                if selected:
+                    draw.rectangle((2, y - 1, 125, y + 18), fill=COLORS["panel"])
+                    draw.rectangle((2, y - 1, 3, y + 18), fill=COLORS["accent"])
+                name = text(row.get("name")) or text(row.get("mac")) or "Unknown"
+                label(7, y, name, "text", panel.small, 116)
+                color = (
+                    "bad"
+                    if row.get("state") in ("fail", "failed")
+                    else (
+                        "good" if row.get("state") in ("ok", "done") else "accent"
+                    )
+                )
+                label(
+                    7,
+                    y + 10,     # at y + 8 the smoothed edges of the name and of this line met
+                    "OURS" if row.get("state") == "recognized" else (row.get("phase") or row.get("state")),
+                    color,
+                    panel.small,
+                    116,
+                )
+        else:
+            station = (
+                panel.data.get("station")
+                if isinstance(panel.data.get("station"), dict)
+                else {}
+            )
+            lines = [
+                panel.data.get("host"),
+                panel.data.get("app_version"),
+                station.get("management"),
+                station.get("provisioning") or "No provisioning link",
+                station.get("storage"),
+            ]
+            services = station.get("services")
+            service_colour = "muted"
+            if isinstance(services, dict):
+                stopped = services.get("stopped")
+                disabled = services.get("disabled")
+                if isinstance(stopped, list) and stopped:
+                    lines[-1] = f"{len(stopped)} services stopped"
+                    service_colour = "bad"
+                elif isinstance(disabled, list) and disabled:
+                    lines[-1] = f"{len(disabled)} services disabled"
+
+            from .cmprovision_rescue import info as rescue_info, lines as rescue_lines
+            rescue = rescue_info(panel.data)
+            if rescue and rescue['active']:
+                lines = rescue_lines(panel.data, lambda s: draw.textlength(s, font=panel.small), 118)
+                service_colour = 'muted'
+            elif rescue:
+                lines[1] = rescue['summary']
+
+            for i, value in enumerate(lines):
+                label(
+                    5,
+                    (40 + i * 12) if rescue and rescue["active"] else (42 + i * 14),
+                    value or "--",
+                    "accent" if rescue and rescue["active"] and i == 0 else "text" if i == 0 else (service_colour if i == 4 else "muted"),
+                    panel.small,
+                )
+        draw.line((3, 115, 124, 115), fill=COLORS["line"])
+        leave = "Menu" if panel.can_leave else "Home"
+        if panel.prompt_until is not None and panel.clock() < panel.prompt_until:
+            label(4, 117, "Press 2 again to leave", "warn", panel.small)
+        else:
+            label(
+                4,
+                117,
+                ("Up/down scroll   2 Back" if scrollable else "2 Back")
+                if panel.detail
+                else (f"< > Page   OK  2 {leave}" if panel.page in (1, 2, 3) else f"< > Page   2 {leave}"),
+                "muted",
+                panel.small,
+            )
+        return image
+
+
+def link_speed(mbps):
+    """1G, 100M: the speed of a link (Mbit/s)."""
+    value = number(mbps, None)
+    if value is None or value <= 0:
+        return ""
+    return f"Link {value / 1000:g}G" if value >= 1000 else f"Link {int(value)}M"
