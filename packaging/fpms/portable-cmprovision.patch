@@ -0,0 +1,916 @@
+"""Native landscape station menu for the rectangular HyperPixel 4.0 Touch."""
+
+import ipaddress
+import re
+import time
+
+from PIL import Image, ImageDraw
+
+from . import cmprovision_classic as classic
+from . import cmprovision_new as compact
+from . import cmprovision_touch_station as station_view
+from . import cmprovision_touch_details as cards
+from .cmprovision import PAGES, first_admin_projection, hardware_lines, identity, number, objects, text
+from .cmprovision_power import COLOR_MODES, SCREEN_TIMEOUTS, timeout_label
+from .cmprovision_touch_style import DARK, LIGHT, brand, centered, fit, font, icon, icon_caption, wrap
+from .display_marquee import Marquee
+
+
+COUNTERS = (
+    ("running", "run", "Running", "activity", "run"),
+    ("done", "ok", "Done", "check", "good"),
+    ("failed", "fail", "Failed", "Errors", "bad"),
+    ("stale", "stale", "Silent", "clock", "warn"),
+)
+
+
+def port_link(row):
+    """Short label, detail and ink from the switch's operational state."""
+    if row.get("link_up") is True:
+        speed = compact.link_speed(row.get("speed"))
+        return "Up", "Up · " + speed if speed else "Up", "good"
+    if row.get("link_up") is False:
+        return "Down", "Down", "muted"
+    return "?", "No reading", "muted"
+
+
+def port_power(row):
+    """Zero watts alone does not say whether a port is searching, disabled or in fault."""
+    state = text(row.get("poe_state"))
+    watts = number(row.get("watts"), None)
+    reading = f"{watts:g} W" if watts is not None and watts >= 0 else ""
+    if state == "delivering":
+        short = reading if watts is not None and watts > 0 else "On"
+        detail = "Delivering · " + reading if reading else "Delivering"
+        return short, detail, "good"
+    labels = {
+        "searching": ("Idle", "Waiting for device", "muted"),
+        "disabled": ("Off", "Disabled", "muted"),
+        "fault": ("Fault", "Fault", "bad"),
+        "test": ("Test", "Testing", "warn"),
+    }
+    if state in labels:
+        return labels[state]
+    if watts is not None and watts > 0:  # A measured draw is useful even on an older snapshot.
+        return reading, "Measured · " + reading, "good"
+    return "?", "No reading", "muted"
+
+
+def port_connected(row, power_ink):
+    return (row.get("link_up") is True or bool(row.get("server")) or isinstance(row.get("station"), dict)
+            or row.get("state") in ("module", "recognized", "unrecognized", "quiet", "boot", "uplink")
+            or power_ink == "good")
+
+
+class TouchMenu:
+    def __init__(self, panel):
+        self.panel = panel
+        self.offset = 0
+        self.filter_state = None
+        self.port_mode = "map"
+        self.map_anchor = None
+        self.offline_offset = 0
+        self.history = []
+        self.section = None
+        self.bound_port = None
+        self.rendered_ports = {}
+        self.targets = []
+        self.presented = None
+        self.motion = Marquee()
+
+    def state(self):
+        p = self.panel
+        power, rescue = p.power_menu, p.rescue_menu
+        if power and power.open:
+            power.expire()
+            p.sync_display_menu()
+        return (
+            p.page,
+            p.detail,
+            p.theme(),
+            bool(first_admin_projection()),
+            bool(p.data),
+            p.enabled,
+            power.stage if power and power.open else None,
+            rescue.stage if rescue and rescue.open else None,
+        )
+
+    def label(self, x, y, value, size=20, color="fg", width=730, weight="regular", *, hostname=False):
+        face = font(size, weight)
+        if hostname and self.motion.label((x, y), text(value), face, self.c[color], width):
+            return
+        self.draw.text((x, y), fit(value, face, width), font=face, fill=self.c[color], anchor="lt")
+
+    def mark(self, x, y, name, size, color="muted"):
+        self.draw.bitmap((x, y), icon(name, size), fill=self.c[color])
+
+    def logo(self, x, y, size, peer=False):
+        tile = brand(size, "peer" if peer else self.panel.color_mode())
+        self.image.paste(tile, (x, y), tile)
+
+    @staticmethod
+    def pill_width(caption, symbol=None):
+        return round(font(14, "bold").getlength(caption)) + (34 if symbol else 14)
+
+    def pill(self, x, y, caption, color="muted", symbol=None):
+        width = self.pill_width(caption, symbol)
+        fill = {"accent": "tint", "muted": "raised"}.get(color, color + "_tint")
+        self.draw.rounded_rectangle((x, y, x + width - 1, y + 23), radius=6, fill=self.c[fill])
+        if symbol:
+            self.mark(x + 6, y + 4, symbol, 16, color)
+        centered(
+            self.draw,
+            (x + (21 if symbol else 0), y, x + width - 1, y + 23),
+            caption,
+            font(14, "bold"),
+            self.c[color],
+        )
+        return x + width
+
+    def header_pager(self, length, step, right, y):
+        self.offset = self.page_arrows(length, step, right, y, self.offset, "offset")
+
+    def page_arrows(self, length, step, right, y, current, action):
+        last = max(0, (length - 1) // step * step)
+        current = min(max(0, current), last)
+        if not last:
+            return current
+        for x, symbol, offset in (
+            (right - 92, "back", current - step),
+            (right - 44, "next", current + step),
+        ):
+            box = (x, y, x + 43, y + 43)
+            allowed = 0 <= offset <= last
+            self.draw.rounded_rectangle(box, radius=8, fill=self.c["surface"], outline=self.c["line"])
+            self.mark(x + 12, y + 12, symbol, 20, "fg" if allowed else "line")
+            if allowed:
+                self.targets.append((box, (action, offset)))
+        return current
+
+    def card(self, box, color="surface"):
+        self.draw.rounded_rectangle(
+            box, radius=3 if self.classic else 12, fill=self.c[color], outline=self.c["line"]
+        )
+
+    def button(self, box, title, action, accent=False):
+        fill, ink = ("tint", "accent") if accent else ("raised", "fg")
+        self.draw.rounded_rectangle(box, radius=9, fill=self.c[fill], outline=self.c["line"])
+        centered(self.draw, box, title, font(18, "bold"), self.c[ink])
+        self.targets.append((box, action))
+
+    def badge(self, right, y, caption, color):
+        face = font(14, "bold")
+        width = round(face.getlength(caption)) + 22
+        fill = {"accent": "tint", "muted": "raised"}.get(color, color + "_tint")
+        box = (right - width, y, right, y + 24)
+        self.draw.rounded_rectangle(box, radius=7, fill=self.c[fill])
+        centered(self.draw, box, caption, face, self.c[color])
+
+    def title(self, value, aside="", *, hostname=False):
+        self.label(24, 77, value, 32, width=465, weight="bold", hostname=hostname)
+        if aside:
+            self.label(495, 88, aside, 16, "muted", 278)
+
+    def pager(self, length, step, left=500):
+        last = max(0, (length - 1) // step * step)
+        self.offset = max(0, min(self.offset, last))
+        if not last:
+            return
+        if self.offset:
+            self.button((left, 355, left + 79, 401), "Prev", ("offset", self.offset - step))
+        centered(
+            self.draw,
+            (left + 85, 355, left + 176, 401),
+            f"{self.offset//step+1} / {last//step+1}",
+            font(16),
+            self.c["muted"],
+        )
+        if self.offset < last:
+            self.button((left + 180, 355, left + 265, 401), "Next", ("offset", self.offset + step))
+
+    def position(self):
+        p = self.panel
+        return (p.page, p.detail, self.offset, self.filter_state, self.section, self.bound_port)
+
+    def port_row(self):
+        if self.bound_port:
+            return next((r for r in self.panel.rows() if r.get("port_id") == self.bound_port), None)
+        return self.panel.detail_row()
+
+    def tap(self, x, y):
+        if self.state() != self.presented:
+            return
+        for (x0, y0, x1, y1), action in self.targets:
+            if not (x0 <= x <= x1 and y0 <= y <= y1):
+                continue
+            self.targets = []
+            kind, value = action
+            p = self.panel
+            if kind == "page":
+                p.page, p.index, p.detail, p.scroll, self.offset = value, 0, None, 0, 0
+                self.filter_state, self.port_mode = None, "map"
+                self.history.clear()
+                self.section = self.bound_port = None
+                self.map_anchor = None
+                self.offline_offset = 0
+            elif kind == "offset":
+                self.offset = value
+                if p.page == 1 and p.detail is None and self.port_mode == "map":
+                    self.map_anchor = None
+            elif kind == "offline_offset":
+                self.offline_offset = value
+            elif kind == "key":
+                modal = any(self.presented[i] for i in (3, 6, 7))
+                p.key(value)
+                if value == "KEY2" and not modal and self.history:
+                    p.page, p.detail, self.offset, self.filter_state, self.section, self.bound_port = self.history.pop()
+                    p.scroll = 0
+            elif kind in ("filter", "health"):
+                self.history.append(self.position())
+                if kind == "filter":
+                    p.page, p.detail, self.filter_state = 2, None, value
+                else:
+                    p.detail = ("health", "station")
+                p.scroll = self.offset = 0
+            elif kind == "port_mode":
+                self.port_mode, self.offset = value, 0
+            elif kind == "rescue" and p.rescue_available():
+                p.rescue_menu.show()
+            elif kind == "section" and p.detail and p.detail[0] == "port" and self.port_row():
+                self.history.append(self.position())
+                self.section, self.offset = value, 0
+            elif kind == "tab":
+                self.section, self.offset = value, 0
+            elif kind == "port_device":
+                row = self.port_row()
+                if row and any(identity(d) == value for d in self.port_devices(row)):
+                    self.history.append(self.position())
+                    p.detail, p.scroll, self.offset, self.section = ("module", value), 0, 0, None
+            elif kind in ("row", "device"):
+                previous = self.position()
+                if kind == "device":
+                    p.page = 2
+                for index, row in enumerate(p.rows()):
+                    key = (row.get("pin") or row.get("name")) if p.page == 1 else identity(row)
+                    expected = self.rendered_ports.get(value) if p.page == 1 else None
+                    if (row.get("port_id") == expected if expected else key == value):
+                        if self.filter_state and row.get("state") != self.filter_state:
+                            break
+                        p.index = index
+                        if p.page == 1:
+                            p.detail, p.scroll = ("port", key), 0
+                            self.bound_port = row.get("port_id")
+                        else:
