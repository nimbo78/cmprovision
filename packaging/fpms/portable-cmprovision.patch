+    assert pa.frame().tobytes() == pb.frame().tobytes()
+    _, ink, centred = drawn(pa)
+    assert {"1", "3", "5", "7", "2", "4", "6", "cm"} <= set(strings(ink))
+    assert fonts.overlaps(ink) == [] and fonts.off_centre(centred) == []
