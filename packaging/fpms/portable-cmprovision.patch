+    p = Panel(directory/'config.json', directory/'snapshot.json')
+    p.refresh(now=101,force=True); p.page=4
+    assert p.frame().size == (128,128)
+'''
+    result = subprocess.run([sys.executable, '-I', '-c', code, str(dest/'usr/lib/fpms-lite'), str(tmp_path)], cwd=tmp_path, capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
