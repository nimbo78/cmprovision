diff --git a/debian/rules b/debian/rules
index 3a71614..60579ab 100755
--- a/debian/rules
+++ b/debian/rules
@@ -54,6 +54,7 @@ override_dh_virtualenv:
 # dh-virtualenv's sequence skips dh_auto_build and dh_auto_clean.
 execute_before_dh_install:
 	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Wall -o splash/fpms-splash splash/fpms-splash.c
+	install -D -m 644 packaging/cmprovision.json debian/wlanpi-fpms/usr/share/fpms/cmprovision.json
 
 execute_before_dh_clean:
 	rm -f splash/fpms-splash
