--- /dev/null
+++ b/fpms/modules/screen/hyperpixel.py
@@ -0,0 +1,273 @@
+"""Rectangular HyperPixel 4.0 Touch on the Raspberry Pi KMS overlay."""
+
+import array
+import ctypes
+import errno
+import fcntl
+import math
+import os
+import re
+import select
+import struct
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+WIDTH, HEIGHT = 800, 480
+SCAN_WIDTH, SCAN_HEIGHT = HEIGHT, WIDTH
+DISPLAY = {"profile": "hyperpixel-4-touch", "id": "gt911"}
+EVENT = struct.Struct("@llHHi")
+
+
+def compatible(path, value):
+    try:
+        return value.encode() in path.read_bytes().split(b"\0")
+    except OSError:
+        return False
+
+
+def configured(tree=Path("/proc/device-tree")):
+    return compatible(tree / "spi/display@0/compatible", "pimoroni,hyperpixel4")
+
+
+def find_touch(tree=Path("/proc/device-tree"), inputs=Path("/sys/class/input")):
+    if not configured(tree):
+        return None
+    for event in sorted(inputs.glob("event[0-9]*")):
+        device = (event / "device").resolve()
+        try:
+            name = (device / "name").read_text().strip()
+            product = (device / "id/product").read_text().strip()
+            controller = device.parents[1]
+            if (
+                re.fullmatch(r"\d+-(0014|005d)", controller.name)
+                and name == controller.name + " Goodix Capacitive TouchScreen"
+                and product == "038f"
+                and (controller / "of_node").resolve().parent == (tree / "i2c@0").resolve()
+                and compatible(controller / "of_node/compatible", "goodix,gt911")
+            ):
+                return event.name
+        except OSError:
+            continue
+    return None
+
+
+def point(x, y, xs, ys, rotate):
+    # The GT911 reports landscape-sized ranges but the overlay has already
+    # oriented both axes. Three physical targets confirm independent scaling.
+    def axis(value, bounds, pixels):
+        low, high = bounds
+        return round((max(low, min(high, value)) - low) * (pixels - 1) / (high - low))
+
+    # The tested Mcuzone mounting needs clockwise portrait scanout.
+    x, y = axis(y, ys, SCAN_HEIGHT), HEIGHT - 1 - axis(x, xs, SCAN_WIDTH)
+    return (WIDTH - 1 - x, HEIGHT - 1 - y) if rotate == 180 else (x, y)
+
+
+def to_scanout(image, rotate):
+    from PIL import Image
+
+    return image.transpose(Image.Transpose.ROTATE_90 if rotate == 180 else Image.Transpose.ROTATE_270)
+
+
+class Touches:
+    def __init__(self, xs, ys, rotate):
+        self.xs, self.ys, self.rotate = xs, ys, rotate
+        self.x = self.y = self.start = None
+        self.down = self.contact = self.blocked = False
+        self.slot = 0
+
+    def feed(self, kind, code, value):
+        if kind == 0 and code == 3:  # SYN_DROPPED: suppress until a clean release
+            self.start = self.x = self.y = None
+            self.blocked = True
+        elif kind == 3:
+            if code == 0:
+                self.x = value
+            elif code == 1:
+                self.y = value
+            elif code == 47:
+                self.slot = value
+            elif code == 57 and self.slot and value >= 0:
+                self.blocked = True
+        elif kind == 1 and code == 330:  # BTN_TOUCH
+            self.down = bool(value)
+        elif kind == 0 and code == 0:  # complete evdev report
+            position = None
+            if self.x is not None and self.y is not None:
+                position = point(self.x, self.y, self.xs, self.ys, self.rotate)
+            if self.down:
+                self.contact = True
+                if self.start is None:
+                    self.start = position
+                elif position and math.dist(self.start, position) > 24:
+                    self.blocked = True
+            elif self.contact:
+                tap = self.start if not self.blocked else None
+                self.start, self.contact, self.blocked = None, False, False
+                return tap
+            elif not self.down:
+                self.blocked = False
+        return None
+
+
+class TouchInput:
+    def __init__(self, event, rotate):
+        self.fd = os.open(Path("/dev/input") / event, os.O_RDONLY | os.O_NONBLOCK)
+        try:
+            bounds = []
+            for code in (0, 1):
+                # EVIOCGABS returns six native 32-bit integers from Linux input.h.
+                values = array.array("i", [0] * 6)
+                fcntl.ioctl(self.fd, 0x80184540 + code, values, True)
+                if values[2] <= values[1]:
+                    raise OSError("Invalid Goodix axis range")
+                bounds.append((values[1], values[2]))
+            self.touches = Touches(*bounds, rotate)
+        except BaseException:
+            self.close()
+            raise
+
+    def read(self, timeout):
+        result = []
+        if select.select([self.fd], [], [], timeout)[0]:
+            data = os.read(self.fd, EVENT.size * 64)
+            if not data:
+                raise OSError("Goodix disconnected")
+            for _, _, kind, code, value in EVENT.iter_unpack(data):
+                tap = self.touches.feed(kind, code, value)
+                if tap is not None:
+                    result.append(tap)
+        return result
+
+    def close(self):
+        os.close(self.fd)
+
+
+class DpiScreen:
+    """Place one overlay on the active DPI output. Never modeset or blank HDMI."""
+
+    def __init__(self, kms, card, connector, crtc, plane):
+        self.kms, self.card, self.connector = kms, card, connector
+        self.crtc, self.plane = crtc, plane
+        self.buffers = [kms.DumbFramebuffer(card, SCAN_WIDTH, SCAN_HEIGHT, "XR24") for _ in range(2)]
+        self.front = None
+        self._libdrm = ctypes.CDLL("libdrm.so.2", use_errno=True)
+        for name in ("drmIsMaster", "drmSetMaster", "drmDropMaster"):
+            method = getattr(self._libdrm, name)
+            method.argtypes = [ctypes.c_int]
+            method.restype = ctypes.c_int
+        if self._libdrm.drmIsMaster(self.card.fd):
+            self._master_call("drmDropMaster")
+
+    def _master_call(self, name):
+        ctypes.set_errno(0)
+        result = getattr(self._libdrm, name)(self.card.fd)
+        if result != 0:
+            raise OSError(ctypes.get_errno() or abs(result), name)
+
+    @contextmanager
+    def _master(self, *, optional=False):
+        # HDMI can briefly hold the same card while committing to its own overlay.
+        deadline = time.monotonic() + 0.075
+        while True:
+            try:
+                self._master_call("drmSetMaster")
+                break
+            except OSError as exc:
+                if exc.errno != errno.EBUSY:
+                    raise
+                if time.monotonic() >= deadline:
+                    if optional:
+                        yield False
+                        return
+                    raise
+                time.sleep(0.004)
+        try:
+            yield True
+        finally:
+            self._master_call("drmDropMaster")
+
+    @staticmethod
+    def dedicated(card, connector, crtc):
+        for output in card.connectors:
+            output.refresh_props()
+            route = output.get_prop_value("CRTC_ID")
+            if output.id == connector.id and route != crtc.id:
+                return False
+            if output.id != connector.id and route == crtc.id:
+                return False
+        return True
+
+    @classmethod
+    def open(cls):
+        import pykms as kms
+
+        for status in sorted(Path("/sys/class/drm").glob("card[0-9]*-DPI-*/status")):
+            if status.read_text().strip() != "connected":
+                continue
+            device, name = status.parent.name.split("-", 1)
+            card = kms.Card("/dev/dri/" + device)
+            for connector in card.connectors:
+                if connector.fullname != name or not connector.connected():
+                    continue
+                crtc = connector.get_current_crtc()
+                if (
+                    crtc is None
+                    or (crtc.mode.hdisplay, crtc.mode.vdisplay) != (SCAN_WIDTH, SCAN_HEIGHT)
+                    or not cls.dedicated(card, connector, crtc)
+                ):
+                    continue
+                for plane in crtc.possible_planes:
+                    if (
+                        plane.plane_type == kms.PlaneType.Overlay
+                        and plane.get_prop_value("CRTC_ID") == 0
+                        and kms.PixelFormat.XRGB8888 in plane.formats
+                    ):
+                        return cls(kms, card, connector, crtc, plane)
+        raise OSError("No dedicated active HyperPixel DPI output or free overlay")
+
+    def show(self, image):
+        next_buffer = 1 if self.front == 0 else 0
+        fb = self.buffers[next_buffer]
+        pixels = image.tobytes("raw", "BGRX")
+        width = SCAN_WIDTH * 4
+        stride = fb.stride(0)
+        target = fb.map(0).cast("B")
+        if stride == width:
+            target[: len(pixels)] = pixels
+        else:
+            for y in range(SCAN_HEIGHT):
+                target[y * stride : y * stride + width] = pixels[y * width : (y + 1) * width]
+        with self._master():
+            if not self.dedicated(self.card, self.connector, self.crtc):
+                raise OSError("DPI output changed")
+            self.plane.refresh_props()
+            current = self.plane.get_prop_value("FB_ID")
+            if current != (self.buffers[self.front].id if self.front is not None else 0):
+                raise OSError("DPI plane changed owner")
+            request = self.kms.AtomicReq(self.card)
+            request.add_plane(self.plane, fb, self.crtc)
+            if request.commit_sync() != 0:
+                raise OSError("Cannot present the HyperPixel overlay")
+            self.front = next_buffer
+
+    def close(self):
+        if self.front is None:
+            return
+        try:
+            # Erase our scanout before waiting: a setup code or rescue QR must
+            # disappear even if another DRM master prevents an explicit detach.
+            pixels = self.buffers[self.front].map(0).cast("B")
+            pixels[:] = bytes(len(pixels))
+            with self._master(optional=True) as acquired:
+                if not acquired:
+                    return
+                self.plane.refresh_props()
+                if self.plane.get_prop_value("FB_ID") == self.buffers[self.front].id:
+                    request = self.kms.AtomicReq(self.card)
+                    request.add(self.plane, {"FB_ID": 0, "CRTC_ID": 0})
+                    request.commit_sync()
+        finally:
+            self.front = None
+            self.buffers.clear()
