+        box = next(box for box, a in menu.targets if a == action)
+        menu.tap((box[0] + box[2]) // 2, (box[1] + box[3]) // 2)
+        menu.frame()
+
+    menu.frame()
+    tap(("port_mode", "list"))
+    assert [a[1] for _, a in menu.targets if a[0] == "row"] == ["0:Gi0/1", "0:Gi0/7", "0:Gi0/8"]
+    assert menu.port_identity(p.rows()[2])[:3] == ("d62", "This station", "accent")
+    assert menu.port_identity(p.rows()[3])[:3] == ("da2", "Other station", "muted")
+    tap(("row", "0:Gi0/1"))
+    assert p.detail == ("port", "0:Gi0/1")
+    tap(("key", "KEY2"))
+    assert menu.port_mode == "list"
+
+
