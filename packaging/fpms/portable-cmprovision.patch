@@ -0,0 +1,127 @@
+"""Explicit Lite-only power menu. No display snapshot authorizes an operation."""
+import json
+import re
+import subprocess
+
+from PIL import Image, ImageDraw
+from . import cmprovision_fonts as fonts
+
+
+def request(payload):
+    """The root display talks only to the package's fixed, bounded local bridge."""
+    result = subprocess.run(["/usr/lib/cmprovision/station-power-panel"],
+                            input=json.dumps(payload), text=True, capture_output=True,
+                            timeout=15, check=False)
+    if len(result.stdout) > 8192:
+        raise RuntimeError("Power controller unavailable")
+    response = json.loads(result.stdout)
+    if result.returncode != 0 or not isinstance(response, dict) or response.get("ok") is not True:
+        raise RuntimeError("Power controller unavailable")
+    return response.get("result")
+
+
+class PowerMenu:
+    def __init__(self, client, clock):
+        self.client, self.clock = client, clock
+        self.open = False
+        self.stage, self.index, self.action = "menu", 0, "reboot"
+        self.token, self.deadline, self.active_count = None, 0, 0
+        self.message = "Check station status before retrying."
+
+    def show(self):
+        self.open, self.stage, self.index = True, "menu", 0
+        self.token = None
+
+    def expire(self):
+        if self.stage in ("confirm", "interrupt") and self.clock() >= self.deadline:
+            self.stage = "expired"
+
+    def _reply(self, result, preparing=False):
+        if not isinstance(result, dict) or result.get("action") != self.action:
+            raise ValueError("Invalid response")
+        stage = result.get("stage")
+        if stage == "scheduled" and not preparing:
+            self.stage, self.token = stage, None
+            return
+        if stage not in (("confirm",) if preparing else ("interrupt",)):
+            raise ValueError("Invalid stage")
+        token, count = result.get("token"), result.get("active_count")
+        if not isinstance(token, str) or not re.fullmatch("[0-9a-f]{64}", token):
+            raise ValueError("Invalid token")
+        if type(count) is not int or not 0 <= count <= 100000:
+            raise ValueError("Invalid module count")
+        if not preparing and token != self.token:
+            raise ValueError("Changed token")
+        self.stage, self.token, self.active_count = stage, token, count
+
+    def key(self, key):
+        self.expire()
+        if key == "KEY2":
+            # Scheduling cannot be cancelled here. For an unused ticket this invalidates
+            # server-side confirmation too; expiry still protects a failed cancel request.
+            if self.token:
+                try: self.client(dict(operation="cancel", token=self.token))
+                except Exception: pass
+            self.open, self.token = False, None
+            return
+        try:
+            if self.stage == "menu":
+                if key in ("UP", "DOWN"):
+                    self.index = (self.index + (1 if key == "DOWN" else -1)) % 3
+                elif key == "CENTER":
+                    if self.index == 0:
+                        self.open = False
+                        return
+                    self.action = ("reboot", "poweroff")[self.index - 1]
+                    self._reply(self.client(dict(operation="prepare", action=self.action)), preparing=True)
+                    self.deadline = self.clock() + 120
+            elif self.stage in ("confirm", "interrupt") and key == "KEY1":
+                self._reply(self.client(dict(operation="confirm", token=self.token,
+                                             interrupt=self.stage == "interrupt")))
+        except Exception:
+            # A lost reply may mean the action was scheduled. Never retry a confirmation
+            # automatically, and never show private command output on the display.
+            self.stage = "error"
+
+
+def render(menu, palette):
+    """Same compact power flow and semantic palette for Classic/New and Light/Dark/Auto."""
+    menu.expire()
+    p = dict(palette)
+    p.setdefault("fg", p.get("text"))
+    img = Image.new("RGB", (128, 128), p["bg"])
+    draw = ImageDraw.Draw(img)
+    title, body, small = fonts.font("title"), fonts.font("body"), fonts.font("code")
+    legend = fonts.font("tiny")
+    draw.rectangle((0, 0, 17, 13), fill=p["accent"])
+    fonts.draw_centered(small, img, (0, 0, 17, 13), "cm", p["bg"])
+    title.draw(img, 22, 0, "Power", p["fg"])
+    draw.line((0, 16, 127, 16), fill=p["line"])
+    action = "Restart" if menu.action == "reboot" else "Shut down"
+    stage = menu.stage
+    if stage == "menu":
+        for n, word in enumerate(("Cancel", "Restart", "Shut down")):
+            y = 25 + n * 22
+            if n == menu.index:
+                draw.rectangle((1, y - 3, 126, y + 14), outline=p["accent"])
+            body.draw(img, 8, y, word, p["accent"] if n == menu.index else p["fg"])
+        lines = ["CENTER Select", "KEY2 Back"]
+    else:
+        heading = {"confirm": action + "?", "interrupt": "Interrupt flashing?",
+                   "scheduled": action + " requested", "error": "Not confirmed",
+                   "expired": "Confirmation expired"}.get(stage, "Power")
+        body.draw(img, 2, 23, fonts.fit(body, heading, 124), p["warn"] if stage == "interrupt" else p["fg"])
+        message = {
+            "confirm": "This station will restart." if menu.action == "reboot" else "To start again, cycle PoE or external power.",
+            "interrupt": f"{menu.active_count} active modules. Image/EEPROM writes may fail. Recovery may be needed.",
+            "scheduled": "Waiting for restart. No more confirmation needed." if menu.action == "reboot" else "Allow shutdown to finish. Cycle power to start again.",
+            "error": menu.message,
+            "expired": "Choose the action again.",
+        }.get(stage, "")
+        for n, line in enumerate(fonts.wrap(small, message, 124)[:5]):
+            small.draw(img, 2, 42 + 12 * n, line, p["muted"])
+        lines = (["KEY1 Confirm", "KEY2 Cancel"] if stage in ("confirm", "interrupt") else ["KEY2 Back"])
+    draw.line((0, 105, 127, 105), fill=p["line"])
+    for n, line in enumerate(lines):
+        legend.draw(img, 2, 109 + 10 * n, line, p["fg"])
+    return img
diff --git a/fpms/integrations/cmprovision_rescue.py b/fpms/integrations/cmprovision_rescue.py
