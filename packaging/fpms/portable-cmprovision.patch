+++ b/tests/test_cmprovision_v2.py
@@ -0,0 +1,362 @@
+"""The second look of the cmprovision panel: buttons, the leave prompt, the age of the data, themes and every screen.
+
+The demo stand is the one of the mockups (docs/superpowers/specs/2026-10-30-fpms-panel-v2/mock3.py): one 2960-CX of 12
+ports as on wlanpi-da2 with modules in every state, and for the bigger cases a second switch of 48 ports.
+"""
+
+import copy
+import json
+
+import pytest
+
+from fpms.integrations import cmprovision
+from fpms.integrations.cmprovision import Panel
+from fpms.integrations.cmprovision_menu import CmprovisionMenu
+
+SWITCH = "t-iof-sw01-provision"
+NBSP = " "
+
+
+def module(n, name, state, phase, step, percent=None, **more):
+    row = {"serial": f"10000000aaaa00{n:02x}", "mac": f"e4:5f:01:aa:00:{n:02x}", "hostname": None if ":" in name else name,
+           "name": name, "port": f"{SWITCH} Gi0/{n}", "phase": phase, "state": state, "step": step, "detail": None,
+           "percent": percent, "speed": None, "eta": None, "cycle": 300, "silent": None, "slow": None, "os_state": None,
+           "diagnostics": None, "steps": [], "cause": None, "reason": None, "code": None, "advice": None, "registered": True}
+    row.update(more)
+    return row
+
+
+def demo_snapshot():
+    modules = [
+        module(1, "wlanpi-fd3", "ok", "done", "Done", 100),
+        module(2, "wlanpi-a71", "run", "write", "Writing image", 63, speed=25 * 1048576, eta=60),
+        module(3, "wlanpi-c18", "fail", "failed", "Writing image", 63, cause=f"Download cut (curl{NBSP}18)",
+               reason="The connection to the provisioning server was closed before the download finished: server "
+                      "timeout, network problem or server restart.",
+               advice="The partition table was cleared, so the module starts from the network again. Restart the "
+                      "module (power cycle) to try again.", code="curl 18, exit 1"),
+        module(4, "e4:5f:01:9b:31:07", "run", "preinstall", "Pre-install: Flash EEPROM"),
+        module(5, "wlanpi-4ae", "stale", "write", "Writing image", 41, silent=360, cause="No report for 6 min",
+               advice="Check its power, the network cable and the switch port, then restart it; provisioning starts over."),
+        module(6, "e4:5f:01:9b:31:6c", "fail", "failed", "Pre-install", None, cause="EEPROM: no SPI chip",
+               advice="flashrom found no SPI flash chip on the module, so the EEPROM was not changed. Restart the "
+                      "module (power cycle) to try again.", code="exit 1"),
+        module(7, "wlanpi-d62", "ok", "done", "Done", 100),
+    ]
+    by_port = {int(m["port"].rsplit("/", 1)[1]): m for m in modules}
+    filt = {"ok": "ok", "run": "run", "fail": "fail", "stale": "stale"}
+
+    def port(n):
+        m = by_port.get(n)
+        if m:
+            return {"name": f"Gi0/{n}", "number": n, "state": "module", "mark": None, "filter": filt[m["state"]],
+                    "serials": [m["serial"]], "server": False, "speed": 1000, "watts": 4.2}
+        if n == 8:
+            return {"name": "Gi0/8", "number": 8, "state": "uplink", "mark": None, "filter": "uplink", "serials": [],
+                    "server": True, "speed": 1000, "watts": None}
+        if n == 9:
+            return {"name": "Gi0/9", "number": 9, "state": "unrecognized", "mark": None, "filter": "foreign",
+                    "serials": [], "server": False, "speed": 100, "watts": 2.1}
+        return {"name": f"Gi0/{n}", "number": n, "state": "free", "mark": None, "filter": "free", "serials": [],
+                "server": False, "speed": None, "watts": None}
+
+    return {
+        "version": 1, "generated_at": 100, "clock": "2026-10-30 16:00:00 MSK", "host": "wlanpi-da2",
+        "app_version": "2.23.0~dev2", "project": "stage1-test",
+        "batch": {"title": "2 failed", "open": True, "counts": {"active": 3, "done": 37, "failed": 2}, "left_seconds": 380},
+        "counts": {"done": 2, "running": 2, "failed": 2, "stale": 1, "unknown": 0},
+        "switches": [{"name": SWITCH, "model": "WS-C2960CX-8PC-L", "verified_layout": True, "answering": True,
+                      "checked_at": 99, "blocks": [
+                          {"rows": 2, "label": "PORTS", "ports": [port(n) for n in range(1, 9)]},
+                          {"rows": 2, "label": "UPLINK", "ports": [port(n) for n in (9, 10)]},
+                          {"rows": 2, "label": "SFP", "ports": [port(n) for n in (11, 12)]}]}],
+        "modules": modules,
+        "unknown": [{"port": f"{SWITCH} Gi0/9", "state": "unrecognized", "name": "iPhone of Anna", "mac": "aa:bb:cc:00:00:09",
+                     "detail": "Apple, Inc.", "says": False}],
+        "station": {"management": "192.168.68.237", "provisioning": "eth0 up", "storage": "41.2 GiB free",
+                     "storage_low": False,
+                     "uplink": {"state": "wifi", "device": "wlan1", "address": "192.168.68.237", "ssid": "78", "signal": -61,
+                                "quality": "Good", "bars": 3, "band": "5 GHz", "generation": "6", "rate": 866,
+                                "speed": None, "spare_active": False},
+                     "links": [{"name": "eth0", "kind": "ethernet", "role": "stand", "up": True, "speed": 1000,
+                                "address": "172.20.0.1"},
+                               {"name": "wlan1", "kind": "wifi", "role": "uplink", "up": True, "speed": None,
+                                "address": "192.168.68.237"}],
+                     "services": {"up": 6, "total": 6, "stopped": []}},
+        "panel": {"theme": "new", "ports_map": "pages"},
+    }
+
+
+class Clock:
+    def __init__(self, now=1000.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+
+def panel_with(tmp_path, snapshot=None, now=101, **kw):
+    config, path = tmp_path / "config.json", tmp_path / "snapshot.json"
+    config.write_text(json.dumps({"enabled": True, "open_on_start": False}))
+    path.write_text(json.dumps(demo_snapshot() if snapshot is None else snapshot))
+    p = Panel(config, path, **kw)
+    p.refresh(now=now, force=True)
+    return p
+
+
+# ---- buttons ----
+
+def test_key2_on_a_page_asks_then_leaves(tmp_path):
+    clock = Clock()
+    p = panel_with(tmp_path, clock=clock)
+    assert p.key("KEY2") is True and p.prompt_until == pytest.approx(1003.0)
+    clock.now += 1
+    assert p.key("KEY2") is False
+    assert p.prompt_until is None
+
+
+def test_the_prompt_runs_out(tmp_path):
+    clock = Clock()
+    p = panel_with(tmp_path, clock=clock)
+    p.key("KEY2")
+    clock.now += 3.1
+    assert p.key("KEY2") is True and p.prompt_until == pytest.approx(1006.1)   # asks again, does not leave
+
+
+def test_another_key_only_dismisses_the_prompt(tmp_path):
+    clock = Clock()
+    p = panel_with(tmp_path, clock=clock)
+    p.key("KEY2")
+    assert p.key("RIGHT") is True
+    assert p.prompt_until is None and p.page == 0
+
+
+def test_key2_in_a_card_goes_back_without_asking(tmp_path):
+    p = panel_with(tmp_path, clock=Clock())
+    p.page = 2
+    p.key("CENTER")
+    assert p.detail is not None
+    assert p.key("KEY2") is True and p.detail is None and p.prompt_until is None
+
+
+def test_left_in_a_card_goes_back(tmp_path):
+    p = panel_with(tmp_path)
+    p.page = 3
+    p.key("CENTER")
+    assert p.key("LEFT") is True and p.detail is None and p.page == 3
+
+
+def test_key3_does_nothing_inside(tmp_path):
+    p = panel_with(tmp_path)
+    p.page = 2
+    assert p.key("KEY3") is True and p.page == 2 and p.detail is None
+    p.key("CENTER")
+    pinned = p.detail
+    assert p.key("KEY3") is True and p.detail == pinned
+
+
+def test_key1_inside_is_overview(tmp_path):
+    p = panel_with(tmp_path)
+    p.page = 3
+    p.key("CENTER")
+    assert p.key("KEY1") is True and p.page == 0 and p.detail is None
+
+
+def test_center_on_overview_with_failures_opens_errors(tmp_path):
+    p = panel_with(tmp_path)
+    assert p.key("CENTER") is True and p.page == 3 and p.detail is None
+    calm = demo_snapshot()
+    calm["modules"] = [m for m in calm["modules"] if m["state"] not in ("fail", "stale")]
+    q = panel_with(tmp_path, calm)
+    assert q.key("CENTER") is True and q.page == 0
+
+
+def test_lite_key2_returns_to_overview(tmp_path):
+    p = panel_with(tmp_path, can_leave=False, clock=Clock())
+    p.page = 4
+    assert p.key("KEY2") is True and p.page == 0 and p.prompt_until is None
+
+
+def test_up_down_scroll_the_station(tmp_path):
+    p = panel_with(tmp_path)
+    p.page = 4
+    p.key("UP")
+    assert p.scroll == 0
+    p.key("DOWN")
+    p.key("DOWN")
+    assert p.scroll == 2
+    p.key("RIGHT")
+    assert p.scroll == 0
+
+
+# ---- age, theme ----
+
+@pytest.mark.parametrize("age, label", [(9, ""), (10, "10 s"), (59, "59 s"), (60, "1 min"), (185, "3 min")])
+def test_age_label(tmp_path, age, label):
+    p = panel_with(tmp_path, now=100 + age)
+    assert p.age_label() == label
+    assert p.problem == ""      # old data is told by the label, the values stay
+
+
+def test_theme_and_ports_map_come_from_the_snapshot(tmp_path):
+    p = panel_with(tmp_path)
+    assert (p.theme(), p.ports_map()) == ("new", "pages")
+    for panel_field, expect in [({"theme": "classic", "ports_map": "whole"}, ("classic", "whole")),
+                                ({"theme": "rainbow", "ports_map": 3}, ("new", "pages")), (None, ("new", "pages")),
+                                ("bad", ("new", "pages"))]:
+        snap = demo_snapshot()
+        if panel_field is None:
+            del snap["panel"]
+        else:
+            snap["panel"] = panel_field
+        q = panel_with(tmp_path, snap)
+        assert (q.theme(), q.ports_map()) == expect
+
+
+# ---- the adapter of the WLAN Pi menu ----
+
+def adapter_with(panel, monkeypatch, clock):
+    from fpms.integrations import cmprovision_menu
+
+    monkeypatch.setattr(cmprovision_menu.time, "monotonic", clock)
+    state = {"display_state": "menu", "button_press_count": 0, "option_selected": None, "current_menu_location": [0]}
+    adapter = CmprovisionMenu(state, [], lambda image: None, hardware=False, panel=panel)
+    adapter.tick(publish=False)
+    adapter.show()
+    return adapter, state
+
+
+def test_after_a_leave_key2_is_swallowed_for_two_seconds(tmp_path, monkeypatch):
+    clock = Clock()
+    p = panel_with(tmp_path, clock=clock)
+    adapter, state = adapter_with(p, monkeypatch, clock)
+    assert adapter.key("KEY2") is True and adapter.selected()      # asks
+    assert adapter.key("KEY2") is True and not adapter.selected()  # leaves
+    clock.now += 1
+    assert adapter.key("KEY2") is True       # in a hurry: the stock rotation must not get it
+    clock.now += 2
+    assert adapter.key("KEY2") is False      # later: the stock menu's own button
+
+
+def test_key3_is_the_stock_one_outside(tmp_path, monkeypatch):
+    clock = Clock()
+    p = panel_with(tmp_path, clock=clock)
+    adapter, state = adapter_with(p, monkeypatch, clock)
+    assert adapter.key("KEY3") is True and adapter.selected()      # inside: nothing happens, the panel stays
+    adapter.key("KEY2")
+    adapter.key("KEY2")
+    assert not adapter.selected()
+    assert adapter.key("KEY3") is False      # outside, right after the leave as later: the stock Reboot shortcut
+
+
+# ---- the new look: header, Overview, the leave prompt ----
+
+from fpms.integrations import cmprovision_fonts as fonts  # noqa: E402
+from fpms.integrations import cmprovision_new as new  # noqa: E402
+
+BAD, PANEL = (255, 50, 40), (30, 30, 34)
+
+
+def drawn(p):
+    """The frame of the panel, the ink boxes of its texts and its centred texts."""
+    fonts.start_recording()
+    img = p.frame()
+    ink, centred = fonts.stop_recording()
+    return img, ink, centred
+
+
+def strings(ink):
+    return [b[4] for b in ink]
+
+
+def box_of(ink, s, nth=0):
+    return [b for b in ink if b[4] == s][nth][:4]
+
+
+def test_overview_counts_the_stand_and_the_batch_in_one_line(tmp_path):
+    img, ink, _ = drawn(panel_with(tmp_path))
+    s = strings(ink)
+    assert "stage1-test" in s and any("37 done" in t and "6:20" in t for t in s)
+    project, batch = box_of(ink, "stage1-test"), next(b for b in ink if "37 done" in b[4])
+    assert project[1] == batch[1] and batch[0] > project[2]     # one line, the batch after the project
+    for word, n in (("FAILED", "2"), ("SILENT", "1"), ("RUNNING", "2"), ("DONE", "2")):
+        assert word in s and n in s
+    assert fonts.overlaps(ink) == []
+
+
+def test_the_project_line_drops_the_eta_first(tmp_path):
+    snap = demo_snapshot()
+    snap["project"] = "a-project-with-a-rather-long-name"
+    img, ink, _ = drawn(panel_with(tmp_path, snap))
+    line = " ".join(t for t in strings(ink) if "done" in t or "project" in t)
+    assert "6:20" not in line
+    assert fonts.overlaps(ink) == []
+
+
+def test_loud_tiles_are_filled_only_above_zero(tmp_path):
+    img, _, _ = drawn(panel_with(tmp_path))
+    assert img.getpixel((60, 50)) == BAD
+    snap = demo_snapshot()
+    snap["counts"]["failed"] = 0
+    img, _, _ = drawn(panel_with(tmp_path, snap))
+    assert img.getpixel((60, 50)) == PANEL
+
+
+@pytest.mark.parametrize("n", [0, 9, 12, 100, 999])
+def test_numbers_keep_four_pixels_from_their_words(tmp_path, n):
+    snap = demo_snapshot()
+    snap["counts"] = {"done": n, "running": n, "failed": n, "stale": n, "unknown": 0}
+    img, ink, _ = drawn(panel_with(tmp_path, snap))
+    for nth, word in enumerate(("FAILED", "SILENT", "RUNNING", "DONE")):
+        number = box_of(ink, str(n), nth)
+        label = box_of(ink, word)
+        assert label[1] - number[3] - 1 >= 4, (word, number, label)
+    assert fonts.overlaps(ink) == []
+
+
+def test_the_stale_tag_shows_from_ten_seconds(tmp_path):
+    _, ink, _ = drawn(panel_with(tmp_path, now=105))
+    assert not any("Updated" in t for t in strings(ink))
+    p = panel_with(tmp_path, now=112)
+    _, ink, _ = drawn(p)
+    assert "Updated 12 s ago" in strings(ink) and "stage1-test" not in strings(ink)
+    assert "12 s" not in strings(ink)              # told once: the band, not the header too
+    p.page = 2
+    _, ink, centred = drawn(p)
+    assert "12 s" in strings(ink)
+    assert fonts.off_centre(centred) == []
+
+
+def test_the_leave_prompt(tmp_path):
+    p = panel_with(tmp_path, clock=Clock())
+    p.key("KEY2")
+    img, ink, centred = drawn(p)
+    s = strings(ink)
+    for word in ("Press", "2", "again", "to leave cmprovision"):
+        assert word in s
+    assert "FAILED" in s and "RUNNING" not in s      # the plate covers the lower tiles
+    # a tag built around its text is centred exactly; the cm of the mark sits on its optical centre on purpose
+    assert fonts.off_centre([c for c in centred if c[2] != "cm"], tolerance=0) == []
+    assert fonts.off_centre(centred) == []
+    assert fonts.overlaps(ink) == []
+
+
+def big_stand(switches):
+    snap = demo_snapshot()
+    for k in range(switches - 1):
+        ports = [{"name": f"Gi1/0/{n}", "number": n, "state": "free", "filter": "free", "serials": [], "server": False}
+                 for n in range(1, 49)]
+        snap["switches"].append({"name": f"sw-{k}", "answering": True, "blocks": [{"rows": 2, "ports": ports}]})
+    return snap
+
+
+def test_the_mini_map_shrinks_for_a_big_stand(tmp_path):
+    size, cells = new.mini_map(big_stand(2)["switches"])
+    assert size >= 3 and len(cells) == 60
+    assert all(0 <= x and x + size - 1 <= 127 for x, y, _ in cells)
+    snap = big_stand(4)
+    del snap["switches"][0]                     # three switches of 48
+    size, cells = new.mini_map(snap["switches"])
+    assert size is None and cells == []
+    _, ink, _ = drawn(panel_with(tmp_path, snap))
+    assert "144 ports, 3 switches" in strings(ink)
