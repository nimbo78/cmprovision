diff --git a/fpms/integrations/cmprovision.py b/fpms/integrations/cmprovision.py
new file mode 100644
index 0000000..bfc7ac6
--- /dev/null
+++ b/fpms/integrations/cmprovision.py
@@ -0,0 +1,452 @@
+"""Read-only cmprovision front panel, shared by Lite and the WLAN Pi menu.
+
+No WLAN Pi state, subprocesses, database access or device control. Pillow is
+the only non-stdlib dependency; drivers belong to the process hosting us.
+"""
+
+import json
+import math
+import os
+import pwd
+import stat
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+CONFIG = Path("/etc/default/cmprovision-fpms.json")
+SNAPSHOT = Path("/run/cmprovision-wallboard-data/snapshot.json")
+HEARTBEAT = Path("/run/fpms/cmprovision.json")
+LIMIT = 2097152
+# cmprovision resources/css/app.css, Warm / Dark; alpha text composited on black.
+COLORS = {
+    "bg": "#000000",
+    "panel": "#121214",
+    "line": "#222226",
+    "text": "#e6e6e6",
+    "muted": "#8a8a8a",
+    "accent": "#ff8a3d",
+    "good": "#7ee2a0",
+    "bad": "#ff9d93",
+    "warn": "#ffcf7a",
+}
+PAGES = ("Overview", "Ports", "Devices", "Errors", "Station")
+
+
+def trusted_owners():
+    """Who may own a file this process reads (FPMS runs as root): root, the web user that writes the snapshot, and
+    whoever runs us (the tests)."""
+    owners = {0, os.geteuid()}
+    try:
+        owners.add(pwd.getpwnam("www-data").pw_uid)
+    except KeyError:
+        pass
+    return frozenset(owners)
+
+
+def read_json(path, limit=4096):
+    """A bounded read of a small file that another user may have prepared: a link is not followed, a pipe is not waited
+    for (a FIFO or /dev/watchdog put in its place would hang or reboot the box), only a regular file of a trusted owner
+    counts, and anything else is an empty answer."""
+    fd = None
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_size > limit or info.st_uid not in trusted_owners():
+            return {}
+        with os.fdopen(fd, "rb") as stream:
+            fd = None
+            raw = stream.read(limit + 1)
+        if len(raw) > limit:
+            return {}
+        value = json.loads(raw)
+        return value if isinstance(value, dict) else {}
+    except (OSError, ValueError, TypeError, RecursionError):
+        return {}
+    finally:
+        if fd is not None:
+            os.close(fd)
+
+
+def settings(path=CONFIG):
+    data = read_json(path)
+    if set(data) != {"enabled", "open_on_start"} or any(
+        type(v) is not bool for v in data.values()
+    ):
+        return {"enabled": False, "open_on_start": False}
+    return data
+
+
+def heartbeat(hardware, path=HEARTBEAT):
+    """Only the display owner writes this bounded liveness record."""
+    try:
+        path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
+        fd, name = tempfile.mkstemp(prefix=".cmprovision-", dir=path.parent)
+        try:
+            with os.fdopen(fd, "w") as out:
+                json.dump(
+                    {"protocol": 1, "at": int(time.time()), "hardware": bool(hardware)},
+                    out,
+                )
+                os.fchmod(out.fileno(), 0o644)
+            os.replace(name, path)
+        finally:
+            if os.path.exists(name):
+                os.unlink(name)
+    except OSError:
+        pass  # An optional integration must not take the stock menu down.
+
+
+def text(value):
+    if not isinstance(value, (str, int, float)) or isinstance(value, bool):
+        return ""
+    return "".join(c if c.isprintable() else " " for c in str(value))[:512]
+
+
+def number(value, default=0):
+    if type(value) not in (int, float):
+        return default
+    try:
+        return value if math.isfinite(value) else default
+    except OverflowError:  # an integer beyond the range of a float
+        return default
+
+
+def rate(value):
+    if type(value) in (int, float):
+        return f"{number(value) / 1048576:.1f} MiB/s" if number(value) > 0 else ""
+    return text(value)
+
+
+def slow(value):
+    """SLOW +3:20: the run is that long past what the finished modules of its batch took (cmprovision 2.19.0)"""
+    seconds = int(number(value)) if type(value) in (int, float) else 0
+    return f"SLOW +{seconds // 60}:{seconds % 60:02d}" if seconds > 0 else ""
+
+
+def identity(row):
+    """What pins an open device card to one device: its serial, else its MAC, else its port and name (a silent device
+    on a port has neither a serial nor a MAC, and its name is the same "unknown device" as the next one's)"""
+    port = text(row.get("port"))
+    return text(row.get("serial") or row.get("mac") or ((port + " " if port else "") + text(row.get("name"))))
+
+
+def remaining(value):
+    if type(value) in (int, float):
+        seconds = max(0, int(number(value)))
+        return f"ETA {seconds // 60}:{seconds % 60:02d}"
+    return text(value)
+
+
+def objects(value, limit=256):
+    return (
+        [x for x in value[:limit] if isinstance(x, dict)]
+        if isinstance(value, list)
+        else []
+    )
+
+
+class Panel:
+    def __init__(self, config=CONFIG, snapshot=SNAPSHOT):
+        self.config, self.snapshot = Path(config), Path(snapshot)
+        self.page, self.index, self.detail, self.scroll = 0, 0, None, 0
+        self.data, self.problem, self.age = {}, "Waiting for data", None
+        self.enabled, self.last_read = False, -1e10
+        self.lock = threading.RLock()
+        self.font = ImageFont.load_default(size=10)
+        self.small = ImageFont.load_default(size=9)
+        self.large = ImageFont.load_default(size=18)
+
+    def refresh(self, now=None, force=False):
+        now = time.time() if now is None else now
+        with self.lock:
+            if not force and time.monotonic() - self.last_read < 2:
+                return
+            self.last_read = time.monotonic()
+            self.enabled = settings(self.config)["enabled"]
+            if not self.enabled:
+                self.data, self.problem, self.age = {}, "Integration off", None
+                self.detail = None
+                return
+            data = read_json(self.snapshot, LIMIT)
+            generated = data.get("generated_at")
+            if type(data.get("version")) is not int or data["version"] != 1:
+                self.problem = "Unsupported data" if data else "Waiting for data"
+                self.data, self.age, self.detail = {}, None, None
+                return
+            if number(generated, None) is None or generated > now:
+                self.data, self.problem, self.age, self.detail = (
+                    {},
+                    "Invalid timestamp",
+                    None,
+                    None,
+                )
+                return
+            self.data, self.age = data, int(now - generated)
+            self.problem = "Stale data" if self.age > 20 else ""
+
+    def rows(self):
+        if self.page == 1:
+            rows = []
+            for s_index, switch in enumerate(objects(self.data.get("switches"), 64)):
+                if switch.get("answering") is False:
+                    rows.append(
+                        {
+                            "name": text(switch.get("name")),
+                            "state": "No response",
+                            "serials": [],
+                        }
+                    )
+                for block in objects(switch.get("blocks"), 32):
+                    for port in objects(block.get("ports"), 256):
+                        rows.append(
+                            dict(
+                                port,
+                                name=text(switch.get("name"))
+                                + " "
+                                + text(port.get("name")),
+                                # two switches may have the same name: the place of the switch in the list tells them apart
+                                pin=f"{s_index}:{text(port.get('name'))}",
+                            )
+                        )
+            return rows[:512]
+        modules = objects(self.data.get("modules"))
+        if self.page == 3:
+            modules = [
+                m for m in modules if m.get("state") in ("fail", "stale", "unknown")
+            ]
+            modules += [
+                dict(m, state="unknown", name=text(m.get("name")) or text(m.get("mac")))
+                for m in objects(self.data.get("unknown"))
+            ]
+        return modules
+
+    def selected(self):
+        rows = self.rows()
+        self.index = min(self.index, max(0, len(rows) - 1))
+        return rows[self.index] if rows else None
+
+    def key(self, key):
+        """False means leave this integration. No operation writes to a device."""
+        with self.lock:
+            if key == "KEY3":
+                if self.detail is not None:
+                    self.detail, self.scroll = None, 0
+                else:
+                    return False
+            elif key == "KEY1":
+                self.page, self.index, self.detail = 0, 0, None
+            elif key == "KEY2":
+                self.page, self.index, self.detail = 1, 0, None
+            elif self.detail is not None:
+                if key in ("LEFT", "CENTER"):
+                    self.detail, self.scroll = None, 0
+                elif key in ("UP", "DOWN"):
+                    self.scroll = max(0, self.scroll + (1 if key == "DOWN" else -1))
+            elif key in ("LEFT", "RIGHT"):
+                self.page = (self.page + (1 if key == "RIGHT" else -1)) % len(PAGES)
+                self.index = 0
+            elif key in ("UP", "DOWN"):
+                self.index = (self.index + (1 if key == "DOWN" else -1)) % max(
+                    1, len(self.rows())
+                )
+            elif key == "CENTER" and self.page in (1, 2, 3):
+                row = self.selected()
+                if row:
+                    serials = (
+                        row.get("serials")
+                        if isinstance(row.get("serials"), list)
+                        else []
+                    )
+                    # Pin by identity: a port disappearing must not show another device's details.
+                    self.detail = (
+                        ("port", text(row.get("pin") or row.get("name")))
+                        if self.page == 1 and not serials
+                        else ("module", text(serials[0]) if serials else identity(row))
+                    )
+                    self.scroll = 0
+            return True
+
+    def detail_row(self):
+        kind, pinned = self.detail
+        if kind == "port":
+            return next(
+                (p for p in self.rows() if text(p.get("pin") or p.get("name")) == pinned),
+                None,
+            )
+        rows = objects(self.data.get("modules")) + objects(self.data.get("unknown"))
+        return next((m for m in rows if identity(m) == pinned), None)
+
+    def frame(self):
+        with self.lock:
+            image = Image.new("RGB", (128, 128), COLORS["bg"])
+            draw = ImageDraw.Draw(image)
+
+            def label(x, y, value, color="text", font=None, width=120):
+                font = font or self.font
+                value = text(value)
+                while value and draw.textlength(value, font=font) > width:
+                    value = value[:-1]
+                draw.text((x, y), value, font=font, fill=COLORS[color])
+
+            draw.rounded_rectangle((3, 3, 21, 19), radius=3, fill=COLORS["accent"])
+            draw.text((5, 5), "cm", font=self.small, fill=COLORS["bg"])
+            label(
+                27,
+                4,
+                "Device" if self.detail else PAGES[self.page],
+                font=self.small,
+                width=97,
+            )
+            draw.line((3, 23, 124, 23), fill=COLORS["line"])
+            if self.problem:
+                label(
+                    4,
+                    26,
+                    self.problem + (f" {self.age}s" if self.age is not None else ""),
+                    "warn",
+                    self.small,
+                )
+            else:
+                label(4, 26, f"Updated {self.age or 0}s ago", "muted", self.small)
+            if not self.data:
+                label(
+                    5,
+                    51,
+                    "Enable in Settings" if not self.enabled else "Check web UI",
+                    "accent",
+                )
+                label(5, 69, "FPMS display", "muted")
+            elif self.detail:
+                row = self.detail_row()
+                if row is None:
+                    label(5, 55, "Device left stand", "warn")
+                else:
+                    diag = (
+                        row.get("diagnostics")
+                        if isinstance(row.get("diagnostics"), dict)
+                        else {}
+                    )
+                    lines = [
+                        row.get("name"),
+                        row.get("port"),
+                        row.get("mac"),
+                        row.get("phase") or row.get("state"),
+                        slow(row.get("slow")),
+                        row.get("detail"),
+                        rate(row.get("speed")),
+                        remaining(row.get("eta")),
+                        diag.get("title"),
+                        row.get("advice"),
+                    ]
+                    for issue in objects(diag.get("issues"), 4):
+                        lines += [issue.get("title"), issue.get("advice")]
+                    wrapped = []
+                    for value in filter(None, map(text, lines)):
+                        part = ""
+                        for char in value:
+                            if draw.textlength(part + char, font=self.font) > 118:
+                                wrapped.append(part)
+                                part = ""
+                            part += char
+                        if part:
+                            wrapped.append(part)
+                    self.scroll = min(self.scroll, max(0, len(wrapped) - 5))
+                    for i, line in enumerate(wrapped[self.scroll : self.scroll + 5]):
+                        label(5, 40 + i * 13, line)
+                    pct = row.get("percent")
+                    if type(pct) in (int, float) and math.isfinite(pct):
+                        draw.rectangle((5, 108, 122, 111), fill=COLORS["line"])
+                        draw.rectangle(
+                            (5, 108, 5 + int(117 * max(0, min(100, pct)) / 100), 111),
+                            fill=COLORS["accent"],
+                        )
+            elif self.page == 0:
+                label(
+                    4,
+                    40,
+                    self.data.get("project") or "No active project",
+                    "accent",
+                    self.small,
+                )
+                counts = (
+                    self.data.get("counts")
+                    if isinstance(self.data.get("counts"), dict)
+                    else {}
+                )
+                for x, y, key, title, color in [
+                    (4, 55, "running", "RUN", "accent"),
+                    (66, 55, "done", "DONE", "good"),
+                    (4, 84, "failed", "FAIL", "bad"),
+                    (66, 84, "unknown", "OTHER", "warn"),
+                ]:
+                    draw.rectangle((x, y, x + 57, y + 26), fill=COLORS["panel"])
+                    value = max(0, int(number(counts.get(key))))
+                    if key == "unknown":
+                        value += max(0, int(number(counts.get("stale"))))
+                    label(x + 3, y + 1, str(min(999, value)), color, self.large, 32)
+                    label(x + 27, y + 16, title, "muted", self.small, 30)
+            elif self.page in (1, 2, 3):
+                rows = self.rows()
+                self.selected()
+                if not rows:
+                    label(
+                        5, 56, "No errors" if self.page == 3 else "No devices", "muted"
+                    )
+                for i, row in enumerate(
+                    rows[self.index // 4 * 4 : self.index // 4 * 4 + 4]
+                ):
+                    y = 40 + i * 18
+                    selected = self.index % 4 == i
+                    if selected:
+                        draw.rectangle((2, y - 1, 125, y + 16), fill=COLORS["panel"])
+                        draw.rectangle((2, y - 1, 3, y + 16), fill=COLORS["accent"])
+                    name = text(row.get("name")) or text(row.get("mac")) or "Unknown"
+                    label(7, y, name, "text", self.small, 116)
+                    color = (
+                        "bad"
+                        if row.get("state") in ("fail", "failed")
+                        else (
+                            "good" if row.get("state") in ("ok", "done") else "accent"
+                        )
+                    )
+                    label(
+                        7,
+                        y + 8,
+                        row.get("phase") or row.get("state"),
+                        color,
+                        self.small,
+                        116,
+                    )
+            else:
+                station = (
+                    self.data.get("station")
+                    if isinstance(self.data.get("station"), dict)
+                    else {}
+                )
+                lines = [
+                    self.data.get("host"),
+                    self.data.get("app_version"),
+                    station.get("management"),
+                    station.get("provisioning") or "No provisioning link",
+                    station.get("storage"),
+                ]
+                for i, value in enumerate(lines):
+                    label(
+                        5,
+                        42 + i * 14,
+                        value or "--",
+                        "text" if i == 0 else "muted",
+                        self.small,
+                    )
+            draw.line((3, 115, 124, 115), fill=COLORS["line"])
+            label(
+                4,
+                117,
+                "Up/down scroll   3 Back" if self.detail else "< > Page   OK Details",
+                "muted",
+                self.small,
+            )
+            return image
