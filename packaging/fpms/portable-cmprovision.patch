+@lru_cache(maxsize=40)
+def font(size, weight="regular"):
+    names = {
+        "regular": "nunito-v16-latin-regular.woff",
+        "bold": "nunito-v16-latin-700.woff",
+        "mono": "jetbrains-mono-700.woff2",
+    }
+    try:
+        return ImageFont.truetype(str(Path("/var/lib/cmprovision/public/fonts") / names[weight]), size)
+    except OSError:
+        return ImageFont.load_default(size=size)
