+    select = bounds("menu", ("system", 1))
+    confirm = bounds("confirm", ("key", "KEY1"))
+    interrupt = bounds("interrupt", ("key", "KEY1"))
+    assert separate(select, confirm) and separate(confirm, interrupt)
