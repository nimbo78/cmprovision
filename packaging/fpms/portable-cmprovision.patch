@@ -0,0 +1,66 @@
+#!/bin/sh
+# Build the portable subset only; none of the full WLAN Pi applications/dependencies.
+set -eu
+OUT=$(realpath -m "${1:?output directory required}")
+VERSION=${2:-0.1.0~cmprovision1}
+dpkg --validate-version "$VERSION"
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+DEST=$WORK/pkg
+mkdir -p "$DEST/DEBIAN" "$DEST/usr/lib/fpms-lite/fpms/integrations" "$DEST/usr/lib/fpms-lite/fpms/modules/screen" "$DEST/usr/lib/fpms-lite/fpms/fonts/cmprovision" "$DEST/usr/share/doc/fpms-lite/fonts" "$DEST/usr/share/fpms" "$DEST/usr/lib/systemd/system" "$OUT"
+for f in __init__.py lite.py modules/__init__.py modules/platform.py modules/gpiochip.py modules/screen/__init__.py modules/screen/screen.py modules/screen/st7735.py modules/screen/st7735_probe.py integrations/__init__.py integrations/cmprovision.py integrations/cmprovision_fonts.py integrations/cmprovision_new.py integrations/cmprovision_classic.py integrations/cmprovision_power.py integrations/cmprovision_rescue.py; do
+    install -m 644 "$ROOT/fpms/$f" "$DEST/usr/lib/fpms-lite/fpms/$f"
+done
+for f in modules/screen/hyperpixel.py integrations/cmprovision_touch.py integrations/cmprovision_touch_style.py integrations/cmprovision_touch_station.py integrations/display_marquee.py integrations/display_st7735_id.py integrations/display_details.py integrations/cmprovision_touch_details.py; do
+    install -m 644 "$ROOT/fpms/$f" "$DEST/usr/lib/fpms-lite/fpms/$f"
+done
+install -m 644 "$ROOT/LICENSE" "$DEST/usr/share/doc/fpms-lite/copyright"
+# the bitmap fonts of the panel, their licences in the documentation of the package
+install -m 644 "$ROOT"/fpms/fonts/cmprovision/*.bdf "$DEST/usr/lib/fpms-lite/fpms/fonts/cmprovision/"
+install -m 644 "$ROOT"/fpms/fonts/cmprovision/LICENSES/* "$DEST/usr/share/doc/fpms-lite/fonts/"
+install -m 644 "$ROOT/packaging/cmprovision.json" "$DEST/usr/share/fpms/cmprovision.json"
+install -m 644 "$ROOT/packaging/lite/fpms-lite.service" "$DEST/usr/lib/systemd/system/"
+cat > "$DEST/DEBIAN/control" <<EOF
+Package: fpms-lite
+Version: $VERSION
+Architecture: all
+Maintainer: cmprovision contributors
+Depends: init-system-helpers, python3 (>= 3.13), python3-pil (>= 10.1), python3-qrcode, python3-libgpiod (>= 2), python3-spidev, raspi-utils-core
+Conflicts: wlanpi-fpms
+Recommends: python3-kms++
+Description: Compact FPMS station panel for cmprovision
+ Portable subset of WLAN Pi FPMS for a dedicated provisioning station.
+ Supports the Waveshare 1.44 ST7735 and the rectangular HyperPixel 4.0 Touch.
+ No WLAN Pi applications or services are required.
+EOF
+cat > "$DEST/DEBIAN/postinst" <<'EOF'
+#!/bin/sh
+set -e
+if [ "$1" = configure ]; then
+    deb-systemd-helper enable fpms-lite.service >/dev/null
+    if [ -d /run/systemd/system ]; then
+        systemctl daemon-reload
+        deb-systemd-invoke restart fpms-lite.service >/dev/null || true
+    fi
+fi
+EOF
+cat > "$DEST/DEBIAN/prerm" <<'EOF'
+#!/bin/sh
+set -e
+if [ -d /run/systemd/system ]; then
+    deb-systemd-invoke stop fpms-lite.service >/dev/null || true
+fi
+EOF
+cat > "$DEST/DEBIAN/postrm" <<'EOF'
+#!/bin/sh
+set -e
+if [ "$1" = purge ]; then
+    deb-systemd-helper purge fpms-lite.service >/dev/null
+fi
+if [ -d /run/systemd/system ]; then
+    systemctl daemon-reload
+fi
+EOF
+chmod 755 "$DEST/DEBIAN/postinst" "$DEST/DEBIAN/prerm" "$DEST/DEBIAN/postrm"
+dpkg-deb --root-owner-group --build "$DEST" "$OUT/fpms-lite_${VERSION}_all.deb"
