+    cx, cy = centre_of_ink(panel.frame(), (5, 5, 19, 17), rgb("accent"))   # the tile is (3, 3)-(21, 19)
+    assert abs(cx - 12) <= 0.5 and abs(cy - 11) <= 0.5
+
