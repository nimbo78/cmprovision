+"""Network and service status on the 800 × 480 panel, from the shared station snapshot."""
+
+from .cmprovision import number, objects, text
+from .cmprovision_rescue import info as rescue_info
+from .cmprovision_touch_style import fit, font, wrap
+
+
+def signal(dbm):
+    # Same thresholds and lit arcs as the web uplink (WifiLink::quality and ::arcs).
+    if dbm is None:
+        return "Unmeasured", "muted", "signal-unknown"
+    if dbm >= -55:
+        return "Excellent", "good", "signal-3"
+    if dbm >= -67:
+        return "Good", "good", "signal-3"
+    if dbm >= -75:
+        return "Fair", "warn", "signal-2"
+    return "Weak", "bad", "signal-1" if dbm >= -82 else "signal-0"
+
+
+def speed(mbps):
+    value = number(mbps, None)
+    if value is None or value <= 0:
+        return "—"
+    return f"{value/1000:g} Gb/s" if value >= 1000 else f"{value:g} Mb/s"
+
+
+def uplink(st):
+    up = st.get("uplink")
+    up = up if isinstance(up, dict) else {}
+    state = up.get("state")
+    dev, addr = text(up.get("device")), text(up.get("address") or st.get("management"))
+    if state == "wifi":
+        dbm, rate = number(up.get("signal"), None), number(up.get("rate"), None)
+        quality = signal(dbm)
+        metrics = [
+            ("RSSI", f"{dbm:g} dBm".replace("-", "−") if dbm is not None else "—", quality[1]),
+            ("TX data rate", f"{rate:g} Mb/s" if rate is not None and rate >= 0 else "—", "fg"),
+        ]
+        return (
+            quality,
+            text(up.get("ssid")) or "Wi-Fi connected",
+            " · ".join(filter(None, (dev, text(up.get("band"))))),
+            addr,
+            metrics,
+        )
+    if state == "wired":
+        return (
+            ("Up", "good", "Ports"),
+            dev or "Ethernet",
+            "Ethernet",
+            addr,
+            [("Link speed", speed(up.get("speed")), "fg")],
+        )
+    if state in ("wifi_down", "none"):
+        return (
+            ("Offline", "warn", "down"),
+            dev or "No uplink",
+            "Wi-Fi" if state == "wifi_down" else "",
+            "",
+            [("Link state", "Disconnected", "muted")],
+        )
+    return (
+        ("Unknown", "muted", "Ports"),
+        dev or "No reading",
+        "",
+        addr,
+        [("Link state", "Unknown", "muted")],
+    )
+
+
+def stand_link(st):
+    link = next((r for r in objects(st.get("links")) if r.get("role") == "stand"), {})
+    name, up = text(link.get("name")), link.get("up")
+    if not link:
+        legacy = text(st.get("provisioning")).rsplit(" ", 1)
+        if len(legacy) == 2 and legacy[1] in ("up", "down"):
+            name, up = legacy[0], legacy[1] == "up"
+    badge = (
+        ("Up", "good", "Ports")
+        if up is True
+        else ("Down", "warn", "down") if up is False else ("Unknown", "muted", "Ports")
+    )
+    return (
+        badge,
+        name or "No interface",
+        "Ethernet" if name else "",
+        text(link.get("address")),
+        [("Link speed", speed(link.get("speed")) if up is True else "—", "fg")],
+    )
+
+
+def service_chips(st):
+    units = st.get("services")
+    if not isinstance(units, dict) or not isinstance(units.get("stopped"), list):
+        return [("Services unknown", "muted", "services")]
+    stopped = [text(n) for n in units["stopped"][:64] if text(n)]
+    disabled = units.get("disabled")
+    disabled = [text(n) for n in disabled[:64] if text(n)] if isinstance(disabled, list) else []
+    up = number(units.get("up"), None)
+    result = [(name + " stopped", "bad", "Errors") for name in stopped]
+    if not stopped and (up or not disabled):
+        label = (
+            "Services unknown" if up is None else f"{int(up)} service" + ("" if up == 1 else "s") + " up"
+        )
+        result.append((label, "good" if up else "muted", "check" if up else "services"))
+    result.extend((name + " disabled", "muted", "pause") for name in disabled)
+    return result
+
+
+def network_card(menu, box, title, fields):
+    status, name, context, address, metrics = fields
+    x, y, right, bottom = box
+    menu.card(box)
+    left, edge = x + 16, right - 16
+    badge_x = edge - menu.pill_width(status[0], status[2])
+    menu.label(left, y + 17, title, 16, "muted", badge_x - left - 6, "bold")
+    menu.pill(badge_x, y + 12, *status)
+    # The network identity and the address stay together when service warnings wrap below.
+    net_y = y + (bottom - y - 48) // 2 - 9
+    name = fit(name, font(27, "bold"), edge - left)
+    menu.label(left, net_y, name, 27, width=edge - left, weight="bold")
+    after = left + round(font(27, "bold").getlength(name)) + 10
+    if context and after + 22 < edge:
+        menu.label(after, net_y + 9, context, 15, "muted", edge - after)
+    menu.label(left, net_y + 32, address or "No IP address", 17, width=edge - left, weight="mono")
+    menu.draw.line((left, bottom - 58, edge, bottom - 58), fill=menu.c["line"])
+    mx = left
+    for i, (label, value, ink) in enumerate(metrics):
+        menu.label(mx, bottom - 49, label, 14, "muted", edge - mx, "bold")
+        menu.label(mx, bottom - 28, value, 18, ink, edge - mx, "mono")
+        if i + 1 < len(metrics):
+            mx += max(110, round(font(18, "mono").getlength(value)) + 30)
+            menu.draw.line((mx - 10, bottom - 46, mx - 10, bottom - 12), fill=menu.c["line"])
+
