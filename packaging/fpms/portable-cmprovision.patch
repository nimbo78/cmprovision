+"""The hardware backend must work without the full WLAN Pi application."""
+
+import subprocess
+import sys
+from pathlib import Path
+
+
+def test_st7735_import_does_not_load_application_state():
+    # Fresh interpreter: application test fixtures must not mask an import of
+    # constants.py (it reads WLAN Pi files and changes the current directory).
+    result = subprocess.run(
+        [sys.executable, "-c", """
+import importlib.abc
+import os
+import sys
+import types
+
+class NoApplication(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname in {'fpms.modules.constants', 'fpms.modules.env_utils', 'qrcode'}:
+            raise AssertionError('application dependency: ' + fullname)
+
+sys.meta_path.insert(0, NoApplication())
+gpio = types.ModuleType('gpiod')
+gpio.__path__ = []
+line = types.ModuleType('gpiod.line')
+line.Direction = line.Value = object
+sys.modules['gpiod'] = gpio
+sys.modules['gpiod.line'] = line
+sys.modules['spidev'] = types.ModuleType('spidev')
+before = os.getcwd()
+from fpms.modules.screen.st7735 import ST7735
+assert os.getcwd() == before
+ST7735()  # Does not open devices until init() is explicitly called.
+"""],
+        capture_output=True,
+        text=True,
+        cwd=Path(__file__).resolve().parents[1],
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
diff --git a/tests/test_st7735_probe.py b/tests/test_st7735_probe.py
new file mode 100755
index 0000000..69fae52
--- /dev/null
+++ b/tests/test_st7735_probe.py
@@ -0,0 +1,308 @@
+"""Identify the fitted controller, not the existence of an SPI device."""
+import ctypes
+import importlib
+import struct
+import sys
+from enum import Enum
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+REPLIES = {0xDA: bytes.fromhex('7c'), 0xDB: bytes.fromhex('89'),
+           0xDC: bytes.fromhex('f0'), 0x04: bytes.fromhex('3e44f800'),
+           0x0C: bytes.fromhex('06')}
+
+
+def module():
+    return importlib.import_module('fpms.modules.screen.st7735_probe')
+
+
+def reader(replies):
+    return lambda command, count: replies[command]
+
+
+def test_identifies_real_cold_and_initialized_captured_replies():
+    p = module()
+    assert p.identify(reader(REPLIES)) == '7c89f0'
+    assert p.identify(reader(REPLIES | {0x0C: b'\x05'})) == '7c89f0'
+
+
+def test_accepts_documented_nv_id_variation_instead_of_one_specimen_only():
+    replies = REPLIES | {0xDB: b'\x90', 0xDC: b'\xa1', 0x04: bytes.fromhex('3e485080')}
+    assert module().identify(reader(replies)) == '7c90a1'
+
+
+@pytest.mark.parametrize('replies', [
+    {k: b'\x00' * len(v) for k,v in REPLIES.items()},
+    {k: b'\xff' * len(v) for k,v in REPLIES.items()},
+    REPLIES | {0xDA: b'\x12'},
+    REPLIES | {0xDB: b'\x01'},
+    REPLIES | {0x04: bytes.fromhex('7c89f000')},  # missing dummy-clock decoding
+    REPLIES | {0x04: bytes.fromhex('3e44f880')},  # combined and separate IDs disagree
+    REPLIES | {0x0C: b'\xff'},
+    REPLIES | {0xDA: b''},
+    REPLIES | {0x04: b'\x3e'},
+    REPLIES | {0xDA: None},
+])
+def test_unrecognized_floating_or_malformed_reply_cannot_identify_a_panel(replies):
+    assert module().identify(reader(replies)) is None
+
+
+def test_a_single_plausible_sample_does_not_accept_an_unstable_wire():
+    seen = 0
+    def read(command, count):
+        nonlocal seen
+        if command == 0xDA:
+            seen += 1
+            if seen == 2: return b'\x00'
+        return REPLIES[command]
+    assert module().identify(read) is None
+
+
+class Direction(Enum):
+    AS_IS = 1
+    INPUT = 2
+    OUTPUT = 3
+
+class Bias(Enum):
+    AS_IS = 1
+    UNKNOWN = 2
+    DISABLED = 3
+    PULL_UP = 4
+    PULL_DOWN = 5
+
+class Drive(Enum):
+    PUSH_PULL = 1
+    OPEN_DRAIN = 2
+    OPEN_SOURCE = 3
+
+class Value(Enum):
+    INACTIVE = 0
+    ACTIVE = 1
+
+
+def wire_env(monkeypatch, tmp_path, *, busy=False, fail_read=False, fail_mode=False, output=False, level=Value.ACTIVE, active_low=False, bias=Bias.PULL_DOWN, drive=Drive.PUSH_PULL, pinctrl_reply=None, fail_pinctrl=False):
+    p = module()
+    device = tmp_path/'spidev0.0'; device.touch()
+    monkeypatch.setattr(p, 'SPI_DEVICE', device)
+    monkeypatch.setattr(p, 'DPI_STATUS', tmp_path/'dpi-status')
+    state = SimpleNamespace(mode=0, opened=False, closed=False, requested=False, released=False,
+                            configs=[], reads=0, pinctrl_reads=0)
+    class Chip:
+        def __init__(self, path): pass
+        def __enter__(self): return self
+        def __exit__(self, *args): pass
+        def get_line_info(self, pin):
+            return SimpleNamespace(used=busy, bias=bias, direction=Direction.OUTPUT if output else Direction.INPUT,
+                                   drive=drive, active_low=active_low)
+    class Lines:
+        def __enter__(self): return self
+        def __exit__(self, *args): state.released=True
+        def reconfigure_lines(self, config): state.configs.append(config)
+        def get_values(self, pins): return [level for _ in pins]
+    def request_lines(path, *, consumer, config):
+        state.requested=True; state.configs.append(config)
+        return Lines()
+    gpio = SimpleNamespace(Chip=Chip, request_lines=request_lines,
+                           LineSettings=lambda **kw: SimpleNamespace(**kw))
+    monkeypatch.setitem(sys.modules, 'gpiod', gpio)
+    monkeypatch.setitem(sys.modules, 'gpiod.line', SimpleNamespace(Direction=Direction, Bias=Bias, Value=Value, Drive=Drive))
+    monkeypatch.setitem(sys.modules, 'fpms.modules.gpiochip', SimpleNamespace(get_gpiochip=lambda: '/fake/gpiochip'))
+    def open_device(path, flags):
+        assert path == device
+        state.opened=True
+        return 101
+    def close_device(fd):
+        assert fd==101
+        state.closed=True
+    def ioctl(fd, request, value, *args):
+        assert fd==101
+        if request==0x80046b05:
+            value[0]=state.mode
+        elif request==0x40046b05:
+            requested=int(value[0])
+            if fail_mode and requested==0x10: raise OSError('3-wire not supported')
+            state.mode=requested
+        elif request==0x40406b00:
+            if fail_read: raise OSError('transfer failed')
+            assert state.mode==0x10, 'read must release MOSI using SPI_3WIRE'
+            data=bytes(value)
+            assert len(data)==64
+            tx=struct.unpack('=QQIIHBBBBBB',data[:32])
+            rx=struct.unpack('=QQIIHBBBBBB',data[32:])
+            assert tx[0] and not tx[1] and tx[2]==1 and tx[3]==100000 and tx[5]==8 and tx[6]==0
+            assert not rx[0] and rx[1] and rx[3]==100000 and rx[5]==8 and rx[6]==0
+            command=ctypes.string_at(tx[0],1)[0]
+            reply=REPLIES[command]
+            assert rx[2]==len(reply)
+            ctypes.memmove(rx[1], reply, len(reply))
+            state.reads+=1
+        else:
+            raise AssertionError('unexpected SPI ioctl '+hex(request))
+        return 0
+    def pinctrl(args, **kwargs):
+        assert args==['/usr/bin/pinctrl','get','25,27']
+        state.pinctrl_reads+=1
+        if fail_pinctrl: raise OSError('pinctrl unavailable')
+        direction='op' if output else 'ip'
+        reply=pinctrl_reply if pinctrl_reply is not None else ''.join(
+            f'{pin}: {direction} -- pd | lo // GPIO{pin}\n' for pin in [25,27])
+        return SimpleNamespace(stdout=reply)
+    monkeypatch.setattr(p, 'subprocess', SimpleNamespace(run=pinctrl, SubprocessError=__import__('subprocess').SubprocessError), raising=False)
+    monkeypatch.setattr(p.os, 'open', open_device)
+    monkeypatch.setattr(p.os, 'close', close_device)
+    monkeypatch.setattr(p.fcntl, 'ioctl', ioctl)
+    monkeypatch.setattr(p.time, 'sleep', lambda *_: None)
+    return p,state
+
+
+def test_probe_returns_real_identity_and_restores_bus_and_gpio(monkeypatch, tmp_path):
+    p,s=wire_env(monkeypatch,tmp_path)
+    assert p.probe_st7735()=={'profile':'waveshare-1.44','id':'7c89f0'}
+    assert s.reads==10 and s.mode==0 and s.closed and s.released
+    initial=s.configs[0]
+    assert all(c.direction is Direction.AS_IS for c in initial.values())
+    assert all(not hasattr(c, 'output_value') for c in initial.values())
+    first=s.configs[1]
+    assert set(first)=={25,27}, 'backlight and buttons must remain untouched during identification'
+    assert first[27].direction is Direction.INPUT and first[27].bias is Bias.PULL_UP
+    assert not hasattr(first[27],'output_value'), 'RESET must not be actively driven HIGH on unknown hardware'
+    assert s.configs[-1][27].bias is Bias.PULL_DOWN
+    assert s.configs[-1][25].direction is Direction.INPUT
+
+
+@pytest.mark.parametrize('level', [Value.INACTIVE, Value.ACTIVE])
+@pytest.mark.parametrize('fail_read', [False, True])
+def test_probe_restores_unrequested_outputs_including_level_drive_and_polarity(monkeypatch,tmp_path,level,fail_read):
+    p,s=wire_env(monkeypatch,tmp_path,output=True,level=level,active_low=True,fail_read=fail_read)
+    result=p.probe_st7735()
+    assert (result is None) == fail_read
+    assert s.requested and s.released and s.mode==0 and s.closed
+    initial=s.configs[0]
+    assert all(c.direction is Direction.AS_IS and c.active_low for c in initial.values())
+    assert all(not hasattr(c,'output_value') for c in initial.values())
+    restored=s.configs[-1]
+    assert all(c.direction is Direction.OUTPUT and c.active_low and c.output_value is level
+               and c.bias is Bias.PULL_DOWN for c in restored.values())
+    assert restored[25].drive is Drive.PUSH_PULL
+    assert restored[27].drive is Drive.PUSH_PULL
+
+
+@pytest.mark.parametrize('drive', [Drive.OPEN_DRAIN, Drive.OPEN_SOURCE])
+def test_probe_declines_outputs_whose_latched_level_cannot_be_read(monkeypatch,tmp_path,drive):
+    p,s=wire_env(monkeypatch,tmp_path,output=True,drive=drive)
+    assert p.probe_st7735() is None
+    assert not s.opened and not s.requested
+
+
+@pytest.mark.parametrize('output',[False,True])
+def test_kernel_unknown_bias_is_read_without_altering_it_and_restored(monkeypatch,tmp_path,output):
+    p,s=wire_env(monkeypatch,tmp_path,bias=Bias.UNKNOWN,output=output)
+    assert p.probe_st7735()=={'profile':'waveshare-1.44','id':'7c89f0'}
+    assert s.pinctrl_reads==1 and s.mode==0 and s.released
+    assert all(c.bias is Bias.PULL_DOWN for c in s.configs[-1].values())
+    assert all(c.direction is (Direction.OUTPUT if output else Direction.INPUT)
+               for c in s.configs[-1].values())
+
+
+@pytest.mark.parametrize('reply',[
+    '',
+    '25: ip pd | lo',  # missing second line
+    '25: ip pd | lo\n27: a0 -- pu | hi',  # alternate function is not a free GPIO
+    '25: op -- pd | lo\n27: op -- pd | hi',  # direction changed since line-info snapshot
+    '25: ip ?? | lo\n27: ip pd | lo',
+])
+def test_unreadable_or_changed_bias_is_not_probed(monkeypatch,tmp_path,reply):
+    p,s=wire_env(monkeypatch,tmp_path,bias=Bias.UNKNOWN,pinctrl_reply=reply)
+    assert p.probe_st7735() is None
+    assert not s.opened and not s.requested
+
+
+def test_missing_pinctrl_does_not_guess_bias(monkeypatch,tmp_path):
+    p,s=wire_env(monkeypatch,tmp_path,bias=Bias.UNKNOWN,fail_pinctrl=True)
+    assert p.probe_st7735() is None
+    assert not s.opened and not s.requested
+
+
+@pytest.mark.parametrize('case',['busy','read','mode'])
+def test_probe_failure_releases_resources_without_initializing_controls(monkeypatch,tmp_path,case):
+    p,s=wire_env(monkeypatch,tmp_path,busy=case=='busy',fail_read=case=='read',fail_mode=case=='mode')
+    assert p.probe_st7735() is None
+    assert s.mode==0 and (not s.opened or s.closed)
+    assert not s.requested or s.released
+    if case=='busy': assert not s.requested
+
+
+def test_no_spi_device_never_touches_gpio_or_opens_a_bus(monkeypatch,tmp_path):
+    p,s=wire_env(monkeypatch,tmp_path)
+    p.SPI_DEVICE.unlink()
+    assert p.probe_st7735() is None
+    assert not s.opened and not s.requested
+
+
+def test_active_dpi_configuration_is_left_alone(monkeypatch,tmp_path):
+    p,s=wire_env(monkeypatch,tmp_path)
+    p.DPI_STATUS.write_bytes(b'okay\0')
+    assert p.probe_st7735() is None
+    assert not s.opened and not s.requested
+
+
+class Clock:
+    def __init__(self): self.now=0.
+    def __call__(self): return self.now
+    def sleep(self,seconds): self.now+=seconds
+
+
+def test_detection_wait_keeps_heartbeat_fresh_and_retries_without_spinning(monkeypatch):
+    from fpms import lite
+    clock=Clock(); calls=[]; beats=[]
+    def detect():
+        calls.append(clock.now)
+        return {'profile':'waveshare-1.44','id':'7c89f0'} if clock.now>=30 else None
+    monkeypatch.setattr(lite,'probe_st7735',detect,raising=False)
+    monkeypatch.setattr(lite.Path,'exists',lambda *_:True)
+    monkeypatch.setattr(lite.time,'monotonic',clock)
+    monkeypatch.setattr(lite.time,'sleep',clock.sleep)
+    monkeypatch.setattr(lite,'heartbeat',lambda value,**kw:beats.append((clock.now,value)))
+    assert lite.wait_for_display(lambda:False,until=40)=={'profile':'waveshare-1.44','id':'7c89f0'}
+    assert calls==[0.,30.]
+    assert len(beats)>=10 and all(not v for _,v in beats)
+    assert max(b[0]-a[0] for a,b in zip(beats,beats[1:]))<=3
+
+
+def test_a_stopped_wait_returns_without_display_or_button_initialization(monkeypatch):
+    from fpms import lite
+    clock=Clock()
+    monkeypatch.setattr(lite,'probe_st7735',lambda:None,raising=False)
+    monkeypatch.setattr(lite.Path,'exists',lambda *_:True)
+    monkeypatch.setattr(lite.time,'monotonic',clock)
+    monkeypatch.setattr(lite.time,'sleep',clock.sleep)
+    monkeypatch.setattr(lite,'heartbeat',lambda *a,**k:None)
+    assert lite.wait_for_display(lambda:clock.now>=3,until=50) is None
+    assert clock.now==3
+
+
+def test_lite_does_not_import_hardware_driver_if_no_panel_was_identified(tmp_path,monkeypatch):
+    from fpms import lite
+    clock=Clock()
+    monkeypatch.setattr(lite,'probe_st7735',lambda:None,raising=False)
+    monkeypatch.setattr(lite.Path,'exists',lambda *_:True)
+    monkeypatch.setattr(lite.time,'monotonic',clock)
+    monkeypatch.setattr(lite.time,'sleep',clock.sleep)
+    monkeypatch.setattr(lite.signal,'signal',lambda *a:None)
+    monkeypatch.setattr(lite,'heartbeat',lambda *a,**k:None)
+    monkeypatch.setattr(sys,'argv',['fpms','--seconds','3'])
+    monkeypatch.setitem(sys.modules,'gpiod',None)
+    monkeypatch.setitem(sys.modules,'fpms.modules.screen.st7735',None)
+    lite.main()
+
+
+def test_heartbeat_adds_identity_only_when_it_belongs_to_live_hardware(tmp_path):
+    from fpms.integrations.cmprovision import heartbeat
+    import json
+    path=tmp_path/'beat.json'; display={'profile':'waveshare-1.44','id':'7c89f0'}
+    heartbeat(True,path,display=display)
+    assert json.loads(path.read_text())['display']==display
+    heartbeat(False,path,display=display)
+    assert 'display' not in json.loads(path.read_text())
