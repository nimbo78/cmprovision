index 0000000..bf9a52e
--- /dev/null
+++ b/tools/preview-cmprovision.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Render the actual 128px panel, every page and a device card, in each look (new with either Ports map, classic).
+
+    tools/preview-cmprovision.py OUTPUT [--snapshot FILE]
+
+Without --snapshot the data is clearly labelled illustrative DEMO data; with it, the snapshot a station writes
+(/run/cmprovision-wallboard-data/snapshot.json) is drawn as it is, only its look is set for each sheet.
+Writes OUTPUT/<look>/<n>.png and OUTPUT/<look>/preview.png for new-pages, new-whole and classic.
+"""
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from PIL import Image, ImageDraw, ImageFont
+
+from fpms.integrations.cmprovision import PAGES, Panel
+
+LOOKS = {"new-pages": ("new", "pages"), "new-whole": ("new", "whole"), "classic": ("classic", "pages")}
+
+
+def demo():
+    return {
+        "version": 1,
+        "generated_at": int(time.time()),
+        "host": "demo-station",
+        "app_version": "cmprovision / DEMO",
+        "project": "DEMO - batch 78",
+        "batch": {"title": "1 failed", "open": True, "counts": {"active": 1, "done": 4, "failed": 1}, "left_seconds": 120},
+        "counts": {"running": 1, "done": 4, "failed": 1, "stale": 0, "unknown": 0},
+        "station": {
+            "management": "192.0.2.4",
+            "provisioning": "eth0.42 up",
+            "storage": "21 GiB free",
+            "storage_low": False,
+            "uplink": {"state": "wifi", "device": "wlan0", "address": "192.0.2.4", "ssid": "DEMO", "signal": -58,
+                       "quality": "Good", "bars": 3, "band": "5 GHz", "generation": "6", "rate": 600, "speed": None,
+                       "spare_active": False},
+            "links": [{"name": "eth0.42", "kind": "other", "role": "stand", "up": True, "speed": None, "address": "172.20.0.1"}],
+            "services": {"up": 6, "total": 6, "stopped": []},
+        },
+        "unknown": [],
+        "modules": [
+            {"serial": "demo-1", "mac": "02:00:00:00:00:01", "name": "demo-sensor-1", "port": "sw Gi0/2", "state": "run",
+             "phase": "write", "step": "Writing image", "percent": 42, "speed": 30 * 1048576, "eta": 120},
+            {"serial": "demo-2", "mac": "02:00:00:00:00:02", "name": "demo-sensor-2", "port": "sw Gi0/3", "state": "fail",
+             "phase": "failed", "step": "Writing image", "percent": 63, "cause": "eMMC I/O error",
+             "reason": "The storage device reported an I/O error (failing eMMC/SD card or power problem).",
+             "advice": "Check power and retry diagnostics.", "code": "exit 1"},
+        ],
+        "switches": [{"name": "sw", "answering": True, "blocks": [{"rows": 2, "ports": [
+            {"name": "Gi0/1", "number": 1, "state": "uplink", "filter": "uplink", "serials": [], "server": True},
+            {"name": "Gi0/2", "number": 2, "state": "module", "filter": "run", "serials": ["demo-1"], "server": False},
+            {"name": "Gi0/3", "number": 3, "state": "module", "filter": "fail", "serials": ["demo-2"], "server": False},
+            {"name": "Gi0/4", "number": 4, "state": "free", "filter": "free", "serials": [], "server": False},
+        ]}]}],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--snapshot", type=Path, help="a snapshot of a station instead of the DEMO data")
+    args = parser.parse_args()
+    data = json.loads(args.snapshot.read_text()) if args.snapshot else demo()
+    label = "a station's snapshot" if args.snapshot else "illustrative DEMO data"
+    font = ImageFont.load_default(size=17)
+    for look, (theme, ports_map) in LOOKS.items():
+        out = args.output / look
+        out.mkdir(parents=True, exist_ok=True)
+        config, snapshot = out / "config.json", out / "snapshot.json"
+        config.write_text(json.dumps({"enabled": True, "open_on_start": True}))
+        snapshot.write_text(json.dumps(dict(data, panel={"theme": theme, "ports_map": ports_map})))
+        panel = Panel(config, snapshot)
+        panel.refresh(now=data.get("generated_at"), force=True)
+        sheet = Image.new("RGB", (6 * 400 + 16, 470), "#202024")
+        draw = ImageDraw.Draw(sheet)
+        for i, title in enumerate((*PAGES, "Device details")):
+            panel.detail, panel.scroll = None, 0
+            if i < 5:
+                panel.page, panel.index = i, 0
+            else:
+                panel.page, panel.index = 3, 0
+                panel.key("CENTER")
+                if panel.detail is None:
+                    panel.page = 2
+                    panel.key("CENTER")
+            frame = panel.frame()
+            frame.save(out / f"{i + 1}.png")
+            sheet.paste(frame.resize((384, 384), Image.Resampling.NEAREST), (16 + i * 400, 40))
+            draw.text((16 + i * 400, 10), title, font=font, fill="white")
+        draw.text((16, 441), f"FPMS 128 x 128 - actual renderer, {look} look, {label}", font=font, fill="#ff8a3d")
+        sheet.save(out / "preview.png")
+
+
+if __name__ == "__main__":
+    main()
