+++ b/tests/test_cmprovision_rescue_wifi.py
@@ -0,0 +1,106 @@
+import copy
+from PIL import ImageDraw
+import pytest
+from fpms.integrations import cmprovision_fonts as fonts
+from test_cmprovision_v2 import demo_snapshot, panel_with
+
+
+@pytest.mark.parametrize('theme', ['classic', 'new'])
+@pytest.mark.parametrize('mode', ['light', 'dark'])
+def test_station_exposes_rescue_ssid_ip_and_clients_without_password(tmp_path, monkeypatch, theme, mode):
+    data = demo_snapshot()
+    data['panel'].update(theme=theme, color_mode=mode)
+    data['rescue_wifi'] = dict(enabled=True, active=True, state='active', ssid='ap-d62', address='192.168.240.1',
+                               clients=2, password='must-not-be-drawn')
+    p = panel_with(tmp_path, data)
+    p.page = 4
+    classic = []
+    original = ImageDraw.ImageDraw.text
+    def record(self, xy, text, *args, **kwargs):
+        classic.append(str(text))
+        return original(self, xy, text, *args, **kwargs)
+    monkeypatch.setattr(ImageDraw.ImageDraw, 'text', record)
+    fonts.start_recording()
+    image = p.frame()
+    ink, _ = fonts.stop_recording()
+    said = ' '.join(classic + [box[4] for box in ink])
+    assert 'AP active' in said
+    assert 'ap-d62' in said
+    assert '192.168.240.1' in said
+    assert '2 clients' in said
+    assert 'must-not-be-drawn' not in said
+    assert image.size == (128, 128)
+    assert all(0 <= box[0] and box[2] <= 128 and 0 <= box[1] and box[3] <= 128 for box in ink)
+
+
+@pytest.mark.parametrize('theme', ['classic', 'new'])
+def test_rescue_countdown_is_ten_minutes_and_missing_old_field_is_supported(tmp_path, monkeypatch, theme):
+    data = demo_snapshot()
+    data['panel']['theme'] = theme
+    data['rescue_wifi'] = dict(enabled=True, active=False, state='waiting', remaining=600)
+    p = panel_with(tmp_path, data)
+    p.page = 4
+    classic = []
+    original = ImageDraw.ImageDraw.text
+    def record(self, xy, text, *args, **kwargs):
+        classic.append(str(text)); return original(self, xy, text, *args, **kwargs)
+    monkeypatch.setattr(ImageDraw.ImageDraw, 'text', record)
+    fonts.start_recording(); p.frame(); ink, _ = fonts.stop_recording()
+    said = ' '.join(classic + [box[4] for box in ink])
+    assert 'AP waiting' in said and '10:00' in said
+    del p.data['rescue_wifi']
+    assert p.frame().size == (128, 128)
+
+
+@pytest.mark.parametrize('theme', ['classic', 'new'])
+@pytest.mark.parametrize('mode', ['light', 'dark'])
+def test_long_ssid_wraps_without_hiding_address_or_clients(tmp_path, monkeypatch, theme, mode):
+    data = demo_snapshot()
+    data['panel'].update(theme=theme, color_mode=mode)
