+            line((12, 20), (12, 21))
+        else:
+            d.ellipse((10.7 * scale, 17.7 * scale, 13.3 * scale, 20.3 * scale), fill=255)
+    return mask.resize((size, size), Image.Resampling.LANCZOS)
+
+
+def fit(value, face, width):
+    value = text(value)
+    if face.getlength(value) <= width:
+        return value
+    lo, hi = 0, len(value)
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if face.getlength(value[:mid] + "…") <= width:
+            lo = mid
+        else:
+            hi = mid - 1
+    return value[:lo] + "…"
+
+
+def wrap(value, face, width):
+    # Preserve long unbroken values (for example generated Wi-Fi passwords).
+    lines, line = [], ""
+    for word in text(value).split(" "):
+        candidate = (line + " " + word).strip()
+        if face.getlength(candidate) <= width:
+            line = candidate
+            continue
+        if line:
+            lines.append(line)
+        line = ""
+        for char in word:
+            if line and face.getlength(line + char) > width:
+                lines.append(line)
+                line = ""
+            line += char
+    if line:
+        lines.append(line)
+    return lines
