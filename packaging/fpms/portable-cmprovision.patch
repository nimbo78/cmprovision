+def old_snapshot(theme=None):
+    """What a cmprovision before the second look sends: no panel, short cause, step, reason or code, no batch ETA,
+    no links, uplink, services or low storage, no silent_since."""
+    snap = demo_snapshot()
+    del snap["panel"]
+    if theme:
+        snap["panel"] = {"theme": theme}
+    del snap["batch"]["left_seconds"]
+    for m in snap["modules"]:
+        for key in ("cause", "reason", "code", "step"):
+            m.pop(key, None)
+    for key in ("links", "uplink", "services", "storage_low"):
+        snap["station"].pop(key)
