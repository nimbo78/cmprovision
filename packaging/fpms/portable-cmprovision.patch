+
+def test_left_and_right_only_turn_the_pages_and_button_2_closes_a_card_then_asks_to_leave(panel):
+    assert panel.key("LEFT") is True and panel.page == len(cmprovision.PAGES) - 1  # round the end
+    assert panel.key("RIGHT") is True and panel.page == 0
+    panel.key("RIGHT")
+    panel.key("CENTER")
+    assert panel.detail is not None
+    assert panel.key("KEY2") is True and panel.detail is None  # the first press closes the card
+    assert panel.key("KEY2") is True  # the second asks
+    assert panel.key("KEY2") is False  # the third leaves
+
+
+def test_the_frame_goes_into_the_image_of_the_stock_menu_and_does_not_replace_it(panel):
+    from PIL import Image
+
+    shared = Image.new("RGB", (128, 128))
+    state = {"display_state": "menu", "button_press_count": 0, "option_selected": None, "current_menu_location": [0], "image": shared}
+    drawn = []
+    adapter = CmprovisionMenu(state, [], drawn.append, hardware=False, panel=panel)
+    adapter.show()
+    assert state["image"] is shared, "the stock pages draw with an ImageDraw bound to this object"
+    assert drawn == [shared]
+    assert shared.getbbox() is not None and shared.tobytes() == panel.frame().tobytes()
+
+
+def test_leaving_redraws_the_stock_menu(panel):
+    state = {"display_state": "menu", "button_press_count": 0, "option_selected": None, "current_menu_location": [0]}
+    redraws = []
+    adapter = CmprovisionMenu(state, [], lambda image: None, hardware=False, panel=panel, redraw=lambda: redraws.append(1))
+    adapter.tick(publish=False)
+    adapter.show()
+    assert adapter.key("KEY2") is True and adapter.key("KEY2") is True
+    assert state["display_state"] == "menu" and redraws == [1]
+    # a stock drawing that fails must not stop the menu
+    broken = CmprovisionMenu(state, [], lambda image: None, hardware=False, panel=panel, redraw=lambda: 1 / 0)
+    broken.leave()
+
+
+def map_snapshot(count=20, rows=2):
+    """one switch of $count ports in a block, and a second that does not answer"""
+    ports = []
+    states = [("ok", "module", ["m1"]), ("run", "module", ["m2"]), ("fail", "module", ["m3"]), ("free", "free", []), ("stale", "module", ["m4"]), ("uplink", "uplink", [])]
+    for i in range(count):
+        filt, state, serials = states[i % len(states)]
+        ports.append({"name": f"Gi0/{i + 1}", "number": i + 1, "state": state, "filter": filt, "serials": serials, "server": False})
+    return {
+        "panel": {"theme": "classic"},
+        "switches": [{"name": "sw-one", "answering": True, "blocks": [{"rows": rows, "ports": ports}]},
+                     {"name": "sw-two", "answering": False, "blocks": []}],
+        "modules": [{"serial": "m1", "name": "wlanpi-one", "phase": "done", "state": "ok", "percent": 100},
+                    {"serial": "m2", "name": "wlanpi-two", "phase": "write", "state": "run", "percent": 42}],
+    }
+
+
+def test_the_ports_page_is_a_map_of_cubes_filled_by_state(panel):
+    panel.data.update(map_snapshot())
+    panel.page, panel.index = 1, 0
+    name, bank, banks, answering, cells = classic.map_cells(panel)
+    assert (name, bank, answering) == ("sw-one", 0, True) and banks == 2
+    image = panel.frame()
+    colors = {index: image.getpixel((x + 1, y + 1)) for x, y, index in cells}
+    rgb = lambda key: tuple(int(cmprovision.COLORS[key][i : i + 2], 16) for i in (1, 3, 5))
+    assert colors[0] == rgb("good") and colors[1] == rgb("info") and colors[2] == rgb("bad")
+    assert colors[3] == rgb("bg") and colors[4] == rgb("warn")   # a free port is hollow: the inside is the background
+
+
+def test_a_free_port_is_an_outline_and_the_cursor_marks_the_selected_one(panel):
+    panel.data.update(map_snapshot())
+    panel.page, panel.index = 1, 3
+    x, y, _ = next(c for c in classic.map_cells(panel)[4] if c[2] == 3)
+    image = panel.frame()
+    assert image.getpixel((x + 2, y + 2)) == (0, 0, 0)
+    assert image.getpixel((x - 1, y - 1)) != (0, 0, 0)   # the cursor goes round the cube
+
+
+def test_the_map_turns_to_the_bank_of_the_selected_port_and_goes_on_through_the_ports(panel):
+    panel.data.update(map_snapshot(count=20))   # ten columns: two banks of eight
+    panel.page, panel.index = 1, 0
+    assert classic.map_cells(panel)[1:3] == (0, 2)
+    for _ in range(17):
+        panel.key("DOWN")
+    name, bank, banks, answering, cells = classic.map_cells(panel)
+    assert (bank, banks) == (1, 2) and panel.index == 17
+    assert all(index >= 16 for _, _, index in cells)   # the ports 17 to 20 are on the second screen
+    assert panel.frame().size == (128, 128)
+
+
+def test_a_switch_that_does_not_answer_is_said_so_on_the_map(panel):
+    panel.data.update(map_snapshot(count=4))
+    panel.page, panel.index = 1, 4   # the row of the second switch
+    assert classic.map_cells(panel)[0] == "sw-two" and classic.map_cells(panel)[3] is False
+    assert panel.frame().size == (128, 128)
+
+
+def test_uplinks_sit_on_the_lower_row_and_blocks_are_told_apart(panel):
+    data = map_snapshot(count=4)
+    data["switches"][0]["blocks"] = [
+        {"rows": 2, "ports": [{"name": "Gi0/1", "number": 1, "state": "free", "filter": "free", "serials": []}, {"name": "Gi0/2", "number": 2, "state": "free", "filter": "free", "serials": []}]},
+        {"rows": 1, "ports": [{"name": "Gi0/9", "number": 9, "state": "uplink", "filter": "uplink", "serials": []}]},
+    ]
+    panel.data.update(data)
+    panel.page, panel.index = 1, 0
+    cells = {index: (x, y) for x, y, index in classic.map_cells(panel)[4]}
+    assert cells[0][1] < cells[1][1] and cells[0][0] == cells[1][0]   # 1 above 2
+    assert cells[2][1] == cells[1][1]                                 # the uplink on the lower row
+    assert cells[2][0] - cells[1][0] == cmprovision.CUBE + cmprovision.GAP + cmprovision.BLOCK_GAP
+
+
+def test_the_card_has_a_scroll_bar_only_when_there_is_more_and_the_bar_of_progress_has_the_colour_of_the_state(panel):
+    rgb = lambda key: tuple(int(cmprovision.COLORS[key][i : i + 2], 16) for i in (1, 3, 5))
+    panel.page = 2
+    panel.index = 0
+    panel.key("CENTER")
+    row = panel.detail_row()
+    row.update(percent=100, detail="x " * 80)
+    image = panel.frame()
+    assert image.getpixel((125, 45)) != (0, 0, 0)       # the bar of the scroll is on the right
+    assert image.getpixel((60, 109)) == rgb("bad")      # this module failed: its bar is red, whatever the percent
+    panel.data["modules"][0].update(detail="short", percent=100)
+    assert panel.frame().getpixel((125, 45)) == (0, 0, 0)  # nothing more below: no bar
+
+
+def centre_of_ink(image, box, background):
+    """The middle of the pixels of box that are clearly not the background colour."""
+    x0, y0, x1, y1 = box
+    points = [
+        (x, y)
+        for x in range(x0, x1 + 1)
+        for y in range(y0, y1 + 1)
+        if sum(abs(a - b) for a, b in zip(image.getpixel((x, y)), background)) > 150
+    ]
+    xs, ys = [p[0] for p in points], [p[1] for p in points]
+    return (min(xs) + max(xs)) / 2, (min(ys) + max(ys)) / 2
+
+
+def test_the_cm_of_the_header_tile_sits_in_the_middle_of_it(panel):
+    rgb = lambda key: tuple(int(cmprovision.COLORS[key][i : i + 2], 16) for i in (1, 3, 5))
+    cx, cy = centre_of_ink(panel.frame(), (5, 5, 19, 17), rgb("accent"))   # the tile is (3, 3)-(21, 19)
+    assert abs(cx - 12) <= 0.5 and abs(cy - 11) <= 0.5
+
+
+def test_the_cm_of_the_provisioners_cube_sits_in_the_middle_of_it(panel):
+    rgb = lambda key: tuple(int(cmprovision.COLORS[key][i : i + 2], 16) for i in (1, 3, 5))
+    data = map_snapshot(count=4)
+    data["switches"][0]["blocks"][0]["ports"][0]["server"] = True
+    panel.data.update(data)
+    panel.page, panel.index = 1, 1
+    x, y, _ = next(c for c in classic.map_cells(panel)[4] if c[2] == 0)
+    cx, cy = centre_of_ink(panel.frame(), (x, y, x + cmprovision.CUBE - 1, y + cmprovision.CUBE - 1), rgb("accent"))
+    assert abs(cx - (x + (cmprovision.CUBE - 1) / 2)) <= 0.5 and abs(cy - (y + (cmprovision.CUBE - 1) / 2)) <= 0.5
