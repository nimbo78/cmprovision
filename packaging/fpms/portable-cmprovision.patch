+    def port_devices(self, port):
+        serials = port.get("serials") or []
+        if serials:
+            assigned = {d.get("serial"): d for d in self.modules() if d.get("serial") in serials}
+            return [assigned[s] for s in serials if s in assigned]
+        others = objects(self.panel.data.get("recognized")) + objects(self.panel.data.get("unknown"))
+        return [d for d in others if (port.get("port_id") == d["port_id"] if d.get("port_id")
+                else port.get("name") == d.get("port") and self.observed_port(d))]
