+def health(menu):
+    p = menu.panel
+    st = p.data.get("station")
+    st = st if isinstance(st, dict) else {}
+    rows = [
+        ("Free space", text(st.get("storage")) or "No reading", "warn" if st.get("storage_low") else "fg")
+    ]
+    for name, color, _ in service_chips(st):
+        rows.append(("Services", name, color))
+    up, stand = uplink(st), stand_link(st)
+    rows.append(("Uplink", " · ".join(filter(None, (up[1], up[2], up[3]))), "fg"))
+    rows.append(("Stand link", " · ".join((stand[1], stand[0][0], stand[4][0][1])), "fg"))
+    for link in objects(st.get("links")):
+        if link.get("role") in ("backup", "other"):
+            rows.append(
+                (
+                    text(link.get("name")),
+                    text(link.get("ssid") or link.get("address"))
+                    or (
+                        "Up" if link.get("up") is True else "Down" if link.get("up") is False else "Unknown"
+                    ),
+                    "muted",
+                )
+            )
+    for sw in objects(p.data.get("switches"), 64):
+        ok = sw.get("answering") is not False
+        rows.append(
+            (
+                "Switch",
+                text(sw.get("name")) + (" · Answering" if ok else " · No response"),
+                "good" if ok else "bad",
+            )
+        )
+    rescue = rescue_info(p.data)
+    if rescue:
+        rows.append(
+            (
+                "Rescue Wi-Fi",
+                " · ".join(
+                    filter(
+                        None,
+                        (
+                            rescue["summary"],
+                            rescue["ssid"],
+                            rescue["address"],
+                            rescue["clients"] if rescue["active"] else "",
+                        ),
+                    )
+                ),
+                "accent" if rescue["active"] else "muted",
+            )
+        )
+    lines = [
+        (name if i == 0 else "", line, color)
+        for name, value, color in rows
+        for i, line in enumerate(wrap(value, font(16, "bold"), 545))
+    ]
+    menu.label(20, 76, "Station health", 30, weight="bold")
+    menu.header_pager(len(lines), 6, 780, 69)
+    menu.card((18, 126, 781, 397))
+    for i, (name, value, color) in enumerate(lines[menu.offset : menu.offset + 6]):
+        y = 127 + i * 45
+        if i:
+            menu.draw.line((32, y, 767, y), fill=menu.c["line"])
+        menu.label(34, y + 14, name, 16, "muted", 144)
+        menu.label(190, y + 14, value, 16, color, 570, "bold")
