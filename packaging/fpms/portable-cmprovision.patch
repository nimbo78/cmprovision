@@ -0,0 +1,215 @@
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from fpms.integrations import cmprovision_rescue as r
+from test_cmprovision_v2 import Clock, demo_snapshot, panel_with
+
+
+def active_data():
+    data = demo_snapshot()
+    data['rescue_wifi'] = dict(enabled=True, active=True, state='active', ssid='Rescue;lab',
+                               address='192.168.240.1', clients=0)
+    return data
+
+
+@pytest.mark.parametrize('theme', ['classic', 'new'])
+@pytest.mark.parametrize('mode', ['light', 'dark', 'auto'])
+def test_ok_on_active_station_opens_qr_then_credentials_for_one_minute(tmp_path, theme, mode):
+    clock, calls = Clock(), []
+    data = active_data()
+    data['panel'].update(theme=theme, color_mode=mode)
+    def client():
+        calls.append(True)
+        return dict(ssid='Rescue;lab', password='pass:word;123', matrix=[[False]*29 for _ in range(29)])
+    p = panel_with(tmp_path, data, clock=clock, rescue_client=client)
+    p.page = 4
+    p.key('CENTER')
+    assert calls == [True] and p.rescue_menu.open
+    assert p.rescue_menu.stage == 'qr'
+    assert p.frame().size == (128, 128)
+    p.key('CENTER')
+    assert p.rescue_menu.stage == 'text'
+    assert p.frame().size == (128, 128)
+    assert 'pass:word;123' not in json.dumps(p.data)
+    clock.now += 60
+    p.frame()
+    assert not p.rescue_menu.open and p.rescue_menu.credentials is None
+    assert calls == [True]
+
+
+@pytest.mark.parametrize('change', [dict(active=False), dict(state='unavailable')])
+def test_inactive_or_stale_ap_never_requests_password(tmp_path, change):
+    data = active_data()
+    data['rescue_wifi'].update(change)
+    calls = []
+    p = panel_with(tmp_path, data, rescue_client=lambda: calls.append(True))
+    p.page = 4
+    p.key('CENTER')
+    assert calls == [] and not p.rescue_menu.open
+
+
+def test_back_clears_credentials_and_power_key_keeps_existing_menu(tmp_path):
+    p = panel_with(tmp_path, active_data(), rescue_client=lambda: dict(
+        ssid='Rescue;lab', password='pass:word;123', matrix=[[False]*29 for _ in range(29)]))
+    p.page = 4
+    p.key('CENTER'); p.key('KEY2')
+    assert not p.rescue_menu.open and p.rescue_menu.credentials is None
+    assert p.page == 4
+
+
+def test_back_publishes_only_close_time_for_automatic_hdmi_qr(tmp_path, monkeypatch):
+    marker = tmp_path/'closed.json'
+    monkeypatch.setattr(r, 'CLOSED', marker)
+    monkeypatch.setattr(r.time, 'monotonic', lambda:123)
+    p = panel_with(tmp_path, active_data(), rescue_client=lambda: dict(
+        ssid='Rescue;lab', password='pass:word;123', matrix=[[False]*29 for _ in range(29)]))
+    p.page = 4; p.key('CENTER'); p.key('KEY2')
+    assert json.loads(marker.read_text()) == dict(closed_at=123)
+
+
+@pytest.mark.parametrize('with_power', [False, True])
+def test_back_dismisses_automatic_hdmi_card_without_opening_manual_card(tmp_path, monkeypatch, with_power):
+    marker = tmp_path/'closed.json'
+    monkeypatch.setattr(r, 'CLOSED', marker)
+    monkeypatch.setattr(r.time, 'monotonic', lambda:123)
+    calls = []
+    p = panel_with(tmp_path, active_data(), can_leave=False, rescue_client=lambda: calls.append(True),
+                   power_client=(lambda payload: None) if with_power else None)
+    p.page = 4
+    if with_power: p.key('KEY3')
+    p.key('KEY2')
+    assert json.loads(marker.read_text()) == dict(closed_at=123)
+    assert not p.rescue_menu.open and calls == [] and p.page == (4 if with_power else 0)
+
+
+def test_wifi_payload_escapes_delimiters_without_changing_password():
+    assert r.wifi_payload('Lab;:known,\\"', 'a:b;c,d\\e"123') == (
+        'WIFI:T:WPA;S:Lab\\;\\:known\\,\\\\\\";P:a\\:b\\;c\\,d\\\\e\\"123;;')
+
+
+def test_largest_supported_credentials_keep_integer_two_pixel_qr_and_quiet_zone():
+    matrix = r.qr_matrix(';'*32, ':'*63)
+    assert len(matrix) <= 64
+    assert all(len(row) == len(matrix) for row in matrix)
+    assert all(not cell for row in matrix[:4] + matrix[-4:] for cell in row)
+    assert all(not cell for row in matrix for cell in row[:4] + row[-4:])
+
+
+def test_request_uses_running_credentials_and_private_hdmi_lease(tmp_path, monkeypatch):
+    # Model the installed root-owned status/runtime directory on an unprivileged CI runner.
+    real_fstat, real_lstat, chowns = r.os.fstat, Path.lstat, []
+    def root_stat(info):
+        return SimpleNamespace(st_mode=info.st_mode, st_uid=0, st_size=info.st_size)
+    monkeypatch.setattr(r.os, 'fstat', lambda fd: root_stat(real_fstat(fd)))
+    monkeypatch.setattr(Path, 'lstat', lambda path: root_stat(real_lstat(path)))
+    monkeypatch.setattr(r.os, 'fchown', lambda fd, uid, gid: chowns.append((uid, gid)))
+    status, lease = tmp_path/'status.json', tmp_path/'lease.json'
+    status.write_text(json.dumps(dict(active=True, state='recovery', checked_at=100, ssid='Running')))
+    status.chmod(0o644)
+    monkeypatch.setattr(r, 'STATUS', status)
+    monkeypatch.setattr(r, 'LEASE', lease)
+    monkeypatch.setattr(r.time, 'time', lambda: 101)
+    monkeypatch.setattr(r.time, 'monotonic', lambda: 20)
+    monkeypatch.setattr(r.grp, 'getgrnam', lambda name: SimpleNamespace(gr_gid=0))
+    monkeypatch.setattr(r.subprocess, 'run', lambda *a, **k: SimpleNamespace(returncode=0, stdout=json.dumps(
+        dict(ssid='Staged', password='staged-secret', active=dict(ssid='Running', password='actual-secret')))))
+    value = r.request()
+    assert value['ssid'] == 'Running' and value['password'] == 'actual-secret'
+    saved = json.loads(lease.read_text())
+    assert saved['expires_at'] == 80 and saved['created_at'] == 20
+    assert lease.stat().st_mode & 0o777 == 0o640
+    assert chowns == [(0, 0)]
+    assert 'staged-secret' not in lease.read_text()
+    status.write_text(json.dumps(dict(active=False, state='standby', checked_at=101)))
+    with pytest.raises(Exception):
+        r.request()
+
+
+def test_secret_helper_failure_is_generic_on_screen(tmp_path):
+    def fail():
+        raise RuntimeError('never-print-this-secret')
+    p = panel_with(tmp_path, active_data(), rescue_client=fail)
+    p.page = 4; p.key('CENTER')
+    assert p.rescue_menu.stage == 'error'
+    assert p.rescue_menu.credentials is None
+    assert 'never-print' not in repr(p.rescue_menu.__dict__)
+    assert p.frame().size == (128, 128)
+
+
+def test_ap_change_closes_the_access_card(tmp_path):
+    p = panel_with(tmp_path, active_data(), rescue_client=lambda: dict(
+        ssid='Rescue;lab', password='pass:word;123', matrix=[[False]*29 for _ in range(29)]))
+    p.page = 4; p.key('CENTER')
+    p.data['rescue_wifi']['ssid'] = 'Another AP'
+    p.frame()
+    assert not p.rescue_menu.open and p.rescue_menu.credentials is None
+
+
+def test_lite_expires_secrets_even_when_lcd_is_sleeping(tmp_path, monkeypatch):
+    import sys
+    from fpms import lite
+    clock = Clock(now=0)
+    lease = tmp_path/'lease.json'
+    lease.write_text('test-secret')
+    monkeypatch.setattr(r, 'LEASE', lease)
+    p = panel_with(tmp_path, active_data(), clock=clock, rescue_client=lambda: dict(
+        ssid='Rescue;lab', password='pass:word;123', matrix=[[False]*29 for _ in range(29)]))
+    p.page = 4; p.key('CENTER')
+    p.refresh = lambda **kw: None
+    monkeypatch.setattr(lite, 'Panel', lambda *a, **kw: p)
+    monkeypatch.setattr(lite, 'heartbeat', lambda *a, **kw: None)
+    monkeypatch.setattr(lite, 'probe_st7735', lambda: dict(profile='waveshare-1.44', id='7c89f0'))
+    monkeypatch.setattr(lite.time, 'monotonic', clock)
+    monkeypatch.setattr(lite.signal, 'signal', lambda *a: None)
+    monkeypatch.setattr(lite.Path, 'exists', lambda path: True)
+    monkeypatch.setattr(sys, 'argv', ['fpms', '--sleep', '1', '--seconds', '70'])
+    observations = []
+    class Buttons:
+        def __enter__(self): return self
+        def __exit__(self, *a): pass
+        def wait_edge_events(self, timeout):
+            clock.now += 1
+            if clock.now > 61:
+                observations.append(True)
+                assert p.rescue_menu.credentials is None and not lease.is_file()
+            return False
+    class Screen:
+        def init(self): pass
+        def drawImage(self, image): pass
+        def sleep(self): pass
+    monkeypatch.setitem(sys.modules, 'gpiod', SimpleNamespace(request_lines=lambda *a, **kw: Buttons(), LineSettings=lambda **kw: None))
+    monkeypatch.setitem(sys.modules, 'gpiod.line', SimpleNamespace(Bias=SimpleNamespace(PULL_UP=1), Edge=SimpleNamespace(FALLING=1)))
+    monkeypatch.setitem(sys.modules, 'fpms.modules.gpiochip', SimpleNamespace(get_gpiochip=lambda: 'fake'))
+    monkeypatch.setitem(sys.modules, 'fpms.modules.screen.st7735', SimpleNamespace(ST7735=Screen))
+    lite.main()
+    assert observations
+
+
+def test_unsupported_ssid_text_explicitly_points_to_exact_qr(tmp_path):
+    from fpms.integrations import cmprovision_fonts as fonts
+    card = r.AccessCard(None, Clock())
+    card.stage, card.deadline = 'text', 1060
+    card.credentials = dict(ssid='\u30c6\u30b9\u30c8', password='example-pass-123')
+    fonts.start_recording()
+    r.render(card, dict(bg='black', fg='white', accent='orange', muted='grey'))
+    ink, _ = fonts.stop_recording()
+    assert 'Scan QR for SSID' in [box[4] for box in ink]
+
+
+@pytest.mark.parametrize('ssid,password', [('cmprovision-wlanpi-d62-rescue', 'Demo-only-123456'), (';'*32, ':'*63)])
+def test_rendered_128_pixel_qr_decodes_to_exact_wifi_payload(tmp_path, ssid, password):
+    import shutil
+    import subprocess
+    if not shutil.which('zbarimg'):
+        pytest.skip('Optional independent QR decoder')
+    card = r.AccessCard(None, Clock())
+    card.stage = 'qr'
+    card.credentials = dict(ssid=ssid, password=password, matrix=r.qr_matrix(ssid, password))
+    image = r.render(card, {})
+    path = tmp_path/'qr.png'
+    image.save(path)
+    result = subprocess.run(['zbarimg', '--quiet', '--raw', str(path)], capture_output=True, check=True)
+    assert result.stdout.decode('utf-8').rstrip('\n') == r.wifi_payload(ssid, password)
diff --git a/tests/test_cmprovision_rescue_wifi.py b/tests/test_cmprovision_rescue_wifi.py
