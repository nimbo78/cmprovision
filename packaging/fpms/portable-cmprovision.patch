@@ -0,0 +1,93 @@
+"""The bitmap fonts of the cmprovision panel: their metrics match the mockups, wrapping keeps codes whole and loses
+nothing, and the checks every screen goes through (touching texts, text off centre) find what they should."""
+
+from PIL import Image
+
+from fpms.integrations import cmprovision_fonts as fonts
+
+
+def test_metrics_match_the_mockups():
+    expect = {"title": (12, 16), "body": (9, 12), "big": (19, 25), "code": (9, 13), "tiny": (6, 8)}
+    for role, (asc, h) in expect.items():
+        f = fonts.font(role)
+        assert (f.asc, f.h) == (asc, h), role
+    big = fonts.font("big")
+    assert big.asc - big.ink_top("0123456789") == 18
+    assert big.width("12") == 26
+
+
+def test_silkscreen_fits_23_letters():
+    error = fonts.font("error")
+    line = "The connection to the provisioning server"
+    assert error.width(line[:23]) <= 124 < error.width(line[:24])
+
+
+def test_wrap_keeps_the_code_together():
+    error = fonts.font("error")
+    assert fonts.wrap(error, "Download cut (curl 18)", 115) == ["Download cut", "(curl 18)"]
+
+
+def test_wrap_never_drops_a_character():
+    body = fonts.font("body")
+    text = "a-very-long-hostname-that-does-not-fit-on-one-line and then some words wlanpi-c18"
+    lines = fonts.wrap(body, text, 60)
+    assert all(body.width(line) <= 60 for line in lines)
+    assert "".join(lines).replace(" ", "") == text.replace(" ", "")
+
+
+def test_fit_marks_the_cut():
+    body = fonts.font("body")
+    assert fonts.fit(body, "short", 100) == "short"
+    cut = fonts.fit(body, "a name far too long for the width given here", 60)
+    assert cut.endswith("...") and body.width(cut) <= 60
+
+
+def test_draw_centered_gives_equal_margins():
+    body = fonts.font("body")
+    x0, y0, x1, y1 = fonts.ink_bbox(body, "2")
+    box = (10, 10, 10 + (x1 - x0 + 1) + 8 - 1, 10 + (y1 - y0 + 1) + 4 - 1)
+    img = Image.new("RGB", (64, 64))
+    fonts.start_recording()
+    fonts.draw_centered(body, img, box, "2", (255, 255, 255))
+    ink, centred = fonts.stop_recording()
+    (b, i, s), = centred
+    assert (i[0] - b[0], b[2] - i[2], i[1] - b[1], b[3] - i[3]) == (4, 4, 2, 2)
+    assert fonts.off_centre(centred) == []
+
+
+def test_overlap_check_finds_touching_texts():
+    body = fonts.font("body")
+    img = Image.new("RGB", (128, 128))
+    fonts.start_recording()
+    body.draw(img, 2, 2, "Gi0/3", (255, 255, 255))
+    right = 2 + fonts.ink_bbox(body, "Gi0/3")[2]
+    body.draw(img, right + 1 - fonts.ink_bbox(body, "FAILED")[0], 2, "FAILED", (255, 255, 255))  # no empty column between
+    ink, _ = fonts.stop_recording()
+    assert len(fonts.overlaps(ink)) == 1
+
+    fonts.start_recording()
+    body.draw(img, 2, 2, "Gi0/3", (255, 255, 255))
+    body.draw(img, 2, 2 + body.h, "FAILED", (255, 255, 255))  # the next line: a blank row between
+    ink, _ = fonts.stop_recording()
+    assert fonts.overlaps(ink) == []
+
+
+def test_text_off_the_screen_is_found():
+    body = fonts.font("body")
+    img = Image.new("RGB", (128, 128))
+    fonts.start_recording()
+    body.draw(img, 100, 120, "FAILED", (255, 255, 255))
+    ink, _ = fonts.stop_recording()
+    assert any(p.startswith("off screen") for p in fonts.overlaps(ink))
+
+
+def test_hidden_text_is_not_checked():
+    body = fonts.font("body")
+    img = Image.new("RGB", (128, 128))
+    fonts.start_recording()
+    body.draw(img, 2, 100, "RUNNING", (255, 255, 255))
+    body.draw(img, 2, 100, "Press 2", (0, 0, 0))
+    fonts.hide_below(98)       # a plate from y 98 covered the first; the second was drawn on it
+    body.draw(img, 2, 100, "Press 2", (0, 0, 0))
+    ink, _ = fonts.stop_recording()
+    assert fonts.overlaps(ink) == []
diff --git a/tests/test_cmprovision_power.py b/tests/test_cmprovision_power.py
new file mode 100644
index 0000000..b458119
--- /dev/null
+++ b/tests/test_cmprovision_power.py
@@ -0,0 +1,163 @@
+"""Power controls use live authorization, never the display snapshot."""
+import copy
+from unittest.mock import Mock
+
+import pytest
+
+from fpms.integrations.cmprovision import Panel
+from fpms.integrations import cmprovision_fonts as fonts
+from fpms.integrations.cmprovision_power import request
+
+
+class Client:
+    def __init__(self):
+        self.calls = []
+        self.active = 0
+        self.warning = False
+        self.fail = False
+
+    def __call__(self, payload):
+        self.calls.append(copy.deepcopy(payload))
+        if self.fail:
+            raise RuntimeError("private backend error")
+        if payload["operation"] == "prepare":
+            self.warning = False
+            self.action = payload["action"]
+            return dict(stage="confirm", action=self.action, token="a" * 64, active_count=self.active)
+        if payload["operation"] == "cancel":
+            return {}
+        if self.active and (not self.warning or not payload["interrupt"]):
+            self.warning = True
+            return dict(stage="interrupt", action=self.action, token="a" * 64, active_count=self.active)
+        return dict(stage="scheduled", action=self.action, delay=5)
+
+
+def panel(tmp_path, client=None, clock=lambda: 0):
+    p = Panel(tmp_path / "config", tmp_path / "snapshot", can_leave=False,
+              clock=clock, power_client=client)
+    p.data = {"panel": {"theme": "new", "color_mode": "dark"}}
+    return p
+
+
+def select(p, action="reboot"):
+    p.key("KEY3")
+    p.key("DOWN")
+    if action == "poweroff":
+        p.key("DOWN")
+    p.key("CENTER")
+
+
+@pytest.mark.parametrize("action", ["reboot", "poweroff"])
+def test_open_select_and_center_never_execute(tmp_path, action):
+    c = Client()
+    p = panel(tmp_path, c)
+    select(p, action)
+    p.key("CENTER")
+    assert c.calls == [{"operation": "prepare", "action": action}]
+    p.key("KEY1")
+    assert p.power_menu.stage == "scheduled"
+    assert c.calls[-1] == dict(operation="confirm", token="a" * 64, interrupt=False)
+    p.key("KEY1")
+    assert len(c.calls) == 2
+
+
+def test_default_cancel_and_read_only_integration(tmp_path):
+    c = Client()
+    p = panel(tmp_path, c)
+    p.key("KEY3")
+    p.key("CENTER")
+    assert not p.power_menu.open and not c.calls
+    # Stock WLAN Pi integration and preview do not acquire a power callback.
+    readonly = Panel(tmp_path / "config", tmp_path / "snapshot")
+    readonly.key("KEY3")
+    assert readonly.power_menu is None
+
+
+def test_live_active_warning_requires_another_key1(tmp_path):
+    c = Client()
+    p = panel(tmp_path, c)
+    select(p)
+    c.active = 4  # the display snapshot can be stale; only the response is used
+    p.key("KEY1")
+    assert p.power_menu.stage == "interrupt" and p.power_menu.active_count == 4
+    p.key("CENTER")
+    assert len(c.calls) == 2
+    p.key("KEY1")
+    assert c.calls[-1]["interrupt"] is True
+    assert p.power_menu.stage == "scheduled"
+
+
+def test_changed_warning_is_not_treated_as_scheduled(tmp_path):
+    c = Client()
+    c.active = 1
+    p = panel(tmp_path, c)
+    select(p)
+    p.key("KEY1")
+    c.warning = False
+    c.active = 2
+    p.key("KEY1")
+    assert p.power_menu.stage == "interrupt" and p.power_menu.active_count == 2
+
+
+def test_cancel_and_expiry_do_not_confirm(tmp_path):
+    c = Client()
+    now = [0]
+    p = panel(tmp_path, c, lambda: now[0])
+    select(p)
+    p.key("KEY2")
+    assert not p.power_menu.open and c.calls[-1]["operation"] == "cancel"
+    select(p)
+    now[0] = 121
+    p.key("KEY1")
+    assert p.power_menu.stage == "expired"
+    assert not any(r["operation"] == "confirm" for r in c.calls)
+
+
+@pytest.mark.parametrize("bad", [None, {}, {"stage": "scheduled"},
+    {"stage": "confirm", "token": "a" * 64, "action": "poweroff", "active_count": 0}])
+def test_bad_backend_reply_cannot_authorize_confirmation(tmp_path, bad):
+    c = Mock(return_value=bad)
+    p = panel(tmp_path, c)
+    select(p)
+    p.key("KEY1")
+    assert p.power_menu.stage == "error" and c.call_count == 1
+
+
+def test_backend_error_is_safe_and_key2_exits(tmp_path):
+    c = Client()
+    c.fail = True
+    p = panel(tmp_path, c)
+    select(p)
+    assert p.power_menu.stage == "error"
+    assert "private" not in p.power_menu.message
+    p.key("KEY2")
+    assert not p.power_menu.open
+
+
+def test_client_uses_only_fixed_bridge_and_bounded_json(monkeypatch):
+    run = Mock(return_value=Mock(returncode=0, stdout='{"ok":true,"result":{}}'))
+    monkeypatch.setattr("fpms.integrations.cmprovision_power.subprocess.run", run)
+    assert request({"operation": "cancel", "token": "a" * 64}) == {}
+    args, kwargs = run.call_args
+    assert args == (["/usr/lib/cmprovision/station-power-panel"],)
+    assert kwargs["timeout"] == 15 and not kwargs.get("shell", False)
+    assert '"operation": "cancel"' in kwargs["input"]
+
+
+@pytest.mark.parametrize("theme", ["new", "classic"])
+@pytest.mark.parametrize("mode", ["light", "dark", "auto"])
+@pytest.mark.parametrize("stage", ["menu", "confirm", "interrupt", "scheduled", "error", "expired"])
+def test_power_frames_fit_in_both_layouts_and_all_modes(tmp_path, theme, mode, stage):
+    p = panel(tmp_path, Client())
+    p.data = {"panel": {"theme": theme, "color_mode": mode}, "display_auto_mode": "light"}
+    p.key("KEY3")
+    p.power_menu.stage = stage
+    p.power_menu.action = "poweroff"
+    p.power_menu.active_count = 48
+    p.power_menu.deadline = 999
+    fonts.start_recording()
+    img = p.frame()
+    ink, centred = fonts.stop_recording()
+    assert img.size == (128, 128)
+    assert not fonts.overlaps(ink)
+    assert not fonts.off_centre(centred)
diff --git a/tests/test_cmprovision_rescue_wifi.py b/tests/test_cmprovision_rescue_wifi.py
