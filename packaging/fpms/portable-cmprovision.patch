+++ b/fpms/modules/gpiochip.py
@@ -0,0 +1,23 @@
+"""Find the Raspberry Pi header without importing WLAN Pi application state."""
+
+import glob
+import os
+
+from fpms.modules.platform import HEADER_GPIOCHIP_LABELS
+
+
+def get_gpiochip(dev_dir="/dev"):
+    fallback = os.path.join(dev_dir, "gpiochip0")
+    try:
+        import gpiod
+    except ImportError:
+        return fallback
+
+    for path in sorted(glob.glob(os.path.join(dev_dir, "gpiochip*"))):
+        try:
+            with gpiod.Chip(path) as chip:
+                if chip.get_info().label in HEADER_GPIOCHIP_LABELS:
+                    return path
+        except OSError:
+            continue
+    return fallback
