+def show(menu):
+    panel = menu.panel
+    st = panel.data.get("station")
+    menu.label(19, 76, "Station", 30, width=330, weight="bold")
+    if not isinstance(st, dict):
+        menu.label(24, 165, "Waiting for station data", 22, "muted")
+        return
+    packed = [[]]
+    x = 33
+    chips = service_chips(st)
+    for i, (caption, ink, symbol) in enumerate(chips):
+        caption = fit(caption, font(14, "bold"), 385)
+        width = menu.pill_width(caption, symbol)
+        if x + width > 767:
+            if len(packed) == 2:
+                remaining = len(chips) - i
+                while packed[-1] and x + menu.pill_width(f"+{remaining} more") > 767:
+                    x = packed[-1].pop()[0]
+                    remaining += 1
+                packed[-1].append((x, f"+{remaining} more", "muted", None))
+                break
+            packed.append([])
+            x = 33
+        packed[-1].append((x, caption, ink, symbol))
+        x += width + 6
+    top = 331 - 28 * (len(packed) - 1)
+    network_card(menu, (18, 116, 464, top - 11), "Management uplink", uplink(st))
+    network_card(menu, (475, 116, 781, top - 11), "Stand link", stand_link(st))
+    menu.card((18, top, 781, 407))
+    menu.label(33, top + 14, "Station health", 18, width=190, weight="bold")
+    menu.mark(757, top + 12, "next", 16)
+    rescue = rescue_info(panel.data)
+    available = panel.rescue_available()
+    right = 744
+    if rescue:
+        label = rescue["summary"]
+        if label == "AP ready":
+            label = "AP standby"
+        if available:
+            label += " · QR"
+        key = "accent" if available else "muted" if label == "AP standby" else "warn"
+        start = right - menu.pill_width(label, "wifi")
+        menu.pill(start, top + 9, label, key, "wifi")
+        if available:
+            menu.targets.append(((start - 3, top, 746, top + 44), ("rescue", None)))
+        right = start - 7
+    disk = text(st.get("storage"))
+    low = bool(st.get("storage_low") and disk)
+    disk = ("Disk low · " if low else "") + disk if disk else "Disk unknown"
+    disk = fit(disk, font(14, "bold"), max(40, right - 220))
+    menu.pill(right - menu.pill_width(disk, "disk"), top + 9, disk, "warn" if low else "muted", "disk")
+    for j, row in enumerate(packed):
+        for x, caption, ink, symbol in row:
+            menu.pill(x, top + 43 + j * 28, caption, ink, symbol)
+    # The dedicated QR control above wins only inside its own hit area.
+    menu.targets.append(((18, top, 781, 407), ("health", None)))
