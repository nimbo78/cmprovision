diff --git a/fpms/integrations/cmprovision.py b/fpms/integrations/cmprovision.py
new file mode 100644
index 0000000..1fc12f4
--- /dev/null
+++ b/fpms/integrations/cmprovision.py
@@ -0,0 +1,435 @@
+"""Read-only cmprovision front panel, shared by Lite and the WLAN Pi menu.
+
+No WLAN Pi state, subprocesses, database access or device control. Pillow is
+the only non-stdlib dependency; drivers belong to the process hosting us.
+"""
+
+import json
+import math
+import os
+import pwd
+import stat
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+CONFIG = Path("/etc/default/cmprovision-fpms.json")
+SNAPSHOT = Path("/run/cmprovision-wallboard-data/snapshot.json")
+HEARTBEAT = Path("/run/fpms/cmprovision.json")
+LIMIT = 2097152
+
+
+def hardware_lines(row):
+    """Five compact lines; ~ marks the server's inferred SKU, not a label read."""
+    hardware = row.get("hardware")
+    if not isinstance(hardware, dict) or not hardware:
+        return []
+    value = lambda key: text(hardware.get(key)) or "Unknown"
+    model = value("model").replace("Raspberry Pi Compute Module ", "CM").removeprefix("Raspberry Pi ")
+    sku = value("sku")
+    sku = "SKU: unknown" if sku == "Unknown" else "~" + sku.removesuffix(" (inferred)")
+    ram = value("ram").replace("GiB", "GB").replace("Unknown", "unknown")
+    emmc = value("emmc")
+    emmc = {"Not fitted (Lite)": "Lite", "Fitted; not detected": "missing", "Fitted; capacity unknown": "size unknown",
+            "Conflict: Lite / eMMC detected": "conflict", "Unknown": "unknown"}.get(emmc, emmc.removesuffix(" (detected)"))
+    wifi = {"Built-in": "yes", "Not fitted": "no"}.get(value("wifi"), "unknown")
+    return [model + " rev " + value("revision"), sku, "RAM: " + ram, "eMMC: " + emmc, "Wi-Fi: " + wifi]
+
+
+# cmprovision resources/css/app.css, Warm / Dark; alpha text composited on black.
+COLORS = {
+    "bg": "#000000",
+    "panel": "#121214",
+    "line": "#222226",
+    "text": "#e6e6e6",
+    "muted": "#8a8a8a",
+    "accent": "#ff8a3d",
+    "good": "#7ee2a0",
+    "bad": "#ff9d93",
+    "warn": "#ffcf7a",
+    "info": "#7fb2ff",
+}
+MAP_COLUMNS = 8   # columns of the front panel on a screen: 8 cubes of 12 pixels with their gaps fill the width
+MAP_TOP = 49
+CUBE, GAP, BLOCK_GAP = 12, 2, 3
+PAGES = ("Overview", "Ports", "Devices", "Errors", "Station")
+PALETTE_LOCK = threading.RLock()  # one physical screen; also safe when tests render multiple panels
+PROMPT_SECONDS = 3.0   # the leave prompt waits this long for the second press of button 2
+AGE_SHOWN = 10         # data younger than this is not called old
+
+
+def trusted_owners():
+    """Who may own a file this process reads (FPMS runs as root): root, the web user that writes the snapshot, and
+    whoever runs us (the tests)."""
+    owners = {0, os.geteuid()}
+    try:
+        owners.add(pwd.getpwnam("www-data").pw_uid)
+    except KeyError:
+        pass
+    return frozenset(owners)
+
+
+def read_json(path, limit=4096):
+    """A bounded read of a small file that another user may have prepared: a link is not followed, a pipe is not waited
+    for (a FIFO or /dev/watchdog put in its place would hang or reboot the box), only a regular file of a trusted owner
+    counts, and anything else is an empty answer."""
+    fd = None
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_size > limit or info.st_uid not in trusted_owners():
+            return {}
+        with os.fdopen(fd, "rb") as stream:
+            fd = None
+            raw = stream.read(limit + 1)
+        if len(raw) > limit:
+            return {}
+        value = json.loads(raw)
+        return value if isinstance(value, dict) else {}
+    except (OSError, ValueError, TypeError, RecursionError):
+        return {}
+    finally:
+        if fd is not None:
+            os.close(fd)
+
+
+def settings(path=CONFIG):
+    data = read_json(path)
+    if set(data) != {"enabled", "open_on_start"} or any(
+        type(v) is not bool for v in data.values()
+    ):
+        return {"enabled": False, "open_on_start": False}
+    return data
+
+
+def heartbeat(hardware, path=HEARTBEAT):
+    """Only the display owner writes this bounded liveness record."""
+    try:
+        path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
+        fd, name = tempfile.mkstemp(prefix=".cmprovision-", dir=path.parent)
+        try:
+            with os.fdopen(fd, "w") as out:
+                json.dump(
+                    {"protocol": 1, "at": int(time.time()), "hardware": bool(hardware)},
+                    out,
+                )
+                os.fchmod(out.fileno(), 0o644)
+            os.replace(name, path)
+        finally:
+            if os.path.exists(name):
+                os.unlink(name)
+    except OSError:
+        pass  # An optional integration must not take the stock menu down.
+
+
+def text(value):
+    if not isinstance(value, (str, int, float)) or isinstance(value, bool):
+        return ""
+    # the no-break space stays: it keeps a code with its word when a cause wraps ("(curl 18)", cmprovision ShortCause);
+    # the typographic marks the server sends (Neighbors::text cuts with "\u2026") have no glyph in the panel's fonts
+    value = str(value).translate(ASCII_MARKS)
+    return "".join(c if c.isprintable() or c == "\u00a0" else " " for c in value)[:512]
+
+
+ASCII_MARKS = str.maketrans({"\u2026": "...", "\u2013": "-", "\u2014": "-", "\u2018": "'", "\u2019": "'",
+                             "\u201c": '"', "\u201d": '"'})
+
+
+def number(value, default=0):
+    if type(value) not in (int, float):
+        return default
+    try:
+        return value if math.isfinite(value) else default
+    except OverflowError:  # an integer beyond the range of a float
+        return default
+
+
+def rate(value):
+    if type(value) in (int, float):
+        return f"{number(value) / 1048576:.1f} MiB/s" if number(value) > 0 else ""
+    return text(value)
+
+
+def slow(value):
+    """SLOW +3:20: the run is that long past what the finished modules of its batch took (cmprovision 2.19.0)"""
+    seconds = int(number(value)) if type(value) in (int, float) else 0
+    return f"SLOW +{seconds // 60}:{seconds % 60:02d}" if seconds > 0 else ""
+
+
+def identity(row):
+    """What pins an open device card to one device: its serial, else its MAC, else its port and name (a silent device
+    on a port has neither a serial nor a MAC, and its name is the same "unknown device" as the next one's)"""
+    port = text(row.get("port"))
+    return text(row.get("serial") or row.get("mac") or ((port + " " if port else "") + text(row.get("name"))))
+
+
+def remaining(value):
+    if type(value) in (int, float):
+        seconds = max(0, int(number(value)))
+        return f"ETA {seconds // 60}:{seconds % 60:02d}"
+    return text(value)
+
+
+def objects(value, limit=256):
+    return (
+        [x for x in value[:limit] if isinstance(x, dict)]
+        if isinstance(value, list)
+        else []
+    )
+
+
+class Panel:
+    def __init__(self, config=CONFIG, snapshot=SNAPSHOT, can_leave=True, clock=time.monotonic, power_client=None):
+        """can_leave: there is a menu to go back to (WLAN Pi); on Lite the panel is the whole screen.
+        clock: monotonic seconds, for the leave prompt (the tests turn it)."""
+        self.can_leave, self.clock = can_leave, clock
+        from .cmprovision_power import PowerMenu
+        self.power_menu = PowerMenu(power_client, clock) if power_client else None
+        # button 2 on a page asks first: until this time a second press leaves (PROMPT_SECONDS)
+        self.prompt_until = None
+        self.config, self.snapshot = Path(config), Path(snapshot)
+        self.page, self.index, self.detail, self.scroll = 0, 0, None, 0
+        self.data, self.problem, self.age = {}, "Waiting for data", None
+        self.enabled, self.last_read = False, -1e10
+        self.lock = threading.RLock()
+        self.font = ImageFont.load_default(size=10)
+        self.small = ImageFont.load_default(size=9)
+        self.large = ImageFont.load_default(size=18)
+        self.tiny = ImageFont.load_default(size=8)
+
+    def refresh(self, now=None, force=False):
+        now = time.time() if now is None else now
+        with self.lock:
+            if not force and time.monotonic() - self.last_read < 2:
+                return
+            self.last_read = time.monotonic()
+            self.enabled = settings(self.config)["enabled"]
+            if not self.enabled:
+                self.data, self.problem, self.age = {}, "Integration off", None
+                self.detail = None
+                return
+            data = read_json(self.snapshot, LIMIT)
+            generated = data.get("generated_at")
+            if type(data.get("version")) is not int or data["version"] != 1:
+                self.problem = "Unsupported data" if data else "Waiting for data"
+                self.data, self.age, self.detail = {}, None, None
+                return
+            if number(generated, None) is None or generated > now:
+                self.data, self.problem, self.age, self.detail = (
+                    {},
+                    "Invalid timestamp",
+                    None,
+                    None,
+                )
+                return
+            self.data, self.age = data, int(now - generated)
+            # old data stays on the screen, told by its age (age_label): the values are the last ones saved
+            self.problem = ""
+
+    def age_label(self):
+        """'' while the data is fresh (under AGE_SHOWN seconds), then '12 s', and from a minute '3 min'."""
+        if self.age is None or self.age < AGE_SHOWN:
+            return ""
+        return f"{self.age} s" if self.age < 60 else f"{self.age // 60} min"
+
+    def _panel_setting(self, key, values):
+        panel = self.data.get("panel") if isinstance(self.data.get("panel"), dict) else {}
+        value = panel.get(key)
+        return value if isinstance(value, str) and value in values else values[0]
+
+    def theme(self):
+        """new or classic (Settings → Provisioning → FPMS display); new when the server does not say."""
+        return self._panel_setting("theme", ("new", "classic"))
+
+    def color_mode(self):
+        mode = self._panel_setting("color_mode", ("dark", "light", "auto"))
+        if mode == "auto":
+            return "light" if self.data.get("display_auto_mode") == "light" else "dark"
+        return mode
+
+    def ports_map(self):
+        """pages (12 px cells with numbers, 8 columns to a screen) or whole (every port of a switch at once)."""
+        return self._panel_setting("ports_map", ("pages", "whole"))
+
+    def error_count(self):
+        """The modules that failed or went silent: the red counter of Errors and the OK > of Overview. Devices on ports
+        that are not modules are listed in Errors too, but a phone plugged in for good must not keep the counter red."""
+        return sum(1 for m in objects(self.data.get("modules")) if m.get("state") in ("fail", "stale"))
+
+    def rows(self):
+        if self.page == 1:
+            rows = []
+            for s_index, switch in enumerate(objects(self.data.get("switches"), 64)):
+                if switch.get("answering") is False:
+                    rows.append(
+                        {
+                            "name": text(switch.get("name")),
+                            "state": "No response",
+                            "serials": [],
+                        }
+                    )
+                for block in objects(switch.get("blocks"), 32):
+                    for port in objects(block.get("ports"), 256):
+                        rows.append(
+                            dict(
+                                port,
+                                name=text(switch.get("name"))
+                                + " "
+                                + text(port.get("name")),
+                                # two switches may have the same name: the place of the switch in the list tells them apart
+                                pin=f"{s_index}:{text(port.get('name'))}",
+                                portname=text(port.get("name")),
+                            )
+                        )
+            return rows[:512]
+        modules = objects(self.data.get("modules"))
+        if self.page == 2:
+            modules += objects(self.data.get("recognized"))
+        if self.page == 3:
+            # the modules that need a look first, then USB observations, then devices on ports that are not modules
+            # (kind keeps what they are: unrecognized or quiet)
+            modules = [m for m in modules if m.get("state") in ("fail", "stale")] + [
+                m for m in modules if m.get("state") == "unknown"
+            ]
+            modules += [
+                dict(m, kind=text(m.get("state")), state="unknown", name=text(m.get("name")) or text(m.get("mac")))
+                for m in objects(self.data.get("unknown"))
+            ]
+        return modules
+
+    def selected(self):
+        rows = self.rows()
+        self.index = min(self.index, max(0, len(rows) - 1))
+        return rows[self.index] if rows else None
+
+    def key(self, key):
+        """False means leave this integration. Button 2 goes back: it closes a card, and on a page it asks first, so a
+        second press within PROMPT_SECONDS leaves (on Lite, with no menu to go to, it is Overview). Button 3 does nothing
+        here: in the stock menu it is the Reboot/Shutdown shortcut, whose Confirm the next press of the centre would take.
+        Button 1 is Overview. Left and right turn the pages. Only Lite explicitly supplies a power callback;
+        its KEY3 menu uses KEY1 to confirm, never the centre used to open/select."""
+        with self.lock:
+            now = self.clock()
+            if self.power_menu and self.power_menu.open:
+                self.power_menu.key(key)
+                return True
+            if key == "KEY3" and self.power_menu:
+                self.prompt_until = None
+                self.power_menu.show()
+                return True
+            if self.prompt_until is not None:
+                asked, self.prompt_until = now < self.prompt_until, None
+                if asked:
+                    # the second press leaves; any other button only takes the question away
+                    return key != "KEY2"
+            if key == "KEY3":
+                pass
+            elif key == "KEY1":
+                self.page, self.index, self.detail, self.scroll = 0, 0, None, 0
+            elif key == "KEY2":
+                if self.detail is not None:
+                    self.detail, self.scroll = None, 0
+                elif self.can_leave:
+                    self.prompt_until = now + PROMPT_SECONDS
+                else:
+                    self.page, self.index, self.scroll = 0, 0, 0
+            elif self.detail is not None:
+                if key in ("LEFT", "CENTER"):
+                    self.detail, self.scroll = None, 0
+                elif key in ("UP", "DOWN"):
+                    self.scroll = max(0, self.scroll + (1 if key == "DOWN" else -1))
+            elif key in ("LEFT", "RIGHT"):
+                self.page = (self.page + (1 if key == "RIGHT" else -1)) % len(PAGES)
+                self.index, self.scroll = 0, 0
+            elif key in ("UP", "DOWN") and self.page == 4:
+                # Station scrolls when its rows do not fit
+                self.scroll = max(0, self.scroll + (1 if key == "DOWN" else -1))
+            elif key in ("UP", "DOWN"):
+                self.index = (self.index + (1 if key == "DOWN" else -1)) % max(
+                    1, len(self.rows())
+                )
+            elif key == "CENTER" and self.page == 0:
+                if self.error_count():
+                    self.page, self.index = 3, 0
+            elif key == "CENTER" and self.page in (1, 2, 3):
+                row = self.selected()
+                if row:
+                    serials = (
+                        row.get("serials")
+                        if isinstance(row.get("serials"), list)
+                        else []
+                    )
+                    # Pin by identity: a port disappearing must not show another device's details.
+                    self.detail = (
+                        ("port", text(row.get("pin") or row.get("name")))
+                        if self.page == 1 and not serials
+                        else ("module", text(serials[0]) if serials else identity(row))
+                    )
+                    self.scroll = 0
+            return True
+
+    def detail_row(self):
+        kind, pinned = self.detail
+        if kind == "port":
+            return next(
+                (p for p in self.rows() if text(p.get("pin") or p.get("name")) == pinned),
+                None,
+            )
+        rows = objects(self.data.get("modules")) + objects(self.data.get("recognized")) + objects(self.data.get("unknown"))
+        return next((m for m in rows if identity(m) == pinned), None)
+
+    def map_view(self):
+        """The ports of every switch as the columns of its front panel, in the order of rows(): [{name, answering, first,
+        columns: [(top, bottom, block)]}], where top and bottom are indexes into rows() or None. A block of two rows is read
+        column by column (1 above 2, 3 above 4); a block of one row (uplinks, SFP) sits on the lower row, as on the switch."""
+        views, n = [], 0
+        for switch in objects(self.data.get("switches"), 64):
+            view = {
+                "name": text(switch.get("name")),
+                "answering": switch.get("answering") is not False,
+                "first": n,
+                "columns": [],
+            }
+            if not view["answering"]:
+                n += 1
+            for b, block in enumerate(objects(switch.get("blocks"), 32)):
+                indexes = list(range(n, n + len(objects(block.get("ports"), 256))))
+                n += len(indexes)
+                if number(block.get("rows"), 1) >= 2:
+                    for i in range(0, len(indexes), 2):
+                        view["columns"].append(
+                            (indexes[i], indexes[i + 1] if i + 1 < len(indexes) else None, b)
+                        )
+                else:
+                    view["columns"] += [(None, i, b) for i in indexes]
+            views.append(view)
+        return views
+
+    def frame(self):
+        with self.lock, PALETTE_LOCK:
+            if self.theme() == "new":
+                from . import cmprovision_new
+
+                old = dict(cmprovision_new.P)
+                try:
+                    cmprovision_new.P.update(cmprovision_new.LIGHT if self.color_mode() == "light" else cmprovision_new.DARK)
+                    if self.power_menu and self.power_menu.open:
+                        from .cmprovision_power import render
+                        return render(self.power_menu, cmprovision_new.P)
+                    return cmprovision_new.render(self)
+                finally:
+                    cmprovision_new.P.update(old)
+            from . import cmprovision_classic
+
+            old = dict(COLORS)
+            try:
+                COLORS.update(cmprovision_classic.LIGHT if self.color_mode() == "light" else cmprovision_classic.DARK)
+                if self.power_menu and self.power_menu.open:
+                    from .cmprovision_power import render
+                    return render(self.power_menu, COLORS)
+                return cmprovision_classic.render(self)
+            finally:
+                COLORS.update(old)
