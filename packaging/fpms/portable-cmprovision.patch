+def test_light_palette_statuses_have_readable_contrast():
+    def luminance(rgb):
+        def linear(v):
+            v /= 255
+            return v / 12.92 if v <= .04045 else ((v + .055) / 1.055) ** 2.4
+        r, g, b = map(linear, rgb)
+        return .2126*r + .7152*g + .0722*b
+    def ratio(a, b):
+        a, b = sorted((luminance(a), luminance(b)))
+        return (b + .05) / (a + .05)
+    old = dict(new.P)
+    try:
+        new.P.update(new.LIGHT)
+        for key in ("accent", "good", "run", "bad", "warn"):
+            assert ratio(new.P[key], new.P["bg"]) >= 4.5, key
+            assert ratio(new.on_color(key), new.P[key]) >= 4.5, key
+    finally:
+        new.P.update(old)
