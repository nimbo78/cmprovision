@@ -0,0 +1,38 @@
+"""The hardware backend must work without the full WLAN Pi application."""
+
+import subprocess
+import sys
+
+
+def test_st7735_import_does_not_load_application_state():
+    # Fresh interpreter: application test fixtures must not mask an import of
+    # constants.py (it reads WLAN Pi files and changes the current directory).
+    result = subprocess.run(
+        [sys.executable, "-c", """
+import importlib.abc
+import os
+import sys
+import types
+
+class NoApplication(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname in {'fpms.modules.constants', 'fpms.modules.env_utils', 'qrcode'}:
+            raise AssertionError('application dependency: ' + fullname)
+
+sys.meta_path.insert(0, NoApplication())
+gpio = types.ModuleType('gpiod')
+gpio.__path__ = []
+line = types.ModuleType('gpiod.line')
+line.Direction = line.Value = object
+sys.modules['gpiod'] = gpio
+sys.modules['gpiod.line'] = line
+sys.modules['spidev'] = types.ModuleType('spidev')
+before = os.getcwd()
+from fpms.modules.screen.st7735 import ST7735
+assert os.getcwd() == before
+ST7735()  # Does not open devices until init() is explicitly called.
+"""],
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
