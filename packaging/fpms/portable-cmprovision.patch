index 0000000..cf9fab1
--- /dev/null
+++ b/fpms/integrations/cmprovision_fonts.py
@@ -0,0 +1,218 @@
+"""Bitmap fonts of the cmprovision panel and the checks every screen goes through.
+
+A 128x128 panel of 0.2 mm pixels reads best in fonts drawn for its pixels: BDF files in fpms/fonts/cmprovision (made by
+tools/cmprovision-fonts.py; licences beside them), drawn one to one without smoothing. Text is placed by its ink, not by
+the advance of its glyphs, which carries empty columns: that is what keeps a digit in the middle of its tag.
+
+While recording (the tests), every text drawn leaves its ink box and every centred text its box and ink, so a test can
+find texts that touch, text off the screen and text off the centre of its box.
+"""
+
+import string
+from pathlib import Path
+
+from PIL import Image
+
+FONT_DIR = Path(__file__).resolve().parent.parent / "fonts" / "cmprovision"
+# Silkscreen's brackets and bars reach above its capitals: its lines are measured by what the panel writes with it
+TEXT = string.ascii_letters + string.digits + ":-/.()%>"
+ROLES = {
+    "title": ("helvB10.bdf", None),      # page titles, the port in lists and cards
+    "body": ("helvB08.bdf", None),       # lists, lines, tags
+    "big": ("helvB18.bdf", None),        # the counts of Overview
+    "code": ("spleen-6x12.bdf", None),   # MAC, address
+    "tiny": ("5x7.bdf", None),           # port numbers in the cells of the map
+    "error": ("silkscreen-8.bdf", TEXT),  # what went wrong
+    "mark": ("helvB08.bdf", None),       # the cm of the mark
+}
+_cache = {}
+
+
+class BitmapFont:
+    """A BDF font. h is the line: tight metrics over printable ASCII (or the given characters), not the declared ascent,
+    which keeps room for accents a 128 px screen cannot spare."""
+
+    def __init__(self, path, chars=None):
+        self.glyphs = {}
+        lines = iter(Path(path).read_text(encoding="latin-1").splitlines())
+        for line in lines:
+            if not line.startswith("STARTCHAR"):
+                continue
+            enc, dw, bb, rows = None, 0, None, []
+            for line in lines:
+                key, _, value = line.partition(" ")
+                if key == "ENCODING":
+                    enc = int(value.split()[0])
+                elif key == "DWIDTH":
+                    dw = int(value.split()[0])
+                elif key == "BBX":
+                    bb = [int(v) for v in value.split()]
+                elif key == "BITMAP":
+                    for line in lines:
+                        if line.startswith("ENDCHAR"):
+                            break
+                        rows.append(line.strip())
+                    break
+            if enc is None or enc < 0 or bb is None:
+                continue
+            w, h, xo, yo = bb
+            mask = Image.new("1", (max(w, 1), max(h, 1)), 0)
+            px = mask.load()
+            for r, hexrow in enumerate(rows[:h]):
+                bits, n = (int(hexrow, 16) if hexrow else 0), len(hexrow) * 4
+                for c in range(w):
+                    if bits >> (n - 1 - c) & 1:
+                        px[c, r] = 1
+            self.glyphs[chr(enc)] = (mask, dw, xo, yo, h, mask.getbbox())
+        measured = [self.glyphs[c] for c in (chars or map(chr, range(33, 127))) if c in self.glyphs]
+        self.asc = max(yo + h for _, _, _, yo, h, _ in measured)
+        self.desc = max(0, max(-yo for _, _, _, yo, _, _ in measured))
+        self.h = self.asc + self.desc + 1
+
+    def _g(self, ch):
+        return self.glyphs.get(ch) or self.glyphs.get(" " if ch == " " else "?") or self.glyphs["?"]
+
+    def width(self, s):
+        return sum(self._g(ch)[1] for ch in s)
+
+    def ink_top(self, s):
+        """Pixels from the top of the line to the highest ink of s."""
+        tops = [self.asc - (self._g(ch)[3] + self._g(ch)[4]) for ch in s if self._g(ch)[5]]
+        return min(tops) if tops else self.asc
+
+    def ink(self, x, y, s):
+        """The ink box of s drawn at x, y (inclusive), or None for blank text."""
+        box, base = None, y + self.asc
+        for ch in s:
+            mask, dw, xo, yo, h, bb = self._g(ch)
+            if bb:
+                gx, gy = x + xo, base - yo - h
+                g = (gx + bb[0], gy + bb[1], gx + bb[2] - 1, gy + bb[3] - 1)
+                box = g if box is None else (min(box[0], g[0]), min(box[1], g[1]), max(box[2], g[2]), max(box[3], g[3]))
+            x += dw
+        return box
+
+    def draw(self, img, x, y, s, color):
+        """Draws s with the top of its line at y; returns the x after it."""
+        if _ink is not None:
+            box = self.ink(x, y, s)
+            if box:
+                _ink.append(box + (s,))
+        base = y + self.asc
+        for ch in s:
+            mask, dw, xo, yo, h, _ = self._g(ch)
+            img.paste(color, (x + xo, base - yo - h), mask)
+            x += dw
+        return x
+
+
+def font(role):
+    if role not in _cache:
+        name, chars = ROLES[role]
+        _cache[role] = BitmapFont(FONT_DIR / name, chars)
+    return _cache[role]
+
+
+def fit(f, s, width):
+    """s as is, or cut with '...' so the cut is seen (the whole text is one press away, on the card)."""
+    s = s.replace(" ", " ")
+    if f.width(s) <= width:
+        return s
+    n = len(s)
+    while n > 1 and f.width(s[:n].rstrip() + "...") > width:
+        n -= 1
+    return s[:n].rstrip() + "..."
+
+
+def wrap(f, s, width):
+    """Words to lines no wider than width; a word wider than a line is cut, never dropped. A no-break space keeps its
+    neighbours on one line ("(curl 18)") and is drawn as a space."""
+    lines, cur = [], ""
+    for word in [w for w in s.split(" ") if w]:
+        while f.width(word) > width:
+            if cur:
+                lines.append(cur)
+                cur = ""
+            n = len(word)
+            while n > 1 and f.width(word[:n]) > width:
+                n -= 1
+            lines.append(word[:n])
+            word = word[n:]
+        trial = cur + " " + word if cur else word
+        if f.width(trial) <= width:
+            cur = trial
+        else:
+            lines.append(cur)
+            cur = word
+    if cur:
+        lines.append(cur)
+    return [line.replace(" ", " ") for line in lines]
+
+
+def ink_bbox(f, s):
+    """The ink of s relative to where draw() puts it, inclusive; (0, 0, -1, -1) for blank text."""
+    return f.ink(0, 0, s) or (0, 0, -1, -1)
+
+
+def draw_centered(f, img, box, s, color):
+    """s with its ink in the middle of box (inclusive): an odd pixel left over goes right and down."""
+    ix0, iy0, ix1, iy1 = ink_bbox(f, s)
+    x = box[0] + (box[2] - box[0] + 1 - (ix1 - ix0 + 1)) // 2 - ix0
+    y = box[1] + (box[3] - box[1] + 1 - (iy1 - iy0 + 1)) // 2 - iy0
+    f.draw(img, x, y, s, color)
+    if _centred is not None:
+        _centred.append((tuple(box), (x + ix0, y + iy0, x + ix1, y + iy1), s))
+
+
+# ---- the checks every screen goes through (tests) ----
+_ink = None
+_centred = None
+
+
+def start_recording():
+    global _ink, _centred
+    _ink, _centred = [], []
+
+
+def stop_recording():
+    """(ink boxes, centred texts) since start_recording()."""
+    global _ink, _centred
+    found = (_ink or [], _centred or [])
+    _ink = _centred = None
+    return found
+
+
+def record(box, s):
+    """A text drawn by other means (the classic theme's default font): its ink box, inclusive."""
+    if _ink is not None and box:
+        _ink.append(tuple(box) + (s,))
+
+
+def hide_below(y):
+    """A plate from row y down covers what was drawn there: it is not on the screen to be checked."""
+    if _ink is not None:
+        _ink[:] = [b for b in _ink if b[3] < y]
+        _centred[:] = [c for c in _centred if c[0][3] < y]
+
+
+def overlaps(ink):
+    """Texts with no empty pixel between their inks, and text that leaves the 128x128 screen."""
+    bad = []
+    for i, a in enumerate(ink):
+        if a[0] < 0 or a[1] < 0 or a[2] > 127 or a[3] > 127:
+            bad.append(f"off screen: {a[4]!r} {a[:4]}")
+        for b in ink[i + 1:]:
+            if a[0] <= b[2] + 1 and b[0] <= a[2] + 1 and a[1] <= b[3] + 1 and b[1] <= a[3] + 1:
+                bad.append(f"{a[4]!r} {a[:4]} touches {b[4]!r} {b[:4]}")
+    return bad
+
+
+def off_centre(centred, tolerance=1):
+    """Texts in boxes whose left and right (or top and bottom) margins differ by more than tolerance pixels."""
+    bad = []
+    for box, ink, s in centred:
+        dx = (ink[0] - box[0]) - (box[2] - ink[2])
+        dy = (ink[1] - box[1]) - (box[3] - ink[3])
+        if abs(dx) > tolerance or abs(dy) > tolerance:
+            bad.append(f"{s!r} in {box}: left-right {dx:+d}, top-bottom {dy:+d}")
+    return bad
