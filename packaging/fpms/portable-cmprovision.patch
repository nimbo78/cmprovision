+    tile = Image.new("RGBA", (side, side))
+    draw = ImageDraw.Draw(tile)
+    for i in range(side * 2):
+        t = min(1, max(0, (i - 12) / 264))
+        rgb = tuple(round(c + (d - c) * t) for c, d in zip(a, b))
+        draw.line((i, 0, 0, i), fill=rgb)
+    mask = Image.new("L", tile.size)
+    ImageDraw.Draw(mask).rounded_rectangle((6, 6, 137, 137), radius=39, fill=255)
+    tile.putalpha(mask)
+    # fmt: off
+    paths = (
+        ((19.6,18.5),(18.1,18.2),(16.5,18.3),(15,18.7),(13.7,19.5),(12.6,20.7),
+         (11.8,22),(11.4,23.5),(11.4,25.1),(11.9,26.6),(12.6,28),(13.7,29.1),
+         (15.1,29.9),(16.6,30.3),(18.2,30.4),(19.7,30.2),(21.2,29.6),(22.4,28.7),
