+def centered(draw, box, value, face, color):
+    # Ink bounds give the monogram even margins despite the font's side bearings.
+    left, top, right, bottom = face.getbbox(value)
+    mask = Image.new("L", (max(1, right - left), max(1, bottom - top)))
+    ImageDraw.Draw(mask).text((-left, -top), value, font=face, fill=255)
+    bounds = mask.getbbox()
+    if bounds:
+        ink = mask.crop(bounds)
+        x = box[0] + (box[2] - box[0] + 1 - ink.width) // 2
+        y = box[1] + (box[3] - box[1] + 1 - ink.height) // 2
+        draw.bitmap((x, y), ink, fill=color)
+
+
+@lru_cache(maxsize=96)
+def caption_masks(symbol, title, icon_size, text_size):
+    """Centre the actual ink of both shapes. An SVG view box and a font line box have different bearings."""
+    face = font(text_size, "bold")
+    bounds = face.getbbox(title)
+    letters = Image.new("L", (bounds[2] - bounds[0], bounds[3] - bounds[1]))
+    ImageDraw.Draw(letters).text((-bounds[0], -bounds[1]), title, font=face, fill=255)
+    result = []
+    for mask in (icon(symbol, icon_size), letters):
+        visible = mask.point(lambda alpha: 255 if alpha >= 48 else 0).getbbox()
+        result.append((mask, (visible[1] + visible[3] - 1) / 2))
+    return result
+
+
+def icon_caption(draw, x, center_y, symbol, title, symbol_ink, text_ink, icon_size=21, text_size=18, gap=7):
+    for (mask, middle), left, ink in zip(
+        caption_masks(symbol, title, icon_size, text_size), (x, x + icon_size + gap), (symbol_ink, text_ink)
+    ):
+        draw.bitmap((left, round(center_y - middle)), mask, fill=ink)
