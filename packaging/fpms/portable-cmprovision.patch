+#!/bin/sh
+# Build the portable subset only; none of the full WLAN Pi applications/dependencies.
+set -eu
+OUT=$(realpath -m "${1:?output directory required}")
+VERSION=${2:-0.1.0~cmprovision1}
+dpkg --validate-version "$VERSION"
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+DEST=$WORK/pkg
+mkdir -p "$DEST/DEBIAN" "$DEST/usr/lib/fpms-lite/fpms/integrations" "$DEST/usr/lib/fpms-lite/fpms/modules/screen" "$DEST/usr/share/doc/fpms-lite" "$DEST/usr/share/fpms" "$DEST/usr/lib/systemd/system" "$OUT"
+for f in __init__.py lite.py modules/__init__.py modules/platform.py modules/gpiochip.py modules/screen/__init__.py modules/screen/screen.py modules/screen/st7735.py integrations/__init__.py integrations/cmprovision.py; do
+    install -m 644 "$ROOT/fpms/$f" "$DEST/usr/lib/fpms-lite/fpms/$f"
+done
+install -m 644 "$ROOT/LICENSE" "$DEST/usr/share/doc/fpms-lite/copyright"
+install -m 644 "$ROOT/packaging/cmprovision.json" "$DEST/usr/share/fpms/cmprovision.json"
+install -m 644 "$ROOT/packaging/lite/fpms-lite.service" "$DEST/usr/lib/systemd/system/"
+cat > "$DEST/DEBIAN/control" <<EOF
+Package: fpms-lite
+Version: $VERSION
+Architecture: all
+Maintainer: cmprovision contributors
+Depends: init-system-helpers, python3 (>= 3.13), python3-pil (>= 10.1), python3-libgpiod (>= 2), python3-spidev
+Conflicts: wlanpi-fpms
+Description: Compact FPMS station panel for cmprovision
+ Portable subset of WLAN Pi FPMS for a dedicated provisioning station.
+ Supports the Waveshare 1.44 ST7735 panel on qualified CM4 hardware.
+ No WLAN Pi applications or services are required.
+EOF
+cat > "$DEST/DEBIAN/postinst" <<'EOF'
+#!/bin/sh
+set -e
+if [ "$1" = configure ]; then
+    deb-systemd-helper enable fpms-lite.service >/dev/null
+    if [ -d /run/systemd/system ]; then
+        systemctl daemon-reload
+        deb-systemd-invoke restart fpms-lite.service >/dev/null || true
+    fi
+fi
+EOF
+cat > "$DEST/DEBIAN/prerm" <<'EOF'
+#!/bin/sh
+set -e
+if [ -d /run/systemd/system ]; then
+    deb-systemd-invoke stop fpms-lite.service >/dev/null || true
+fi
+EOF
+cat > "$DEST/DEBIAN/postrm" <<'EOF'
+#!/bin/sh
+set -e
+if [ "$1" = purge ]; then
+    deb-systemd-helper purge fpms-lite.service >/dev/null
+fi
+if [ -d /run/systemd/system ]; then
+    systemctl daemon-reload
+fi
+EOF
+chmod 755 "$DEST/DEBIAN/postinst" "$DEST/DEBIAN/prerm" "$DEST/DEBIAN/postrm"
+dpkg-deb --root-owner-group --build "$DEST" "$OUT/fpms-lite_${VERSION}_all.deb"
diff --git a/tools/cmprovision-fonts.py b/tools/cmprovision-fonts.py
new file mode 100644
index 0000000..9c2fe06
--- /dev/null
+++ b/tools/cmprovision-fonts.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Make the bitmap fonts of the cmprovision panel (fpms/fonts/cmprovision) from their upstream files.
+
+    tools/cmprovision-fonts.py SOURCE_DIR OUT_DIR
+
+SOURCE_DIR holds, as published upstream:
+  helvB08.bdf helvB10.bdf helvB18.bdf  https://gitlab.freedesktop.org/xorg/font/adobe-100dpi (COPYING: adobe-COPYING)
+  5x7.bdf                              https://gitlab.freedesktop.org/xorg/font/misc-misc (public domain)
+  spleen-6x12.bdf                      https://github.com/fcambus/spleen (BSD-2-Clause: spleen-LICENSE)
+  Silkscreen-Regular.ttf               https://github.com/google/fonts/tree/main/ofl/silkscreen (OFL 1.1, no reserved
+                                       font name), SHA256 c845473330b94c2079ce9af01c51ac8ba2d99c24f4d14c039843bbb8e642ebd8
+The BDF fonts keep only printable ASCII, the no-break space and the middle dot (the panel draws nothing else); Silkscreen,
+drawn by the panel at 8 px where it sits on the pixel grid, becomes a BDF of that size: one glyph at a time, without
+smoothing, at whole-pixel pen positions. Needs Pillow; run once when a font changes, the output is in the patch.
+"""
+
+import hashlib
+import shutil
+import sys
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+KEEP = set(range(32, 127)) | {0xA0, 0xB7}
+SILKSCREEN_SHA256 = "c845473330b94c2079ce9af01c51ac8ba2d99c24f4d14c039843bbb8e642ebd8"
+LICENSES = {"adobe-COPYING": "adobe-100dpi.txt", "misc-COPYING": "misc-misc.txt", "spleen-LICENSE": "spleen.txt",
+            "silkscreen-OFL.txt": "silkscreen-OFL.txt"}
+
+
+def subset(src, out):
+    head, glyphs, block, encoding = [], [], None, None
+    for line in Path(src).read_text(encoding="latin-1").splitlines():
+        if block is None and line.startswith("STARTCHAR"):
+            block, encoding = [line], None
+        elif block is not None:
+            block.append(line)
+            if line.startswith("ENCODING"):
+                encoding = int(line.split()[1])
+            if line.startswith("ENDCHAR"):
+                if encoding in KEEP:
+                    glyphs.append(block)
+                block = None
+        elif line.startswith("CHARS ") or line.startswith("ENDFONT"):
+            continue
+        else:
+            head.append(line)
+            if line.startswith("STARTFONT"):
+                head.append("COMMENT Subset by cmprovision tools/cmprovision-fonts.py: printable ASCII, U+00A0, U+00B7")
+    lines = head + [f"CHARS {len(glyphs)}"] + [l for g in glyphs for l in g] + ["ENDFONT"]
+    Path(out).write_text("\n".join(lines) + "\n", encoding="latin-1")
+
+
+def silkscreen(src, out, size=8):
+    if hashlib.sha256(Path(src).read_bytes()).hexdigest() != SILKSCREEN_SHA256:
+        sys.exit(f"{src}: not the Silkscreen this was made for")
+    font = ImageFont.truetype(str(src), size)
+    glyphs, asc, desc = [], 0, 0
+    for code in range(32, 127):
+        ch = chr(code)
+        advance = round(font.getlength(ch))
+        img = Image.new("1", (size * 4, size * 4), 0)
+        draw = ImageDraw.Draw(img)
+        draw.fontmode = "1"
+        base = size * 2
+        draw.text((size, base), ch, font=font, fill=1, anchor="ls")
+        box = img.getbbox()
+        if box is None:
+            glyphs.append((code, advance, 0, 0, 0, 0, []))
+            continue
+        x0, y0, x1, y1 = box
+        rows = []
+        for y in range(y0, y1):
+            bits = "".join("1" if img.getpixel((x, y)) else "0" for x in range(x0, x1))
+            bits += "0" * (-len(bits) % 8)
+            rows.append("".join(f"{int(bits[i:i + 8], 2):02X}" for i in range(0, len(bits), 8)))
+        w, h, xoff, yoff = x1 - x0, y1 - y0, x0 - size, base - y1
+        asc, desc = max(asc, yoff + h), max(desc, -yoff)
+        glyphs.append((code, advance, w, h, xoff, yoff, rows))
+    nbsp = next(g for g in glyphs if g[0] == 32)
+    glyphs.append((0xA0,) + nbsp[1:])
+    width = max(g[2] for g in glyphs)
+    lines = ["STARTFONT 2.1",
+             "COMMENT Silkscreen by Jason Kottke at 8 px, as BDF by cmprovision tools/cmprovision-fonts.py",
+             "FONT -Kottke-Silkscreen-Medium-R-Normal--8-80-75-75-P-80-ISO10646-1",
+             f"SIZE {size} 75 75", f"FONTBOUNDINGBOX {width} {asc + desc} 0 {-desc}",
+             "STARTPROPERTIES 4",
+             'COPYRIGHT "Copyright 2001 The Silkscreen Project Authors (https://github.com/googlefonts/silkscreen)"',
+             'NOTICE "Licensed under the SIL Open Font License, Version 1.1"',
+             f"FONT_ASCENT {asc}", f"FONT_DESCENT {desc}", "ENDPROPERTIES", f"CHARS {len(glyphs)}"]
+    for code, advance, w, h, xoff, yoff, rows in glyphs:
+        lines += [f"STARTCHAR U+{code:04X}", f"ENCODING {code}", f"SWIDTH {advance * 125} 0", f"DWIDTH {advance} 0",
+                  f"BBX {w} {h} {xoff} {yoff}", "BITMAP", *rows, "ENDCHAR"]
+    lines.append("ENDFONT")
+    Path(out).write_text("\n".join(lines) + "\n", encoding="ascii")
+
+
+def main(src, out):
+    src, out = Path(src), Path(out)
+    (out / "LICENSES").mkdir(parents=True, exist_ok=True)
+    for name in ("helvB08", "helvB10", "helvB18", "5x7", "spleen-6x12"):
+        subset(src / f"{name}.bdf", out / f"{name}.bdf")
+    silkscreen(src / "Silkscreen-Regular.ttf", out / "silkscreen-8.bdf")
+    for name, dest in LICENSES.items():
+        shutil.copyfile(src / name, out / "LICENSES" / dest)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        sys.exit(__doc__)
+    main(sys.argv[1], sys.argv[2])
