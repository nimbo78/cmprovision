@@ -0,0 +1,145 @@
+"""Compact station menu. No imports from the WLAN Pi application/provider."""
+
+import argparse
+import json
+import logging
+import signal
+import time
+from datetime import timedelta
+from pathlib import Path
+
+from .integrations.cmprovision import CONFIG, SNAPSHOT, Panel, heartbeat
+
+BUTTONS = {
+    6: "UP",
+    19: "DOWN",
+    5: "LEFT",
+    26: "RIGHT",
+    13: "CENTER",
+    21: "KEY1",
+    20: "KEY2",
+    16: "KEY3",
+}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--snapshot", type=Path, default=SNAPSHOT)
+    parser.add_argument("--config", type=Path, default=CONFIG)
+    parser.add_argument("--preview", type=Path)
+    parser.add_argument("--rotate", type=int, choices=(0, 180), default=0)
+    parser.add_argument(
+        "--sleep",
+        type=int,
+        choices=range(0, 3601),
+        default=60,
+        help="Idle seconds before blanking; 0 stays on",
+    )
+    parser.add_argument(
+        "--seconds", type=int, choices=range(1, 601), help="Bounded hardware test"
+    )
+    args = parser.parse_args()
+    # the panel is the whole screen here: button 2 goes back to Overview instead of leaving
+    panel = Panel(args.config, args.snapshot, can_leave=False)
+    panel.refresh(force=True)
+    if args.preview:
+        panel.frame().save(args.preview)
+        return
+
+    # Headless installations stay idle and report the absence of the SPI device.
+    stop = False
+
+    def stopping(*_):
+        nonlocal stop
+        stop = True
+
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        signal.signal(sig, stopping)
+    started = time.monotonic()
+    while not Path("/dev/spidev0.0").exists():
+        heartbeat(False)
+        if stop or (args.seconds and time.monotonic() - started >= args.seconds):
+            return
+        time.sleep(3)
+
+    import gpiod
+    from gpiod.line import Bias, Edge
+
+    from .modules.gpiochip import get_gpiochip
+    from .modules.screen.st7735 import ST7735
+
+    screen = ST7735()
+    last_key, last_frame, last_heartbeat, sleeping = time.monotonic(), 0, 0, False
+    with gpiod.request_lines(
+        get_gpiochip(),
+        consumer="fpms-lite",
+        config={
+            tuple(BUTTONS): gpiod.LineSettings(
+                bias=Bias.PULL_UP,
+                edge_detection=Edge.FALLING,
+                debounce_period=timedelta(milliseconds=30),
+            )
+        },
+    ) as buttons:
+        try:
+            screen.init()
+            print("FPMS_LITE_READY", flush=True)
+            while not stop and (
+                not args.seconds or time.monotonic() - started < args.seconds
+            ):
+                now = time.monotonic()
+                if now - last_heartbeat >= 3:
+                    heartbeat(True)
+                    last_heartbeat = now
+                try:
+                    panel.refresh()
+                except Exception:
+                    logging.getLogger(__name__).exception("snapshot not usable")
+                if args.sleep and now - last_key >= args.sleep and not sleeping:
+                    screen.sleep()
+                    sleeping = True
+                if not sleeping and now - last_frame >= 2:
+                    try:
+                        screen.drawImage(panel.frame().rotate(args.rotate))
+                    except Exception:
+                        logging.getLogger(__name__).exception("page not drawn")
+                    last_frame = now
+                if buttons.wait_edge_events(timedelta(seconds=0.2)):
+                    for event in buttons.read_edge_events():
+                        last_key = time.monotonic()
+                        if sleeping:
+                            screen.wakeup()
+                            sleeping = False
+                        else:
+                            key = BUTTONS[event.line_offset]
+                            if args.rotate:
+                                key = {
+                                    "UP": "DOWN",
+                                    "DOWN": "UP",
+                                    "LEFT": "RIGHT",
+                                    "RIGHT": "LEFT",
+                                    "KEY1": "KEY3",
+                                    "KEY3": "KEY1",
+                                }.get(key, key)
+                            panel.key(key)
+                            if args.seconds:
+                                print(
+                                    json.dumps(
+                                        {
+                                            "button": key,
+                                            "page": panel.page,
+                                            "detail": panel.detail,
+                                        }
+                                    ),
+                                    flush=True,
+                                )
+                        last_frame = 0
+        finally:
+            if hasattr(screen, "device"):
+                screen.sleep()
+                screen.device.module_exit()
+            heartbeat(False)
+
+
+if __name__ == "__main__":
+    main()
