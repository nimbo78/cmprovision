+    def observed_port(self, device):
+        matches = []
+        for switch in objects(self.panel.data.get("switches")):
+            if switch.get("answering") is False:
+                continue
+            for block in objects(switch.get("blocks")):
+                for port in objects(block.get("ports")):
+                    if device.get("port_id"):
+                        if port.get("port_id") == device["port_id"]:
+                            return port
+                    elif device.get("port") == text(switch.get("name"))+" "+text(port.get("name")):
+                        matches.append(port)
+        return matches[0] if len(matches) == 1 else {}
+
+    def details(self):
+        p = self.panel
+        is_port = p.detail[0] == "port"
+        row = self.port_row() if is_port else p.detail_row()
+        if row is None:
+            kind = "Port" if is_port else "Device"
+            self.title(kind + " details")
+            self.label(25, 167, kind + " is no longer present", 23, "muted")
+        elif is_port:
+            index = int(row["pin"].partition(":")[0])
+            switch = objects(p.data.get("switches"))[index]
+            cards.port(self, row, switch, port_link(row), port_power(row))
+        else:
