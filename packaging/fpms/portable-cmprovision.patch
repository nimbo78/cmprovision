+@pytest.mark.parametrize("commit_fails, initially_busy", [(False, False), (True, False), (False, True)])
+def test_frame_gives_drm_master_back_to_the_console(monkeypatch, commit_fails, initially_busy):
+    import ctypes
+    from fpms.modules.screen.hyperpixel import SCAN_HEIGHT, SCAN_WIDTH
+
+    events = []
+
+    def record(name):
+        def call(fd):
+            assert fd == 3
+            events.append(name)
+            return 0
+        return call
+
+    def acquire(fd):
+        import errno
+        if initially_busy and "busy" not in events:
+            events.append("busy")
+            return -errno.EBUSY
+        return record("acquire")(fd)
+
+    libdrm = SimpleNamespace(
+        drmIsMaster=lambda fd: 1,
+        drmSetMaster=acquire,
+        drmDropMaster=record("release"),
+    )
+    monkeypatch.setattr(ctypes, "CDLL", lambda *args, **kwargs: libdrm)
+
+    class Buffer:
+        id = 42
+
+        def stride(self, index):
+            return SCAN_WIDTH * 4
+
+        def map(self, index):
+            return memoryview(bytearray(SCAN_WIDTH * SCAN_HEIGHT * 4))
+
+    def commit():
+        events.append("commit")
+        return -1 if commit_fails else 0
+
+    request = SimpleNamespace(add_plane=lambda *args: None, commit_sync=commit)
+    kms = SimpleNamespace(DumbFramebuffer=lambda *args: Buffer(), AtomicReq=lambda *args: request)
+    output = SimpleNamespace(id=1, refresh_props=lambda: None, get_prop_value=lambda key: 2)
+    plane = SimpleNamespace(refresh_props=lambda: None, get_prop_value=lambda key: 0)
+    card = SimpleNamespace(fd=3, connectors=[output])
+    screen = DpiScreen(kms, card, output, SimpleNamespace(id=2), plane)
+
+    assert events == ["release"]
+    image = Image.new("RGB", (SCAN_WIDTH, SCAN_HEIGHT))
+    if commit_fails:
+        with pytest.raises(OSError, match="Cannot present"):
+            screen.show(image)
+    else:
+        screen.show(image)
+    assert events == ["release"] + (["busy"] if initially_busy else []) + ["acquire", "commit", "release"]
+
+
+@pytest.mark.parametrize("contention", ["brief", "persistent", "denied"])
+def test_hyperpixel_exit_during_an_hdmi_commit(monkeypatch, tmp_path, contention):
+    import errno
+    from fpms import lite
+    from fpms.modules.screen import hyperpixel
+
+    # The live KMS framebuffer represents the last private setup/QR frame.
+    pixels = bytearray(b"code")
+    buffer = SimpleNamespace(id=42, map=lambda index: memoryview(pixels))
+    screen = DpiScreen.__new__(DpiScreen)
+    screen.card = SimpleNamespace(fd=3)
+    screen.buffers = [buffer]
+    screen.front = None
+    screen.show = lambda image: setattr(screen, "front", 0)
+    commits, attempts, drops, heartbeats, pauses = [], [], [], [], []
+
+    def acquire(fd):
+        attempts.append(fd)
+        if contention == "denied":
+            return -errno.EACCES
+        if contention == "brief" and len(attempts) == 2:
+            return 0
+        return -errno.EBUSY
+
+    screen._libdrm = SimpleNamespace(drmSetMaster=acquire, drmDropMaster=lambda fd: drops.append(fd) or 0)
+    screen.plane = SimpleNamespace(refresh_props=lambda: None, get_prop_value=lambda key: buffer.id)
+    request = SimpleNamespace(add=lambda plane, values: commits.append(values), commit_sync=lambda: 0)
+    screen.kms = SimpleNamespace(AtomicReq=lambda card: request)
+
+    stop = []
+    touch = SimpleNamespace(read=lambda timeout: stop.append(True) or [], close=lambda: None)
+    monkeypatch.setattr(hyperpixel, "find_touch", lambda: "event-panel")
+    monkeypatch.setattr(hyperpixel, "TouchInput", lambda *args: touch)
+    monkeypatch.setattr(DpiScreen, "open", lambda: screen)
+    monkeypatch.setattr(TouchMenu, "frame", lambda self: Image.new("RGB", (800, 480)))
+    monkeypatch.setattr(lite, "FIRST_ADMIN", tmp_path / "first-admin")
+    monkeypatch.setattr(lite, "heartbeat", lambda live, **kwargs: heartbeats.append(live))
+    # A clock shared by the loop and DRM acquisition proves that retries sleep and finish.
+    clock = SimpleNamespace(monotonic=lambda: 1.0 + sum(pauses), sleep=lambda seconds: pauses.append(seconds))
+    monkeypatch.setattr(lite, "time", clock)
+    monkeypatch.setattr(hyperpixel, "time", clock)
+    args = SimpleNamespace(seconds=0, rotate=0, sleep=0)
+    panel = Panel(tmp_path / "config", tmp_path / "snapshot", can_leave=False)
+
+    if contention == "denied":
+        with pytest.raises(OSError, match="drmSetMaster") as exc:
+            lite.run_hyperpixel(panel, args, lambda: bool(stop), 0)
+        assert exc.value.errno == errno.EACCES
+        assert attempts == [3] and pauses == []
+    else:
+        lite.run_hyperpixel(panel, args, lambda: bool(stop), 0)
+        assert 0 < sum(pauses) < 0.5
+    assert heartbeats == [True, False]
+    assert commits == ([{"FB_ID": 0, "CRTC_ID": 0}] if contention == "brief" else [])
+    assert drops == ([3] if contention == "brief" else [])
+    assert pixels == bytes(4)
+    assert screen.front is None and not screen.buffers
