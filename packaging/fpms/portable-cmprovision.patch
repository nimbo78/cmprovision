diff --git a/fpms/integrations/cmprovision.py b/fpms/integrations/cmprovision.py
new file mode 100644
index 0000000..5d6b926
--- /dev/null
+++ b/fpms/integrations/cmprovision.py
@@ -0,0 +1,642 @@
+"""Read-only cmprovision front panel, shared by Lite and the WLAN Pi menu.
+
+No WLAN Pi state, subprocesses, database access or device control. Pillow is
+the only non-stdlib dependency; drivers belong to the process hosting us.
+"""
+
+import json
+import math
+import os
+import pwd
+import stat
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+CONFIG = Path("/etc/default/cmprovision-fpms.json")
+SNAPSHOT = Path("/run/cmprovision-wallboard-data/snapshot.json")
+HEARTBEAT = Path("/run/fpms/cmprovision.json")
+LIMIT = 2097152
+# cmprovision resources/css/app.css, Warm / Dark; alpha text composited on black.
+COLORS = {
+    "bg": "#000000",
+    "panel": "#121214",
+    "line": "#222226",
+    "text": "#e6e6e6",
+    "muted": "#8a8a8a",
+    "accent": "#ff8a3d",
+    "good": "#7ee2a0",
+    "bad": "#ff9d93",
+    "warn": "#ffcf7a",
+    "info": "#7fb2ff",
+}
+MAP_COLUMNS = 8   # columns of the front panel on a screen: 8 cubes of 12 pixels with their gaps fill the width
+MAP_TOP = 49
+CUBE, GAP, BLOCK_GAP = 12, 2, 3
+PAGES = ("Overview", "Ports", "Devices", "Errors", "Station")
+PROMPT_SECONDS = 3.0   # the leave prompt waits this long for the second press of button 2
+AGE_SHOWN = 10         # data younger than this is not called old
+
+
+def trusted_owners():
+    """Who may own a file this process reads (FPMS runs as root): root, the web user that writes the snapshot, and
+    whoever runs us (the tests)."""
+    owners = {0, os.geteuid()}
+    try:
+        owners.add(pwd.getpwnam("www-data").pw_uid)
+    except KeyError:
+        pass
+    return frozenset(owners)
+
+
+def read_json(path, limit=4096):
+    """A bounded read of a small file that another user may have prepared: a link is not followed, a pipe is not waited
+    for (a FIFO or /dev/watchdog put in its place would hang or reboot the box), only a regular file of a trusted owner
+    counts, and anything else is an empty answer."""
+    fd = None
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_size > limit or info.st_uid not in trusted_owners():
+            return {}
+        with os.fdopen(fd, "rb") as stream:
+            fd = None
+            raw = stream.read(limit + 1)
+        if len(raw) > limit:
+            return {}
+        value = json.loads(raw)
+        return value if isinstance(value, dict) else {}
+    except (OSError, ValueError, TypeError, RecursionError):
+        return {}
+    finally:
+        if fd is not None:
+            os.close(fd)
+
+
+def settings(path=CONFIG):
+    data = read_json(path)
+    if set(data) != {"enabled", "open_on_start"} or any(
+        type(v) is not bool for v in data.values()
+    ):
+        return {"enabled": False, "open_on_start": False}
+    return data
+
+
+def heartbeat(hardware, path=HEARTBEAT):
+    """Only the display owner writes this bounded liveness record."""
+    try:
+        path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
+        fd, name = tempfile.mkstemp(prefix=".cmprovision-", dir=path.parent)
+        try:
+            with os.fdopen(fd, "w") as out:
+                json.dump(
+                    {"protocol": 1, "at": int(time.time()), "hardware": bool(hardware)},
+                    out,
+                )
+                os.fchmod(out.fileno(), 0o644)
+            os.replace(name, path)
+        finally:
+            if os.path.exists(name):
+                os.unlink(name)
+    except OSError:
+        pass  # An optional integration must not take the stock menu down.
+
+
+def text(value):
+    if not isinstance(value, (str, int, float)) or isinstance(value, bool):
+        return ""
+    return "".join(c if c.isprintable() else " " for c in str(value))[:512]
+
+
+def number(value, default=0):
+    if type(value) not in (int, float):
+        return default
+    try:
+        return value if math.isfinite(value) else default
+    except OverflowError:  # an integer beyond the range of a float
+        return default
+
+
+def rate(value):
+    if type(value) in (int, float):
+        return f"{number(value) / 1048576:.1f} MiB/s" if number(value) > 0 else ""
+    return text(value)
+
+
+def slow(value):
+    """SLOW +3:20: the run is that long past what the finished modules of its batch took (cmprovision 2.19.0)"""
+    seconds = int(number(value)) if type(value) in (int, float) else 0
+    return f"SLOW +{seconds // 60}:{seconds % 60:02d}" if seconds > 0 else ""
+
+
+def identity(row):
+    """What pins an open device card to one device: its serial, else its MAC, else its port and name (a silent device
+    on a port has neither a serial nor a MAC, and its name is the same "unknown device" as the next one's)"""
+    port = text(row.get("port"))
+    return text(row.get("serial") or row.get("mac") or ((port + " " if port else "") + text(row.get("name"))))
+
+
+def remaining(value):
+    if type(value) in (int, float):
+        seconds = max(0, int(number(value)))
+        return f"ETA {seconds // 60}:{seconds % 60:02d}"
+    return text(value)
+
+
+def objects(value, limit=256):
+    return (
+        [x for x in value[:limit] if isinstance(x, dict)]
+        if isinstance(value, list)
+        else []
+    )
+
+
+class Panel:
+    def __init__(self, config=CONFIG, snapshot=SNAPSHOT, can_leave=True, clock=time.monotonic):
+        """can_leave: there is a menu to go back to (WLAN Pi); on Lite the panel is the whole screen.
+        clock: monotonic seconds, for the leave prompt (the tests turn it)."""
+        self.can_leave, self.clock = can_leave, clock
+        # button 2 on a page asks first: until this time a second press leaves (PROMPT_SECONDS)
+        self.prompt_until = None
+        self.config, self.snapshot = Path(config), Path(snapshot)
+        self.page, self.index, self.detail, self.scroll = 0, 0, None, 0
+        self.data, self.problem, self.age = {}, "Waiting for data", None
+        self.enabled, self.last_read = False, -1e10
+        self.lock = threading.RLock()
+        self.font = ImageFont.load_default(size=10)
+        self.small = ImageFont.load_default(size=9)
+        self.large = ImageFont.load_default(size=18)
+        self.tiny = ImageFont.load_default(size=8)
+
+    def refresh(self, now=None, force=False):
+        now = time.time() if now is None else now
+        with self.lock:
+            if not force and time.monotonic() - self.last_read < 2:
+                return
+            self.last_read = time.monotonic()
+            self.enabled = settings(self.config)["enabled"]
+            if not self.enabled:
+                self.data, self.problem, self.age = {}, "Integration off", None
+                self.detail = None
+                return
+            data = read_json(self.snapshot, LIMIT)
+            generated = data.get("generated_at")
+            if type(data.get("version")) is not int or data["version"] != 1:
+                self.problem = "Unsupported data" if data else "Waiting for data"
+                self.data, self.age, self.detail = {}, None, None
+                return
+            if number(generated, None) is None or generated > now:
+                self.data, self.problem, self.age, self.detail = (
+                    {},
+                    "Invalid timestamp",
+                    None,
+                    None,
+                )
+                return
+            self.data, self.age = data, int(now - generated)
+            # old data stays on the screen, told by its age (age_label): the values are the last ones saved
+            self.problem = ""
+
+    def age_label(self):
+        """'' while the data is fresh (under AGE_SHOWN seconds), then '12 s', and from a minute '3 min'."""
+        if self.age is None or self.age < AGE_SHOWN:
+            return ""
+        return f"{self.age} s" if self.age < 60 else f"{self.age // 60} min"
+
+    def _panel_setting(self, key, values):
+        panel = self.data.get("panel") if isinstance(self.data.get("panel"), dict) else {}
+        value = panel.get(key)
+        return value if isinstance(value, str) and value in values else values[0]
+
+    def theme(self):
+        """new or classic (Settings → Provisioning → FPMS display); new when the server does not say."""
+        return self._panel_setting("theme", ("new", "classic"))
+
+    def ports_map(self):
+        """pages (12 px cells with numbers, 8 columns to a screen) or whole (every port of a switch at once)."""
+        return self._panel_setting("ports_map", ("pages", "whole"))
+
+    def error_count(self):
+        """The modules that failed or went silent: the red counter of Errors and the OK > of Overview. Devices on ports
+        that are not modules are listed in Errors too, but a phone plugged in for good must not keep the counter red."""
+        return sum(1 for m in objects(self.data.get("modules")) if m.get("state") in ("fail", "stale"))
+
+    def rows(self):
+        if self.page == 1:
+            rows = []
+            for s_index, switch in enumerate(objects(self.data.get("switches"), 64)):
+                if switch.get("answering") is False:
+                    rows.append(
+                        {
+                            "name": text(switch.get("name")),
+                            "state": "No response",
+                            "serials": [],
+                        }
+                    )
+                for block in objects(switch.get("blocks"), 32):
+                    for port in objects(block.get("ports"), 256):
+                        rows.append(
+                            dict(
+                                port,
+                                name=text(switch.get("name"))
+                                + " "
+                                + text(port.get("name")),
+                                # two switches may have the same name: the place of the switch in the list tells them apart
+                                pin=f"{s_index}:{text(port.get('name'))}",
+                                portname=text(port.get("name")),
+                            )
+                        )
+            return rows[:512]
+        modules = objects(self.data.get("modules"))
+        if self.page == 3:
+            modules = [
+                m for m in modules if m.get("state") in ("fail", "stale", "unknown")
+            ]
+            modules += [
+                dict(m, state="unknown", name=text(m.get("name")) or text(m.get("mac")))
+                for m in objects(self.data.get("unknown"))
+            ]
+        return modules
+
+    def selected(self):
+        rows = self.rows()
+        self.index = min(self.index, max(0, len(rows) - 1))
+        return rows[self.index] if rows else None
+
+    def key(self, key):
+        """False means leave this integration. Button 2 goes back: it closes a card, and on a page it asks first, so a
+        second press within PROMPT_SECONDS leaves (on Lite, with no menu to go to, it is Overview). Button 3 does nothing
+        here: in the stock menu it is the Reboot/Shutdown shortcut, whose Confirm the next press of the centre would take.
+        Button 1 is Overview. Left and right turn the pages. No operation writes to a device."""
+        with self.lock:
+            now = self.clock()
+            if self.prompt_until is not None:
+                asked, self.prompt_until = now < self.prompt_until, None
+                if asked:
+                    # the second press leaves; any other button only takes the question away
+                    return key != "KEY2"
+            if key == "KEY3":
+                pass
+            elif key == "KEY1":
+                self.page, self.index, self.detail, self.scroll = 0, 0, None, 0
+            elif key == "KEY2":
+                if self.detail is not None:
+                    self.detail, self.scroll = None, 0
+                elif self.can_leave:
+                    self.prompt_until = now + PROMPT_SECONDS
+                else:
+                    self.page, self.index, self.scroll = 0, 0, 0
+            elif self.detail is not None:
+                if key in ("LEFT", "CENTER"):
+                    self.detail, self.scroll = None, 0
+                elif key in ("UP", "DOWN"):
+                    self.scroll = max(0, self.scroll + (1 if key == "DOWN" else -1))
+            elif key in ("LEFT", "RIGHT"):
+                self.page = (self.page + (1 if key == "RIGHT" else -1)) % len(PAGES)
+                self.index, self.scroll = 0, 0
+            elif key in ("UP", "DOWN") and self.page == 4:
+                # Station scrolls when its rows do not fit
+                self.scroll = max(0, self.scroll + (1 if key == "DOWN" else -1))
+            elif key in ("UP", "DOWN"):
+                self.index = (self.index + (1 if key == "DOWN" else -1)) % max(
+                    1, len(self.rows())
+                )
+            elif key == "CENTER" and self.page == 0:
+                if self.error_count():
+                    self.page, self.index = 3, 0
+            elif key == "CENTER" and self.page in (1, 2, 3):
+                row = self.selected()
+                if row:
+                    serials = (
+                        row.get("serials")
+                        if isinstance(row.get("serials"), list)
+                        else []
+                    )
+                    # Pin by identity: a port disappearing must not show another device's details.
+                    self.detail = (
+                        ("port", text(row.get("pin") or row.get("name")))
+                        if self.page == 1 and not serials
+                        else ("module", text(serials[0]) if serials else identity(row))
+                    )
+                    self.scroll = 0
+            return True
+
+    def detail_row(self):
+        kind, pinned = self.detail
+        if kind == "port":
+            return next(
+                (p for p in self.rows() if text(p.get("pin") or p.get("name")) == pinned),
+                None,
+            )
+        rows = objects(self.data.get("modules")) + objects(self.data.get("unknown"))
+        return next((m for m in rows if identity(m) == pinned), None)
+
+    def map_view(self):
+        """The ports of every switch as the columns of its front panel, in the order of rows(): [{name, answering, first,
+        columns: [(top, bottom, block)]}], where top and bottom are indexes into rows() or None. A block of two rows is read
+        column by column (1 above 2, 3 above 4); a block of one row (uplinks, SFP) sits on the lower row, as on the switch."""
+        views, n = [], 0
+        for switch in objects(self.data.get("switches"), 64):
+            view = {
+                "name": text(switch.get("name")),
+                "answering": switch.get("answering") is not False,
+                "first": n,
+                "columns": [],
+            }
+            if not view["answering"]:
+                n += 1
+            for b, block in enumerate(objects(switch.get("blocks"), 32)):
+                indexes = list(range(n, n + len(objects(block.get("ports"), 256))))
+                n += len(indexes)
+                if number(block.get("rows"), 1) >= 2:
+                    for i in range(0, len(indexes), 2):
+                        view["columns"].append(
+                            (indexes[i], indexes[i + 1] if i + 1 < len(indexes) else None, b)
+                        )
+                else:
+                    view["columns"] += [(None, i, b) for i in indexes]
+            views.append(view)
+        return views
+
+    def map_cells(self):
+        """What the map page draws: (switch name, bank, banks, switch answers, cells) for the switch of the selected row;
+        a cell is (x, y, index into rows())."""
+        self.selected()
+        for view in self.map_view():
+            columns = view["columns"]
+            mine = [
+                i
+                for i, (top, bottom, _) in enumerate(columns)
+                if self.index in (top, bottom)
+            ]
+            if not mine and not (not view["answering"] and view["first"] == self.index):
+                continue
+            banks = max(1, -(-len(columns) // MAP_COLUMNS))
+            bank = (mine[0] // MAP_COLUMNS) if mine else 0
+            cells, x, last = [], 4, None
+            for top, bottom, block in columns[bank * MAP_COLUMNS : (bank + 1) * MAP_COLUMNS]:
+                if last is not None and block != last:
+                    x += BLOCK_GAP
+                last = block
+                for y, index in ((MAP_TOP, top), (MAP_TOP + CUBE + GAP, bottom)):
+                    if index is not None and index < 512:
+                        cells.append((x, y, index))
+                x += CUBE + GAP
+            return view["name"], bank, banks, view["answering"], cells
+        return "", 0, 1, True, []
+
+    @staticmethod
+    def map_style(row):
+        """(fill, outline, ink) as names of COLORS: hollow is free, filled is a module, outlined is something else."""
+        filt, state = text(row.get("filter")), text(row.get("state"))
+        if row.get("server"):
+            return "accent", "accent", "bg"
+        if state == "module" or filt in ("ok", "run", "fail", "stale"):
+            key = {"ok": "good", "run": "info", "fail": "bad", "stale": "warn"}.get(filt, "muted")
+            return key, key, "bg"
+        key = {"free": "muted", "uplink": "accent", "boot": "info"}.get(state, "warn")
+        return None, key, key
+
+    def draw_map(self, draw, label):
+        rows = self.rows()
+        name, bank, banks, answering, cells = self.map_cells()
+        label(4, 36, name + (f"  {bank + 1}/{banks}" if banks > 1 else ""), "text", self.small, 120)
+        if not answering:
+            label(5, 60, "No response", "warn")
+        for x, y, index in cells:
+            row = rows[index] if index < len(rows) else {}
+            fill, outline, ink = self.map_style(row)
+            draw.rectangle(
+                (x, y, x + CUBE - 1, y + CUBE - 1),
+                fill=COLORS[fill] if fill else None,
+                outline=COLORS[outline],
+            )
+            caption = "cm" if row.get("server") else text(row.get("number"))
+            width = draw.textlength(caption, font=self.tiny)
+            # digits stand one pixel from the top; the lowercase "cm" has no height above its x-height: one pixel higher
+            top = y if row.get("server") else y + 1
+            draw.text(
+                (x + (CUBE - width) / 2, top), caption, font=self.tiny, fill=COLORS[ink]
+            )
+            if index == self.index:
+                draw.rectangle((x - 1, y - 1, x + CUBE, y + CUBE), outline=COLORS["text"])
+        row = rows[self.index] if rows and self.index < len(rows) else None
+        if row:
+            module = next(
+                (
+                    m
+                    for m in objects(self.data.get("modules"))
+                    if text(m.get("serial")) in [text(s) for s in (row.get("serials") or [])]
+                ),
+                None,
+            )
+            port = text(row.get("portname")) or text(row.get("name"))
+            if module:
+                label(4, 82, text(module.get("name")), "text", self.small, 120)
+                percent = module.get("percent")
+                progress = f" {int(percent)}%" if type(percent) in (int, float) and math.isfinite(percent) else ""
+                label(4, 92, port + "  " + text(module.get("phase") or module.get("state")) + progress, "muted", self.small, 120)
+            else:
+                label(4, 82, port, "text", self.small, 120)
+                label(4, 92, text(row.get("state")), "muted", self.small, 120)
+        for x, fill, title in ((3, "good", "done"), (38, "info", "run"), (66, "bad", "fail"), (94, "muted", "free")):
+            hollow = title == "free"
+            draw.rectangle(
+                (x, 104, x + 6, 110), fill=None if hollow else COLORS[fill], outline=COLORS[fill]
+            )
+            label(x + 10, 102, title, "muted", self.small, 24)
+
+    def frame(self):
+        with self.lock:
+            if self.theme() == "new":
+                from . import cmprovision_new
+
+                return cmprovision_new.render(self)
+            scrollable = False
+            image = Image.new("RGB", (128, 128), COLORS["bg"])
+            draw = ImageDraw.Draw(image)
+
+            def label(x, y, value, color="text", font=None, width=120):
+                font = font or self.font
+                value = text(value)
+                while value and draw.textlength(value, font=font) > width:
+                    value = value[:-1]
+                draw.text((x, y), value, font=font, fill=COLORS[color])
+
+            draw.rounded_rectangle((3, 3, 21, 19), radius=3, fill=COLORS["accent"])
+            # the tile is 3..21 by 3..19 and the lettering is 13 px wide (x 6..18) and 5 px high (y 9..13): the same margin on both sides
+            draw.text((6, 5), "cm", font=self.small, fill=COLORS["bg"])
+            label(
+                27,
+                4,
+                "Device" if self.detail else PAGES[self.page],
+                font=self.small,
+                width=97,
+            )
+            draw.line((3, 23, 124, 23), fill=COLORS["line"])
+            if self.problem:
+                label(
+                    4,
+                    26,
+                    self.problem + (f" {self.age}s" if self.age is not None else ""),
+                    "warn",
+                    self.small,
+                )
+            else:
+                label(4, 26, f"Updated {self.age or 0}s ago", "muted", self.small)
+            if not self.data:
+                label(
+                    5,
+                    51,
+                    "Enable in Settings" if not self.enabled else "Check web UI",
+                    "accent",
+                )
+                label(5, 69, "FPMS display", "muted")
+            elif self.detail:
+                row = self.detail_row()
+                if row is None:
+                    label(5, 55, "Device left stand", "warn")
+                else:
+                    diag = (
+                        row.get("diagnostics")
+                        if isinstance(row.get("diagnostics"), dict)
+                        else {}
+                    )
+                    lines = [
+                        row.get("name"),
+                        row.get("port"),
+                        row.get("mac"),
+                        row.get("phase") or row.get("state"),
+                        slow(row.get("slow")),
+                        row.get("detail"),
+                        rate(row.get("speed")),
+                        remaining(row.get("eta")),
+                        diag.get("title"),
+                        row.get("advice"),
+                    ]
+                    for issue in objects(diag.get("issues"), 4):
+                        lines += [issue.get("title"), issue.get("advice")]
+                    wrapped = []
+                    for value in filter(None, map(text, lines)):
+                        part = ""
+                        for char in value:
+                            if draw.textlength(part + char, font=self.font) > 118:
+                                wrapped.append(part)
+                                part = ""
+                            part += char
+                        if part:
+                            wrapped.append(part)
+                    self.scroll = min(self.scroll, max(0, len(wrapped) - 5))
+                    for i, line in enumerate(wrapped[self.scroll : self.scroll + 5]):
+                        label(5, 40 + i * 13, line, width=114)
+                    if len(wrapped) > 5:
+                        # a bar on the right: where the window is among the lines, so the end of a card is seen as the end
+                        scrollable = True
+                        draw.rectangle((124, 40, 125, 104), fill=COLORS["line"])
+                        top = 40 + int(65 * self.scroll / len(wrapped))
+                        bottom = 40 + int(65 * (self.scroll + 5) / len(wrapped))
+                        draw.rectangle((124, top, 125, max(top + 2, bottom)), fill=COLORS["text"])
+                    pct = row.get("percent")
+                    if type(pct) in (int, float) and math.isfinite(pct):
+                        shade = {"ok": "good", "done": "good", "fail": "bad", "failed": "bad", "stale": "warn", "run": "info"}.get(
+                            text(row.get("state")), "accent"
+                        )
+                        draw.rectangle((5, 108, 122, 111), fill=COLORS["line"])
+                        draw.rectangle(
+                            (5, 108, 5 + int(117 * max(0, min(100, pct)) / 100), 111),
+                            fill=COLORS[shade],
+                        )
+            elif self.page == 0:
+                label(
+                    4,
+                    40,
+                    self.data.get("project") or "No active project",
+                    "accent",
+                    self.small,
+                )
+                counts = (
+                    self.data.get("counts")
+                    if isinstance(self.data.get("counts"), dict)
+                    else {}
+                )
+                for x, y, key, title, color in [
+                    (4, 55, "running", "RUN", "accent"),
+                    (66, 55, "done", "DONE", "good"),
+                    (4, 84, "failed", "FAIL", "bad"),
+                    (66, 84, "unknown", "OTHER", "warn"),
+                ]:
+                    draw.rectangle((x, y, x + 57, y + 26), fill=COLORS["panel"])
+                    value = max(0, int(number(counts.get(key))))
+                    if key == "unknown":
+                        value += max(0, int(number(counts.get("stale"))))
+                    label(x + 3, y + 1, str(min(999, value)), color, self.large, 32)
+                    label(x + 27, y + 16, title, "muted", self.small, 30)
+            elif self.page == 1:
+                self.draw_map(draw, label)
+            elif self.page in (2, 3):
+                rows = self.rows()
+                self.selected()
+                if not rows:
+                    label(
+                        5, 56, "No errors" if self.page == 3 else "No devices", "muted"
+                    )
+                for i, row in enumerate(
+                    rows[self.index // 4 * 4 : self.index // 4 * 4 + 4]
+                ):
+                    y = 40 + i * 18
+                    selected = self.index % 4 == i
+                    if selected:
+                        draw.rectangle((2, y - 1, 125, y + 16), fill=COLORS["panel"])
+                        draw.rectangle((2, y - 1, 3, y + 16), fill=COLORS["accent"])
+                    name = text(row.get("name")) or text(row.get("mac")) or "Unknown"
+                    label(7, y, name, "text", self.small, 116)
+                    color = (
+                        "bad"
+                        if row.get("state") in ("fail", "failed")
+                        else (
+                            "good" if row.get("state") in ("ok", "done") else "accent"
+                        )
+                    )
+                    label(
+                        7,
+                        y + 8,
+                        row.get("phase") or row.get("state"),
+                        color,
+                        self.small,
+                        116,
+                    )
+            else:
+                station = (
+                    self.data.get("station")
+                    if isinstance(self.data.get("station"), dict)
+                    else {}
+                )
+                lines = [
+                    self.data.get("host"),
+                    self.data.get("app_version"),
+                    station.get("management"),
+                    station.get("provisioning") or "No provisioning link",
+                    station.get("storage"),
+                ]
+                for i, value in enumerate(lines):
+                    label(
+                        5,
+                        42 + i * 14,
+                        value or "--",
+                        "text" if i == 0 else "muted",
+                        self.small,
+                    )
+            draw.line((3, 115, 124, 115), fill=COLORS["line"])
+            label(
+                4,
+                117,
+                ("Up/down scroll   3 Back" if scrollable else "3 Back")
+                if self.detail
+                else ("< > Page   OK  3 Menu" if self.page in (1, 2, 3) else "< > Page   3 Menu"),
+                "muted",
+                self.small,
+            )
+            return image
