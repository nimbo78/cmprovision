[Unit]
Description=Create a unique cmprovision key on the first image boot
After=local-fs.target systemd-random-seed.service
Before=ssh.service nginx.service cmprovision-queue.service cmprovision-queue-images.service cmprovision-wallboard-data.service cmprovision-fpms-data.service

[Service]
Type=oneshot
ExecStart=/usr/lib/cmprovision/image-firstboot
RemainAfterExit=yes
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
