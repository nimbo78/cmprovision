#!/usr/bin/python3
"""Start dnsmasq, optionally confined to a root-selected provisioning interface."""
import os
import re
import stat
import subprocess
import sys

CONFIG = '/var/lib/cmprovision/etc/dnsmasq.conf'
BINDING = '/etc/default/cmprovision-stand-interface'
PIDFILE = '/run/cmprovision-dnsmasq.pid'
IFNAME = re.compile(r'^[A-Za-z0-9_.-]{1,15}$')
CONFLICTS = {'interface', 'listen-address', 'except-interface', 'bind-interfaces', 'bind-dynamic',
             'conf-file', 'conf-dir', 'no-dhcp-interface', 'no-dhcpv6-interface', 'no-tftp-interface'}


def binding(path=BINDING):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    try:
        info = os.fstat(fd)
        parent = os.lstat(os.path.dirname(path))
        if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_mode & 0o022 or \
                not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_size > 64:
            raise ValueError('The stand interface configuration is not secure.')
        with os.fdopen(fd, encoding='ascii', closefd=False) as source:
            name = source.read().strip()
    finally:
        os.close(fd)
    if not IFNAME.fullmatch(name):
        raise ValueError('The stand interface configuration is invalid.')
    return name


def check_config(content):
    if len(content) > 1048576:
        raise ValueError('The dnsmasq configuration is too large to check safely.')
    for line in content.splitlines():
        option = line.strip()
        if not option or option.startswith('#'):
            continue
        key = option.partition('=')[0].strip().lower()
        if key in CONFLICTS:
            raise ValueError('Remove the conflicting dnsmasq option: ' + key)


def command(name):
    args = ['/usr/sbin/dnsmasq', '-C', CONFIG, '--pid-file=' + PIDFILE]
    if name is not None:
        # The config is web-owned: read it as the web user, never follow its paths as root here.
        result = subprocess.run(['runuser', '-u', 'www-data', '--', 'head', '-c', '1048577', CONFIG],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10, check=False)
        if result.returncode:
            raise ValueError('The dnsmasq configuration could not be read as the web user.')
        check_config(result.stdout.decode('utf-8'))
        args += ['--interface=' + name, '--bind-dynamic']
    return args


def main():
    args = command(binding())
    os.execv(args[0], args)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, UnicodeError, subprocess.SubprocessError) as exc:
        print('cmprovision dnsmasq: ' + str(exc), file=sys.stderr)
        sys.exit(1)
