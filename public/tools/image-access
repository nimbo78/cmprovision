#!/usr/bin/python3
"""Offline per-user SSH setup. Settings arrive on authenticated SSH stdin only."""
import base64
import fcntl
import fnmatch
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import struct
import subprocess
import sys
import tempfile

RUNTIME = Path('/run/cmprovision-station-setup')
STATE = 'var/lib/cmprovision-image-access'
SSH_POLICY = 'etc/ssh/cmprovision-user-access.conf'
SUDO_POLICY = 'etc/cmprovision-image-access.sudoers'
NAME = r'[a-z][a-z0-9-]{0,31}'
HASH = r'\$6\$(?:rounds=100000\$)?[A-Za-z0-9./]{1,16}\$[A-Za-z0-9./]{86}'
RESERVED = {'root', 'nobody', 'daemon', 'bin', 'sys', 'www-data', 'sshd'}
CODES = {'invalid_settings', 'unsafe_path', 'unsupported_image', 'account_missing', 'account_conflict',
         'account_ambiguous', 'account_unsafe', 'rename_references', 'receipt_conflict',
         'ssh_policy', 'command_failed', 'identity_mismatch', 'busy'}


class Failure(RuntimeError):
    def __init__(self, code):
        self.code = code if code in CODES else 'command_failed'
        super().__init__(self.code)


def checked(root, member):
    member = PurePosixPath(member)
    if member.is_absolute() or '..' in member.parts or not member.parts:
        raise Failure('unsafe_path')
    current = root
    if root.is_symlink():
        raise Failure('unsafe_path')
    for number, part in enumerate(member.parts):
        current /= part
        if current.is_symlink() or (number < len(member.parts) - 1 and current.exists() and not current.is_dir()):
            raise Failure('unsafe_path')
    return current


def read(root, member, limit=1024 * 1024):
    path = checked(root, member)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        raise Failure('unsafe_path') from None
    with os.fdopen(fd, 'rb') as file:
        info = os.fstat(file.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
            raise Failure('unsafe_path')
        return file.read(limit + 1).decode('utf-8')


def write(root, member, text, mode=0o600):
    path = checked(root, member)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.exists() and not path.is_file():
        raise Failure('unsafe_path')
    fd, temporary = tempfile.mkstemp(prefix='.cmprovision-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as file:
            os.fchmod(file.fileno(), mode)
            file.write(text)
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def validate_settings(settings):
    fields = {'schema', 'profile', 'hostname', 'username', 'password_hash', 'keys', 'ssh', 'wifi',
              'source_username', 'sudo_passwordless'}
    if not isinstance(settings, dict) or set(settings) != fields:
        raise Failure('invalid_settings')
    if type(settings['schema']) is not int or settings['schema'] != 2 or settings['profile'] != 'raspios':
        raise Failure('invalid_settings')
    for key in ('username', 'source_username'):
        value = settings[key]
        if key == 'source_username' and value == '':
            continue
        if not isinstance(value, str) or not re.fullmatch(NAME, value) or value in RESERVED:
            raise Failure('invalid_settings')
    host = settings['hostname']
    if not isinstance(host, str) or (host and not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', host)):
        raise Failure('invalid_settings')
    password = settings['password_hash']
    if password is not None and (not isinstance(password, str) or not re.fullmatch(HASH, password)):
        raise Failure('invalid_settings')
    if settings['ssh'] is not True or settings['wifi'] is not None or type(settings['sudo_passwordless']) is not bool:
        raise Failure('invalid_settings')
    keys = settings['keys']
    if not isinstance(keys, list) or len(keys) > 10 or len(set(k for k in keys if isinstance(k, str))) != len(keys):
        raise Failure('invalid_settings')
    for key in keys:
        if not isinstance(key, str) or len(key) > 16384:
            raise Failure('invalid_settings')
        match = re.fullmatch(r'(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(?:256|384|521)) ([A-Za-z0-9+/=]+)', key)
        try:
            blob = base64.b64decode(match[2], validate=True) if match else b''
            length = struct.unpack('>I', blob[:4])[0]
            valid = length <= 64 and blob[4:4 + length].decode() == match[1] and len(blob) >= length + 12
        except (ValueError, TypeError, UnicodeError, struct.error):
            valid = False
        if not valid:
            raise Failure('invalid_settings')
    if password is None and (not keys or not settings['sudo_passwordless']):
        raise Failure('invalid_settings')
    return settings


def accounts(root):
    result = []
    for line in read(root, 'etc/passwd').splitlines():
        row = line.split(':')
        if len(row) != 7 or not row[2].isdigit() or not row[3].isdigit():
            raise Failure('unsupported_image')
        result.append({'name': row[0], 'uid': int(row[2]), 'gid': int(row[3]), 'home': row[5], 'shell': row[6], 'create': False})
    return result


def interactive(account):
    return 1000 <= account['uid'] < 60000 and account['shell'].startswith('/') and PurePosixPath(account['shell']).name not in {'nologin', 'false', 'sync'}


def first_user_template(root, account):
    return account['name'] == 'pi' and account['uid'] == 1000 and account['shell'] == '/usr/sbin/nologin' \
        and checked(root, 'usr/lib/userconf-pi/userconf').is_file() \
        and checked(root, 'usr/bin/cancel-rename').is_file() \
        and checked(root, 'usr/lib/systemd/system/userconfig.service').is_file()


def select_account(root, settings):
    users = accounts(root)
    destination = next((u for u in users if u['name'] == settings['username']), None)
    source = settings['source_username']
    if source:
        selected = next((u for u in users if u['name'] == source), None)
        if selected is None:
            raise Failure('account_missing')
        if destination is not None and destination['name'] != selected['name']:
            raise Failure('account_conflict')
    elif destination is not None:
        selected = destination
    else:
        normal = [u for u in users if interactive(u) or first_user_template(root, u)]
        selected = next((u for u in normal if u['uid'] == 1000), None)
        if selected is None and len(normal) > 1:
            raise Failure('account_ambiguous')
        if selected is None:
            selected = normal[0] if normal else {'name': settings['username'], 'uid': None, 'gid': None,
                'home': '/home/' + settings['username'], 'shell': '/bin/bash', 'create': True}
    if not selected['create'] and first_user_template(root, selected):
        selected = dict(selected, template=True)
    if not selected['create'] and not interactive(selected) and not selected.get('template'):
        raise Failure('account_unsafe')
    return selected


def resolved_read(root, member):
    """Resolve image symlinks with absolute targets anchored at the image, never the host."""
    relative = PurePosixPath(member)
    if relative.is_absolute():
        raise Failure('unsafe_path')
    remaining, parts, links = list(relative.parts), [], 0
    while remaining:
        piece = remaining.pop(0)
        if piece in {'', '.'}:
            continue
        if piece == '..':
            if not parts:
                raise Failure('unsafe_path')
            parts.pop()
            continue
        path = root.joinpath(*parts, piece)
        if path.is_symlink():
            links += 1
            if links > 40:
                raise Failure('unsafe_path')
            target = PurePosixPath(os.readlink(path))
            if target.is_absolute():
                parts = []
            remaining = [p for p in target.parts if p != '/'] + remaining
        else:
            parts.append(piece)
    return root.joinpath(*parts)


def executable(root, member):
    path = resolved_read(root, member)
    if not path.is_file() or not os.access(path, os.X_OK):
        raise Failure('unsupported_image')
    return path


def renamed_metadata(root, old, new):
    changes = []
    for member in ['etc/sudoers', *regular_files(root, 'etc/sudoers.d'), 'etc/subuid', 'etc/subgid']:
        path = checked(root, member)
        if not path.exists():
            continue
        before = read(root, member)
        lines = []
        for line in before.splitlines(keepends=True):
            if member in {'etc/subuid', 'etc/subgid'}:
                line = re.sub(r'^' + re.escape(old) + ':', new + ':', line)
            else:
                body = line.split('#', 1)[0]
                if re.match(r'^\s*' + re.escape(old) + r'\s', body):
                    line = re.sub(r'^(\s*)' + re.escape(old) + r'(?=\s)', lambda m: m[1] + new, line, count=1)
                elif re.search(r'(?<![a-zA-Z0-9_%/-])' + re.escape(old) + r'(?![a-zA-Z0-9_/-])', body) \
                        and (body.lstrip().startswith('User_Alias ') or ',' in body.split(' ', 1)[0]):
                    raise Failure('rename_references')
            lines.append(line)
        after = ''.join(lines)
        if after != before:
            changes.append((member, after, stat.S_IMODE(path.stat().st_mode)))
    return changes


def regular_files(root, member):
    directory = checked(root, member)
    if not directory.exists():
        return []
    if not directory.is_dir():
        raise Failure('unsafe_path')
    result = []
    for parent, children, files in os.walk(directory, followlinks=False):
        children[:] = [name for name in children if not (Path(parent) / name).is_symlink()]
        for name in files:
            path = Path(parent) / name
            if not path.is_symlink() and path.is_file():
                result.append(path.relative_to(root).as_posix())
            if len(result) > 8192:
                raise Failure('unsupported_image')
    return result


def preflight(root, selected, settings):
    release = checked(root, 'etc/os-release') if not (root / 'etc/os-release').is_symlink() else None
    if release is None:
        target = os.readlink(root / 'etc/os-release')
        if target not in {'../usr/lib/os-release', '/usr/lib/os-release'}:
            raise Failure('unsafe_path')
        member = 'usr/lib/os-release'
    else:
        member = 'etc/os-release'
    os_release = read(root, member)
    if not re.search(r'(?m)^(?:ID|ID_LIKE)=["\']?(?:debian|raspbian)(?:["\']?$|\s)', os_release):
        raise Failure('unsupported_image')
    for member in ['usr/sbin/useradd', 'usr/sbin/usermod', 'usr/sbin/chpasswd', 'usr/sbin/sshd',
                   'usr/sbin/visudo', 'usr/bin/python3', 'usr/bin/systemctl']:
        executable(root, member)
    if selected.get('template'):
        executable(root, 'usr/bin/cancel-rename')
    if not re.search(r'(?m)^sudo:[^:]*:[0-9]+:', read(root, 'etc/group')):
        raise Failure('unsupported_image')
    home = PurePosixPath(selected['home'])
    if not home.is_absolute() or home == PurePosixPath('/') or home.parts[1] in {'root', 'etc', 'usr', 'bin', 'sbin', 'dev', 'proc', 'sys', 'run'}:
        raise Failure('account_unsafe')
    for member in [home.as_posix().lstrip('/'), home.as_posix().lstrip('/') + '/.ssh/authorized_keys',
                   'etc/passwd', 'etc/group', 'etc/shadow', 'etc/gshadow',
                   'etc/ssh/sshd_config', SSH_POLICY, 'etc/sudoers', SUDO_POLICY, STATE + '/receipt.json']:
        checked(root, member)
    if selected['name'] != settings['username']:
        old = re.escape(selected['name'])
        renamed_metadata(root, selected['name'], settings['username'])
        for folder in ['usr/lib/systemd/system', 'etc/systemd/system']:
            members = regular_files(root, folder)
            directory = checked(root, folder)
            if directory.exists():
                for parent, directories, files in os.walk(directory, followlinks=False):
                    directories[:] = [name for name in directories if not (Path(parent) / name).is_symlink()]
                    for name in files:
                        path = Path(parent) / name
                        if path.is_symlink():
                            target = resolved_read(root, path.relative_to(root).as_posix())
                            if target.is_file():
                                members.append(target.relative_to(root).as_posix())
                    if len(members) > 8192:
                        raise Failure('unsupported_image')
            for member in set(members):
                if re.search(r'(?m)^\s*User\s*=\s*' + old + r'\s*(?:[#;].*)?$', read(root, member)):
                    raise Failure('rename_references')
        if checked(root, 'var/spool/cron/crontabs/' + selected['name']).exists():
            raise Failure('rename_references')
        for member in ['etc/crontab', *regular_files(root, 'etc/cron.d')]:
            if checked(root, member).exists():
                for line in read(root, member).splitlines():
                    fields = line.split()
                    if not fields or fields[0].startswith('#'):
                        continue
                    index = 1 if fields[0].startswith('@') else 5
                    if len(fields) > index and fields[index] == selected['name']:
                        raise Failure('rename_references')


def user_ssh_policy(settings):
    policy = 'Match User ' + settings['username'] + '\n    PasswordAuthentication ' + ('yes' if settings['password_hash'] else 'no') + \
        '\n    PubkeyAuthentication yes\n    KbdInteractiveAuthentication no\n'
    if settings['keys']:
        policy += '    AuthorizedKeysFile .ssh/authorized_keys\n    AuthorizedKeysCommand none\n'
    if settings['password_hash'] is None:
        policy += '    AuthenticationMethods publickey\n'
    return policy


def validate_ssh(run, settings, config=None):
    arguments = ['-h', '/run/cmprovision-station-setup/host'] + (['-f', config] if config else [])
    run(['/usr/sbin/sshd', '-t', *arguments])
    effective = run(['/usr/sbin/sshd', '-T', *arguments, '-C',
                     'user=' + settings['username'] + ',host=localhost,addr=127.0.0.1']).decode()
    rows = [line.split(' ', 1) for line in effective.splitlines() if ' ' in line]
    options = dict(rows)
    if options.get('passwordauthentication') != ('yes' if settings['password_hash'] else 'no') or options.get('pubkeyauthentication') != 'yes' \
            or options.get('kbdinteractiveauthentication') != 'no' or options.get('forcecommand', 'none') != 'none' \
            or options.get('authenticationmethods', 'any') != ('any' if settings['password_hash'] else 'publickey'):
        raise Failure('ssh_policy')
    if settings['keys'] and (options.get('authorizedkeysfile') != '.ssh/authorized_keys' or options.get('authorizedkeyscommand', 'none') != 'none'):
        raise Failure('ssh_policy')
    limits = {key: [word for name, value in rows if name == key for word in value.split()]
              for key in ('allowusers', 'denyusers', 'allowgroups', 'denygroups')}
    allowed = limits['allowusers']
    denied = limits['denyusers']
    user = settings['username']
    if limits['allowgroups'] or limits['denygroups'] or any('!' in p for p in allowed + denied) \
            or (allowed and not any('@' not in p and fnmatch.fnmatchcase(user, p) for p in allowed)) \
            or any(fnmatch.fnmatchcase(user, p.split('@', 1)[0]) for p in denied):
        raise Failure('ssh_policy')


def stage_ssh(root, settings, run):
    canonical = 'Include /' + SSH_POLICY
    original = '\n'.join(line for line in read(root, 'etc/ssh/sshd_config').splitlines() if line.strip() != canonical)
    staged_policy = 'run/cmprovision-station-setup/access-sshd.conf'
    staged_config = 'run/cmprovision-station-setup/access-sshd_config'
    write(root, staged_policy, user_ssh_policy(settings))
    write(root, staged_config, original.rstrip() + '\nInclude /' + staged_policy + '\n')
    validate_ssh(run, settings, '/' + staged_config)


def configure(root, identity, settings, run):
    validate_settings(settings)
    fingerprint = hashlib.sha256(json.dumps(settings, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    receipt_path = checked(root, STATE + '/receipt.json')
    receipt = json.loads(read(root, STATE + '/receipt.json')) if receipt_path.exists() else None
    if receipt:
        if receipt.get('identity') != identity or receipt.get('fingerprint') != fingerprint:
            raise Failure('receipt_conflict')
        if receipt.get('state') == 'applied':
            return
        selected = dict(receipt['account'])
        current = next((u for u in accounts(root) if u['name'] == settings['username']), None)
        if current is not None:
            if not selected['create'] and any(current[k] != selected[k] for k in ('uid', 'gid', 'home')):
                raise Failure('account_conflict')
            selected = current
    else:
        selected = select_account(root, settings)
    preflight(root, selected, settings)
    stage_ssh(root, settings, run)
    if receipt is None:
        receipt = {'identity': identity, 'fingerprint': fingerprint, 'state': 'pending', 'account': selected}
        write(root, STATE + '/receipt.json', json.dumps(receipt))
    user = settings['username']
    if selected['create']:
        run(['useradd', '--create-home', '--shell', '/bin/bash', '--', user])
    elif selected['name'] != user:
        run(['usermod', '--login', user, '--', selected['name']])
    original = receipt['account']
    if original.get('template'):
        run(['usermod', '--shell', '/bin/bash', '--', user])
    if original['name'] != user:
        for member, contents, mode in renamed_metadata(root, original['name'], user):
            write(root, member, contents, mode)
    current = next((u for u in accounts(root) if u['name'] == user), None)
    if current is None or not interactive(current):
        raise Failure('account_unsafe')
    run(['usermod', '--append', '--groups', 'sudo', '--', user])
    run(['chpasswd', '-e'], (user + ':' + (settings['password_hash'] or '*') + '\n').encode())
    home = current['home'].lstrip('/')
    if settings['keys']:
        write(root, home + '/.ssh/authorized_keys', '\n'.join(settings['keys']) + '\n')
        folder = checked(root, home + '/.ssh')
        folder.chmod(0o700)
        os.chown(folder, current['uid'], current['gid'])
        os.chown(folder / 'authorized_keys', current['uid'], current['gid'])
    if settings['hostname']:
        write(root, 'etc/hostname', settings['hostname'] + '\n', 0o644)
        if checked(root, 'etc/hosts').exists():
            lines = [line for line in read(root, 'etc/hosts').splitlines() if not re.match(r'^\s*127\.0\.1\.1\s', line)]
            write(root, 'etc/hosts', '\n'.join(lines) + '\n127.0.1.1\t' + settings['hostname'] + '\n', 0o644)
    if original.get('template'):
        run(['/usr/bin/cancel-rename', user])
    include = 'Include /' + SSH_POLICY
    ssh_config = '\n'.join(line for line in read(root, 'etc/ssh/sshd_config').splitlines() if line.strip() != include)
    write(root, SSH_POLICY, user_ssh_policy(settings), 0o644)
    write(root, 'etc/ssh/sshd_config', ssh_config.rstrip() + '\n' + include + '\n', 0o644)
    validate_ssh(run, settings)
    rule = user + ' ALL=(ALL:ALL) ' + ('NOPASSWD' if settings['sudo_passwordless'] else 'PASSWD') + ': ALL\n'
    write(root, SUDO_POLICY, rule, 0o440)
    run(['visudo', '-c', '-f', '/' + SUDO_POLICY])
    sudoers = read(root, 'etc/sudoers')
    sudo_include = '@include /' + SUDO_POLICY
    if sudo_include not in sudoers.splitlines():
        write(root, 'etc/sudoers', sudoers.rstrip() + '\n\n# cmprovision installed OS access\n' + sudo_include + '\n', 0o440)
    run(['visudo', '-c'])
    for service in ['userconfig.service', 'userconfig-pi.service']:
        if any((root / folder / service).exists() for folder in ('etc/systemd/system', 'usr/lib/systemd/system')):
            run(['systemctl', 'disable', service])
    run(['systemctl', 'enable', 'ssh.service'])
    receipt['state'] = 'applied'
    write(root, STATE + '/receipt.json', json.dumps(receipt))


def execute(argv, data=None):
    result = subprocess.run(argv, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'}, timeout=60)
    if result.returncode:
        raise Failure('command_failed')
    return result.stdout


def identity():
    root = Path('/')
    expected = json.loads(read(root, str(RUNTIME / 'identity.json').lstrip('/'), 4096))
    if set(expected) != {'schema', 'serial', 'cid', 'run'} or expected['schema'] != 1 \
            or not re.fullmatch(r'[a-f0-9]{16}', expected['serial']) or not re.fullmatch(r'[a-f0-9]{32}', expected['cid']) \
            or not re.fullmatch(r'[A-Za-z0-9]{40}', expected['run']):
        raise Failure('identity_mismatch')
    disk = read(root, str(RUNTIME / 'storage').lstrip('/'), 128).strip()
    if not re.fullmatch(r'/dev/mmcblk[0-9]+', disk):
        raise Failure('identity_mismatch')
    serial = Path('/proc/device-tree/serial-number').read_bytes().rstrip(b'\0').decode().lower()
    cid = Path('/sys/class/block/' + disk[5:] + '/device/cid').read_text().strip().lower()
    if serial != expected['serial'] or cid != expected['cid']:
        raise Failure('identity_mismatch')
    return expected


def main():
    if os.geteuid() != 0:
        raise Failure('identity_mismatch')
    expected = identity()
    command = os.environ.get('SSH_ORIGINAL_COMMAND', '')
    if command == 'identity':
        print(json.dumps(expected))
        return
    if command != 'apply':
        raise Failure('identity_mismatch')
    raw = sys.stdin.buffer.read(65537)
    if len(raw) > 65536:
        raise Failure('invalid_settings')
    payload = json.loads(raw)
    if not isinstance(payload, dict) or set(payload) != {'identity', 'settings'} or payload['identity'] != expected:
        raise Failure('identity_mismatch')
    fd = os.open(RUNTIME / 'access.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Failure('busy') from None
        configure(Path('/'), expected, payload['settings'], execute)
        print('applied')
    finally:
        os.close(fd)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('image-access:error:' + (error.code if isinstance(error, Failure) else 'command_failed'))
        sys.exit(1)
